/*
 * nexus: the HTTP application framework for Echo.
 *
 * An app is a list of extensions. Each one wires the app by hand in one
 * place: services into the container, actions onto routes
 * (`$s->bindAction<ShowPost>(method: .get, path: '/v1/posts/{id}', ...)`),
 * signal handlers onto a dispatcher. `nexus gen` writes what only the types can
 * tell: the code that runs each action from its `handle()` signature,
 * the input decoders and the config loaders. The kernel finds the
 * generated tables at compile time, keyed by type.
 *
 * The core knows no transport and no database: nexus-http serves it over
 * libhttp, nexus-carbon hands each request a database session.
 */

#[module: "nexus"]
#[version: "0.1.1"] // x-release-please-version
#[epm::echoc: ">=0.16.0"]
#[epm::license: "MIT"]
#[epm::description: "The HTTP application framework for Echo"]

#[requires: "echopack/container" { version: "^0.1.0", source: git "https://github.com/echopack/container" }]
#[requires: "echolang/libjson" { version: "^0.3.0", source: git "https://github.com/echolang/libjson" }]
#[requires: "echolang/libcommand" { version: "^0.1.6", source: git "https://github.com/echolang/libcommand" }]
#[requires: "echolang/libcrypto" { version: "^0.3.3", source: git "https://github.com/echolang/libcrypto" }]
#[requires: "echopack/calendar" { version: "^0.1.2", source: git "https://github.com/echopack/calendar" }]

#[sources: "src/**/*.eco"]

// every module developed with the core. `echoc test --workspace` builds them as one program and
// runs each one's tests, and `epm install` here installs what all of them require
#[workspace: ["modules/*", "modules/*/*", "examples/blog"]]

// the developer tool: `nexus gen`, run by an app's before_build hook
#[target: exe { name: "nexus", entry: "cli/main.eco", public: true }] {
    #[sources: ["cli/main.eco", "cli/src/*.eco"]]
}

#[target: test] {
    #[sources: ["tests/*.eco", "cli/src/*.eco", "cli/tests/*.eco"]]
    #[requires: "echolang/ecotest" { version: "^0.3.4", source: git "https://github.com/echolang/ecotest" }]
}
