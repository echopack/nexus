namespace nexusgen;

/**
 * One `handle()` parameter, classified.
 */
public struct Param
{
    public string $name;
    public ParamKind $kind;
    public json::Value $type;
    public string $typeText;
    public bool $hasDefault;
    public string $defaultText;

    /**
     * The input struct of a `Body<T>` or `QueryOf<T>`, qualified.
     */
    public string $input = '';

    /**
     * Whether the path segment is `{name?}`.
     */
    public bool $optionalSegment = false;
}
