namespace nexusgen;

/**
 * An action (or an MCP tool class, which is read the same way): its
 * `handle()` parameters and return type, and whether nexus gen writes the
 * code that offers it as a tool.
 */
public struct ActionDecl
{
    public string $qualified;
    public string $file;
    public int64 $line;
    public array<Param> $params = [];

    /**
     * The transformer `#[nexus::answers]` names, and whether it answers
     * one model (`response`) or a list (`collection`).
     */
    public string $answers = '';
    public string $answersAs = '';
    /**
     * The middleware `#[nexus::through]` names, outermost first.
     */
    public array<string> $through = [];
    public json::Value $returns = json::nil();
    public string $returnText = '';

    /**
     * Whether it can be offered over MCP; the app offers it, under the
     * name it picks.
     */
    public bool $offered = false;
    public ToolMeta $tool = ToolMeta();
}
