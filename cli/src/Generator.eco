/**
 * The pipeline `nexus gen` runs in a module directory: one `echoc -p decls` pass over the whole
 * program, the generators of the dependencies on it, then `.nexus/nexus.eco` for the module's own
 * actions, inputs and configs.
 *
 * The pass defines NEXUS_NOGEN, CARBON_NOGEN and REST_NOGEN, which the manifest uses to leave every
 * generated directory out, so a stale generated file never stops the next one from being written,
 * and passes --no-hooks, since this is the hook. Code that uses generated names fails to compile in
 * that pass; echoc still prints every declaration, so those complaints only matter when nothing
 * came out. carbongen and restgen read the same pass from a file (`--decls`) when the manifest
 * wires `.carbon/` or `.rest/`.
 */

namespace nexusgen;

use std::env;
use std::io;
use nexusgen::{decl, emitter, stamp};

public struct Generator
{
    public string $echoc = 'echoc';
    public bool $quiet = false;
    public std::fs::path $target = '.nexus/nexus.eco';

    /**
     * What the module's dependencies offer, from `echoc -p tools`, read the first time a tool is
     * needed.
     */
    private json::Value? $offered = null;

    /**
     * Makes the decls pass, runs the wired generators of the dependencies on it (`check` or
     * `generate`, as `$check` says) and renders nexus's own file.
     */
    public function render(bool $check) : result<string, Failure>
    {
        $manifest = std::fs::readfile('module.eco')->or('');
        if ($manifest->empty()) {
            return .error(.noManifest);
        }
        if (!$manifest->contains('NEXUS_NOGEN') || !$manifest->contains('.nexus/')) {
            return .error(.unwired);
        }
        string $name = guard Generator::named($manifest) else {
            return .error(.unnamed);
        };
        $file = Generator::declsPath();
        $all = try $this->pass($file);
        foreach (Tool::all() as const &$tool) {
            if ($tool->wired($manifest)) {
                try $this->run($tool, $file, $check);
            }
        }
        json::Value $local = guard Generator::only($all, $name) else {
            return .error(.noModule($name));
        };
        $p = Program($local, $all);
        if (!$p->problems->empty()) {
            return .error(.problems($p->problems));
        }
        string $extra = '';
        if (!$p->tasks->empty()) {
            $extra->append(", {$p->tasks->count()} task(s)");
        }
        if (!$p->commands->empty()) {
            $extra->append(", {$p->commands->count()} command(s)");
        }
        if (!$p->tools->empty()) {
            $extra->append(", {$p->tools->count()} tool(s)");
        }
        if (!$p->mapped->empty()) {
            $extra->append(", {$p->mapped->count()} mapped model(s)");
        }
        if (!$p->logs->empty()) {
            $extra->append(", {$p->logs->count()} log record(s)");
        }
        if (!$p->mails->empty()) {
            $extra->append(", {$p->mails->count()} mail(s)");
        }
        $this->say("nexus gen  {$p->actions->count()} action(s), {$p->inputs->count()} input(s), {$p->configs->count()} config(s){$extra}");
        return .ok(emitter::render($p));
    }

    /**
     * Writes the generated files when their content changed. With `$force` false, a module whose
     * sources did not change since the last run is not even read.
     */
    public function generate(bool $force) : status<Failure>
    {
        $stampPath = Generator::stampPath();
        $stamp = stamp::digest('.', $this->echoc);
        if (!$force && $this->there() && std::fs::readfile($stampPath)->or('') == $stamp) {
            $this->say('nexus gen  up to date');
            return .ok;
        }
        $text = try $this->render(false);
        std::fs::mkdir('.nexus');
        if (std::fs::readfile($this->target)->or('') != $text) {
            try Generator::put($this->target, $text);
            $this->say("wrote      {$this->target}");
        } else {
            $this->say("current    {$this->target}");
        }
        // a stamp that cannot be written only costs the next run its shortcut
        Generator::put($stampPath, $stamp);
        return .ok;
    }

    /**
     * Whether every generated file is what generating would write now.
     */
    public function check() : status<Failure>
    {
        $text = try $this->render(true);
        if (std::fs::readfile($this->target)->or('') != $text) {
            return .error(.stale($this->target));
        }
        $this->say("current    {$this->target}");
        return .ok;
    }

    /**
     * Whether every file a run would write is on disk, so an unchanged stamp may skip the run.
     */
    private const function there() : bool
    {
        if (!std::fs::exists($this->target)->or(false)) {
            return false;
        }
        $manifest = std::fs::readfile('module.eco')->or('');
        foreach (Tool::all() as const &$tool) {
            if ($tool->wired($manifest) && !std::fs::exists($tool->target())->or(false)) {
                return false;
            }
        }
        return true;
    }

    /**
     * The decls pass over the whole program, kept in `$file` for the generators of the
     * dependencies.
     */
    private const function pass(const std::fs::path& $file) : result<json::Value, Failure>
    {
        array<string> $args = ['build', '-p', 'decls', '--no-hooks', '--decls-all'];
        foreach (['NEXUS_NOGEN', 'CARBON_NOGEN', 'REST_NOGEN'] as const &$define) {
            $args[] = '--define';
            $args[] = $define;
        }
        $args[] = '-o';
        $args[] = 'ecobuild/nexus-decls';
        std::process::output $run = guard std::process::command($this->echoc, $args)->output() else ($e) {
            return .error(.cannotRun($this->echoc, $e));
        };
        json::Value $decls = guard json::parse($run->stdout) else {
            return .error(.tool($run->status, $run->stderr));
        };
        if (decl::items($decls, 'modules')->empty()) {
            return .error(.tool($run->status, $run->stderr));
        }
        try Generator::put($file, $run->stdout);
        return .ok($decls);
    }

    /**
     * Builds `$tool` the way echoc says it is built, then runs it on the decls in `$file`.
     */
    private function run(Tool $tool, const std::fs::path& $file, bool $check) : status<Failure>
    {
        $entry = try $this->find($tool);
        $build = decl::texts(decl::field($entry, 'build'));
        if ($build->empty()) {
            return .error(.noBuild($tool));
        }
        string $compiler = $build[0];
        array<string> $rest = [];
        usize $i = 1;
        while ($i < $build->count()) {
            $rest[] = $build[$i];
            $i = $i + 1;
        }
        std::process::output $built = guard std::process::command($compiler, $rest)->output() else ($e) {
            return .error(.cannotBuild($tool, $e));
        };
        if (!$built->status->success()) {
            return .error(.generator($tool->program(), "{$built->stdout}{$built->stderr}"));
        }
        $binary = decl::text($entry, 'binary');
        string $mode = 'generate';
        if ($check) {
            $mode = 'check';
        }
        array<string> $args = [$mode, '--decls', $file->string()];
        if ($this->quiet) {
            $args[] = '--quiet';
        }
        std::process::output $ran = guard std::process::command($binary, $args)->output() else ($e) {
            return .error(.cannotRun($binary, $e));
        };
        if (!$ran->status->success()) {
            return .error(.generator($tool->program(), "{$ran->stdout}{$ran->stderr}"));
        }
        string $said = string::from(str::trim($ran->stdout));
        if (!$said->empty()) {
            $this->say($said);
        }
        return .ok;
    }

    /**
     * The `echoc -p tools` entry offering `$tool`.
     */
    private function find(Tool $tool) : result<json::Value, Failure>
    {
        if ($this->offered == null) {
            std::process::output $run = guard std::process::command($this->echoc, ['build', '-p', 'tools'])->output() else ($e) {
                return .error(.cannotRun($this->echoc, $e));
            };
            json::Value $tools = guard json::parse($run->stdout) else {
                return .error(.tool($run->status, $run->stderr));
            };
            $this->offered = $tools;
        }
        json::Value $offered = guard $this->offered;
        foreach (decl::items($offered, 'public_tools') as const &$entry) {
            foreach (decl::texts(decl::field($entry, 'refs')) as const &$ref) {
                if ($ref == $tool->program()) {
                    return .ok($entry);
                }
            }
        }
        return .error(.notOffered($tool));
    }

    /**
     * The name `#[module: "..."]` gives in `$manifest`, null when it gives none.
     */
    public static function named(const string& $manifest) : string?
    {
        foreach (str::split($manifest, "\n") as const &$raw) {
            string $line = string::from(str::trim($raw));
            if ($line->starts('#[module:')) {
                return Generator::quoted($line);
            }
        }
        return null;
    }

    /**
     * The paths every `#[depends: "..."]` in `$manifest` names, in any target.
     */
    public static function depends(const string& $manifest) : array<string>
    {
        array<string> $out = [];
        foreach (str::split($manifest, "\n") as const &$raw) {
            string $line = string::from(str::trim($raw));
            if (!$line->starts('#[depends:')) {
                continue;
            }
            string? $found = Generator::quoted($line);
            if ($found != null) {
                $out[] = $found ?? '';
            }
        }
        return $out;
    }

    /**
     * The text between the first pair of quotes on `$line`, null when there is none.
     */
    internal static function quoted(const string& $line) : string?
    {
        // either quote: the manifest is Echo
        string $quote = '"';
        usize $open = $line->find($quote);
        usize $single = $line->find("'");
        if ($single < $open) {
            $open = $single;
            $quote = "'";
        }
        if ($open == $line->size()) {
            return null;
        }
        string $tail = $line->sub($open + 1, $line->size() - $open - 1);
        usize $close = $tail->find($quote);
        if ($close == $tail->size()) {
            return null;
        }
        return $tail->sub(0, $close);
    }

    /**
     * `$decls` cut down to the module called `$name`, in the shape a pass without `--decls-all`
     * prints; null when no module has that name.
     */
    public static function only(const json::Value& $decls, const string& $name) : json::Value?
    {
        foreach (decl::items($decls, 'modules') as const &$m) {
            if (decl::text($m, 'name') != $name) {
                continue;
            }
            $list = json::arr();
            $list[] = $m;
            $out = json::object();
            $out['modules'] = mv $list;
            return $out;
        }
        return null;
    }

    private const function say(const string& $line) : void
    {
        if (!$this->quiet) {
            io::eprintln($line);
        }
    }

    /**
     * Where the decls pass is kept: the hook's state directory under a build, `ecobuild/`
     * otherwise.
     */
    private static function declsPath() : std::fs::path
    {
        string::view? $state = env::var('ECHO_HOOK_STATE');
        if ($state != null) {
            string::view $dir = guard $state;
            return std::fs::path(string($dir)) / 'decls.json';
        }
        std::fs::mkdir('ecobuild');
        return 'ecobuild/nexus-decls.json';
    }

    /**
     * Where the stamp of the last run is kept, beside the decls pass.
     */
    private static function stampPath() : std::fs::path
    {
        string::view? $state = env::var('ECHO_HOOK_STATE');
        if ($state != null) {
            string::view $dir = guard $state;
            return std::fs::path(string($dir)) / 'stamp';
        }
        std::fs::mkdir('ecobuild');
        return 'ecobuild/nexus-gen.stamp';
    }

    private static function put(const std::fs::path& $path, const string& $text) : status<Failure>
    {
        guard std::fs::writefile($path, $text) else ($e) {
            return .error(.cannotWrite($path, $e));
        };
        return .ok;
    }
}
