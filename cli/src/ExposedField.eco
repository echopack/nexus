namespace nexusgen;

/**
 * One `#[nexus::expose]` field of a model and how its mapping writes it.
 */
public struct ExposedField
{
    public string $name;

    /**
     * The key on the wire, `created_at` for `createdAt` unless `key:` says
     * otherwise.
     */
    public string $key;

    /**
     * The `nexus::rest::Item` writer: `int`, `float`, `bool`, `text`,
     * `time`, `texts`, `ints`, `value`, `enum`, `include` (a
     * `carbon::One`) or `includeCollection` (a `carbon::Many`).
     */
    public string $writer;

    /**
     * The field's type without its `?`, as source.
     */
    public string $type = '';

    /**
     * Whether the value may be null (`T?`), written as `nil` then.
     */
    public bool $nullable = false;

    /**
     * The cast an integer or float needs on its way to int64 or float64,
     * like ` as int64`; empty when none.
     */
    public string $cast = '';

    /**
     * The shapes the field is in; empty for every shape.
     */
    public array<string> $shapes = [];

    public bool $attribute = false;
    public bool $sensitive = false;

    /**
     * XML's element name for each item of a list, `stamp` for a time.
     */
    public string $item = '';
    public string $stamp = '';

    /**
     * For an include, whether it is written without being asked.
     */
    public bool $always = false;

    /**
     * The model a relation includes, or the enum an `enum` writer names.
     */
    public string $of = '';
}
