/**
 * Small readers over libjson for the decls JSON, where a missing key and a
 * `null` mean the same thing: not there.
 */

namespace nexusgen;

public struct Json
{
    public static function field(const json::Value& $v, const string& $key) : json::Value
    {
        return $v->get($key) ?? json::nil();
    }

    public static function text(const json::Value& $v, const string& $key) : string
    {
        return Json::field($v, $key)->asStr() ?? '';
    }

    public static function int(const json::Value& $v, const string& $key) : int64
    {
        return Json::field($v, $key)->asInt() ?? 0;
    }

    public static function flag(const json::Value& $v, const string& $key) : bool
    {
        return Json::field($v, $key)->asBool() ?? false;
    }

    public static function items(const json::Value& $v, const string& $key) : array<json::Value>
    {
        return Json::field($v, $key)->asArray() ?? array<json::Value>();
    }

    /**
     * The `#[nexus::<name>]` attribute of a declaration, or null.
     */
    public static function tool(const json::Value& $decl, const string& $name) : json::Value?
    {
        foreach (Json::items($decl, 'tools') as const &$t) {
            if (Json::text($t, 'namespace') == 'nexus' && Json::text($t, 'name') == $name) {
                json::Value $hit = $t->clone();
                return $hit;
            }
        }
        return null;
    }

    public static function has(const json::Value& $decl, const string& $name) : bool
    {
        json::Value? $t = Json::tool($decl, $name);
        return $t != null;
    }

    /**
     * The value node of an attribute (`{"kind": "string", ...}`), nil when
     * it has none.
     */
    public static function value(const json::Value& $tool) : json::Value
    {
        return Json::field($tool, 'value');
    }

    /**
     * A string attribute value, or empty.
     */
    public static function string(const json::Value& $value) : string
    {
        if (Json::text($value, 'kind') != 'string') {
            return '';
        }
        return Json::text($value, 'text');
    }

    /**
     * The strings of a list attribute value.
     */
    public static function strings(const json::Value& $value) : array<string>
    {
        array<string> $out = [];
        foreach (Json::items($value, 'items') as const &$item) {
            $out[] = Json::string($item);
        }
        return $out;
    }

    /**
     * The strings of a plain JSON array of strings, skipping anything else.
     */
    public static function texts(const json::Value& $list) : array<string>
    {
        array<string> $out = [];
        foreach ($list->asArray() ?? array<json::Value>() as const &$item) {
            string? $text = $item->asStr();
            if ($text != null) {
                string $t = guard $text;
                $out[] = $t;
            }
        }
        return $out;
    }

    /**
     * The entries of a record attribute value, as key and value node.
     */
    public static function record(const json::Value& $value) : array<Entry>
    {
        array<Entry> $out = [];
        foreach (Json::items($value, 'fields') as const &$f) {
            $out[] = Entry(Json::text($f, 'key'), Json::field($f, 'value'));
        }
        return $out;
    }
}
