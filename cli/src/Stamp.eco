/**
 * A digest of everything the generated file depends on: every `.eco` file of the module (outside
 * build, vendor and hidden directories) and the compiler used. Equal stamps mean the decls pass can
 * be skipped.
 */

namespace nexusgen::stamp;

/**
 * The digest of the `.eco` files under `$root` and of the compiler `$echoc`.
 */
public function digest(const std::fs::path& $root, const string& $echoc) : string
{
    $h = crypto::Sha256();
    $h->update($echoc);
    $h->update('nexus-gen 2');
    array<string> $files = [];
    walk($root, $files);
    $files->sort();
    foreach ($files as const &$path) {
        $h->update($path);
        $h->update(std::fs::readfile($path)->or(''));
    }
    return crypto::hex($h->finish());
}

/**
 * Adds every `.eco` file under `$dir` to `$out`, as its path spelled out.
 */
internal function walk(const std::fs::path& $dir, array<string>& $out) : void
{
    $d = guard std::fs::opendir($dir) else {
        return;
    };
    foreach ($d as const &$e) {
        $name = $e->name();
        if ($name->starts('.') || $name == 'ecobuild' || $name == 'vendor') {
            continue;
        }
        if ($e->is_directory()) {
            walk($e->path(), $out);
        } else if ($name->ends('.eco')) {
            $out[] = $e->path()->string();
        }
    }
}
