/**
 * A digest of everything the generated file depends on: every `.eco` file of the module and of the
 * path dependencies its `module.eco` names, in turn (outside the build, vendor and hidden
 * directories at each of their roots), every mail template under `resources/emails/`, the lock file and the compiler
 * used. Equal stamps mean the decls pass can be skipped.
 */

namespace nexusgen::stamp;

use nexusgen::{mails, Generator};

/**
 * The digest of the `.eco` files under `$root` and of the compiler `$echoc`.
 */
public function digest(const std::fs::path& $root, const string& $echoc) : string
{
    $h = crypto::Sha256();
    $h->update($echoc);
    $h->update('nexus-gen 6');
    array<string> $files = [];
    walk($root, '.eco', $files, true);
    array<string> $seen = [];
    follow($root, $files, $seen);
    walk($root / mails::FOLDER, '', $files, true);
    $files[] = ($root / 'epm.lock.json')->string();
    $files->sort();
    foreach ($files as const &$path) {
        $h->update($path);
        $h->update(std::fs::readfile($path)->or(''));
    }
    return crypto::hex($h->finish());
}

/**
 * Adds the `.eco` files of every path dependency `$dir`'s `module.eco` names, and of theirs: the
 * decls pass reads their enums and inputs, so a change there makes the stamp stale. `$seen` holds
 * the cleaned paths already walked, so a cycle ends.
 */
internal function follow(const std::fs::path& $dir, array<string>& $out, array<string>& $seen) : void
{
    string $manifest = std::fs::readfile($dir / 'module.eco')->or('');
    foreach (Generator::depends($manifest) as const &$dep) {
        std::fs::path $at = ($dir / $dep)->clean();
        string $key = $at->string();
        bool $known = false;
        foreach ($seen as const &$s) {
            if ($s == $key) {
                $known = true;
            }
        }
        if ($known) {
            continue;
        }
        $seen[] = $key;
        walk($at, '.eco', $out, true);
        follow($at, $out, $seen);
    }
}

/**
 * Adds every file under `$dir` whose name ends in `$suffix` to `$out`, as its path spelled out. At
 * a `$root` (a module's own directory, or one nested in it with a `module.eco` of its own),
 * `ecobuild/`, `vendor/` and hidden entries are skipped: build output, installed dependencies and
 * `.nexus/` itself. Deeper down they are sources like any other, so `src/vendor/` counts.
 */
internal function walk(const std::fs::path& $dir, const string& $suffix, array<string>& $out, bool $root) : void
{
    $d = guard std::fs::opendir($dir) else {
        return;
    };
    foreach ($d as const &$e) {
        $name = $e->name();
        if ($root && ($name->starts('.') || $name == 'ecobuild' || $name == 'vendor')) {
            continue;
        }
        if ($e->is_directory()) {
            walk($e->path(), $suffix, $out, std::fs::exists($e->path() / 'module.eco')->or(false));
        } else if ($name->ends($suffix)) {
            $out[] = $e->path()->string();
        }
    }
}
