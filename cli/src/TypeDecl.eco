namespace nexusgen;

/**
 * An `#[nexus::input]` or `#[nexus::config]` struct.
 */
public struct TypeDecl
{
    public string $qualified;
    public string $file;
    public int64 $line;
    public array<FieldDecl> $fields = [];

    /**
     * The rule classes the whole input runs, once every field passed.
     */
    public array<string> $checks = [];
}
