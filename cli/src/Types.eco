/**
 * Renders a decls type tree back into Echo source, and sorts types into what the generated code
 * knows how to read.
 */

namespace nexusgen::types;

use nexusgen::decl;

public function render(const json::Value& $t) : string
{
    $kind = decl::text($t, 'kind');
    if ($kind == 'string') {
        return 'string';
    }
    if ($kind == 'prim') {
        return decl::text($t, 'name');
    }
    if ($kind == 'optional') {
        $inner = render(decl::field($t, 'of'));
        return "{$inner}?";
    }
    if ($kind == 'array') {
        $of = render(decl::field($t, 'of'));
        return "array<{$of}>";
    }
    if ($kind == 'map') {
        $k = render(decl::field($t, 'key'));
        $v = render(decl::field($t, 'value'));
        return "map<{$k}, {$v}>";
    }
    if ($kind == 'ptr') {
        $to = render(decl::field($t, 'to'));
        if (!decl::flag($t, 'borrow')) {
            return '';
        }
        if (decl::flag($t, 'const') || decl::flag(decl::field($t, 'to'), 'const')) {
            return "const {$to}&";
        }
        return "{$to}&";
    }
    if ($kind == 'named') {
        $name = decl::text($t, 'name');
        $args = decl::items($t, 'args');
        if ($args->count() == 0) {
            return $name;
        }
        array<string> $parts = [];
        foreach ($args as const &$a) {
            $parts[] = render($a);
        }
        $joined = str::join($parts, ', ');
        return "{$name}<{$joined}>";
    }
    return '';
}

/**
 * The named type's name, or empty.
 */
public function name(const json::Value& $t) : string
{
    if (decl::text($t, 'kind') != 'named') {
        return '';
    }
    return decl::text($t, 'name');
}

/**
 * The single type argument of `name<T>`, or nil.
 */
public function argument(const json::Value& $t) : json::Value
{
    $args = decl::items($t, 'args');
    if ($args->count() != 1) {
        return json::nil();
    }
    return $args[0]->clone();
}

public function optional(const json::Value& $t) : bool
{
    return decl::text($t, 'kind') == 'optional';
}

/**
 * `T` for `T?`, the type itself otherwise.
 */
public function bare(const json::Value& $t) : json::Value
{
    if (optional($t)) {
        return decl::field($t, 'of');
    }
    return $t->clone();
}

/**
 * The reader a value of this type uses on `nexus::Fields` and `nexus::Settings` (`string`, `int64`,
 * `strings`, `duration`, ...), or empty when it has none.
 */
public function reader(const json::Value& $t) : string
{
    $b = bare($t);
    $kind = decl::text($b, 'kind');
    if ($kind == 'string') {
        return 'string';
    }
    if ($kind == 'prim') {
        $n = decl::text($b, 'name');
        if ($n == 'bool' || $n == 'int32' || $n == 'int64' || $n == 'uint16' || $n == 'uint32' || $n == 'uint64' || $n == 'float64') {
            return $n;
        }
        return '';
    }
    if ($kind == 'array') {
        $of = decl::field($b, 'of');
        if (decl::text($of, 'kind') == 'string') {
            return 'strings';
        }
        if (decl::text($of, 'kind') == 'prim' && decl::text($of, 'name') == 'int64') {
            return 'ints';
        }
        return '';
    }
    $name = name($b);
    if ($name == 'json::Value') {
        return 'json';
    }
    if ($name == 'std::time::duration' || $name == 'time::duration') {
        return 'duration';
    }
    return '';
}

/**
 * The path constraint a parameter of this type implies, or empty.
 */
public function constraint(const json::Value& $t) : string
{
    $r = reader($t);
    if ($r == 'int32' || $r == 'int64') {
        return 'integer';
    }
    if ($r == 'uint16' || $r == 'uint32' || $r == 'uint64') {
        return 'number';
    }
    return '';
}

/**
 * Whether the source type `$type` (or the type inside it, for `T?`) is an integer.
 */
public function integer(const string& $type) : bool
{
    string $t = $type;
    if ($t->ends('?')) {
        $t = $t->sub(0, $t->size() - 1);
    }
    array<string> $all = ['int8', 'int16', 'int32', 'int64', 'uint8', 'uint16', 'uint32', 'uint64', 'isize', 'usize'];
    foreach ($all as const &$i) {
        if ($i == $t) {
            return true;
        }
    }
    return false;
}

/**
 * The left side declaring `$local` for a value of `$type` whose right side infers it: the type is
 * written only for an integer, so its width stays in sight.
 */
public function binding(const string& $type, const string& $local) : string
{
    if (integer($type)) {
        return "{$type} {$local}";
    }
    return $local;
}

/**
 * `$local` handed on at its last use: moved, unless it holds a number or a bool, where a move buys
 * nothing.
 */
public function moved(const string& $type, const string& $local) : string
{
    if (integer($type) || $type == 'bool' || $type == 'float32' || $type == 'float64') {
        return $local;
    }
    return "mv {$local}";
}
