namespace nexusgen;

/**
 * One field of an input or config struct.
 */
public struct FieldDecl
{
    public string $name;

    /**
     * The key in the input, or the variable in the environment.
     */
    public string $wire;

    public json::Value $type;
    public string $typeText;
    public bool $hasDefault;
    public string $defaultText;
    public array<Rule> $rules = [];
    public bool $secret = false;

    /**
     * The field's docblock as prose, for option help and schemas.
     */
    public string $doc = '';

    /**
     * Whether `#[nexus::positional]` makes it a word on the command line.
     */
    public bool $positional = false;

    /**
     * How an input field is read: `scalar` (a `Fields` reader), `enum`, `enums` (a list of them),
     * `object` (a nested input) or `objects`.
     */
    public string $shape = 'scalar';

    /**
     * The `Fields` reader: `string`, `int64`, `strings`, `date`, ...; for enums the reader of their
     * backing.
     */
    public string $reader = '';

    /**
     * What the field holds, as messages name it: `string`, `integer`, `number`, `boolean`, `list`,
     * `date`, `timestamp`, `enum`, `object`, `json`.
     */
    public string $kind = '';

    /**
     * The enum or nested input of an `enum`, `enums`, `object` or `objects` field.
     */
    public string $item = '';

    /**
     * `#[nexus::label]`, and the English messages `#[nexus::message]` gives per code.
     */
    public string $label = '';
    public array<Entry> $messages = [];

    /**
     * The rules every item of a list follows (`each:`), and the rule classes the field and its
     * items run.
     */
    public array<Rule> $each = [];
    public array<string> $checks = [];
    public array<string> $eachChecks = [];

    /**
     * The rule named `$key`, nil when the field has none.
     */
    public const function rule(const string& $key) : json::Value
    {
        foreach ($this->rules as const &$r) {
            if ($r->key == $key) {
                return $r->value->clone();
            }
        }
        return json::nil();
    }

    public const function has(const string& $key) : bool
    {
        foreach ($this->rules as const &$r) {
            if ($r->key == $key) {
                return true;
            }
        }
        return false;
    }
}
