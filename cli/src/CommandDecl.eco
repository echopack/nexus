namespace nexusgen;

/**
 * A class conforming to `nexus::Cli`: its help from the docblock and the
 * `#[nexus::input]` struct its options fill (empty for a command that
 * takes none). The app names it when it adds the command.
 */
public struct CommandDecl
{
    public string $qualified;
    public string $file;
    public int64 $line;
    public string $summary = '';
    public string $help = '';
    public string $input = '';
}
