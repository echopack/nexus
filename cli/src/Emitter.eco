namespace nexusgen;

/**
 * Writes the generated file for a program: per action a
 * `<Action>Dispatch` struct with the dispatcher (and `call()` when it can
 * be offered over MCP), per input a `<Input>Decoder`, per task a
 * `<Task>Task`, per command a `<Command>Cli`, per tool a `<Tool>Mcp`, per
 * shape of an exposing model a `<Model><Shape>Mapping`, and the
 * tables, keyed by type, that the kernel and the extensions find. Routes,
 * command names, tool names and task queues are not in it: the app gives
 * those where it is wired.
 */
public struct Emitter
{
    public static function render(const Program& $p) : string
    {
        Code $code = Code();
        $code->line('// generated by `nexus gen` from the types of this module.');
        $code->line('// do not edit; change the code and run `nexus gen` (a build does it).');

        array<string> $spaces = [];
        foreach ($p->actions as const &$a) {
            Emitter::note($spaces, Names::space($a->qualified));
        }
        foreach ($p->inputs as const &$i) {
            Emitter::note($spaces, Names::space($i->qualified));
        }
        foreach ($p->tasks as const &$j) {
            Emitter::note($spaces, Names::space($j->qualified));
        }
        foreach ($p->commands as const &$cmd) {
            Emitter::note($spaces, Names::space($cmd->qualified));
        }
        foreach ($p->tools as const &$t) {
            Emitter::note($spaces, Names::space($t->qualified));
        }
        foreach ($p->mapped as const &$m) {
            Emitter::note($spaces, Names::space($m->qualified));
        }
        $spaces->sort();
        foreach ($spaces as const &$space) {
            $code->blank();
            if (!$space->empty()) {
                $code->line("namespace {$space};");
                $code->blank();
            }
            foreach ($p->actions as const &$a) {
                if (Names::space($a->qualified) == $space) {
                    Emitter::dispatcher($code, $p, $a);
                }
            }
            foreach ($p->inputs as const &$i) {
                if (Names::space($i->qualified) == $space) {
                    Decoders::decoder($code, $p, $i);
                }
            }
            foreach ($p->tasks as const &$j) {
                if (Names::space($j->qualified) == $space) {
                    Emitter::task($code, $j);
                }
            }
            foreach ($p->commands as const &$cmd) {
                if (Names::space($cmd->qualified) == $space) {
                    Emitter::command($code, $p, $cmd);
                }
            }
            foreach ($p->tools as const &$t) {
                if (Names::space($t->qualified) == $space) {
                    Emitter::tool($code, $p, $t);
                }
            }
            foreach ($p->mapped as const &$m) {
                if (Names::space($m->qualified) == $space) {
                    foreach ($m->shapes as const &$shape) {
                        Mappings::mapping($code, $p, $m, $shape);
                    }
                }
            }
        }

        string $module = Names::segment($p->module);
        $code->blank();
        $code->line("namespace nexusgen::{$module};");
        $code->blank();
        Emitter::table($code, $p);
        $code->blank();
        Emitter::configs($code, $p);
        if (Emitter::declares($p)) {
            $code->blank();
            Emitter::inputs($code, $p);
        }
        if (Emitter::offers($p)) {
            $code->blank();
            Emitter::tools($code, $p);
        }
        if (!$p->tasks->empty()) {
            $code->blank();
            Emitter::tasks($code, $p);
        }
        return $code->text;
    }

    /**
     * Whether the program offers any MCP tool, as a class or an action.
     */
    internal static function offers(const Program& $p) : bool
    {
        if (!$p->tools->empty()) {
            return true;
        }
        foreach ($p->actions as const &$a) {
            if ($a->offered) {
                return true;
            }
        }
        return false;
    }

    internal static function note(array<string>& $list, const string& $s) : void
    {
        foreach ($list as const &$have) {
            if ($have == $s) {
                return;
            }
        }
        $list[] = $s;
    }

    // actions ----------------------------------------------------------------

    internal static function dispatcher(Code& $code, const Program& $prog, const ActionDecl& $a) : void
    {
        string $short = Names::short($a->qualified);
        $code->line('/**');
        $code->line(" * Runs {$a->qualified}.");
        $code->line(' */');
        $code->open("public struct {$short}Dispatch");
        Emitter::dispatch($code, $a);
        if ($a->offered) {
            $code->blank();
            Emitter::offer($code, $a, Emitter::actionSchema($prog, $a), "{$a->qualified}Dispatch");
            $code->blank();
            Emitter::call($code, $a);
        }
        $code->close();
        $code->blank();
    }

    internal static function problem(Code& $code) : void
    {
        $code->line('return nexus::Reply::problem($payload, $p);');
    }

    internal static function dispatch(Code& $code, const ActionDecl& $a) : void
    {
        $code->line('/**');
        $code->line(" * Reads what {$a->qualified}::handle() asks for, calls it and turns");
        $code->line(' * the result into a response.');
        $code->line(' */');
        $code->open('internal static function dispatch(nexus::Payload& $payload) : nexus::Response');

        array<string> $args = [];
        foreach ($a->params as const &$p) {
            string $u = Names::upper($p->name);
            $args[] = "$arg{$u}";
        }

        // path parameters
        foreach ($a->params as const &$p) {
            if ($p->kind != ParamKind::path) {
                continue;
            }
            string $u = Names::upper($p->name);
            string $reader = Types::reader($p->type);
            string $bare = Types::render(Types::bare($p->type));
            string $key = Names::quote($p->name);
            if (!$p->optionalSegment) {
                $code->begin("{$p->typeText} $arg{$u} = guard nexus::Param::{$reader}($payload, {$key}) else ($p)");
                Emitter::problem($code);
                $code->close(';');
                continue;
            }
            if ($p->hasDefault) {
                $code->line("{$p->typeText} $arg{$u} = {$p->defaultText};");
            } else {
                $code->line("{$p->typeText} $arg{$u} = null;");
            }
            $code->begin("if ($payload->param({$key}) != null)");
            $code->begin("{$bare} $got{$u} = guard nexus::Param::{$reader}($payload, {$key}) else ($p)");
            Emitter::problem($code);
            $code->close(';');
            $code->line("$arg{$u} = $got{$u};");
            $code->close();
        }

        // the payload and the request
        foreach ($a->params as const &$p) {
            string $u = Names::upper($p->name);
            if ($p->kind == ParamKind::payload) {
                $args = Emitter::swap($args, "$arg{$u}", '$payload');
            } else if ($p->kind == ParamKind::request) {
                $args = Emitter::swap($args, "$arg{$u}", '$payload->request');
            }
        }

        // inputs
        foreach ($a->params as const &$p) {
            if ($p->kind != ParamKind::body && $p->kind != ParamKind::queryInput) {
                continue;
            }
            string $u = Names::upper($p->name);
            string $decoder = "{$p->input}Decoder";
            if ($p->kind == ParamKind::body) {
                $code->begin("nexus::Fields $fields{$u} = guard nexus::Fields::body($payload) else ($p)");
                Emitter::problem($code);
                $code->close(';');
            } else {
                $code->line("nexus::Fields $fields{$u} = nexus::Fields::query($payload);");
            }
            $code->begin("{$p->input} $value{$u} = guard {$decoder}::decode($payload, $fields{$u}) else ($p)");
            Emitter::problem($code);
            $code->close(';');
            $code->line("{$p->typeText} $arg{$u} = {$p->typeText}($value{$u});");
        }

        string $short = Names::short($a->qualified);
        $code->line("{$a->qualified} $action = $payload->get<{$a->qualified}>();");
        string $call = str::join($args, ', ');
        string $kind = Json::text($a->returns, 'kind');
        if ($kind == 'void' || $a->returnText->empty() || $a->returnText == 'void') {
            $code->line("$action->handle({$call});");
            $code->line('nexus::Response $res = nexus::Response::noContent();');
        } else {
            $code->line("{$a->returnText} $result = $action->handle({$call});");
            string $reply = Emitter::reply($a);
            $code->line("nexus::Response $res = {$reply};");
        }
        $code->line('return $res;');
        $code->close();
    }

    internal static function swap(const array<string>& $args, const string& $from, const string& $to) : array<string>
    {
        array<string> $out = [];
        foreach ($args as const &$a) {
            if ($a == $from) {
                $out[] = $to;
            } else {
                $out[] = $a;
            }
        }
        return $out;
    }

    /**
     * The expression that turns `$result` into a response, by the declared
     * return type of handle().
     */
    internal static function reply(const ActionDecl& $a) : string
    {
        json::Value $t = $a->returns;
        string $named = Types::name($t);
        if ($named == 'nexus::Response') {
            return '$result';
        }
        if ($named == 'json::Value') {
            return 'nexus::Response(json: $result)';
        }
        if (Json::text($t, 'kind') == 'string') {
            return 'nexus::Response(text: $result)';
        }
        if ($named == 'status') {
            return 'nexus::Reply::of($payload, $result)';
        }
        if ($named == 'result') {
            array<json::Value> $args = Json::items($t, 'args');
            if ($args->count() == 2) {
                json::Value $ok = $args[0]->clone();
                string $okName = Types::name($ok);
                if ($okName == 'nexus::Response' || $okName == 'json::Value' || Json::text($ok, 'kind') == 'string') {
                    return 'nexus::Reply::of($payload, $result)';
                }
                if (Json::text($ok, 'kind') == 'array') {
                    return 'nexus::Reply::resources($payload, $result)';
                }
                return 'nexus::Reply::resource($payload, $result)';
            }
        }
        return 'nexus::Reply::resource($payload, $result)';
    }

    // MCP tools --------------------------------------------------------------

    /**
     * A `<Tool>Mcp` struct for a class conforming to `nexus::mcp::Tool`: its
     * offer and the call that reads its arguments and runs it.
     */
    internal static function tool(Code& $code, const Program& $p, const ActionDecl& $t) : void
    {
        string $short = Names::short($t->qualified);
        $code->line('/**');
        $code->line(" * Runs {$t->qualified} as an MCP tool.");
        $code->line(' */');
        $code->open("public struct {$short}Mcp");
        Emitter::offer($code, $t, Emitter::toolSchema($p, $t), "{$t->qualified}Mcp");
        $code->blank();
        Emitter::call($code, $t);
        $code->close();
        $code->blank();
    }

    /**
     * The JSON Schema of a tool class's arguments: the fields of its input.
     */
    internal static function toolSchema(const Program& $p, const ActionDecl& $t) : json::Value
    {
        json::Value $none = json::object();
        json::Value $schema = Emitter::objectSchema($none, array<string>());
        foreach ($t->params as const &$param) {
            if ($param->kind == ParamKind::input) {
                $schema = Emitter::inputSchema($p, $p->input($param->input));
            }
        }
        return $schema;
    }

    /**
     * The static `about()` (the docblock, the default description) and
     * `offer()` answering what `$a` offers MCP clients: its schema, that
     * description and the call that runs it.
     */
    internal static function offer(Code& $code, const ActionDecl& $a, const json::Value& $schema, const string& $companion) : void
    {
        string $ownerQ = Names::quote($a->qualified);
        string $schemaQ = Names::quote(json::dump($schema));
        $code->line('/**');
        $code->line(" * What MCP clients read of {$a->qualified} unless the app says more.");
        $code->line(' */');
        $code->open('public static function about() : string');
        // line by line: str::join(..., "\n") here trips echoc 0.12.3
        array<string> $lines = str::split($a->tool->description, "\n")->owned();
        if ($lines->empty()) {
            $code->line("return '';");
        } else {
            string $first = Names::quote($lines[0]);
            $code->line("string $text = {$first};");
            usize $i = 1;
            while ($i < $lines->count()) {
                string $next = Names::quote($lines[$i]);
                $code->line('$text->push(10);');
                if ($lines[$i] != '') {
                    $code->line("$text->append({$next});");
                }
                $i = $i + 1;
            }
            $code->line('return $text;');
        }
        $code->close();
        $code->blank();
        $code->line('/**');
        $code->line(" * What {$a->qualified} offers MCP clients, and how it runs.");
        $code->line(' */');
        $code->open('public static function offer() : nexus::mcp::Offer');
        $code->begin('function<nexus::Response(nexus::Payload&, nexus::Fields&)> $call = function(nexus::Payload& $payload, nexus::Fields& $args) : nexus::Response');
        $code->line("return {$companion}::call($payload, $args);");
        $code->close(';');
        // literals go through locals: straight into these calls they trip echoc 0.12.3
        $code->line("string $owner = {$ownerQ};");
        $code->line("string $text = {$schemaQ};");
        $code->line('json::Value $schema = nexus::mcp::Schema::of($text);');
        $code->line("string $about = {$companion}::about();");
        if ($a->through->empty()) {
            $code->line('return nexus::mcp::Offer($owner, $schema, $about, $call);');
        } else {
            $code->line('nexus::mcp::Offer $offer = nexus::mcp::Offer($owner, $schema, $about, $call);');
            Emitter::through($code, $a, '$through');
            $code->line('$offer->through = $through;');
            $code->line('return $offer;');
        }
        $code->close();
    }

    /**
     * A local `$name` holding the middleware `#[nexus::through]` names.
     */
    internal static function through(Code& $code, const ActionDecl& $a, const string& $name) : void
    {
        array<string> $refs = [];
        foreach ($a->through as const &$m) {
            string $mQ = Names::quote($m);
            $refs[] = "nexus::MiddlewareRef::of<{$m}>({$mQ})";
        }
        string $list = str::join($refs, ', ');
        $code->line("array<nexus::MiddlewareRef> {$name} = [{$list}];");
    }

    /**
     * `call(Payload&, Fields&)`: what the dispatcher does, with every
     * value read from the tool's arguments instead of the request, and no
     * routing and no middleware around it.
     */
    internal static function call(Code& $code, const ActionDecl& $a) : void
    {
        $code->line('/**');
        $code->line(" * Reads what {$a->qualified}::handle() asks for from tool arguments,");
        $code->line(' * calls it and turns the result into a response.');
        $code->line(' */');
        $code->open('public static function call(nexus::Payload& $payload, nexus::Fields& $args) : nexus::Response');
        array<string> $callArgs = [];
        foreach ($a->params as const &$p) {
            string $u = Names::upper($p->name);
            $callArgs[] = "$arg{$u}";
        }

        // path parameters, by their own names; the app's renames are undone before this runs
        array<string> $unwraps = [];
        bool $read = false;
        foreach ($a->params as const &$p) {
            if ($p->kind != ParamKind::path) {
                continue;
            }
            $read = true;
            string $u = Names::upper($p->name);
            string $wire = $p->name;
            array<Rule> $none = [];
            bool $hasDefault = $p->hasDefault;
            string $defaultText = $p->defaultText;
            json::Value $type = $p->type;
            if ($p->kind == ParamKind::path && $p->optionalSegment && !$hasDefault) {
                $hasDefault = true;
                $defaultText = 'null';
            }
            Read $r = Emitter::read($code, '$args', $p->name, $wire, $type, $hasDefault, $defaultText, "A{$u}");
            if (!$r->unwrap->empty()) {
                $unwraps[] = $r->unwrap;
            }
            $callArgs = Emitter::swap($callArgs, "$arg{$u}", $r->local);
        }
        if ($read) {
            $code->begin('guard $args->done() else ($p)');
            Emitter::problem($code);
            $code->close(';');
            foreach ($unwraps as const &$line) {
                $code->line($line);
            }
        }

        // the payload and the request
        foreach ($a->params as const &$p) {
            string $u = Names::upper($p->name);
            if ($p->kind == ParamKind::payload) {
                $callArgs = Emitter::swap($callArgs, "$arg{$u}", '$payload');
            } else if ($p->kind == ParamKind::request) {
                $callArgs = Emitter::swap($callArgs, "$arg{$u}", '$payload->request');
            }
        }

        // inputs, from the same arguments
        foreach ($a->params as const &$p) {
            if ($p->kind != ParamKind::body && $p->kind != ParamKind::queryInput && $p->kind != ParamKind::input) {
                continue;
            }
            string $u = Names::upper($p->name);
            $code->begin("{$p->input} $value{$u} = guard {$p->input}Decoder::decode($payload, $args) else ($p)");
            Emitter::problem($code);
            $code->close(';');
            if ($p->kind == ParamKind::input) {
                $callArgs = Emitter::swap($callArgs, "$arg{$u}", "$value{$u}");
            } else {
                $code->line("{$p->typeText} $arg{$u} = {$p->typeText}($value{$u});");
            }
        }

        $code->line("{$a->qualified} $target = $payload->get<{$a->qualified}>();");
        string $joined = str::join($callArgs, ', ');
        string $kind = Json::text($a->returns, 'kind');
        if ($kind == 'void' || $a->returnText->empty() || $a->returnText == 'void') {
            $code->line("$target->handle({$joined});");
            $code->line('return nexus::Response::noContent();');
        } else {
            $code->line("{$a->returnText} $result = $target->handle({$joined});");
            string $reply = Emitter::reply($a);
            $code->line("return {$reply};");
        }
        $code->close();
    }

    /**
     * The JSON Schema of an action's tool arguments: its path parameters
     * and the fields of its body or query input.
     */
    internal static function actionSchema(const Program& $prog, const ActionDecl& $a) : json::Value
    {
        json::Value $props = json::object();
        array<string> $required = [];
        foreach ($a->params as const &$p) {
            if ($p->kind == ParamKind::path) {
                string $arg = $p->name;
                array<Rule> $none = [];
                $props[$arg] = Emitter::property($p->type, $none, '');
                bool $optional = Types::optional($p->type) || $p->hasDefault || ($p->kind == ParamKind::path && $p->optionalSegment);
                if (!$optional) {
                    $required[] = $arg;
                }
            } else if ($p->kind == ParamKind::body || $p->kind == ParamKind::queryInput) {
                json::Value $inner = Emitter::inputSchema($prog, $prog->input($p->input));
                foreach (($inner['properties']->asObject() ?? ordered_map<string, json::Value>()) as $k => const &$v) {
                    $props[$k] = $v;
                }
                foreach (Json::texts(Json::field($inner, 'required')) as const &$r) {
                    $required[] = $r;
                }
            }
        }
        return Emitter::objectSchema($props, $required);
    }

    /**
     * The JSON Schema of an `#[nexus::input]` struct: a property per field
     * with its type, rules and docblock, nested inputs inline.
     */
    internal static function inputSchema(const Program& $p, const TypeDecl& $t) : json::Value
    {
        json::Value $props = json::object();
        array<string> $required = [];
        foreach ($t->fields as const &$f) {
            $props[$f->wire] = Emitter::fieldSchema($p, $f);
            if (!$f->hasDefault && !Types::optional($f->type)) {
                $required[] = $f->wire;
            }
        }
        return Emitter::objectSchema($props, $required);
    }

    /**
     * One input field's JSON Schema.
     */
    internal static function fieldSchema(const Program& $p, const FieldDecl& $f) : json::Value
    {
        if ($f->shape == 'scalar') {
            json::Value $o = Emitter::property($f->type, $f->rules, $f->doc);
            if (!$f->each->empty()) {
                json::Value $items = $o['items']->clone();
                Emitter::constrain($items, $f->each, 'string');
                $o['items'] = $items;
            }
            return $o;
        }
        json::Value $o = json::object();
        if ($f->shape == 'enum' || $f->shape == 'enums') {
            EnumDecl $e = $p->enumOf($f->item);
            json::Value $one = json::object();
            json::Value $values = json::arr();
            foreach ($e->cases as const &$c) {
                if ($e->text) {
                    $values[] = json::str($c->text);
                } else {
                    $values[] = json::int($c->number);
                }
            }
            if ($e->text) {
                $one['type'] = json::str('string');
            } else {
                $one['type'] = json::str('integer');
            }
            $one['enum'] = $values;
            if ($f->shape == 'enum') {
                $o = $one;
            } else {
                $o['type'] = json::str('array');
                $o['items'] = $one;
            }
        } else if ($f->shape == 'object') {
            $o = Emitter::inputSchema($p, $p->input($f->item));
        } else {
            $o['type'] = json::str('array');
            $o['items'] = Emitter::inputSchema($p, $p->input($f->item));
        }
        if ($f->kind == 'list') {
            Emitter::constrain($o, $f->rules, 'list');
        }
        if (!$f->doc->empty()) {
            $o['description'] = json::str($f->doc);
        }
        return $o;
    }

    internal static function objectSchema(const json::Value& $props, const array<string>& $required) : json::Value
    {
        json::Value $o = json::object();
        $o['type'] = json::str('object');
        $o['properties'] = $props;
        if (!$required->empty()) {
            json::Value $list = json::arr();
            foreach ($required as const &$r) {
                $list[] = json::str($r);
            }
            $o['required'] = $list;
        }
        $o['additionalProperties'] = json::bool(false);
        return $o;
    }

    /**
     * One property's JSON Schema, from its type and rules.
     */
    internal static function property(const json::Value& $type, const array<Rule>& $rules, const string& $doc) : json::Value
    {
        string $reader = Types::reader($type);
        string $named = Types::name(Types::bare($type));
        json::Value $o = json::object();
        bool $number = $reader == 'int32' || $reader == 'int64' || $reader == 'uint16' || $reader == 'uint32' || $reader == 'uint64' || $reader == 'float64';
        string $kind = Rules::kind($reader);
        if ($reader == 'string') {
            $o['type'] = json::str('string');
        } else if ($reader == 'bool') {
            $o['type'] = json::str('boolean');
        } else if ($reader == 'float64') {
            $o['type'] = json::str('number');
        } else if ($number) {
            $o['type'] = json::str('integer');
            if ($reader->starts('u')) {
                $o['minimum'] = json::int(0);
            }
        } else if ($reader == 'strings' || $reader == 'ints') {
            json::Value $items = json::object();
            if ($reader == 'strings') {
                $items['type'] = json::str('string');
            } else {
                $items['type'] = json::str('integer');
            }
            $o['type'] = json::str('array');
            $o['items'] = $items;
        } else if ($named == 'calendar::Date') {
            $o['type'] = json::str('string');
            $o['format'] = json::str('date');
            $kind = 'date';
        } else if ($named == 'std::time::timestamp' || $named == 'time::timestamp') {
            $o['type'] = json::str('string');
            $o['format'] = json::str('date-time');
            $kind = 'timestamp';
        }
        Emitter::constrain($o, $rules, $kind);
        if (!$doc->empty()) {
            $o['description'] = json::str($doc);
        }
        return $o;
    }

    /**
     * What `$rules` say about a value of `$kind`, written into its schema.
     */
    internal static function constrain(json::Value& $o, const array<Rule>& $rules, const string& $kind) : void
    {
        string $lo = 'minimum';
        string $hi = 'maximum';
        if ($kind == 'string') {
            $lo = 'minLength';
            $hi = 'maxLength';
        } else if ($kind == 'list') {
            $lo = 'minItems';
            $hi = 'maxItems';
        }
        bool $blank = false;
        foreach ($rules as const &$r) {
            string $k = $r->key;
            if ($k == 'min') {
                $o[$lo] = Emitter::number($r->value);
            } else if ($k == 'max') {
                $o[$hi] = Emitter::number($r->value);
            } else if ($k == 'size') {
                $o[$lo] = Emitter::number($r->value);
                $o[$hi] = Emitter::number($r->value);
            } else if ($k == 'between') {
                array<json::Value> $two = Json::items($r->value, 'items');
                $o[$lo] = Emitter::number($two[0]);
                $o[$hi] = Emitter::number($two[1]);
            } else if ($k == 'notBlank') {
                $blank = true;
            } else if ($k == 'email') {
                $o['format'] = json::str('email');
            } else if ($k == 'url') {
                $o['format'] = json::str('uri');
            } else if ($k == 'uuid') {
                $o['format'] = json::str('uuid');
            } else if ($k == 'distinct') {
                $o['uniqueItems'] = json::bool(true);
            } else if ($k == 'multipleOf') {
                $o['multipleOf'] = Emitter::number($r->value);
            } else if ($k == 'accepted') {
                $o['const'] = json::bool(true);
            } else if ($k == 'declined') {
                $o['const'] = json::bool(false);
            } else if ($k == 'oneOf') {
                json::Value $allowed = json::arr();
                foreach (Json::items($r->value, 'items') as const &$i) {
                    if (Json::text($i, 'kind') == 'int') {
                        $allowed[] = json::int(Json::int($i, 'integer'));
                    } else {
                        $allowed[] = json::str(Json::string($i));
                    }
                }
                $o['enum'] = $allowed;
            } else if (Rules::comparing($k) && Json::text($r->value, 'kind') != 'string') {
                if ($k == 'gt') {
                    $o['exclusiveMinimum'] = Emitter::number($r->value);
                } else if ($k == 'gte') {
                    $o['minimum'] = Emitter::number($r->value);
                } else if ($k == 'lt') {
                    $o['exclusiveMaximum'] = Emitter::number($r->value);
                } else {
                    $o['maximum'] = Emitter::number($r->value);
                }
            }
        }
        if ($blank && $o->get('minLength') == null) {
            $o['minLength'] = json::int(1);
        }
    }

    internal static function number(const json::Value& $v) : json::Value
    {
        if (Json::text($v, 'kind') == 'float') {
            return json::float(Json::field($v, 'number')->asFloat() ?? 0.0);
        }
        return json::int(Json::int($v, 'integer'));
    }

    /**
     * Every MCP tool of the program, classes and actions, for nexus-mcp.
     */
    internal static function tools(Code& $code, const Program& $p) : void
    {
        $code->line('/**');
        $code->line(" * What the actions and tool classes of module {$p->module} offer MCP");
        $code->line(' * clients, keyed by type; the app offers them under the names it picks.');
        $code->line(' * nexus-mcp finds this function through its attribute.');
        $code->line(' */');
        string $moduleName = Emitter::dq($p->module);
        $code->line("#[nexus::mcp::tools: {$moduleName}]");
        $code->open('public function tools(nexus::mcp::Offers $o) : void');
        foreach ($p->actions as const &$a) {
            if ($a->offered) {
                $code->line("$o->add<{$a->qualified}>({$a->qualified}Dispatch::offer());");
            }
        }
        foreach ($p->tools as const &$tool) {
            $code->line("$o->add<{$tool->qualified}>({$tool->qualified}Mcp::offer());");
        }
        $code->close();
    }

    // commands ---------------------------------------------------------------

    /**
     * A `<Command>Cli` class: the `nexus::Command` that offers a
     * `nexus::Cli` class on the command line, under the name the app gives
     * it.
     */
    internal static function command(Code& $code, const Program& $p, const CommandDecl& $cmd) : void
    {
        string $short = Names::short($cmd->qualified);
        TypeDecl $input = TypeDecl('', '', 0);
        if (!$cmd->input->empty()) {
            $input = $p->input($cmd->input);
        }
        $code->line('/**');
        $code->line(" * Runs {$cmd->qualified} as a command.");
        $code->line(' */');
        $code->open("public class {$short}Cli : nexus::Command");
        $code->line('private string $named;');
        $code->blank();
        $code->open('public constructor(const string& $name)');
        $code->line('$this->named = $name;');
        $code->close();
        $code->blank();
        $code->open('public function name() : string');
        $code->line('return $this->named;');
        $code->close();
        $code->blank();
        string $summary = Names::literal($cmd->summary);
        $code->open('public function summary() : string');
        $code->line("return {$summary};");
        $code->close();
        $code->blank();
        string $help = Names::literal($cmd->help);
        $code->open('public function help() : string');
        $code->line("return {$help};");
        $code->close();
        $code->blank();

        $code->open('public function options() : array<nexus::CommandOption>');
        $code->line('array<nexus::CommandOption> $out = [];');
        foreach ($input->fields as const &$f) {
            string $option = Names::quote(Names::kebab($f->name));
            string $metavar = Names::quote("<{$f->wire}>");
            string $about = Names::quote(Names::summary($f->doc));
            string $reader = $f->reader;
            if ($f->positional) {
                string $required = 'false';
                if (!$f->hasDefault && !Types::optional($f->type)) {
                    $required = 'true';
                }
                $code->line("$out[] = nexus::CommandOption(positional: {$option}, {$metavar}, {$about}, {$required});");
            } else if ($reader == 'bool') {
                $code->line("$out[] = nexus::CommandOption(flag: {$option}, {$about});");
            } else if ($reader == 'strings' || $reader == 'ints') {
                $code->line("$out[] = nexus::CommandOption(list: {$option}, {$metavar}, {$about});");
            } else {
                $code->line("$out[] = nexus::CommandOption(value: {$option}, {$metavar}, {$about});");
            }
        }
        $code->line('return $out;');
        $code->close();
        $code->blank();

        $code->open('public function bound(container::Container $services) : bool');
        $code->line("return $services->has<{$cmd->qualified}>();");
        $code->close();
        $code->blank();

        $code->open('public function run(nexus::Kernel $k, const nexus::Invocation& $in) : int32');
        $code->line('command::CLIContext $out = $in->out;');
        if (!$cmd->input->empty()) {
            $code->line('nexus::Query $pairs = nexus::Query();');
            usize $word = 0;
            foreach ($input->fields as const &$f) {
                string $option = Names::quote(Names::kebab($f->name));
                string $wireQ = Names::quote($f->wire);
                string $reader = $f->reader;
                if ($f->positional) {
                    $code->line("string? $word{$word} = $in->positional({$word});");
                    $code->begin("if ($word{$word} != null)");
                    $code->line("string $given{$word} = guard $word{$word};");
                    $code->line("$pairs->add({$wireQ}, $given{$word});");
                    $code->close();
                    $word = $word + 1;
                } else if ($reader == 'bool') {
                    $code->begin("if ($in->flag({$option}))");
                    $code->line("$pairs->add({$wireQ}, 'true');");
                    $code->close();
                } else if ($reader == 'strings' || $reader == 'ints') {
                    $code->begin("foreach ($in->list({$option}) as const &$item)");
                    $code->line("$pairs->add({$wireQ}, $item);");
                    $code->close();
                } else {
                    $code->begin("if ($in->stated({$option}))");
                    $code->line("$pairs->add({$wireQ}, $in->value({$option}));");
                    $code->close();
                }
            }
        }
        $code->line('nexus::Payload $payload = $k->background($this->named, nexus::Kernel::id());');
        $code->line('$payload->door = nexus::Door::cli;');
        if (!$cmd->input->empty()) {
            $code->line('nexus::Fields $fields = nexus::Fields(pairs: $pairs);');
            $code->begin("{$cmd->input} $input = guard {$cmd->input}Decoder::decode($payload, $fields) else ($p)");
            $code->line('nexus::Kernel::finish($payload);');
            $code->line('return nexus::Console::report($out, $payload->localized($p), $in->mode);');
            $code->close(';');
        }
        $code->line("{$cmd->qualified} $command = $payload->get<{$cmd->qualified}>();");
        if ($cmd->input->empty()) {
            $code->line('status<nexus::Problem> $done = $command->handle($payload, $out);');
        } else {
            $code->line('status<nexus::Problem> $done = $command->handle($payload, $out, $input);');
        }
        $code->line('nexus::Kernel::finish($payload);');
        $code->begin('guard $done else ($p)');
        $code->line('return nexus::Console::report($out, $payload->localized($p), $in->mode);');
        $code->close(';');
        $code->line('return 0;');
        $code->close();
        $code->close();
        $code->blank();
    }

    // reading values ---------------------------------------------------------

    /**
     * Emits the read of one value from `$source` (a `nexus::Fields` or a
     * `nexus::Settings`) with its rules, and says where it ends up.
     */
    internal static function read(Code& $code, const string& $source, const string& $name, const string& $wire, const json::Value& $type, bool $hasDefault, const string& $defaultText, const string& $tag) : Read
    {
        string $reader = Types::reader($type);
        string $bare = Types::render(Types::bare($type));
        string $text = Types::render($type);
        string $wireQ = Names::quote($wire);
        bool $optional = Types::optional($type);
        bool $defaulted = $hasDefault && $defaultText != 'null';

        if ($optional && !$defaulted) {
            $code->line("{$text} $ok{$tag} = {$source}->{$reader}({$wireQ}, required: false);");
            return Read("$ok{$tag}", '');
        }
        if ($defaulted) {
            $code->line("{$text} $ok{$tag} = {$defaultText};");
            $code->line("{$bare}? $v{$tag} = {$source}->{$reader}({$wireQ}, required: false);");
            $code->begin("if ($v{$tag} != null)");
            $code->line("{$bare} $x{$tag} = guard $v{$tag};");
            $code->line("$ok{$tag} = $x{$tag};");
            $code->close();
            return Read("$ok{$tag}", '');
        }
        $code->line("{$bare}? $v{$tag} = {$source}->{$reader}({$wireQ}, required: true);");
        return Read("$ok{$tag}", "{$bare} $ok{$tag} = guard $v{$tag};");
    }

    // inputs -----------------------------------------------------------------

    // tasks -------------------------------------------------------------------

    internal static function task(Code& $code, const TaskDecl& $j) : void
    {
        string $short = Names::short($j->qualified);
        string $companion = "{$j->qualified}Task";
        string $nameQ = Names::quote($j->qualified);
        $code->line('/**');
        $code->line(" * Pushes, encodes and runs {$j->qualified}.");
        $code->line(' */');
        $code->open("public struct {$short}Task");

        $code->line('/**');
        $code->line(" * Queues `$task` to run on a worker as soon as one is free, on the");
        $code->line(' * queue the app bound the task with.');
        $code->line(' */');
        $code->open("public static function push(nexus::Payload& $payload, const {$j->qualified}& $task) : status<nexus::Problem>");
        $code->line("return nexus::work::Tasks::push<{$j->qualified}>($payload, {$companion}::encode($task));");
        $code->close();
        $code->blank();

        $code->line('/**');
        $code->line(" * Queues `$task` to run once `$delay` has passed.");
        $code->line(' */');
        $code->open("public static function push(nexus::Payload& $payload, const {$j->qualified}& $task, after: std::time::duration $delay) : status<nexus::Problem>");
        $code->line("return nexus::work::Tasks::push<{$j->qualified}>($payload, {$companion}::encode($task), after: $delay);");
        $code->close();
        $code->blank();

        $code->line('/**');
        $code->line(' * The task data as JSON text.');
        $code->line(' */');
        $code->open("public static function encode(const {$j->qualified}& $task) : string");
        $code->line('nexus::work::TaskData $p = nexus::work::TaskData();');
        foreach ($j->fields as const &$f) {
            string $wireQ = Names::quote($f->name);
            string $reader = Types::reader($f->type);
            string $value = "$task->{$f->name}";
            if (Types::optional($f->type)) {
                string $bare = Types::render(Types::bare($f->type));
                string $u = Names::upper($f->name);
                $code->begin("if ({$value} == null)");
                $code->line("$p->nil({$wireQ});");
                $code->close();
                $code->begin('else');
                $code->line("{$bare} $x{$u} = guard {$value};");
                string $wide = Emitter::widen("$x{$u}", $reader);
                $code->line("$p->put({$wireQ}, {$wide});");
                $code->close();
            } else {
                string $wide = Emitter::widen($value, $reader);
                $code->line("$p->put({$wireQ}, {$wide});");
            }
        }
        $code->line('return $p->text();');
        $code->close();
        $code->blank();

        $code->line('/**');
        $code->line(' * The task from its JSON text, or why it is not one.');
        $code->line(' */');
        $code->open("public static function decode(const string& $text) : result<{$j->qualified}, string>");
        $code->begin('nexus::work::TaskData $p = guard nexus::work::TaskData::parse($text) else ($e)');
        $code->line('return .error($e);');
        $code->close(';');
        array<string> $unwraps = [];
        array<string> $named = [];
        foreach ($j->fields as const &$f) {
            string $u = Names::upper($f->name);
            array<Rule> $none = [];
            Read $r = Emitter::read($code, '$p', $f->name, $f->name, $f->type, $f->hasDefault, $f->defaultText, $u);
            if (!$r->unwrap->empty()) {
                $unwraps[] = $r->unwrap;
            }
            $named[] = "${$f->name}: {$r->local}";
        }
        $code->begin('guard $p->done() else ($e)');
        $code->line('return .error($e);');
        $code->close(';');
        foreach ($unwraps as const &$line) {
            $code->line($line);
        }
        string $args = str::join($named, ', ');
        $code->line("return .ok({$j->qualified}({$args}));");
        $code->close();
        $code->blank();

        $code->line('/**');
        $code->line(' * Decodes the task data and runs the task; data that does not');
        $code->line(' * decode gives up, since no retry will change it.');
        $code->line(' */');
        $code->open('internal static function run(nexus::Payload& $payload, const string& $data) : status<nexus::work::Failure>');
        $code->begin("{$j->qualified} $task = guard {$companion}::decode($data) else ($e)");
        $code->line('return .error(.giveUp("the task data does not decode: {$e}"));');
        $code->close(';');
        $code->line('return $task->handle($payload);');
        $code->close();
        $code->close();
        $code->blank();
    }

    /**
     * `$value` as the type `TaskData::put` takes for `$reader`.
     */
    internal static function widen(const string& $value, const string& $reader) : string
    {
        if ($reader == 'int32' || $reader == 'uint16' || $reader == 'uint32' || $reader == 'uint64') {
            return "{$value} as int64";
        }
        return $value;
    }

    internal static function tasks(Code& $code, const Program& $p) : void
    {
        $code->line('/**');
        $code->line(" * How each task of module {$p->module} runs, keyed by type; the app binds");
        $code->line(' * them with their queue, tries and schedule. nexus-work finds this');
        $code->line(' * function through its attribute.');
        $code->line(' */');
        string $moduleName = Emitter::dq($p->module);
        $code->line("#[nexus::tasks: {$moduleName}]");
        $code->open('public function tasks(nexus::work::Codecs $k) : void');
        int32 $n = 0;
        foreach ($p->tasks as const &$j) {
            string $nameQ = Names::quote($j->qualified);
            string $companion = "{$j->qualified}Task";
            $code->begin("function<status<nexus::work::Failure>(nexus::Payload&, const string&)> $run{$n} = function(nexus::Payload& $payload, const string& $data) : status<nexus::work::Failure>");
            $code->line("return {$companion}::run($payload, $data);");
            $code->close(';');
            if ($j->defaults) {
                $code->line("string $data{$n} = {$companion}::encode({$j->qualified}());");
            } else {
                $code->line("string $data{$n} = '';");
            }
            $code->line("nexus::work::Codec $codec{$n} = nexus::work::Codec({$nameQ}, $run{$n}, $data{$n});");
            $code->line("$k->add<{$j->qualified}>($codec{$n});");
            $n = $n + 1;
        }
        $code->close();
    }

    // tables -----------------------------------------------------------------

    internal static function table(Code& $code, const Program& $p) : void
    {
        $code->line('/**');
        $code->line(" * How the actions and commands of module {$p->module} run, and the");
        $code->line(' * names of its types, keyed by type. The kernel finds this function');
        $code->line(' * through its attribute.');
        $code->line(' */');
        string $moduleName = Emitter::dq($p->module);
        $code->line("#[nexus::generated: {$moduleName}]");
        $code->open('public function generated(nexus::Generated $g) : void');
        int32 $n = 0;
        foreach ($p->actions as const &$a) {
            array<string> $params = [];
            foreach ($a->params as const &$param) {
                if ($param->kind != ParamKind::path) {
                    continue;
                }
                string $nameQ = Names::quote($param->name);
                string $constraintQ = Names::quote(Types::constraint($param->type));
                string $optional = 'false';
                if ($param->optionalSegment) {
                    $optional = 'true';
                }
                $params[] = "nexus::PathParam({$nameQ}, {$constraintQ}, {$optional})";
            }
            string $list = str::join($params, ', ');
            $code->line("array<nexus::PathParam> $params{$n} = [{$list}];");
            string $actionQ = Names::quote($a->qualified);
            $code->begin("$g->action<{$a->qualified}>({$actionQ}, $params{$n}, function(nexus::Payload& $payload) : nexus::Response");
            $code->line("return {$a->qualified}Dispatch::dispatch($payload);");
            $code->close(');');
            if (!$a->through->empty()) {
                Emitter::through($code, $a, "$through{$n}");
                $code->line("$g->through<{$a->qualified}>($through{$n});");
            }
            $n = $n + 1;
        }
        foreach ($p->commands as const &$cmd) {
            string $ownerQ = Names::quote($cmd->qualified);
            $code->begin("$g->command<{$cmd->qualified}>({$ownerQ}, function(const string& $name) : nexus::Command");
            $code->line("return {$cmd->qualified}Cli($name);");
            $code->close(');');
        }
        foreach ($p->tools as const &$tool) {
            string $toolQ = Names::quote($tool->qualified);
            $code->line("$g->name<{$tool->qualified}>({$toolQ});");
        }
        // tasks, listeners, middleware and the rest that conforms to a nexus interface
        foreach ($p->named as const &$q) {
            string $nameQ = Names::quote($q);
            $code->line("$g->name<{$q}>({$nameQ});");
        }
        $code->close();
    }

    /**
     * Whether any input of the program brings a message or a rule class
     * the kernel has to know about.
     */
    internal static function declares(const Program& $p) : bool
    {
        foreach ($p->inputs as const &$t) {
            if (!$t->checks->empty()) {
                return true;
            }
            foreach ($t->fields as const &$f) {
                if (!$f->messages->empty() || !$f->checks->empty() || !$f->eachChecks->empty()) {
                    return true;
                }
            }
        }
        return false;
    }

    /**
     * The English messages `#[nexus::message]` gives, and every rule class
     * an input names, for the kernel to load and to check are bound.
     */
    internal static function inputs(Code& $code, const Program& $p) : void
    {
        $code->line('/**');
        $code->line(" * What the inputs of module {$p->module} bring: English messages and");
        $code->line(' * the rule classes they run. The kernel finds this function through');
        $code->line(' * its attribute.');
        $code->line(' */');
        string $moduleName = Emitter::dq($p->module);
        $code->line("#[nexus::inputs: {$moduleName}]");
        $code->open('public function inputs(nexus::Inputs $in) : void');
        map<string, bool> $seen = [];
        foreach ($p->inputs as const &$t) {
            string $inputQ = Names::quote($t->qualified);
            array<string> $rules = $t->checks;
            foreach ($t->fields as const &$f) {
                string $fieldQ = Names::quote($f->wire);
                foreach ($f->messages as const &$m) {
                    string $codeQ = Names::quote($m->key);
                    string $textQ = Names::quote(Json::string($m->value));
                    $code->line("$in->message({$inputQ}, {$fieldQ}, {$codeQ}, {$textQ});");
                }
                foreach ($f->checks as const &$r) {
                    $rules[] = $r;
                }
                foreach ($f->eachChecks as const &$r) {
                    $rules[] = $r;
                }
            }
            foreach ($rules as const &$r) {
                if ($seen->has($r)) {
                    continue;
                }
                $seen[$r] = true;
                string $ruleQ = Names::quote($r);
                $code->begin("$in->rule({$ruleQ}, function(container::Container $services) : bool");
                $code->line("return $services->has<{$r}>();");
                $code->close(');');
            }
        }
        $code->close();
    }

    internal static function configs(Code& $code, const Program& $p) : void
    {
        $code->line('/**');
        $code->line(" * Reads every #[nexus::config] struct of module {$p->module} and binds it.");
        $code->line(' */');
        string $moduleName = Emitter::dq($p->module);
        $code->line("#[nexus::configs: {$moduleName}]");
        $code->open('public function configs(nexus::Env $env, container::Builder& $b) : status<nexus::BootError>');
        if ($p->configs->empty()) {
            $code->line('return .ok;');
            $code->close();
            return;
        }
        $code->line('nexus::Settings $s = nexus::Settings($env);');
        array<string> $unwraps = [];
        array<string> $binds = [];
        int32 $i = 0;
        foreach ($p->configs as const &$t) {
            array<string> $named = [];
            foreach ($t->fields as const &$f) {
                string $u = Names::upper($f->name);
                array<Rule> $none = [];
                Read $r = Emitter::read($code, '$s', $f->name, $f->wire, $f->type, $f->hasDefault, $f->defaultText, "C{$i}{$u}");
                if (!$r->unwrap->empty()) {
                    $unwraps[] = $r->unwrap;
                }
                $named[] = "${$f->name}: {$r->local}";
            }
            string $args = str::join($named, ', ');
            $binds[] = "$b->param<{$t->qualified}>({$t->qualified}({$args}));";
            $i = $i + 1;
        }
        $code->begin('guard $s->done() else ($e)');
        $code->line('return .error($e);');
        $code->close(';');
        foreach ($unwraps as const &$line) {
            $code->line($line);
        }
        foreach ($binds as const &$line) {
            $code->line($line);
        }
        $code->line('return .ok;');
        $code->close();
    }

    internal static function dq(const string& $text) : string
    {
        string $out = '"';
        $out->append($text);
        $out->push(34);
        return $out;
    }
}
