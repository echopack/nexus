/**
 * Writes the generated file for a program: per action a `<Action>Dispatch` struct with the
 * dispatcher (and `call()` when it can be offered over MCP), per input a `<Input>Decoder`, per task
 * a `<Task>TaskCodec`, per command a `<Command>Cli`, per tool a `<Tool>Mcp`, per shape of an exposing
 * model a `<Model><Shape>Mapping`, per log record a `nexus::log::record` overload, and the tables,
 * keyed by type, that the kernel and the extensions find. Routes, command names, tool names and
 * task queues are not in it: the app gives those where it is wired.
 */

namespace nexusgen::emitter;

use nexusgen::{decl, decoders, mails, mappings, names, records, rules, types};

public function render(const Program& $p) : string
{
    $code = Code();
    $code->line('// generated by `nexus gen` from the types of this module');
    $code->line('// do not edit; change the code and run `nexus gen` (a build does it)');

    array<string> $spaces = [];
    foreach ($p->actions as const &$a) {
        note($spaces, names::space($a->qualified));
    }
    foreach ($p->inputs as const &$i) {
        note($spaces, names::space($i->qualified));
    }
    foreach ($p->tasks as const &$j) {
        note($spaces, names::space($j->qualified));
    }
    foreach ($p->commands as const &$cmd) {
        note($spaces, names::space($cmd->qualified));
    }
    foreach ($p->tools as const &$t) {
        note($spaces, names::space($t->qualified));
    }
    foreach ($p->mapped as const &$m) {
        note($spaces, names::space($m->qualified));
    }
    $spaces->sort();
    foreach ($spaces as const &$space) {
        $code->blank();
        if (!$space->empty()) {
            $code->line("namespace {$space};");
            $code->blank();
        }
        foreach ($p->actions as const &$a) {
            if (names::space($a->qualified) == $space) {
                dispatcher($code, $p, $a);
            }
        }
        foreach ($p->inputs as const &$i) {
            if (names::space($i->qualified) == $space) {
                decoders::write($code, $p, $i);
            }
        }
        foreach ($p->tasks as const &$j) {
            if (names::space($j->qualified) == $space) {
                task($code, $j);
            }
        }
        foreach ($p->commands as const &$cmd) {
            if (names::space($cmd->qualified) == $space) {
                command($code, $p, $cmd);
            }
        }
        foreach ($p->tools as const &$t) {
            if (names::space($t->qualified) == $space) {
                tool($code, $p, $t);
            }
        }
        foreach ($p->mapped as const &$m) {
            if (names::space($m->qualified) == $space) {
                foreach ($m->shapes as const &$shape) {
                    mappings::mapping($code, $p, $m, $shape);
                }
            }
        }
    }

    if (!$p->logs->empty()) {
        // overloads of nexus::log::record, which Logger::emit<R> asks for
        $code->blank();
        $code->line('namespace nexus::log;');
        foreach ($p->logs as const &$r) {
            $code->blank();
            records::emit($code, $r);
        }
    }

    if (!$p->mails->empty()) {
        // overloads of nexus::mail::render, which Mailer::compose<M> asks for
        $code->blank();
        $code->line('namespace nexus::mail;');
        foreach ($p->mails as const &$m) {
            $code->blank();
            mails::emit($code, $m);
        }
    }

    $module = names::segment($p->module);
    $code->blank();
    $code->line("namespace nexusgen::{$module};");
    $code->blank();
    table($code, $p);
    $code->blank();
    configs($code, $p);
    $code->blank();
    envs($code, $p);
    if (declares($p)) {
        $code->blank();
        inputs($code, $p);
    }
    if (offers($p)) {
        $code->blank();
        tools($code, $p);
    }
    if (!$p->tasks->empty()) {
        $code->blank();
        tasks($code, $p);
    }
    return mv $code->text;
}

/**
 * Whether the program offers any MCP tool, as a class or an action.
 */
internal function offers(const Program& $p) : bool
{
    if (!$p->tools->empty()) {
        return true;
    }
    foreach ($p->actions as const &$a) {
        if ($a->offered) {
            return true;
        }
    }
    return false;
}

/**
 * Adds `$s` to `$list` unless it is there already.
 */
internal function note(array<string>& $list, const string& $s) : void
{
    foreach ($list as const &$have) {
        if ($have == $s) {
            return;
        }
    }
    $list[] = $s;
}

// actions ----------------------------------------------------------------

/**
 * The `<Action>Dispatch` struct of `$a`.
 */
internal function dispatcher(Code& $code, const Program& $prog, const ActionDecl& $a) : void
{
    $short = names::short($a->qualified);
    $code->line('/**');
    $code->line(" * Runs {$a->qualified}.");
    $code->line(' */');
    $code->open("public struct {$short}Dispatch");
    dispatch($code, $a);
    if ($a->offered) {
        $code->blank();
        offer($code, $a, actionSchema($prog, $a), "{$a->qualified}Dispatch");
        $code->blank();
        call($code, $a);
    }
    $code->close();
    $code->blank();
}

/**
 * The line that answers a refused value with its problem.
 */
internal function problem(Code& $code) : void
{
    $code->line('return nexus::Reply::problem($payload, $p);');
}

/**
 * `dispatch(Payload&)`: reads every parameter of `handle()` from the request, calls it and answers.
 */
internal function dispatch(Code& $code, const ActionDecl& $a) : void
{
    $code->line('/**');
    $code->line(" * Reads what {$a->qualified}::handle() asks for, calls it and turns");
    $code->line(' * the result into a response.');
    $code->line(' */');
    $code->open('internal static function dispatch(nexus::Payload& $payload) : nexus::Response');

    array<string> $args = [];
    foreach ($a->params as const &$p) {
        $u = names::upper($p->name);
        $args[] = "$arg{$u}";
    }

    // path parameters
    foreach ($a->params as const &$p) {
        if ($p->kind != ParamKind::path) {
            continue;
        }
        $u = names::upper($p->name);
        $reader = types::reader($p->type);
        $bare = types::render(types::bare($p->type));
        $key = names::quote($p->name);
        if (!$p->optionalSegment) {
            param($code, $reader, $p->typeText, $key, "$arg{$u}");
            continue;
        }
        if ($p->hasDefault) {
            $code->line("{$p->typeText} $arg{$u} = {$p->defaultText};");
        } else {
            $code->line("{$p->typeText} $arg{$u} = null;");
        }
        $code->begin("if ($payload->param({$key}) != null)");
        param($code, $reader, $bare, $key, "$got{$u}");
        $gotMoved = types::moved($bare, "$got{$u}");
        $code->line("$arg{$u} = {$gotMoved};");
        $code->close();
    }

    // the payload and the request
    foreach ($a->params as const &$p) {
        $u = names::upper($p->name);
        if ($p->kind == ParamKind::payload) {
            $args = swap($args, "$arg{$u}", '$payload');
        } else if ($p->kind == ParamKind::request) {
            $args = swap($args, "$arg{$u}", '$payload->request');
        }
    }

    // inputs
    foreach ($a->params as const &$p) {
        if ($p->kind != ParamKind::body && $p->kind != ParamKind::queryInput) {
            continue;
        }
        $u = names::upper($p->name);
        string $decoder = "{$p->input}Decoder";
        if ($p->kind == ParamKind::body) {
            $code->begin("$fields{$u} = guard nexus::Fields::body($payload) else ($p)");
            problem($code);
            $code->close(';');
        } else {
            $code->line("$fields{$u} = nexus::Fields(pairs: $payload->request->query);");
        }
        $code->begin("$value{$u} = guard {$decoder}::decode($payload, $fields{$u}) else ($p)");
        problem($code);
        $code->close(';');
        $code->line("$arg{$u} = {$p->typeText}(mv $value{$u});");
        $args = swap($args, "$arg{$u}", "mv $arg{$u}");
    }

    $code->line("$action = $payload->get<{$a->qualified}>();");
    $call = str::join($args, ', ');
    $kind = decl::text($a->returns, 'kind');
    if ($kind == 'void' || $a->returnText->empty() || $a->returnText == 'void') {
        $code->line("$action->handle({$call});");
        $code->line('return .noContent();');
    } else {
        $code->line("$result = $action->handle({$call});");
        $reply = reply($a);
        $code->line("return {$reply};");
    }
    $code->close();
}

/**
 * Reads the path parameter `$key` into a new local `$local` of type `$type`. `nexus::Param` reads
 * a uint16 as a uint32, so one past 65535 is answered here, like any value too large for its
 * type: 404.
 */
internal function param(Code& $code, const string& $reader, const string& $type, const string& $key, const string& $local) : void
{
    if ($reader != 'uint16') {
        $declared = types::binding($type, $local);
        $code->begin("{$declared} = guard nexus::Param::{$reader}($payload, {$key}) else ($p)");
        problem($code);
        $code->close(';');
        return;
    }
    string $wide = "{$local}Wide";
    $code->begin("uint32 {$wide} = guard nexus::Param::uint32($payload, {$key}) else ($p)");
    problem($code);
    $code->close(';');
    $code->begin("if ({$wide} > 65535)");
    $code->line('return nexus::Reply::problem($payload, nexus::Problem::notFound($payload->request->path));');
    $code->close();
    $code->line("uint16 {$local} = {$wide} as uint16;");
}

/**
 * `$args` with `$from` replaced by `$to`.
 */
internal function swap(const array<string>& $args, const string& $from, const string& $to) : array<string>
{
    array<string> $out = [];
    foreach ($args as const &$a) {
        if ($a == $from) {
            $out[] = $to;
        } else {
            $out[] = $a;
        }
    }
    return $out;
}

/**
 * The expression that turns `$result` into a response, by the declared return type of handle().
 */
internal function reply(const ActionDecl& $a) : string
{
    const json::Value& $t = $a->returns;
    $named = types::name($t);
    if ($named == 'nexus::Response') {
        return '$result';
    }
    if ($named == 'json::Value') {
        return 'nexus::Response(json: $result)';
    }
    if (decl::text($t, 'kind') == 'string') {
        return 'nexus::Response(text: $result)';
    }
    if ($named == 'status') {
        return 'nexus::Reply::of($payload, $result)';
    }
    if ($named == 'result') {
        $args = decl::items($t, 'args');
        if ($args->count() == 2) {
            json::Value $ok = $args[0]->clone();
            $okName = types::name($ok);
            if ($okName == 'nexus::Response' || $okName == 'json::Value' || decl::text($ok, 'kind') == 'string') {
                return 'nexus::Reply::of($payload, $result)';
            }
            if (decl::text($ok, 'kind') == 'array') {
                return 'nexus::Reply::resources($payload, $result)';
            }
            return 'nexus::Reply::resource($payload, $result)';
        }
    }
    return 'nexus::Reply::resource($payload, $result)';
}

// MCP tools --------------------------------------------------------------

/**
 * A `<Tool>Mcp` struct for a class conforming to `nexus::mcp::Tool`: its offer and the call that
 * reads its arguments and runs it.
 */
internal function tool(Code& $code, const Program& $p, const ActionDecl& $t) : void
{
    $short = names::short($t->qualified);
    $code->line('/**');
    $code->line(" * Runs {$t->qualified} as an MCP tool.");
    $code->line(' */');
    $code->open("public struct {$short}Mcp");
    offer($code, $t, toolSchema($p, $t), "{$t->qualified}Mcp");
    $code->blank();
    call($code, $t);
    $code->close();
    $code->blank();
}

/**
 * The JSON Schema of a tool class's arguments: the fields of its input.
 */
internal function toolSchema(const Program& $p, const ActionDecl& $t) : json::Value
{
    $schema = objectSchema(json::object(), array<string>());
    foreach ($t->params as const &$param) {
        if ($param->kind == ParamKind::input) {
            $schema = inputSchema($p, $p->input($param->input));
        }
    }
    return $schema;
}

/**
 * The static `about()` (the docblock, the default description) and `offer()` answering what `$a`
 * offers MCP clients: its schema, that description and the call that runs it.
 */
internal function offer(Code& $code, const ActionDecl& $a, const json::Value& $schema, const string& $companion) : void
{
    $ownerQ = names::quote($a->qualified);
    $schemaQ = names::quote(json::dump($schema));
    $code->line('/**');
    $code->line(" * What MCP clients read of {$a->qualified} unless the app says more.");
    $code->line(' */');
    $code->open('public static function about() : string');
    $about = names::literal($a->tool->description);
    $code->line("return {$about};");
    $code->close();
    $code->blank();
    $code->line('/**');
    $code->line(" * What {$a->qualified} offers MCP clients, and how it runs.");
    $code->line(' */');
    $code->open('public static function offer() : nexus::mcp::Offer');
    $code->begin('$call = function(nexus::Payload& $payload, nexus::Fields& $args) : nexus::Response');
    $code->line("return {$companion}::call($payload, $args);");
    $code->close(';');
    string $offer = "nexus::mcp::Offer({$ownerQ}, nexus::mcp::Schema::of({$schemaQ}), {$companion}::about(), mv $call)";
    if ($a->through->empty()) {
        $code->line("return {$offer};");
    } else {
        $code->line("$offer = {$offer};");
        $refs = through($a);
        $code->line("$offer->through = {$refs};");
        $code->line('return $offer;');
    }
    $code->close();
}

/**
 * The list of the middleware `#[nexus::through]` names, as source.
 */
internal function through(const ActionDecl& $a) : string
{
    array<string> $refs = [];
    foreach ($a->through as const &$m) {
        $mQ = names::quote($m);
        $refs[] = "nexus::MiddlewareRef::of<{$m}>({$mQ})";
    }
    $list = str::join($refs, ', ');
    return "[{$list}]";
}

/**
 * `call(Payload&, Fields&)`: what the dispatcher does, with every value read from the tool's
 * arguments instead of the request, and no routing and no middleware around it.
 */
internal function call(Code& $code, const ActionDecl& $a) : void
{
    $code->line('/**');
    $code->line(" * Reads what {$a->qualified}::handle() asks for from tool arguments,");
    $code->line(' * calls it and turns the result into a response.');
    $code->line(' */');
    $code->open('public static function call(nexus::Payload& $payload, nexus::Fields& $args) : nexus::Response');
    array<string> $callArgs = [];
    foreach ($a->params as const &$p) {
        $u = names::upper($p->name);
        $callArgs[] = "$arg{$u}";
    }

    // path parameters, by their own names; the app's renames are undone before this runs
    array<string> $unwraps = [];
    bool $read = false;
    foreach ($a->params as const &$p) {
        if ($p->kind != ParamKind::path) {
            continue;
        }
        $read = true;
        $u = names::upper($p->name);
        bool $hasDefault = $p->hasDefault;
        string $defaultText = $p->defaultText;
        if ($p->optionalSegment && !$hasDefault) {
            $hasDefault = true;
            $defaultText = 'null';
        }
        $r = read($code, '$args', $p->name, $p->type, $hasDefault, $defaultText, "A{$u}", true);
        if (!$r->unwrap->empty()) {
            $unwraps[] = $r->unwrap;
        }
        $callArgs = swap($callArgs, "$arg{$u}", $r->local);
    }
    if ($read) {
        $code->begin('guard $args->done() else ($p)');
        problem($code);
        $code->close(';');
        foreach ($unwraps as const &$line) {
            $code->line($line);
        }
    }

    // the payload and the request
    foreach ($a->params as const &$p) {
        $u = names::upper($p->name);
        if ($p->kind == ParamKind::payload) {
            $callArgs = swap($callArgs, "$arg{$u}", '$payload');
        } else if ($p->kind == ParamKind::request) {
            $callArgs = swap($callArgs, "$arg{$u}", '$payload->request');
        }
    }

    // inputs, from the same arguments
    foreach ($a->params as const &$p) {
        if ($p->kind != ParamKind::body && $p->kind != ParamKind::queryInput && $p->kind != ParamKind::input) {
            continue;
        }
        $u = names::upper($p->name);
        $code->begin("$value{$u} = guard {$p->input}Decoder::decode($payload, $args) else ($p)");
        problem($code);
        $code->close(';');
        if ($p->kind == ParamKind::input) {
            $callArgs = swap($callArgs, "$arg{$u}", "mv $value{$u}");
        } else {
            $code->line("$arg{$u} = {$p->typeText}(mv $value{$u});");
            $callArgs = swap($callArgs, "$arg{$u}", "mv $arg{$u}");
        }
    }

    $code->line("$target = $payload->get<{$a->qualified}>();");
    $joined = str::join($callArgs, ', ');
    $kind = decl::text($a->returns, 'kind');
    if ($kind == 'void' || $a->returnText->empty() || $a->returnText == 'void') {
        $code->line("$target->handle({$joined});");
        $code->line('return .noContent();');
    } else {
        $code->line("$result = $target->handle({$joined});");
        $reply = reply($a);
        $code->line("return {$reply};");
    }
    $code->close();
}

/**
 * The JSON Schema of an action's tool arguments: its path parameters and the fields of its body or
 * query input.
 */
internal function actionSchema(const Program& $prog, const ActionDecl& $a) : json::Value
{
    $props = json::object();
    array<string> $required = [];
    foreach ($a->params as const &$p) {
        if ($p->kind == ParamKind::path) {
            string $arg = $p->name;
            array<Rule> $none = [];
            $props[$arg] = property($p->type, $none, '');
            $optional = types::optional($p->type) || $p->hasDefault || ($p->kind == ParamKind::path && $p->optionalSegment);
            if (!$optional) {
                $required[] = $arg;
            }
        } else if ($p->kind == ParamKind::body || $p->kind == ParamKind::queryInput) {
            $inner = inputSchema($prog, $prog->input($p->input));
            foreach (($inner['properties']->asObject() ?? ordered_map<string, json::Value>()) as $k => const &$v) {
                $props[$k] = $v;
            }
            foreach (decl::texts(decl::field($inner, 'required')) as const &$r) {
                $required[] = $r;
            }
        }
    }
    return objectSchema($props, $required);
}

/**
 * The JSON Schema of an `#[nexus::input]` struct: a property per field with its type, rules and
 * docblock, nested inputs inline.
 */
internal function inputSchema(const Program& $p, const TypeDecl& $t) : json::Value
{
    $props = json::object();
    array<string> $required = [];
    foreach ($t->fields as const &$f) {
        $props[$f->wire] = fieldSchema($p, $f);
        if (!$f->hasDefault && !types::optional($f->type)) {
            $required[] = $f->wire;
        }
    }
    return objectSchema($props, $required);
}

/**
 * One input field's JSON Schema.
 */
internal function fieldSchema(const Program& $p, const FieldDecl& $f) : json::Value
{
    if ($f->shape == 'scalar') {
        $o = property($f->type, $f->rules, $f->doc);
        if (!$f->each->empty()) {
            $items = $o['items']->clone();
            constrain($items, $f->each, 'string');
            $o['items'] = mv $items;
        }
        return $o;
    }
    $o = json::object();
    if ($f->shape == 'enum' || $f->shape == 'enums') {
        $e = guard $p->findEnum($f->item) else {
            $o['type'] = json::str('string');
            return $o;
        };
        $one = json::object();
        $values = json::arr();
        foreach ($e->cases as const &$c) {
            if ($e->text) {
                $values[] = json::str($c->text);
            } else {
                $values[] = json::int($c->number);
            }
        }
        if ($e->text) {
            $one['type'] = json::str('string');
        } else {
            $one['type'] = json::str('integer');
        }
        $one['enum'] = mv $values;
        if ($f->shape == 'enum') {
            $o = mv $one;
        } else {
            $o['type'] = json::str('array');
            $o['items'] = mv $one;
        }
    } else if ($f->shape == 'object') {
        $nested = guard $p->findInput($f->item) else {
            $o['type'] = json::str('object');
            return $o;
        };
        $o = inputSchema($p, $nested);
    } else {
        $o['type'] = json::str('array');
        $item = guard $p->findInput($f->item) else {
            json::Value $one = json::object();
            $one['type'] = json::str('object');
            $o['items'] = mv $one;
            return $o;
        };
        $o['items'] = inputSchema($p, $item);
    }
    if ($f->kind == 'list') {
        constrain($o, $f->rules, 'list');
    }
    if (!$f->doc->empty()) {
        $o['description'] = json::str($f->doc);
    }
    return $o;
}

internal function objectSchema(const json::Value& $props, const array<string>& $required) : json::Value
{
    $o = json::object();
    $o['type'] = json::str('object');
    $o['properties'] = $props;
    if (!$required->empty()) {
        $list = json::arr();
        foreach ($required as const &$r) {
            $list[] = json::str($r);
        }
        $o['required'] = mv $list;
    }
    $o['additionalProperties'] = json::bool(false);
    return $o;
}

/**
 * One property's JSON Schema, from its type and rules.
 */
internal function property(const json::Value& $type, const array<Rule>& $rules, const string& $doc) : json::Value
{
    $reader = types::reader($type);
    $named = types::name(types::bare($type));
    $o = json::object();
    bool $number = $reader == 'int32' || $reader == 'int64' || $reader == 'uint16' || $reader == 'uint32' || $reader == 'uint64' || $reader == 'float64';
    $kind = rules::kind($reader);
    if ($reader == 'string') {
        $o['type'] = json::str('string');
    } else if ($reader == 'bool') {
        $o['type'] = json::str('boolean');
    } else if ($reader == 'float64') {
        $o['type'] = json::str('number');
    } else if ($number) {
        $o['type'] = json::str('integer');
        if ($reader->starts('u')) {
            $o['minimum'] = json::int(0);
        }
    } else if ($reader == 'strings' || $reader == 'ints') {
        $items = json::object();
        if ($reader == 'strings') {
            $items['type'] = json::str('string');
        } else {
            $items['type'] = json::str('integer');
        }
        $o['type'] = json::str('array');
        $o['items'] = mv $items;
    } else if ($named == 'calendar::Date') {
        $o['type'] = json::str('string');
        $o['format'] = json::str('date');
        $kind = 'date';
    } else if ($named == 'std::time::timestamp' || $named == 'time::timestamp') {
        $o['type'] = json::str('string');
        $o['format'] = json::str('date-time');
        $kind = 'timestamp';
    }
    constrain($o, $rules, $kind);
    if (!$doc->empty()) {
        $o['description'] = json::str($doc);
    }
    return $o;
}

/**
 * What `$rules` say about a value of `$kind`, written into its schema.
 */
internal function constrain(json::Value& $o, const array<Rule>& $rules, const string& $kind) : void
{
    string $lo = 'minimum';
    string $hi = 'maximum';
    if ($kind == 'string') {
        $lo = 'minLength';
        $hi = 'maxLength';
    } else if ($kind == 'list') {
        $lo = 'minItems';
        $hi = 'maxItems';
    }
    bool $blank = false;
    foreach ($rules as const &$r) {
        string $k = $r->key;
        if ($k == 'min') {
            $o[$lo] = number($r->value);
        } else if ($k == 'max') {
            $o[$hi] = number($r->value);
        } else if ($k == 'size') {
            $o[$lo] = number($r->value);
            $o[$hi] = number($r->value);
        } else if ($k == 'between') {
            $two = decl::items($r->value, 'items');
            $o[$lo] = number($two[0]);
            $o[$hi] = number($two[1]);
        } else if ($k == 'notBlank') {
            $blank = true;
        } else if ($k == 'email') {
            $o['format'] = json::str('email');
        } else if ($k == 'url') {
            $o['format'] = json::str('uri');
        } else if ($k == 'uuid') {
            $o['format'] = json::str('uuid');
        } else if ($k == 'distinct') {
            $o['uniqueItems'] = json::bool(true);
        } else if ($k == 'multipleOf') {
            $o['multipleOf'] = number($r->value);
        } else if ($k == 'accepted') {
            $o['const'] = json::bool(true);
        } else if ($k == 'declined') {
            $o['const'] = json::bool(false);
        } else if ($k == 'oneOf') {
            $allowed = json::arr();
            foreach (decl::items($r->value, 'items') as const &$i) {
                if (decl::text($i, 'kind') == 'int') {
                    $allowed[] = json::int(decl::int($i, 'integer'));
                } else {
                    $allowed[] = json::str(decl::string($i));
                }
            }
            $o['enum'] = mv $allowed;
        } else if (rules::comparing($k) && decl::text($r->value, 'kind') != 'string') {
            if ($k == 'gt') {
                $o['exclusiveMinimum'] = number($r->value);
            } else if ($k == 'gte') {
                $o['minimum'] = number($r->value);
            } else if ($k == 'lt') {
                $o['exclusiveMaximum'] = number($r->value);
            } else {
                $o['maximum'] = number($r->value);
            }
        }
    }
    if ($blank && $o->get('minLength') == null) {
        $o['minLength'] = json::int(1);
    }
}

internal function number(const json::Value& $v) : json::Value
{
    if (decl::text($v, 'kind') == 'float') {
        return json::float(decl::field($v, 'number')->asFloat() ?? 0.0);
    }
    return json::int(decl::int($v, 'integer'));
}

/**
 * Every MCP tool of the program, classes and actions, for nexus-mcp.
 */
internal function tools(Code& $code, const Program& $p) : void
{
    $code->line('/**');
    $code->line(" * What the actions and tool classes of module {$p->module} offer MCP");
    $code->line(' * clients, keyed by type; the app offers them under the names it picks.');
    $code->line(' * nexus-mcp finds this function through its attribute.');
    $code->line(' */');
    $moduleName = names::quote($p->module);
    $code->line("#[nexus::mcp::tools: {$moduleName}]");
    $code->open('public function tools(nexus::mcp::Offers $o) : void');
    foreach ($p->actions as const &$a) {
        if ($a->offered) {
            $code->line("$o->add<{$a->qualified}>({$a->qualified}Dispatch::offer());");
        }
    }
    foreach ($p->tools as const &$tool) {
        $code->line("$o->add<{$tool->qualified}>({$tool->qualified}Mcp::offer());");
    }
    $code->close();
}

// commands ---------------------------------------------------------------

/**
 * A `<Command>Cli` class: the `nexus::Command` that offers a `nexus::Cli` class on the command
 * line, under the name the app gives it.
 */
internal function command(Code& $code, const Program& $p, const CommandDecl& $cmd) : void
{
    $short = names::short($cmd->qualified);
    $input = TypeDecl('', '', 0);
    if (!$cmd->input->empty()) {
        $input = $p->input($cmd->input);
    }
    $code->line('/**');
    $code->line(" * Runs {$cmd->qualified} as a command.");
    $code->line(' */');
    $code->open("public class {$short}Cli : nexus::Command");
    $code->line('private string $named;');
    $code->blank();
    $code->open('public constructor(const string& $name)');
    $code->line('$this->named = $name;');
    $code->close();
    $code->blank();
    $code->open('public const function name() : string');
    $code->line('return $this->named;');
    $code->close();
    $code->blank();
    $summary = names::literal($cmd->summary);
    $code->open('public const function summary() : string');
    $code->line("return {$summary};");
    $code->close();
    $code->blank();
    $help = names::literal($cmd->help);
    $code->open('public const function help() : string');
    $code->line("return {$help};");
    $code->close();
    $code->blank();

    $code->open('public const function options() : array<nexus::CommandOption>');
    $code->line('array<nexus::CommandOption> $out = [];');
    foreach ($input->fields as const &$f) {
        $option = names::quote(names::kebab($f->name));
        $metavar = names::quote("<{$f->wire}>");
        $about = names::quote(names::summary($f->doc));
        string $reader = $f->reader;
        if ($f->positional) {
            string $required = 'false';
            if (!$f->hasDefault && !types::optional($f->type)) {
                $required = 'true';
            }
            $code->line("$out[] = nexus::CommandOption(positional: {$option}, {$metavar}, {$about}, {$required});");
        } else if ($reader == 'bool') {
            $code->line("$out[] = nexus::CommandOption(flag: {$option}, {$about});");
        } else if ($reader == 'strings' || $reader == 'ints') {
            $code->line("$out[] = nexus::CommandOption(list: {$option}, {$metavar}, {$about});");
        } else {
            $code->line("$out[] = nexus::CommandOption(value: {$option}, {$metavar}, {$about});");
        }
    }
    $code->line('return $out;');
    $code->close();
    $code->blank();

    $code->open('public const function bound(container::Container $services) : bool');
    $code->line("return $services->has<{$cmd->qualified}>();");
    $code->close();
    $code->blank();

    $code->open('public function run(nexus::Invocation& $in) : int32');
    $code->line('command::CLIContext $out = $in->out;');
    if (!$cmd->input->empty()) {
        $code->line('$pairs = nexus::Query();');
        usize $word = 0;
        foreach ($input->fields as const &$f) {
            $option = names::quote(names::kebab($f->name));
            $wireQ = names::quote($f->wire);
            string $reader = $f->reader;
            if ($f->positional) {
                $code->line("$word{$word} = $in->positional({$word});");
                $code->begin("if ($word{$word} != null)");
                $code->line("$given{$word} = guard $word{$word};");
                $code->line("$pairs->add({$wireQ}, $given{$word});");
                $code->close();
                $word = $word + 1;
            } else if ($reader == 'bool') {
                // a flag is there or not: left out it is false, even with no default to say so
                $code->begin("if ($in->flag({$option}))");
                $code->line("$pairs->add({$wireQ}, 'true');");
                if (!types::optional($f->type)) {
                    $code->next('else');
                    $code->line("$pairs->add({$wireQ}, 'false');");
                }
                $code->close();
            } else if ($reader == 'strings' || $reader == 'ints') {
                $code->begin("foreach ($in->list({$option}) as const &$item)");
                $code->line("$pairs->add({$wireQ}, $item);");
                $code->close();
            } else {
                $code->begin("if ($in->stated({$option}))");
                $code->line("$pairs->add({$wireQ}, $in->value({$option}));");
                $code->close();
            }
        }
    }
    // the app boots once the arguments are read
    $code->begin('nexus::Kernel $k = guard $in->kernel() else');
    $code->line('return 1;');
    $code->close(';');
    $code->line('$payload = $k->background($this->named, nexus::Kernel::id());');
    $code->line('$payload->door = .cli;');
    if (!$cmd->input->empty()) {
        $code->line('$fields = nexus::Fields(pairs: $pairs);');
        $code->begin("$input = guard {$cmd->input}Decoder::decode($payload, $fields) else ($p)");
        $code->line('nexus::Kernel::finish($payload);');
        $code->line('return nexus::Console::report($out, $payload->localized($p), $in->mode);');
        $code->close(';');
    }
    $code->line("$command = $payload->get<{$cmd->qualified}>();");
    if ($cmd->input->empty()) {
        $code->line('$done = $command->handle($payload, $out);');
    } else {
        $code->line('$done = $command->handle($payload, $out, mv $input);');
    }
    $code->line('nexus::Kernel::finish($payload);');
    $code->begin('guard $done else ($p)');
    $code->line('return nexus::Console::report($out, $payload->localized($p), $in->mode);');
    $code->close(';');
    $code->line('return 0;');
    $code->close();
    $code->close();
    $code->blank();
}

// reading values ---------------------------------------------------------

/**
 * Emits the read of one value from `$source` (a `nexus::Fields`, a `nexus::Settings` or a
 * `nexus::work::TaskData`) with its rules, and says where it ends up. With `$nulls`, the source can
 * give a field as an explicit null (`nulled`), which an optional field with a default takes as
 * null; only a missing one falls back to the default.
 */
internal function read(Code& $code, const string& $source, const string& $wire, const json::Value& $type, bool $hasDefault, const string& $defaultText, const string& $tag, bool $nulls) : Read
{
    $reader = types::reader($type);
    $bare = types::render(types::bare($type));
    $text = types::render($type);
    $wireQ = names::quote($wire);
    $optional = types::optional($type);
    bool $defaulted = $hasDefault && $defaultText != 'null';

    if ($optional && !$defaulted) {
        $ok = types::binding($text, "$ok{$tag}");
        $code->line("{$ok} = {$source}->{$reader}({$wireQ}, required: false);");
        return Read("$ok{$tag}", '');
    }
    if ($defaulted) {
        $v = types::binding("{$bare}?", "$v{$tag}");
        $x = types::binding($bare, "$x{$tag}");
        $moved = types::moved($bare, "$x{$tag}");
        $code->line("{$text} $ok{$tag} = {$defaultText};");
        $code->line("{$v} = {$source}->{$reader}({$wireQ}, required: false);");
        $code->begin("if ($v{$tag} != null)");
        $code->line("{$x} = guard $v{$tag};");
        $code->line("$ok{$tag} = {$moved};");
        if ($optional && $nulls) {
            $code->next("else if ({$source}->nulled({$wireQ}))");
            $code->line("$ok{$tag} = null;");
        }
        $code->close();
        return Read("$ok{$tag}", '');
    }
    $v = types::binding("{$bare}?", "$v{$tag}");
    $ok = types::binding($bare, "$ok{$tag}");
    $code->line("{$v} = {$source}->{$reader}({$wireQ}, required: true);");
    return Read("$ok{$tag}", "{$ok} = guard $v{$tag};");
}

// tasks -------------------------------------------------------------------

/**
 * The `<Task>TaskCodec` struct of `$j`: how its data becomes text and back.
 */
internal function task(Code& $code, const TaskDecl& $j) : void
{
    $short = names::short($j->qualified);
    $code->line('/**');
    $code->line(" * Stores {$j->qualified} as JSON text and reads it back, for a distributed queue.");
    $code->line(' */');
    $code->open("internal struct {$short}TaskCodec");

    $code->line('/**');
    $code->line(' * The task data as JSON text.');
    $code->line(' */');
    $code->open("public static function encode(const {$j->qualified}& $task) : string");
    $code->line('$p = nexus::work::TaskData();');
    foreach ($j->fields as const &$f) {
        $wireQ = names::quote($f->name);
        $reader = types::reader($f->type);
        string $value = "$task->{$f->name}";
        if (types::optional($f->type)) {
            $bare = types::render(types::bare($f->type));
            $u = names::upper($f->name);
            $x = types::binding($bare, "$x{$u}");
            $code->begin("if ({$value} == null)");
            $code->line("$p->nil({$wireQ});");
            $code->next('else');
            $code->line("{$x} = guard {$value};");
            $wide = widen("$x{$u}", $reader);
            $code->line("$p->put({$wireQ}, {$wide});");
            $code->close();
        } else {
            $wide = widen($value, $reader);
            $code->line("$p->put({$wireQ}, {$wide});");
        }
    }
    $code->line('return $p->text();');
    $code->close();
    $code->blank();

    $code->line('/**');
    $code->line(' * The task from its JSON text, or every field that does not read.');
    $code->line(' */');
    $code->open("public static function decode(const string& $text) : result<{$j->qualified}, nexus::work::DataError>");
    $code->line('$p = try nexus::work::TaskData::parse($text);');
    array<string> $unwraps = [];
    array<string> $named = [];
    foreach ($j->fields as const &$f) {
        $u = names::upper($f->name);
        $r = read($code, '$p', $f->name, $f->type, $f->hasDefault, $f->defaultText, $u, true);
        if (!$r->unwrap->empty()) {
            $unwraps[] = $r->unwrap;
        }
        $local = types::moved($f->typeText, $r->local);
        $named[] = "${$f->name}: {$local}";
    }
    $code->line('try $p->done();');
    foreach ($unwraps as const &$line) {
        $code->line($line);
    }
    $args = str::join($named, ', ');
    $code->line("return .ok({$j->qualified}({$args}));");
    $code->close();
    $code->close();
    $code->blank();
}

/**
 * `$value` as the type `TaskData::put` takes for `$reader`. A uint64 goes as it is: its own `put`
 * keeps the top half of the range, which an int64 would turn negative.
 */
internal function widen(const string& $value, const string& $reader) : string
{
    if ($reader == 'int32' || $reader == 'uint16' || $reader == 'uint32') {
        return "{$value} as int64";
    }
    return $value;
}

/**
 * The table of every task of the program, for nexus-work.
 */
internal function tasks(Code& $code, const Program& $p) : void
{
    $code->line('/**');
    $code->line(" * How each task of module {$p->module} is stored, by type and by name. nexus-work");
    $code->line(' * finds this function through its attribute.');
    $code->line(' */');
    $moduleName = names::quote($p->module);
    $code->line("#[nexus::tasks: {$moduleName}]");
    $code->open('public function tasks(nexus::work::Codecs $k) : void');
    foreach ($p->tasks as const &$j) {
        $nameQ = names::quote($j->qualified);
        string $codec = "{$j->qualified}TaskCodec";
        $code->begin("$k->add<{$j->qualified}>({$nameQ}, function(const {$j->qualified}& $task) : string");
        $code->line("return {$codec}::encode($task);");
        $code->close(',');
        $code->begin("function(const string& $text) : result<{$j->qualified}, nexus::work::DataError>");
        $code->line("return {$codec}::decode($text);");
        $code->close(');');
    }
    $code->close();
}

// tables -----------------------------------------------------------------

/**
 * The table of the program's actions, commands and named types, for the kernel.
 */
internal function table(Code& $code, const Program& $p) : void
{
    $code->line('/**');
    $code->line(" * How the actions and commands of module {$p->module} run, and the");
    $code->line(' * names of its types, keyed by type. The kernel finds this function');
    $code->line(' * through its attribute.');
    $code->line(' */');
    $moduleName = names::quote($p->module);
    $code->line("#[nexus::generated: {$moduleName}]");
    $code->open('public function generated(nexus::Generated $g) : void');
    foreach ($p->actions as const &$a) {
        array<string> $params = [];
        foreach ($a->params as const &$param) {
            if ($param->kind != ParamKind::path) {
                continue;
            }
            $nameQ = names::quote($param->name);
            $constraintQ = names::quote(types::constraint($param->type));
            string $optional = 'false';
            if ($param->optionalSegment) {
                $optional = 'true';
            }
            $params[] = "nexus::PathParam({$nameQ}, {$constraintQ}, {$optional})";
        }
        $list = str::join($params, ', ');
        $actionQ = names::quote($a->qualified);
        $code->begin("$g->action<{$a->qualified}>({$actionQ}, [{$list}], function(nexus::Payload& $payload) : nexus::Response");
        $code->line("return {$a->qualified}Dispatch::dispatch($payload);");
        $code->close(');');
        if (!$a->through->empty()) {
            $refs = through($a);
            $code->line("$g->through<{$a->qualified}>({$refs});");
        }
    }
    foreach ($p->commands as const &$cmd) {
        $ownerQ = names::quote($cmd->qualified);
        $code->begin("$g->command<{$cmd->qualified}>({$ownerQ}, function(const string& $name) : nexus::Command");
        $code->line("return {$cmd->qualified}Cli($name);");
        $code->close(');');
    }
    foreach ($p->tools as const &$tool) {
        $toolQ = names::quote($tool->qualified);
        $code->line("$g->name<{$tool->qualified}>({$toolQ});");
    }
    // tasks, signal handlers, middleware and the rest that conforms to a nexus interface
    foreach ($p->named as const &$q) {
        $nameQ = names::quote($q);
        $code->line("$g->name<{$q}>({$nameQ});");
    }
    $code->close();
}

/**
 * Whether any input of the program brings a message or a rule class the kernel has to know about.
 */
internal function declares(const Program& $p) : bool
{
    foreach ($p->inputs as const &$t) {
        if (!$t->checks->empty()) {
            return true;
        }
        foreach ($t->fields as const &$f) {
            if (!$f->messages->empty() || !$f->checks->empty() || !$f->eachChecks->empty()) {
                return true;
            }
        }
    }
    return false;
}

/**
 * The English messages `#[nexus::message]` gives, and every rule class an input names, for the
 * kernel to load and to check are bound.
 */
internal function inputs(Code& $code, const Program& $p) : void
{
    $code->line('/**');
    $code->line(" * What the inputs of module {$p->module} bring: English messages and");
    $code->line(' * the rule classes they run. The kernel finds this function through');
    $code->line(' * its attribute.');
    $code->line(' */');
    $moduleName = names::quote($p->module);
    $code->line("#[nexus::inputs: {$moduleName}]");
    $code->open('public function inputs(nexus::Inputs $in) : void');
    map<string, bool> $seen = [];
    foreach ($p->inputs as const &$t) {
        $inputQ = names::quote($t->qualified);
        array<string> $rules = $t->checks;
        foreach ($t->fields as const &$f) {
            $fieldQ = names::quote($f->wire);
            foreach ($f->messages as const &$m) {
                $codeQ = names::quote($m->key);
                $textQ = names::quote(decl::string($m->value));
                $code->line("$in->message({$inputQ}, {$fieldQ}, {$codeQ}, {$textQ});");
            }
            foreach ($f->checks as const &$r) {
                $rules[] = $r;
            }
            foreach ($f->eachChecks as const &$r) {
                $rules[] = $r;
            }
        }
        foreach ($rules as const &$r) {
            if ($seen->has($r)) {
                continue;
            }
            $seen[$r] = true;
            $ruleQ = names::quote($r);
            $code->begin("$in->rule({$ruleQ}, function(container::Container $services) : bool");
            $code->line("return $services->has<{$r}>();");
            $code->close(');');
        }
    }
    $code->close();
}

/**
 * The function that lists every environment variable the config structs of the module read, for
 * the `env` command: name, type, the default as it would be written, and the field's docblock.
 */
internal function envs(Code& $code, const Program& $p) : void
{
    $code->line('/**');
    $code->line(" * Every environment variable the #[nexus::config] structs of module {$p->module} read.");
    $code->line(' */');
    $moduleName = names::quote($p->module);
    $code->line("#[nexus::envs: {$moduleName}]");
    $code->open('public function envs() : array<nexus::EnvVar>');
    $code->line('array<nexus::EnvVar> $all = [];');
    int32 $i = 0;
    foreach ($p->configs as const &$t) {
        foreach ($t->fields as const &$f) {
            if (!$f->env) {
                continue;
            }
            bool $defaulted = $f->defaulted();
            bool $required = !$defaulted && !types::optional($f->type);
            string $fallback = "''";
            if ($defaulted) {
                $bare = types::render(types::bare($f->type));
                $code->line("{$bare} $d{$i} = {$f->defaultText};");
                $fallback = "nexus::EnvVar::text($d{$i})";
                $i = $i + 1;
            }
            $name = names::quote($f->wire);
            $type = names::quote($f->reader);
            $doc = names::literal($f->doc);
            $owner = names::quote($t->qualified);
            string $must = 'false';
            if ($required) {
                $must = 'true';
            }
            string $hidden = 'false';
            if ($f->secret) {
                $hidden = 'true';
            }
            $code->line("$all[] = nexus::EnvVar($name: {$name}, $type: {$type}, $fallback: {$fallback}, $required: {$must}, $secret: {$hidden}, $doc: {$doc}, $owner: {$owner});");
        }
    }
    $code->line('return $all;');
    $code->close();
}

/**
 * The function that reads every config struct of the program from the environment and binds it.
 */
internal function configs(Code& $code, const Program& $p) : void
{
    $code->line('/**');
    $code->line(" * Reads every #[nexus::config] struct of module {$p->module} and binds it.");
    $code->line(' */');
    $moduleName = names::quote($p->module);
    $code->line("#[nexus::configs: {$moduleName}]");
    $code->open('public function configs(nexus::Env $env, container::Builder& $b) : status<nexus::BootError>');
    if ($p->configs->empty()) {
        $code->line('return .ok;');
        $code->close();
        return;
    }
    $code->line('$s = nexus::Settings($env);');
    array<string> $unwraps = [];
    array<string> $binds = [];
    int32 $i = 0;
    foreach ($p->configs as const &$t) {
        array<string> $named = [];
        foreach ($t->fields as const &$f) {
            // a field not read from the environment keeps its default
            if (!$f->env) {
                continue;
            }
            $u = names::upper($f->name);
            // the environment has no null: a variable is set or it is not
            $r = read($code, '$s', $f->wire, $f->type, $f->hasDefault, $f->defaultText, "C{$i}{$u}", false);
            if (!$r->unwrap->empty()) {
                $unwraps[] = $r->unwrap;
            }
            $local = types::moved($f->typeText, $r->local);
            $named[] = "${$f->name}: {$local}";
        }
        $args = str::join($named, ', ');
        $binds[] = "$b->param<{$t->qualified}>({$t->qualified}({$args}));";
        $i = $i + 1;
    }
    $code->line('try $s->done();');
    foreach ($unwraps as const &$line) {
        $code->line($line);
    }
    foreach ($binds as const &$line) {
        $code->line($line);
    }
    $code->line('return .ok;');
    $code->close();
}
