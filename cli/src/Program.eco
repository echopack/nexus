namespace nexusgen;

use nexusgen::{decl, exposures, mails, names, records, rules, types};

/**
 * Everything `nexus gen` writes code for, read from one module's decls: actions, inputs, configs,
 * tasks, commands, MCP tools and log records, found by what they conform to, the models a mapping
 * writes, plus every problem found on the way. Where they answer is no business of the generator;
 * the app says that where it is wired.
 */
public struct Program
{
    public string $module = '';
    public array<ActionDecl> $actions = [];
    public array<TypeDecl> $inputs = [];
    public array<TypeDecl> $configs = [];
    public array<TaskDecl> $tasks = [];
    public array<CommandDecl> $commands = [];

    /**
     * The structs tagged `#[nexus::log]`, typed log records.
     */
    public array<LogDecl> $logs = [];

    /**
     * The structs tagged `#[nexus::mail]`, mailables with their templates compiled.
     */
    public array<MailDecl> $mails = [];

    /**
     * The module root, which the paths of the module's files (its mail templates) start from.
     */
    public std::fs::path $root = '.';

    /**
     * The classes conforming to `nexus::mcp::Tool`; actions that can be offered as tools stay with
     * the actions.
     */
    public array<ActionDecl> $tools = [];

    /**
     * The models and structs with `#[nexus::expose]` fields, one mapping interface per shape each.
     */
    public array<MappedDecl> $mapped = [];

    /**
     * The other types of the module that conform to a nexus interface (middleware, signal handlers,
     * transformers...), by qualified name: the generated table names them for logs and `routes`.
     */
    public array<string> $named = [];

    /**
     * Whether the program has nexus-mcp, so actions can be offered as tools.
     */
    public bool $mcp = false;
    public array<string> $problems = [];

    /**
     * Every class of the program conforming to nexus::Middleware, by qualified name: what
     * `#[nexus::through]` may name.
     */
    internal map<string, bool> $middleware = [];

    /**
     * Every `#[nexus::input]` of the program, every backed enum, and every class conforming to
     * `nexus::Rule<T>` with its `T`: what input fields may hold and what `check:` may name.
     */
    internal map<string, bool> $known = [];
    internal array<EnumDecl> $enums = [];

    /**
     * Every struct and class of the program, by qualified name: what a mail template path may walk
     * into.
     */
    internal map<string, json::Value> $types = [];
    internal map<string, string> $ruleTypes = [];

    /**
     * Reads the module in `$decls`, which is the whole program too.
     */
    public constructor(const json::Value& $decls)
    {
        $this->read($decls, $decls);
    }

    /**
     * Reads the module in `$decls`, with `$all` (the whole program) telling which classes are
     * middleware, inputs and rules, and `$root` where the module's files (its mail templates) are.
     */
    public constructor(const json::Value& $decls, const json::Value& $all, root: std::fs::path $root = '.')
    {
        $this->root = $root;
        $this->read($decls, $all);
    }

    /**
     * The struct or class of the program called `$q`, or null.
     */
    internal const function typeNamed(const string& $q) : json::Value?
    {
        if (!$this->types->has($q)) {
            return null;
        }
        return $this->types->get($q);
    }

    /**
     * Learns what the whole program `$all` declares (middleware, inputs, enums, rule classes), then
     * reads the module in `$decls`.
     */
    private function read(const json::Value& $decls, const json::Value& $all) : void
    {
        foreach (decl::items($all, 'modules') as const &$mod) {
            foreach (decl::items($mod, 'declarations') as const &$d) {
                $kind = decl::text($d, 'kind');
                $q = decl::text($d, 'qualified');
                if ($kind == 'class' && decl::conforms($d, 'nexus::Middleware')) {
                    $this->middleware[$q] = true;
                }
                if ($kind == 'struct' && decl::has($d, 'input')) {
                    $this->known[$q] = true;
                }
                if ($kind == 'enum') {
                    $this->readEnum($d);
                }
                if ($kind == 'struct' || $kind == 'class') {
                    $this->types[$q] = $d;
                }
                if ($kind == 'class') {
                    foreach (decl::items($d, 'conforms') as const &$c) {
                        if (types::name($c) == 'nexus::Rule') {
                            $this->ruleTypes[$q] = types::render(types::argument($c));
                        }
                    }
                }
                if ($kind == 'interface' && $q == 'nexus::mcp::Tool') {
                    $this->mcp = true;
                }
            }
        }
        $modules = decl::items($decls, 'modules');
        if ($modules->empty()) {
            $this->problems[] = 'the decls output names no module';
            return;
        }
        json::Value $m = $modules[0]->clone();
        $this->module = decl::text($m, 'name');
        $declarations = decl::items($m, 'declarations');
        foreach ($declarations as const &$d) {
            if (decl::has($d, 'input')) {
                $this->readInput($d);
            }
            if (decl::has($d, 'config')) {
                $this->readConfig($d);
            }
            if (decl::conforms($d, 'nexus::work::Task')) {
                $this->readTask($d);
            }
            if (decl::has($d, 'log')) {
                records::read($this, $d);
            }
            $kind = decl::text($d, 'kind');
            if (decl::has($d, 'mail') || (($kind == 'struct' || $kind == 'class') && decl::conforms($d, 'nexus::mail::Mailable'))) {
                mails::read($this, $d);
            }
        }
        foreach ($declarations as const &$d) {
            $kind = decl::text($d, 'kind');
            if (($kind == 'class' || $kind == 'struct') && exposures::marked($d)) {
                exposures::read($this, $d);
            }
        }
        foreach ($declarations as const &$d) {
            $kind = decl::text($d, 'kind');
            if ($kind == 'type alias' && decl::nameable($d)) {
                $this->named[] = decl::text($d, 'qualified');
                continue;
            }
            if ($kind != 'class' && $kind != 'struct') {
                continue;
            }
            if (decl::conforms($d, 'nexus::Action')) {
                $this->readAction($d);
            } else if (decl::conforms($d, 'nexus::mcp::Tool')) {
                $this->readTool($d);
            } else if (decl::conforms($d, 'nexus::Cli')) {
                $this->readCommand($d);
            } else if (decl::nameable($d)) {
                $this->named[] = decl::text($d, 'qualified');
            }
        }
    }

    internal const function where(const json::Value& $d) : string
    {
        $file = decl::text($d, 'file');
        int64 $line = decl::int($d, 'line');
        return "{$file}:{$line}";
    }

    /**
     * A problem at field `$f` of declaration `$d`: its own line when decls gives one.
     */
    internal function failAt(const json::Value& $d, const json::Value& $f, const string& $message) : void
    {
        int64 $line = decl::int($f, 'line');
        if ($line <= 0) {
            $this->fail($d, $message);
            return;
        }
        $file = decl::text($d, 'file');
        $this->problems[] = "{$file}:{$line}: {$message}";
    }

    internal function fail(const json::Value& $d, const string& $message) : void
    {
        $at = $this->where($d);
        $this->problems[] = "{$at}: {$message}";
    }

    internal function readAction(const json::Value& $d) : void
    {
        $q = decl::text($d, 'qualified');
        if (decl::text($d, 'kind') != 'class') {
            $this->fail($d, "{$q} conforms to nexus::Action but is not a class");
            return;
        }
        if (!decl::items($d, 'generics')->empty()) {
            $this->fail($d, "{$q} is a generic action; nexus gen runs actions of one concrete type");
            return;
        }
        json::Value $h = guard decl::handle($d) else {
            $this->fail($d, "{$q} is an action but has no handle() method");
            return;
        };
        $a = ActionDecl($q, decl::text($d, 'file'), decl::int($d, 'line'));
        if (decl::text($h, 'visibility') != 'public') {
            $this->fail($d, "{$q}::handle() must be public");
        }
        $a->returns = decl::field($h, 'return');
        $a->returnText = types::render($a->returns);
        if (!$this->readThrough($d, $a)) {
            return;
        }
        foreach (decl::items($h, 'params') as const &$raw) {
            $param = guard $this->classify($d, $raw) else {
                return;
            };
            $a->params[] = mv $param;
        }
        if ($this->mcp && $this->offerable($a)) {
            $a->offered = true;
            $a->tool = ToolMeta($description: names::prose(decl::text($d, 'doc')));
        }
        $this->actions[] = mv $a;
    }

    /**
     * `#[nexus::through: ["blog::RequireUser", ...]]` (or one name): the middleware the action goes
     * through on every route and as a tool, outermost first. False after a problem.
     */
    internal function readThrough(const json::Value& $d, ActionDecl& $a) : bool
    {
        json::Value $tool = guard decl::tool($d, 'through') else {
            return true;
        };
        $value = decl::value($tool);
        string $usage = '#[nexus::through] takes a middleware class, "x::SomeMiddleware", or a list of them';
        array<string> $named = [];
        $kind = decl::text($value, 'kind');
        if ($kind == 'string') {
            $named[] = decl::string($value);
        } else if ($kind == 'list') {
            foreach (decl::items($value, 'items') as const &$item) {
                if (decl::text($item, 'kind') != 'string') {
                    $this->fail($d, $usage);
                    return false;
                }
                $named[] = decl::string($item);
            }
        } else {
            $this->fail($d, $usage);
            return false;
        }
        if ($named->empty()) {
            $this->fail($d, $usage);
            return false;
        }
        map<string, bool> $seen = [];
        foreach ($named as const &$m) {
            if (!$this->middleware->has($m)) {
                $this->fail($d, "#[nexus::through] names {$m}, which is not a class conforming to nexus::Middleware");
                return false;
            }
            if ($seen->has($m)) {
                $this->fail($d, "#[nexus::through] names {$m} twice");
                return false;
            }
            $seen[$m] = true;
            $a->through[] = $m;
        }
        return true;
    }

    /**
     * What one `handle()` parameter is: the payload or the request, a body or query input, or a
     * path parameter (any loose string or integer). Anything else, such as the signed in user, the
     * action reads from the payload itself.
     */
    internal function classify(const json::Value& $d, const json::Value& $raw) : Param?
    {
        $name = decl::text($raw, 'name');
        $type = decl::field($raw, 'type');
        $text = types::render($type);
        $hasDefault = decl::flag($raw, 'default');
        $defaultText = decl::text($raw, 'default_value');
        $named = types::name($type);
        $p = Param($name, .query, $type, $text, $hasDefault, $defaultText);

        // a borrow of the payload or the request is handed the dispatch's own
        if (decl::text($type, 'kind') == 'ptr' && decl::flag($type, 'borrow')) {
            $to = types::name(decl::field($type, 'to'));
            if ($to == 'nexus::Payload') {
                $p->kind = .payload;
                return $p;
            }
            if ($to == 'nexus::Request') {
                $p->kind = .request;
                return $p;
            }
            $this->fail($d, "handle() parameter ${$name} is a reference; only nexus::Payload& and nexus::Request& are handed in by reference");
            return null;
        }
        if ($named == 'nexus::Payload') {
            $p->kind = .payload;
            return $p;
        }
        if ($named == 'nexus::Request') {
            $p->kind = .request;
            return $p;
        }
        if ($named == 'nexus::Body' || $named == 'nexus::QueryOf') {
            $arg = types::argument($type);
            $input = types::name($arg);
            if (!$this->knowsInput($input)) {
                $this->fail($d, "{$named}<{$input}> needs #[nexus::input] on {$input}");
                return null;
            }
            $p->input = $input;
            if ($named == 'nexus::Body') {
                $p->kind = .body;
            } else {
                $p->kind = .queryInput;
            }
            return $p;
        }
        $reader = types::reader($type);
        if ($reader == 'string' || $reader == 'int32' || $reader == 'int64' || $reader == 'uint32' || $reader == 'uint64') {
            $p->kind = .path;
            $p->optionalSegment = types::optional($type) || $hasDefault;
            return $p;
        }
        if (!$reader->empty() && $reader != 'json' && $reader != 'duration') {
            $this->fail($d, "handle() parameter ${$name} is {$text}; a loose parameter comes from the path, which holds a string or an integer, and a query comes in a nexus::QueryOf<T>");
            return null;
        }
        if ($named->empty()) {
            $this->fail($d, "handle() parameter ${$name} of type {$text} is not something nexus can provide");
            return null;
        }
        $this->fail($d, "handle() parameter ${$name} of type {$text} is not something nexus can provide; let a middleware the action names in #[nexus::through] put it in the payload, and read it with $payload->state<{$text}>()");
        return null;
    }

    internal const function knowsInput(const string& $qualified) : bool
    {
        return $this->findInput($qualified) != null;
    }

    internal function readInput(const json::Value& $d) : void
    {
        $q = decl::text($d, 'qualified');
        if (decl::text($d, 'kind') != 'struct') {
            $this->fail($d, "#[nexus::input] goes on a struct; {$q} is not one");
            return;
        }
        if (!decl::items($d, 'constructors')->empty()) {
            $this->fail($d, "#[nexus::input] {$q} must keep its memberwise constructor; remove the handwritten one");
            return;
        }
        $t = TypeDecl($q, decl::text($d, 'file'), decl::int($d, 'line'));
        bool $refused = false;
        foreach (decl::items($d, 'fields') as const &$f) {
            if (decl::flag($f, 'static')) {
                continue;
            }
            $field = guard $this->field($d, $f, '', '') else {
                // keep going: every field that does not fit is reported in one run
                $refused = true;
                continue;
            };
            $t->fields[] = mv $field;
        }
        if ($refused) {
            return;
        }
        json::Value? $whole = decl::tool($d, 'rule');
        if ($whole != null) {
            json::Value $wholeTool = guard $whole;
            foreach (decl::record(decl::value($wholeTool)) as const &$e) {
                if ($e->key != 'check') {
                    $this->fail($d, "#[nexus::rule] on the input {$q} takes only 'check', a rule class over the whole input; '{$e->key}' goes on a field");
                    return;
                }
                foreach (decl::classes($e->value) as const &$n) {
                    if (!$this->ruleFits($d, $d, $n, $q, "the input {$q}")) {
                        return;
                    }
                    $t->checks[] = $n;
                }
            }
        }
        if (!$this->crossFits($d, $t)) {
            return;
        }
        $this->inputs[] = mv $t;
    }

    internal function readTask(const json::Value& $d) : void
    {
        $q = decl::text($d, 'qualified');
        if (decl::text($d, 'kind') != 'struct') {
            $this->fail($d, "a nexus::work::Task is a struct whose fields are its data; {$q} is not one");
            return;
        }
        if (!decl::items($d, 'constructors')->empty()) {
            $this->fail($d, "task {$q} must keep its memberwise constructor; remove the handwritten one");
            return;
        }
        $j = TaskDecl($q, decl::text($d, 'file'), decl::int($d, 'line'));
        foreach (decl::items($d, 'fields') as const &$f) {
            if (decl::flag($f, 'static')) {
                continue;
            }
            $name = decl::text($f, 'name');
            $type = decl::field($f, 'type');
            $text = types::render($type);
            if (decl::text($f, 'visibility') != 'public') {
                $this->fail($d, "field ${$name} must be public so the generated code can fill it");
                return;
            }
            $reader = types::reader($type);
            if ($reader->empty() || $reader == 'json' || $reader == 'duration') {
                $this->fail($d, "task field ${$name} has type {$text}; task data holds integers, float64, bool, strings, arrays of strings or int64, and their nullables");
                return;
            }
            $j->fields[] = FieldDecl($name, $name, $type, $text, decl::flag($f, 'default'), decl::text($f, 'default_value'));
        }
        string $wanted = 'public function handle(nexus::Payload& $payload) : status<nexus::work::Failure>';
        json::Value $h = guard decl::handle($d) else {
            $this->fail($d, "{$q} is a task but has no handle(); write {$wanted}");
            return;
        };
        $params = decl::items($h, 'params');
        $shaped = $params->count() == 1 && decl::text(decl::field($params[0], 'type'), 'kind') == 'ptr' && types::name(decl::field(decl::field($params[0], 'type'), 'to')) == 'nexus::Payload';
        if (!$shaped || types::render(decl::field($h, 'return')) != 'status<nexus::work::Failure>' || decl::text($h, 'visibility') != 'public') {
            $this->fail($d, "{$q}::handle() must be {$wanted}");
            return;
        }
        $this->tasks[] = mv $j;
    }

    /**
     * The `#[nexus::input]` struct named `$qualified` in this module, or null.
     */
    internal const function findInput(const string& $qualified) : TypeDecl?
    {
        foreach ($this->inputs as const &$i) {
            if ($i->qualified == $qualified) {
                return $i;
            }
        }
        return null;
    }

    /**
     * The `#[nexus::input]` struct named `$qualified`; check `knowsInput` first.
     */
    internal const function input(const string& $qualified) : TypeDecl
    {
        return $this->findInput($qualified) ?? TypeDecl($qualified, '', 0);
    }

    internal function readCommand(const json::Value& $d) : void
    {
        $q = decl::text($d, 'qualified');
        string $wanted = 'public function handle(nexus::Payload& $payload, command::CLIContext& $out, TheInput $in) : status<nexus::Problem>';
        if (decl::text($d, 'kind') != 'class' || !decl::items($d, 'generics')->empty()) {
            $this->fail($d, "{$q} conforms to nexus::Cli but is not a plain class");
            return;
        }
        json::Value $h = guard decl::handle($d) else {
            $this->fail($d, "{$q} is a command but has no handle(); write {$wanted}");
            return;
        };
        $params = decl::items($h, 'params');
        bool $shaped = ($params->count() == 2 || $params->count() == 3) && decl::borrows($params[0], 'nexus::Payload') && decl::borrows($params[1], 'command::CLIContext');
        if (!$shaped || types::render(decl::field($h, 'return')) != 'status<nexus::Problem>' || decl::text($h, 'visibility') != 'public') {
            $this->fail($d, "{$q}::handle() must be {$wanted}; the input is optional");
            return;
        }
        $doc = decl::text($d, 'doc');
        $cmd = CommandDecl($q, decl::text($d, 'file'), decl::int($d, 'line'), $summary: names::summary($doc), $help: names::prose($doc));
        if ($params->count() == 3) {
            $input = types::name(decl::field($params[2], 'type'));
            if (!$this->knowsInput($input)) {
                $text = types::render(decl::field($params[2], 'type'));
                $this->fail($d, "{$q}::handle() takes its options as one #[nexus::input] struct, not {$text}");
                return;
            }
            if (!$this->optionsFit($d, $this->input($input))) {
                return;
            }
            $cmd->input = $input;
        }
        $this->commands[] = mv $cmd;
    }

    /**
     * Whether every field of `$t` can be an option: no JSON, a flag that defaults to false,
     * positionals that are single values with the required ones first.
     */
    internal function optionsFit(const json::Value& $d, const TypeDecl& $t) : bool
    {
        bool $optionalSeen = false;
        foreach ($t->fields as const &$f) {
            if ($f->shape == 'object' || $f->shape == 'objects') {
                $this->fail($d, "option ${$f->name} of {$t->qualified} is a nested input, which a command line cannot give");
                return false;
            }
            string $reader = $f->reader;
            if ($reader == 'json') {
                $this->fail($d, "option ${$f->name} of {$t->qualified} is JSON, which a command line cannot give");
                return false;
            }
            if ($reader == 'bool' && $f->hasDefault && $f->defaultText != 'false') {
                $this->fail($d, "option ${$f->name} of {$t->qualified} is a flag, so it defaults to false");
                return false;
            }
            if (!$f->positional) {
                continue;
            }
            if ($reader == 'bool' || $reader == 'strings' || $reader == 'ints') {
                $this->fail($d, "positional ${$f->name} of {$t->qualified} must be one value, not {$f->typeText}");
                return false;
            }
            bool $required = !$f->hasDefault && !types::optional($f->type);
            if ($required && $optionalSeen) {
                $this->fail($d, "positional ${$f->name} of {$t->qualified} is required, so it goes before the optional ones");
                return false;
            }
            if (!$required) {
                $optionalSeen = true;
            }
        }
        return true;
    }

    internal function readTool(const json::Value& $d) : void
    {
        $q = decl::text($d, 'qualified');
        string $wanted = 'public function handle(nexus::Payload& $payload, TheInput $in) : result<T, nexus::Problem>';
        if (decl::text($d, 'kind') != 'class' || !decl::items($d, 'generics')->empty()) {
            $this->fail($d, "{$q} conforms to nexus::mcp::Tool but is not a plain class");
            return;
        }
        json::Value $h = guard decl::handle($d) else {
            $this->fail($d, "{$q} is a tool but has no handle(); write {$wanted}");
            return;
        };
        if (decl::text($h, 'visibility') != 'public') {
            $this->fail($d, "{$q}::handle() must be public");
            return;
        }
        $a = ActionDecl($q, decl::text($d, 'file'), decl::int($d, 'line'));
        $a->returns = decl::field($h, 'return');
        $a->returnText = types::render($a->returns);
        if (!$this->readThrough($d, $a)) {
            return;
        }
        bool $hasInput = false;
        foreach (decl::items($h, 'params') as const &$raw) {
            $name = decl::text($raw, 'name');
            $type = decl::field($raw, 'type');
            $text = types::render($type);
            $named = types::name($type);
            $p = Param($name, .payload, $type, $text, false, '');
            if (decl::borrows($raw, 'nexus::Payload')) {
                $a->params[] = mv $p;
                continue;
            }
            if (decl::text($type, 'kind') != 'named' || !$this->knowsInput($named)) {
                $this->fail($d, "{$q}::handle() takes nexus::Payload& and one #[nexus::input] struct; ${$name} is {$text}");
                return;
            }
            if ($hasInput) {
                $this->fail($d, "{$q}::handle() takes its arguments as one #[nexus::input] struct, not two");
                return;
            }
            $hasInput = true;
            $p->kind = .input;
            $p->input = $named;
            $a->params[] = mv $p;
        }
        $a->offered = true;
        $a->tool = ToolMeta($description: names::prose(decl::text($d, 'doc')));
        $this->tools[] = mv $a;
    }

    /**
     * Whether an action can be offered as a tool: its path parameters and the fields of its body or
     * query input give distinct argument names. The app may rename arguments when it offers one,
     * but nexus gen only writes the tool code for an action whose names do not clash.
     */
    internal const function offerable(const ActionDecl& $a) : bool
    {
        map<string, bool> $seen = [];
        foreach ($a->params as const &$p) {
            array<string> $names = [];
            if ($p->kind == ParamKind::path) {
                $names[] = $p->name;
            } else if ($p->kind == ParamKind::body || $p->kind == ParamKind::queryInput) {
                foreach ($this->input($p->input)->fields as const &$f) {
                    $names[] = $f->wire;
                }
            }
            foreach ($names as const &$n) {
                if ($seen->has($n)) {
                    return false;
                }
                $seen[$n] = true;
            }
        }
        return true;
    }

    internal function readConfig(const json::Value& $d) : void
    {
        $q = decl::text($d, 'qualified');
        if (decl::text($d, 'kind') != 'struct') {
            $this->fail($d, "#[nexus::config] goes on a struct; {$q} is not one");
            return;
        }
        if (!decl::items($d, 'constructors')->empty()) {
            $this->fail($d, "#[nexus::config] {$q} must keep its memberwise constructor; remove the handwritten one");
            return;
        }
        $tool = guard decl::tool($d, 'config');
        $prefix = decl::string(decl::value($tool));
        if (!names::variable($prefix)) {
            $this->fail($d, '#[nexus::config] takes the env prefix as it is read, like #[nexus::config: "BLOG"]');
            return;
        }
        $t = TypeDecl($q, decl::text($d, 'file'), decl::int($d, 'line'));
        foreach (decl::items($d, 'fields') as const &$f) {
            if (decl::flag($f, 'static')) {
                continue;
            }
            $field = guard $this->field($d, $f, $prefix, 'env') else {
                return;
            };
            $t->fields[] = mv $field;
        }
        $this->configs[] = mv $t;
    }

    internal function field(const json::Value& $d, const json::Value& $f, const string& $envPrefix, const string& $wireTool) : FieldDecl?
    {
        $name = decl::text($f, 'name');
        $type = decl::field($f, 'type');
        $text = types::render($type);
        if (decl::text($f, 'visibility') != 'public') {
            $this->fail($d, "field ${$name} must be public so the generated code can fill it");
            return null;
        }
        $reader = types::reader($type);
        bool $config = !$envPrefix->empty() || $wireTool == 'env';
        // a config field is read from the environment only when #[nexus::env] says so
        bool $env = $config && decl::has($f, 'env');
        if ($config && !$env && !decl::flag($f, 'default')) {
            $this->failAt($d, $f, "field ${$name} is not read from the environment and has no default; give it a default or #[nexus::env]");
            return null;
        }
        if ($env && ($reader->empty() || $reader == 'strings' || $reader == 'ints' || $reader == 'json')) {
            $this->failAt($d, $f, "field ${$name} has type {$text}, which nexus cannot read here");
            return null;
        }
        string $wire = $name;
        if ($config) {
            // #[nexus::env: "PAGE_SIZE"] names what follows the prefix; bare, the field's name does
            string $suffix = decl::option($f, 'env', '');
            if ($suffix->empty()) {
                $suffix = names::screaming($name);
            } else if (!names::variable($suffix)) {
                $this->failAt($d, $f, "#[nexus::env] on ${$name} takes what follows the prefix as it is read, like #[nexus::env: \"PAGE_SIZE\"]");
                return null;
            }
            $wire = "{$envPrefix}_{$suffix}";
        } else {
            $wire = decl::option($f, 'name', $name);
        }
        $out = FieldDecl($name, $wire, $type, $text, decl::flag($f, 'default'), decl::text($f, 'default_value'));
        $out->secret = decl::has($f, 'secret');
        $out->doc = names::prose(decl::text($f, 'doc'));
        $out->positional = decl::has($f, 'positional');
        $out->env = $env;
        if ($config) {
            $out->reader = $reader;
            return $out;
        }
        if (!$this->shape($out)) {
            $this->failAt($d, $f, "field ${$name} has type {$text}, which nexus cannot read here");
            return null;
        }
        json::Value? $label = decl::tool($f, 'label');
        if ($label != null) {
            json::Value $labelTool = guard $label;
            $out->label = decl::string(decl::value($labelTool));
            if ($out->label->empty()) {
                $this->failAt($d, $f, "#[nexus::label] on ${$name} takes the field's name in words, like #[nexus::label: 'e-mail address']");
                return null;
            }
        }
        json::Value? $message = decl::tool($f, 'message');
        if ($message != null) {
            json::Value $messageTool = guard $message;
            $given = decl::record(decl::value($messageTool));
            foreach ($given as const &$e) {
                if (decl::string($e->value)->empty()) {
                    $this->failAt($d, $f, "#[nexus::message] on ${$name} maps a code to its English message, like #[nexus::message: { email: '...' }]");
                    return null;
                }
            }
            if ($given->empty()) {
                $this->failAt($d, $f, "#[nexus::message] on ${$name} maps a code to its English message, like #[nexus::message: { email: '...' }]");
                return null;
            }
            $out->messages = mv $given;
        }
        json::Value? $rule = decl::tool($f, 'rule');
        if ($rule == null) {
            return $out;
        }
        json::Value $ruleTool = guard $rule;
        $nullable = types::optional($type);
        $bare = types::render(types::bare($type));
        foreach (decl::record(decl::value($ruleTool)) as const &$e) {
            string? $misfit = rules::misfit($e->key, $e->value, $out->kind, $out->shape, false, $nullable);
            if ($misfit != null) {
                $why = guard $misfit;
                $this->failAt($d, $f, "rule on ${$name}: {$why}");
                return null;
            }
            if ($e->key == 'check') {
                foreach (decl::classes($e->value) as const &$n) {
                    if (!$this->ruleFits($d, $f, $n, $bare, "field ${$name}")) {
                        return null;
                    }
                    $out->checks[] = $n;
                }
            } else if ($e->key == 'each') {
                string $itemKind = 'string';
                string $itemType = 'string';
                if ($out->reader == 'ints') {
                    $itemKind = 'integer';
                    $itemType = 'int64';
                }
                foreach (decl::record($e->value) as const &$inner) {
                    string? $itemMisfit = rules::misfit($inner->key, $inner->value, $itemKind, 'scalar', true, false);
                    if ($itemMisfit != null) {
                        $whyItem = guard $itemMisfit;
                        $this->failAt($d, $f, "rule on each item of ${$name}: {$whyItem}");
                        return null;
                    }
                    if ($inner->key == 'check') {
                        foreach (decl::classes($inner->value) as const &$n) {
                            if (!$this->ruleFits($d, $f, $n, $itemType, "each item of ${$name}")) {
                                return null;
                            }
                            $out->eachChecks[] = $n;
                        }
                    } else {
                        $out->each[] = Rule($inner->key, $inner->value);
                    }
                }
            } else {
                $out->rules[] = Rule($e->key, $e->value);
            }
        }
        return $out;
    }

    /**
     * Sorts an input field into how it is read: a scalar `Fields` reader, a date, an enum, a nested
     * input or a list of them. False when nexus cannot read its type.
     */
    internal const function shape(FieldDecl& $f) : bool
    {
        $bare = types::bare($f->type);
        $reader = types::reader($f->type);
        if (!$reader->empty() && $reader != 'duration') {
            $f->reader = $reader;
            $f->kind = rules::kind($reader);
            return true;
        }
        $named = types::name($bare);
        if ($named == 'calendar::Date') {
            $f->reader = 'date';
            $f->kind = 'date';
            return true;
        }
        if ($named == 'std::time::timestamp' || $named == 'time::timestamp') {
            $f->reader = 'timestamp';
            $f->kind = 'timestamp';
            return true;
        }
        if ($this->enumNamed($named)) {
            $f->shape = 'enum';
            $f->kind = 'enum';
            $f->item = $named;
            $f->reader = 'int64';
            if ($this->enumOf($named)->text) {
                $f->reader = 'string';
            }
            return true;
        }
        if ($this->known->has($named)) {
            $f->shape = 'object';
            $f->kind = 'object';
            $f->item = $named;
            return true;
        }
        if (decl::text($bare, 'kind') != 'array') {
            return false;
        }
        $of = types::name(decl::field($bare, 'of'));
        if ($this->enumNamed($of)) {
            $f->shape = 'enums';
            $f->kind = 'list';
            $f->item = $of;
            $f->reader = 'ints';
            if ($this->enumOf($of)->text) {
                $f->reader = 'strings';
            }
            return true;
        }
        if ($this->known->has($of)) {
            $f->shape = 'objects';
            $f->kind = 'list';
            $f->item = $of;
            return true;
        }
        return false;
    }

    /**
     * Whether `$name` is a rule class checking a `$type`, failing with why not.
     */
    internal function ruleFits(const json::Value& $d, const json::Value& $at, const string& $name, const string& $type, const string& $what) : bool
    {
        if (!$this->ruleTypes->has($name)) {
            $this->failAt($d, $at, "check on {$what} names {$name}, which is not a class conforming to nexus::Rule<{$type}>");
            return false;
        }
        $checks = $this->ruleTypes->get($name);
        if ($checks != $type) {
            $this->failAt($d, $at, "check on {$what} names {$name}, a nexus::Rule<{$checks}>, but the value is a {$type}");
            return false;
        }
        return true;
    }

    /**
     * Whether every rule naming another field of `$t` names one that exists, with a type it can be
     * compared with.
     */
    internal function crossFits(const json::Value& $d, const TypeDecl& $t) : bool
    {
        foreach ($t->fields as const &$f) {
            foreach ($f->rules as const &$r) {
                if (!rules::crossing($r->key, $r->value)) {
                    continue;
                }
                $other = decl::string($r->value);
                if ($r->key == 'confirmed') {
                    $other = "{$f->name}Confirmation";
                }
                FieldDecl? $found = null;
                foreach ($t->fields as const &$g) {
                    if ($g->name == $other) {
                        $found = $g;
                    }
                }
                FieldDecl $sibling = guard $found else {
                    $this->fail($d, "rule '{$r->key}' on ${$f->name} names ${$other}, which is not a field of {$t->qualified}");
                    return false;
                };
                $mine = types::render(types::bare($f->type));
                $theirs = types::render(types::bare($sibling->type));
                bool $fits = true;
                if ($r->key == 'confirmed' || $r->key == 'same' || $r->key == 'different') {
                    $fits = $mine == $theirs;
                } else if (rules::comparing($r->key)) {
                    $fits = $sibling->kind == 'integer' || $sibling->kind == 'number';
                } else if (rules::dating($r->key)) {
                    $fits = $sibling->kind == $f->kind;
                }
                if (!$fits) {
                    $this->fail($d, "rule '{$r->key}' on ${$f->name} ({$mine}) cannot compare with ${$other} ({$theirs})");
                    return false;
                }
            }
        }
        return true;
    }

    internal function readEnum(const json::Value& $d) : void
    {
        $backing = decl::field($d, 'backing');
        $bk = decl::text($backing, 'kind');
        if ($bk != 'string' && $bk != 'prim') {
            return;
        }
        $e = EnumDecl(decl::text($d, 'qualified'), $bk == 'string');
        foreach (decl::items($d, 'cases') as const &$c) {
            if (!decl::items($c, 'payload')->empty()) {
                return;
            }
            $e->cases[] = EnumCase(decl::text($c, 'name'), decl::text($c, 'value'), decl::int($c, 'discriminant'));
        }
        $this->enums[] = mv $e;
    }

    internal const function enumNamed(const string& $q) : bool
    {
        return $this->findEnum($q) != null;
    }

    /**
     * The enum named `$q`, or null.
     */
    internal const function findEnum(const string& $q) : EnumDecl?
    {
        foreach ($this->enums as const &$e) {
            if ($e->qualified == $q) {
                return $e;
            }
        }
        return null;
    }

    /**
     * The enum named `$q`; check `enumNamed` first.
     */
    internal const function enumOf(const string& $q) : EnumDecl
    {
        return $this->findEnum($q) ?? EnumDecl($q, true);
    }
}
