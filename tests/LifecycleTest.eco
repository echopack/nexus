/**
 * Background payloads get a scope of their own, and a failed start drains what already started.
 */

use nexus::{Kernel, Tables, Extension, ConfigTable, Env, Payload, Serve, BootError};
use ecotest::expect;

#[atomic]
internal class LTrace
{
    public atomic<int32> $started = atomic<int32>(0);
    public atomic<int32> $drained = atomic<int32>(0);
}

internal class LApp : Extension
{
    public LTrace $trace;
    public bool $refuse = false;

    public constructor(LTrace $trace)
    {
        $this->trace = $trace;
    }

    public function name() : string
    {
        return 'lifecycle-test';
    }

    public function start(Kernel $k, const Serve& $o) : status<BootError>
    {
        $this->trace->started->add(1);
        if ($this->refuse) {
            return .error(.extension('lifecycle-test', 'refused to start'));
        }
        return .ok;
    }

    public function drain(Kernel $k) : void
    {
        $this->trace->drained->add(1);
    }
}

internal function lBoot(array<Extension> $exts) : Kernel
{
    array<ConfigTable> $configs = [];
    $tables = Tables($configs: $configs);
    $vars = map<string, string>();
    Kernel $k = guard Kernel::boot(mv $exts, .testing, .silent(), Env(fixed: $vars), tables: $tables);
    return $k;
}

test a_background_payload_has_its_own_scope
{
    array<Extension> $exts = [];
    Kernel $k = lBoot($exts);
    Payload $payload = $k->background('blog::SendWelcome', 'task1');
    expect($payload->request->id)->is('task1');
    expect($payload->action)->is('blog::SendWelcome');
    expect($payload->request->path)->is('/blog::SendWelcome');
    Kernel::finish($payload);
}

test a_failed_start_drains_the_extensions_already_started
{
    $trace = LTrace();
    $ok = LApp($trace);
    $bad = LApp($trace);
    $bad->refuse = true;
    array<Extension> $exts = [$ok, $bad];
    Kernel $k = lBoot($exts);
    $o = Serve();
    status<BootError> $s = $k->start($o);
    expect(lStarted($s))->no(says: 'the kernel refuses to start when an extension does');
    expect($trace->started->load())->is(2);
    expect($trace->drained->load())->is(1);
}

internal function lStarted(status<BootError> $s) : bool
{
    guard $s else {
        return false;
    };
    return true;
}

#[atomic]
internal class LStuck : nexus::Transport
{
    public atomic<int32> $stops = atomic<int32>(0);

    public function serve(Kernel $kernel, const Serve& $options) : status<BootError>
    {
        return .ok;
    }

    public function stop() : void
    {
        $this->stops->add(1);
    }
}

#[atomic]
internal class LSignals
{
    // how many polls answer "a signal came"; the ones listed by number do
    public atomic<int32> $polls = atomic<int32>(0);
    public atomic<int32> $first = atomic<int32>(1);
    public atomic<int32> $second = atomic<int32>(-1);
    public atomic<int32> $quits = atomic<int32>(0);

    public function poll() : bool
    {
        $this->polls->add(1);
        int32 $n = $this->polls->load();
        return $n == $this->first->load() || $n == $this->second->load();
    }
}

test a_stuck_stop_quits_after_the_grace
{
    $t = LStuck();
    $s = LSignals();
    $done = nexus::Flag();
    std::time::instant $at = .now();
    nexus::Console::watch($done, $t, nexus::Logger::silent(), std::time::duration::millis(400), () : bool => $s->poll(), function() : void {
        $s->quits->add(1);
    });
    expect($t->stops->load())->is(1);
    expect($s->quits->load())->is(1);
    expect($at->elapsed()->as_micros() >= 400000)->yes(says: 'it waited out the grace first');
}

test a_second_signal_quits_at_once
{
    $t = LStuck();
    $s = LSignals();
    $s->second->store(3);
    $done = nexus::Flag();
    std::time::instant $at = .now();
    nexus::Console::watch($done, $t, nexus::Logger::silent(), std::time::duration::secs(60), () : bool => $s->poll(), function() : void {
        $s->quits->add(1);
    });
    expect($s->quits->load())->is(1);
    expect($at->elapsed()->as_micros() < 5000000)->yes(says: 'well before the grace');
}

test a_stop_that_finishes_never_quits
{
    $t = LStuck();
    $s = LSignals();
    $done = nexus::Flag();
    std::thread::handle $finisher = guard std::thread::spawn(function[$done]() : void {
        std::thread::sleep(300);
        $done->raise();
    });
    nexus::Console::watch($done, $t, nexus::Logger::silent(), std::time::duration::secs(60), () : bool => $s->poll(), function() : void {
        $s->quits->add(1);
    });
    $finisher->join();
    expect($t->stops->load())->is(1);
    expect($s->quits->load())->is(0);
}
