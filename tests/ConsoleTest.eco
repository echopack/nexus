/**
 * The command line: every command describes itself the same way, and the app boots only for a
 * command that asks.
 */

use nexus::{Console, Extension, Services, Commands, Command, Invocation, BootError};
use ecotest::expect;

/**
 * An app that cannot boot, with one command of its own.
 */
internal class CBroken : Extension
{
    public string $named = 'billing';

    public function name() : string
    {
        return 'shop';
    }

    public function services(Services& $s) : status<BootError>
    {
        return .error(.extension('shop', 'the database is down'));
    }

    public function commands(Commands& $cmds) : void
    {
        $cmds->add(CBill($this->named));
    }
}

internal class CBill : Command
{
    public string $named;

    public constructor(const string& $named)
    {
        $this->named = $named;
    }

    public const function name() : string
    {
        return $this->named;
    }

    public const function summary() : string
    {
        return 'send the bills';
    }

    public function run(Invocation& $in) : int32
    {
        guard $in->kernel() else {
            return 7;
        };
        return 0;
    }
}

test env_runs_without_booting_the_app
{
    array<Extension> $exts = [CBroken()];
    expect(Console::run($exts, ['shop', 'env', '--env-file', 'no-such.env']))->is(0);
}

test a_command_that_asks_for_the_app_boots_it
{
    array<Extension> $exts = [CBroken()];
    expect(Console::run($exts, ['shop', 'billing', '--env-file', 'no-such.env']))->is(7);
}

test no_command_is_the_help_and_a_failure
{
    array<Extension> $exts = [CBroken()];
    expect(Console::run($exts, ['shop']))->is(1);
    expect(Console::run($exts, ['shop', '--help']))->is(0);
}

test a_command_name_is_taken_once
{
    $taken = CBroken();
    $taken->named = 'serve';
    array<Extension> $exts = [$taken];
    expect(Console::run($exts, ['shop', 'serve', '--env-file', 'no-such.env']))->is(1);
}

internal function cKernel(nexus::Mode $mode, map<string, string> $vars) : nexus::Kernel
{
    array<Extension> $exts = [];
    array<nexus::ConfigTable> $configs = [];
    $tables = nexus::Tables($configs: $configs);
    nexus::Kernel $k = guard nexus::Kernel::boot(mv $exts, $mode, .silent(), nexus::Env(fixed: $vars), tables: $tables);
    return $k;
}

test risky_settings_are_named
{
    map<string, string> $none = [];
    nexus::Kernel $dev = cKernel(.dev, $none);
    expect(Console::risks($dev, '127.0.0.1:3246'))->size(0);
    expect(Console::risks($dev, '[::1]:3246'))->size(0);
    array<string> $open = Console::risks($dev, '0.0.0.0:3246');
    expect($open)->size(1);
    expect($open[0])->has('NEXUS_MODE=prod');

    nexus::Kernel $prod = cKernel(.prod, $none);
    array<string> $bare = Console::risks($prod, '0.0.0.0:3246');
    expect($bare)->size(1);
    expect($bare[0])->has('NEXUS_APP_URL');
    map<string, string> $set = ['NEXUS_APP_URL' => 'https://blog.example.com'];
    expect(Console::risks(cKernel(.prod, $set), '0.0.0.0:3246'))->size(0);
}

test links_that_leave_the_app_need_the_origin_in_prod
{
    map<string, string> $none = [];
    expect(cKernel(.dev, $none)->needsOrigin('x', 'the issuer')->failed())->no(says: 'fine outside prod');
    expect(cKernel(.prod, $none)->needsOrigin('x', 'the issuer')->failed())->yes(says: 'the boot fails in prod');
    map<string, string> $set = ['NEXUS_APP_URL' => 'https://blog.example.com'];
    expect(cKernel(.prod, $set)->needsOrigin('x', 'the issuer')->failed())->no(says: 'fine with the origin set');
}
