/**
 * Structured logging: fields from literals, context chains, spans, the three formats, typed
 * records, and the memory, file and async sinks.
 */

use std::time;
use std::thread;
use nexus::{Logger, Console, Mode, Env};
use nexus::log::{Level, Sink, Memory, Entry, Fields, Value, Context, Format, Stamp, Span, Rotate, Overflow, Async, File, ConfigError};
use ecotest::{expect, TempDir};

internal function at(int64 $millis) : time::timestamp
{
    return time::timestamp::from_unix_millis($millis);
}

internal function memoryLog(Memory $mem, Level $min) : Logger
{
    array<Sink> $sinks = [$mem];
    return Logger(mv $sinks, $min);
}

// an entry in span `import` (id abc) below a `with` adding the tenant
internal function spanned() : Entry
{
    $root = Context(null, ['tenant' => 7]);
    $span = Context($root, ['file' => 'a.csv'], span: 'import', id: 'abc');
    Fields $own = ['n' => 5];
    return Entry(at(1234), .info, 'rows read', $span, mv $own);
}

test a_literal_fills_fields_in_order_and_a_repeated_key_replaces
{
    int64 $id = 42;
    usize $count = 3;
    Fields $f = ['post' => $id, 'title' => 'hi', 'ok' => true, 'ms' => 1.5, 'n' => $count, 'post' => 43];
    expect($f->count())->is(5 as usize);
    expect($f->items[0]->key)->is('post');
    expect($f->get('post')?->text())->some('43');
    expect($f->get('n')?->text())->some('3');
    expect($f->get('ok')?->text())->some('true');
    expect($f->get('missing') == null)->yes(says: 'an absent key has no value');
}

test a_null_string_or_integer_leaves_its_key_out
{
    string? $none = null;
    int64? $nothing = null;
    string? $some = 'x';
    Fields $f = ['a' => $none, 'b' => $nothing, 'c' => $some];
    expect($f->count())->is(1 as usize);
    expect($f->items[0]->key)->is('c');
}

test a_child_adds_fields_and_the_nearer_value_wins
{
    $mem = Memory();
    $root = memoryLog($mem, .info);
    $req = $root->with(['req' => 'abc', 'who' => 'root']);
    $deeper = $req->with(['who' => 'child']);
    int64 $id = 42;
    $deeper->info('post created', ['post' => $id]);
    $root->info('plain');
    $all = $mem->entries();
    expect($all)->size(2);
    $f = $all[0]->all();
    expect($f->count())->is(3 as usize);
    expect($f->get('req')?->text())->some('abc');
    expect($f->get('who')?->text())->some('child');
    expect($f->get('post')?->text())->some('42');
    expect($all[1]->all()->empty())->yes(says: 'the root stamps nothing');
}

test also_adds_a_sink_and_only_replaces_them_keeping_the_fields
{
    $app = Memory();
    $own = Memory();
    $root = memoryLog($app, .info);
    $req = $root->with(['req' => 'abc']);
    $req->also($own)->info('both');
    array<Sink> $mine = [$own];
    $only = $req->only(mv $mine);
    $only->info('mine');
    $only->debug('below the level');
    expect($app->entries())->size(1);
    $kept = $own->entries();
    expect($kept)->size(2);
    expect($kept[0]->message)->is('both');
    expect($kept[1]->message)->is('mine');
    expect($kept[1]->all()->get('req')?->text())->some('abc');
}

test entries_below_the_minimum_are_dropped
{
    $mem = Memory();
    $log = memoryLog($mem, .warn);
    $log->trace('t');
    $log->debug('d');
    $log->info('i');
    $log->warn('w');
    $log->error('e');
    expect($mem->entries())->size(2);
    expect($mem->saw(.warn, 'w'))->yes(says: 'warn passes a warn minimum');
    expect($mem->saw(.info, 'w'))->no(says: 'saw compares the level too');
    expect($log->enabled(.info))->no(says: 'info is below warn');
    expect($log->level == Level::warn)->yes(says: 'the minimum is kept');
    expect(Logger::silent()->enabled(.error))->no(says: 'a silent logger is off even for errors');
}

test memory_finds_and_forgets
{
    $mem = Memory();
    $log = memoryLog($mem, .trace);
    $log->trace('first', ['k' => 'v']);
    Entry $e = guard $mem->find('first') else {
        expect(false)->yes(says: 'the entry is found');
        return;
    };
    expect($e->level == Level::trace)->yes(says: 'the level is kept');
    $mem->clear();
    expect($mem->entries())->size(0);
    expect($mem->saw('first'))->no(says: 'cleared');
}

test pretty_prints_spans_before_the_message
{
    string $line = Format::pretty->render(spanned(), false);
    expect($line)->is('00:00:01.234 INFO  import{file=a.csv}: rows read tenant=7 n=5');
}

test pretty_colours_only_when_asked
{
    string $line = Format::pretty->render(spanned(), true);
    expect($line)->has('[32mINFO ');
    expect($line)->has('rows read');
}

test logfmt_quotes_what_needs_it
{
    string $line = Format::logfmt->render(spanned(), false);
    expect($line)->is('t=1970-01-01T00:00:01.234Z level=info msg="rows read" span=import span_id=abc tenant=7 file=a.csv n=5');
    Fields $f = ['say' => 'a "b"', 'eq' => 'x=y', 'empty' => ''];
    string $odd = Format::logfmt->render(Entry(at(0), .warn, 'ok', null, $f), false);
    expect($odd)->has(' msg=ok say="a \\"b\\"" eq="x=y" empty=""');
}

test no_format_lets_a_line_break_or_an_escape_through
{
    Fields $f = ['user' => "bob\n12:00:00.000 INFO  forged", 'tab' => "a\tb", "bad key=x\n" => 'v', 'plain' => 'ok'];
    Entry $e = Entry(at(0), .info, "login\nINFO admin logged in \u{1b}[2J", null, $f);
    string $pretty = Format::pretty->render($e, false);
    expect($pretty->contains("\n"))->no(says: 'one pretty line');
    expect($pretty->contains("\u{1b}"))->no(says: 'no escape reaches the terminal');
    expect($pretty)->has('"login\\nINFO admin logged in \\u001b[2J"');
    expect($pretty)->has('user="bob\\n12:00:00.000 INFO  forged"');
    expect($pretty)->has('tab="a\\tb"');
    expect($pretty)->has(' bad_key_x_=v');
    expect($pretty)->has(' plain=ok');
    // a plain message stays as it is
    expect(Format::pretty->render(spanned(), false))->has(': rows read ');
    string $logfmt = Format::logfmt->render($e, false);
    expect($logfmt->contains("\n"))->no(says: 'one logfmt line');
    expect($logfmt)->has(' bad_key_x_=v');
}

test json_is_one_object_with_typed_values
{
    string $line = Format::json->render(spanned(), false);
    expect($line)->is('{"t":"1970-01-01T00:00:01.234Z","lvl":"info","msg":"rows read","span":"import","span_id":"abc","tenant":7,"file":"a.csv","n":5}');
    json::Value $doc = guard json::parse($line);
    expect($doc['n']->asInt())->some(5);

    array<string> $names = ['x'];
    json::Value $tags = json::Value::from($names);
    Fields $f = ['text' => "two\nlines \"q\"", 'f' => 0.5, 'ok' => false, 'tags' => $tags, 'd' => time::duration::millis(1500)];
    string $odd = Format::json->render(Entry(at(0), .error, 'odd', null, $f), false);
    json::Value $back = guard json::parse($odd);
    expect($back['text']->asStr())->some("two\nlines \"q\"");
    expect($back['f']->asFloat())->some(0.5);
    expect($back['ok']->asBool())->some(false);
    expect($back['tags']->at(0)?->asStr())->some('x');
    expect($back['d']->asStr())->some('1.5s');
}

test a_span_closes_with_its_time_and_nests_by_id
{
    $mem = Memory();
    $log = memoryLog($mem, .debug);
    string $outerId = '';
    {
        Span $outer = $log->span('import', ['file' => 'a.csv']);
        $outerId = $outer->id;
        $outer->log->info('rows read', ['n' => 5]);
        {
            Span $inner = $outer->log->span('row', $close: .debug);
            $inner->log->debug('parsed');
        }
    }
    array<Entry> $all = $mem->entries();
    expect($all)->size(4);
    expect($all[0]->span())->is('import');
    expect($all[0]->spanId())->is($outerId);
    expect($all[0]->parentId())->is('');
    expect($all[1]->message)->is('parsed');
    expect($all[1]->span())->is('row');
    expect($all[1]->parentId())->is($outerId);
    expect($all[2]->message)->is('row closed');
    expect($all[2]->level == Level::debug)->yes(says: 'the inner span closes at the level it asked for');
    expect($all[3]->message)->is('import closed');
    expect($all[3]->level == Level::info)->yes(says: 'a span closes at info by default');
    expect($all[3]->fields->get('ms') != null)->yes(says: 'the close carries the time');
    expect($all[3]->all()->get('file')?->text())->some('a.csv');
    expect($outerId->size())->is(16 as usize);
}

test a_typed_record_is_written_through_its_record_overload
{
    $mem = Memory();
    $log = memoryLog($mem, .info);
    $log->emit<nexus::log::LoginThrottled>('bob', 11);
    $log->emit<nexus::log::Record>(.error, 'by hand', ['x' => 1]);
    Entry $e = guard $mem->find('login throttled') else {
        expect(false)->yes(says: 'the record is written');
        return;
    };
    expect($e->level == Level::warn)->yes(says: 'at the record level');
    expect($e->fields->get('account')?->text())->some('bob');
    expect($e->fields->get('attempts')?->text())->some('11');
    expect($mem->saw(.error, 'by hand'))->yes(says: 'a Record is its own record');
}

test the_process_logger_is_the_installed_one
{
    expect(Logger::process()->enabled(.info))->yes(says: 'a default writes info');
    $mem = Memory();
    Logger::install(memoryLog($mem, .debug));
    Logger::process()->debug('from anywhere');
    thread::handle $h = guard thread::spawn(function() : void {
        Logger::process()->info('from a thread');
    });
    $h->join();
    expect($mem->saw('from anywhere'))->yes(says: 'the installed logger writes');
    expect($mem->saw('from a thread'))->yes(says: 'other threads see it');
    Logger::install(.silent());
}

test async_blocks_and_loses_nothing_across_threads
{
    $mem = Memory();
    $queue = Async($mem, 16, .block);
    array<Sink> $sinks = [$queue];
    $log = Logger($sinks, .info);
    array<thread::handle> $workers = [];
    int32 $w = 0;
    while ($w < 8) {
        Logger $mine = $log->with(['worker' => $w]);
        thread::handle $h = guard thread::spawn(function[$mine]() : void {
            int32 $i = 0;
            while ($i < 200) {
                $mine->info('tick', ['i' => $i]);
                $i++;
            }
        });
        $workers[] = $h;
        $w++;
    }
    foreach ($workers as &$h) {
        $h->join();
    }
    $log->flush();
    expect($mem->entries())->size(1600);
}

// a sink slow enough to fill a small queue
#[atomic]
internal class Slow : Sink
{
    public Memory $mem = Memory();

    public function write(const Entry& $e) : void
    {
        time::sleep(.millis(2));
        $this->mem->write($e);
    }
}

test async_drop_counts_what_it_drops
{
    $slow = Slow();
    $queue = Async($slow, 2, .drop);
    array<Sink> $sinks = [$queue];
    $log = Logger($sinks, .info);
    int32 $i = 0;
    while ($i < 50) {
        $log->info('tick');
        $i++;
    }
    $log->flush();
    // the writer reports drops after the entry it is writing; one more entry
    // gives it the chance to report the last ones
    $log->info('tick');
    $log->flush();
    uint64 $written = 0;
    uint64 $dropped = 0;
    foreach ($slow->mem->entries() as const &$e) {
        if ($e->message == 'tick') {
            $written++;
        } else {
            Value $n = guard $e->fields->get('dropped');
            int64 $d = guard str::int($n->text());
            $dropped = $dropped + ($d as uint64);
        }
    }
    expect($dropped > 0)->yes(says: 'a two entry queue drops some of fifty');
    expect($written + $dropped + $queue->dropped())->is(51 as uint64);
}

test async_flush_waits_until_every_drop_is_reported
{
    $slow = Slow();
    $queue = Async($slow, 2, .drop);
    array<Sink> $sinks = [$queue];
    $log = Logger($sinks, .info);
    int32 $i = 0;
    while ($i < 50) {
        $log->info('tick');
        $i++;
    }
    // no entry after the last drop: flush alone has to get the report out
    $log->flush();
    uint64 $written = 0;
    uint64 $reported = 0;
    foreach ($slow->mem->entries() as const &$e) {
        if ($e->message == 'tick') {
            $written++;
        } else {
            Value $n = guard $e->fields->get('dropped');
            int64 $d = guard str::int($n->text());
            $reported = $reported + ($d as uint64);
        }
    }
    expect($reported > 0)->yes(says: 'a two entry queue drops some of fifty');
    expect($written + $reported)->is(50 as uint64);
    expect($queue->dropped())->is(0 as uint64);
}

test async_keeps_each_threads_entries_in_order
{
    $mem = Memory();
    $queue = Async($mem, 8, .block);
    array<Sink> $sinks = [$queue];
    $log = Logger($sinks, .info);
    array<thread::handle> $workers = [];
    int32 $w = 0;
    while ($w < 4) {
        Logger $mine = $log->with(['worker' => $w]);
        thread::handle $h = guard thread::spawn(function[$mine]() : void {
            int32 $i = 0;
            while ($i < 300) {
                $mine->info('tick', ['i' => $i]);
                $i++;
            }
        });
        $workers[] = $h;
        $w++;
    }
    foreach ($workers as &$h) {
        $h->join();
    }
    $log->flush();
    map<string, int64> $last = [];
    int32 $out = 0;
    foreach ($mem->entries() as const &$e) {
        Fields $all = $e->all();
        Value $worker = guard $all->get('worker');
        Value $at = guard $e->fields->get('i');
        int64 $i = guard str::int($at->text());
        string $who = $worker->text();
        if ($last->has($who) && $last->get($who) >= $i) {
            $out++;
        }
        $last[$who] = $i;
    }
    expect($mem->entries())->size(1200);
    expect($out)->is(0);
}

test the_console_logs_on_the_calling_thread_when_the_queue_is_zero
{
    $dir = TempDir();
    map<string, string> $vars = ['NEXUS_LOG_FILE' => $dir->file('now.log'), 'NEXUS_LOG_FORMAT' => 'logfmt', 'NEXUS_LOG_ASYNC' => '0'];
    Logger $log = guard Console::logFor(.testing, Env(fixed: $vars));
    $log->info('right away');
    // no flush: a synchronous file sink has written the line already
    string $text = guard std::fs::readfile($dir->file('now.log'));
    expect($text)->has('msg="right away"');
    map<string, string> $bad = ['NEXUS_LOG_ASYNC' => 'many'];
    expect(Console::logFor(.testing, Env(fixed: $bad)))->fails();
}

test a_file_rotates_by_size_and_keeps_its_count
{
    $dir = TempDir();
    File $f = guard File::open($dir->file('app.log'), .logfmt, .size(150), 2);
    array<Sink> $sinks = [$f];
    $log = Logger($sinks, .info);
    int32 $i = 0;
    while ($i < 12) {
        $log->info('a line that takes some room', ['i' => $i]);
        $i++;
    }
    $log->flush();
    bool $current = guard std::fs::exists($dir->file('app.log'));
    bool $first = guard std::fs::exists($dir->file('app.1.log'));
    bool $second = guard std::fs::exists($dir->file('app.2.log'));
    bool $third = guard std::fs::exists($dir->file('app.3.log'));
    expect($current)->yes(says: 'the current file');
    expect($first)->yes(says: 'the newest old one');
    expect($second)->yes(says: 'kept up to two');
    expect($third)->no(says: 'nothing past keep');
    string $now = guard std::fs::readfile($dir->file('app.log'));
    expect($now)->has('i=11');
    expect($now->size() <= 150)->yes(says: 'no file grows past the size');
}

test a_daily_file_turns_over_at_the_first_entry_of_a_new_day
{
    $dir = TempDir();
    File $f = guard File::open($dir->file('day.log'), .json, .daily, 3);
    Fields $none = [];
    // days after the one the file was opened on
    int64 $day = 86400000;
    $f->write(Entry(at(40000 * $day + 5), .info, 'monday', null, $none));
    $f->write(Entry(at(40000 * $day + 9), .info, 'monday again', null, $none));
    $f->write(Entry(at(40001 * $day + 1), .info, 'tuesday', null, $none));
    $f->flush();
    string $old = guard std::fs::readfile($dir->file('day.1.log'));
    string $now = guard std::fs::readfile($dir->file('day.log'));
    expect($old)->has('monday again');
    expect($now)->has('tuesday');
    expect($now->contains('monday'))->no(says: 'the new day starts empty');
    // the empty file it was opened with was not kept as a day of its own
    bool $second = guard std::fs::exists($dir->file('day.2.log'));
    expect($second)->no(says: 'an empty file does not rotate');
}

test a_daily_file_turns_once_when_entries_cross_midnight_out_of_order
{
    $dir = TempDir();
    File $f = guard File::open($dir->file('day.log'), .json, .daily, 7);
    Fields $none = [];
    int64 $day = 86400000;
    $f->write(Entry(at(40000 * $day + 5), .info, 'monday', null, $none));
    // stamped before the lock: the last of monday arrives after the first of tuesday
    $f->write(Entry(at(40001 * $day + 1), .info, 'tuesday', null, $none));
    $f->write(Entry(at(40001 * $day - 1), .info, 'late monday', null, $none));
    $f->write(Entry(at(40001 * $day + 2), .info, 'tuesday again', null, $none));
    $f->flush();
    string $old = guard std::fs::readfile($dir->file('day.1.log'));
    string $now = guard std::fs::readfile($dir->file('day.log'));
    expect($old)->has('monday');
    expect($old->contains('tuesday'))->no(says: 'monday holds no tuesday');
    expect($now)->has('tuesday');
    expect($now)->has('late monday');
    expect($now)->has('tuesday again');
    bool $second = guard std::fs::exists($dir->file('day.2.log'));
    expect($second)->no(says: 'one midnight, one rotation');
}

test a_size_rotation_shifts_nothing_while_the_current_file_is_gone
{
    $dir = TempDir();
    File $f = guard File::open($dir->file('app.log'), .logfmt, .size(100), 3);
    Fields $none = [];
    $f->write(Entry(at(0), .info, 'first file, a line with some room in it', null, $none));
    $f->write(Entry(at(0), .info, 'second file, a line with some room in it', null, $none));
    string $kept = guard std::fs::readfile($dir->file('app.1.log'));
    expect($kept)->has('first file');
    // removed by hand while the sink holds it open
    guard std::fs::remove($dir->file('app.log'));
    $f->write(Entry(at(0), .info, 'third file, a line with some room in it', null, $none));
    $f->flush();
    string $still = guard std::fs::readfile($dir->file('app.1.log'));
    expect($still)->has('first file');
    bool $second = guard std::fs::exists($dir->file('app.2.log'));
    expect($second)->no(says: 'the history did not move for a file that is gone');
    string $now = guard std::fs::readfile($dir->file('app.log'));
    expect($now)->has('third file');
}

test a_file_that_cannot_be_reopened_stops_rotating_until_it_can
{
    $dir = TempDir();
    std::fs::path $root = $dir->file('logs');
    guard std::fs::mkdir($root);
    std::fs::path $path = $root / 'app.log';
    File $f = guard File::open($path, .logfmt, .size(100), 3);
    Fields $none = [];
    $f->write(Entry(at(0), .info, 'first file, a line with some room in it', null, $none));
    $f->write(Entry(at(0), .info, 'second file, a line with some room in it', null, $none));
    // neither the directory nor the file may be written: the next rotation cannot reopen
    guard std::fs::chmod($root, std::fs::fileperms(0x16d));
    guard std::fs::chmod($path, std::fs::fileperms(0x124));
    if (std::fs::append($path)->has_value()) {
        guard std::fs::chmod($root, std::fs::fileperms(0x1ed));
        ecotest::skip('this user writes read-only files');
    }
    $f->write(Entry(at(0), .info, 'lost while locked, a line with some room', null, $none));
    $f->write(Entry(at(0), .info, 'lost too while locked, a line with room', null, $none));
    guard std::fs::chmod($root, std::fs::fileperms(0x1ed));
    guard std::fs::chmod($path, std::fs::fileperms(0x1a4));
    $f->write(Entry(at(0), .info, 'back again, a line with some room in it', null, $none));
    $f->flush();
    string $now = guard std::fs::readfile($path);
    string $one = guard std::fs::readfile($root / 'app.1.log');
    string $two = guard std::fs::readfile($root / 'app.2.log');
    expect($now)->has('back again');
    expect($one)->has('second file');
    expect($two)->has('first file');
    bool $three = guard std::fs::exists($root / 'app.3.log');
    expect($three)->no(says: 'one rotation once the file could be reopened');
}

test a_file_that_cannot_open_is_an_error
{
    $dir = TempDir();
    result<File, nexus::log::FileError> $r = File::open($dir->file('missing/dir/app.log'), .json);
    expect($r)->fails();
}

test settings_parse_and_name_what_is_wrong
{
    expect(Level::parse('WARNING')->or(.trace) == Level::warn)->yes(says: 'warning is warn');
    expect(Format::parse('logfmt')->or(.json) == Format::logfmt)->yes(says: 'a format by name');
    expect(Overflow::parse('drop')->or(.block) == Overflow::drop)->yes(says: 'an overflow by name');
    Rotate $r = Rotate::parse('64mb')->or(.never);
    expect(match ($r) { .size($b) => $b == 67108864, else => false })->yes(says: '64mb is 64 MiB');
    Rotate $daily = Rotate::parse('daily')->or(.never);
    expect(match ($daily) { .daily => true, else => false })->yes(says: 'daily');
    expect(Rotate::parse('lots'))->fails();
    // too large for 64 bits: refused, not wrapped to a size that rotates every line
    expect(Rotate::parse('17179869184gb'))->fails();
    expect(Rotate::parse('9223372036854775807kb'))->fails();
    Rotate $most = Rotate::parse('17179869183gb')->or(.never);
    expect(match ($most) { .size($b) => $b == 18446744072635809792, else => false })->yes(says: 'the largest size that fits');
    expect(Level::parse('loud'))->fails();
    Level $never = guard Level::parse('loud') else ($e) {
        expect($e->message())->has("not 'loud'");
        return;
    };
    expect(false)->yes(says: 'loud is not a level');
}

test the_console_builds_its_logger_from_the_environment
{
    $dir = TempDir();
    map<string, string> $vars = ['NEXUS_LOG' => 'debug', 'NEXUS_LOG_FILE' => $dir->file('app.log'), 'NEXUS_LOG_FORMAT' => 'logfmt', 'NEXUS_LOG_ASYNC' => '64'];
    Logger $log = guard Console::logFor(.testing, Env(fixed: $vars));
    $log->debug('to the file', ['k' => 'v']);
    $log->flush();
    string $text = guard std::fs::readfile($dir->file('app.log'));
    expect($text)->has('msg="to the file" k=v');

    map<string, string> $bad = ['NEXUS_LOG' => 'loud'];
    expect(Console::logFor(.dev, Env(fixed: $bad)))->fails();
    map<string, string> $keep = ['NEXUS_LOG_FILE' => $dir->file('k.log'), 'NEXUS_LOG_KEEP' => 'zero'];
    expect(Console::logFor(.dev, Env(fixed: $keep)))->fails();
    map<string, string> $none = [];
    Logger $quiet = guard Console::logFor(.testing, Env(fixed: $none));
    expect($quiet->enabled(.error))->no(says: 'testing logs nowhere by default');
}

test stamps_are_rfc3339_and_a_clock
{
    expect(Stamp::rfc3339(at(0)))->starts('1970-01-01T00:00:00');
    expect(Stamp::clock(at(3723004)))->is('01:02:03.004');
    expect(Stamp::day(at(86400000 * 2 + 1)))->is(2 as int64);
    expect(Stamp::day(at(-1)))->is(-1 as int64);
}

#[if: NEXUS_LOG_MAX_INFO]
test the_cap_compiles_the_levels_below_it_away
{
    $mem = Memory();
    $log = memoryLog($mem, .trace);
    $log->trace('t');
    $log->debug('d');
    $log->info('i');
    $log->write(.debug, 'written directly');
    expect($mem->entries())->size(1);
    expect($log->enabled(.debug))->no(says: 'debug is below the cap');
    expect(Level::cap() == Level::info)->yes(says: 'the cap is info');
}
#[end]

test a_tap_reaches_every_logger_of_the_root_taken_before_or_after
{
    $mem = Memory();
    $root = memoryLog($mem, .info);
    $req = $root->with(['req' => 'abc']);
    $tapped = Memory();
    $root->tap($tapped);
    $req->info('from a child taken before');
    $root->only([])->info('from one with no sinks of its own');
    expect($tapped->entries())->size(2);
    expect($tapped->entries()[0]->all()->get('req')?->text())->some('abc');
    expect($mem->entries())->size(1);
}

test a_root_without_sinks_writes_once_tapped
{
    array<Sink> $none = [];
    $log = Logger(mv $none, .info);
    expect($log->enabled(.info))->no(says: 'nowhere to write yet');
    $tapped = Memory();
    $log->tap($tapped);
    expect($log->enabled(.info))->yes(says: 'the tap is somewhere to write');
}
