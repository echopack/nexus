/**
 * Patterns and the route table.
 */

use nexus::{Pattern, Router, Route, Method, Payload, Response, RouteError, Url};
use ecotest::expect;

internal struct LinkShow {}
internal struct LinkFiles {}
internal struct LinkArchive {}
internal struct LinkHome {}
internal struct LinkSlugs {}

internal function routerNoop() : function<Response(Payload&)>
{
    return function(Payload& $payload) : Response {
        return Response(text: 'x');
    };
}

internal function routerBound() : function<bool(container::Container)>
{
    return function(container::Container $c) : bool {
        return true;
    };
}

internal function routerRoute(array<Method> $methods, const string& $path, const string& $action) : Route
{
    return Route($methods, $path, $action, routerNoop(), routerBound());
}

internal function linkRoute<A>(const string& $path) : Route
{
    array<Method> $get = [.get];
    Route $r = routerRoute($get, $path, 'Link');
    $r->type = type_id<A>();
    return $r;
}

test pattern_captures_and_constraints
{
    Pattern $p = guard Pattern::parse('/v1/posts/{id:number}/comments/{page?}');
    $out = map<string, string>();
    expect($p->matches('/v1/posts/42/comments', $out))->yes(says: 'the path without the optional page matches');
    expect($out->get('id'))->is('42');
    expect($out->has('page'))->no(says: 'a left-out optional segment captures nothing');
    $two = map<string, string>();
    expect($p->matches('/v1/posts/42/comments/3/', $two))->yes(says: 'the path with a page and a trailing slash matches');
    expect($two->get('page'))->is('3');
    $bad = map<string, string>();
    expect($p->matches('/v1/posts/abc/comments', $bad))->no(says: 'a non-number id does not match');
    expect($p->matches('/v1/posts/42/comments/3/4', $bad))->no(says: 'an extra segment does not match');
}

test pattern_rest_and_decoding
{
    Pattern $p = guard Pattern::parse('/files/{path*}');
    $out = map<string, string>();
    expect($p->matches('/files/a%20b/c.txt', $out))->yes(says: 'the rest segment takes several segments');
    expect($out->get('path'))->is('a b/c.txt');
    $empty = map<string, string>();
    expect($p->matches('/files', $empty))->yes(says: 'the rest segment may be empty');
    expect($empty->get('path'))->is('');
    Pattern $slug = guard Pattern::parse('/files/{path:slug*}');
    $ok = map<string, string>();
    expect($slug->matches('/files/a-b/c-d', $ok))->yes(says: 'each rest piece admits slug');
    expect($ok->get('path'))->is('a-b/c-d');
    $bad = map<string, string>();
    expect($slug->matches('/files/A/B', $bad))->no(says: 'a rest piece that fails the constraint does not match');
    expect($slug->matches('/files', $bad))->no(says: 'an empty constrained rest does not match');
}

test pattern_refuses_bad_sources
{
    expect(Pattern::parse('posts'))->fails();
    expect(Pattern::parse('/posts/{id'))->fails();
    expect(Pattern::parse('/posts/{id:bogus}'))->fails();
    expect(Pattern::parse('/a/{x}/{x}'))->fails();
    expect(Pattern::parse('/a/{rest*}/b'))->fails();
    expect(Pattern::parse('/a/x{y}'))->fails();
}

test router_prefers_literal_segments
{
    $r = Router();
    array<Method> $get = [.get];
    guard $r->add(routerRoute($get, '/posts/{id}', 'Show'));
    guard $r->add(routerRoute($get, '/posts/new', 'New'));
    guard $r->add(routerRoute($get, '/{path*}', 'Fallback'));
    $params = map<string, string>();
    array<Method> $allow = [];
    Route $hit = expect($r->find(.get, '/posts/new', $params, $allow))->some();
    expect($hit->action)->is('New');
    Route $show = expect($r->find(.get, '/posts/7', $params, $allow))->some();
    expect($show->action)->is('Show');
    Route $fb = expect($r->find(.get, '/about/team', $params, $allow))->some();
    expect($fb->action)->is('Fallback');
}

test router_reports_allowed_methods
{
    $r = Router();
    array<Method> $get = [.get];
    array<Method> $post = [.post];
    guard $r->add(routerRoute($get, '/posts', 'List'));
    guard $r->add(routerRoute($post, '/posts', 'Create'));
    $params = map<string, string>();
    array<Method> $allow = [];
    expect($r->find(.delete, '/posts', $params, $allow))->none();
    expect($allow)->size(4);
    array<Method> $none = [];
    expect($r->find(.get, '/nope', $params, $none))->none();
    expect($none)->empty();
    array<Method> $headAllow = [];
    Route $head = expect($r->find(.head, '/posts', $params, $headAllow))->some();
    expect($head->action)->is('List');
}

test router_refuses_duplicates
{
    $r = Router();
    array<Method> $get = [.get];
    guard $r->add(routerRoute($get, '/posts', 'A'));
    status<RouteError> $again = $r->add(routerRoute($get, '/posts', 'B'));
    expect($again)->fails();
}

test router_builds_links_by_action_type
{
    $r = Router();
    guard $r->add(linkRoute<LinkShow>('/v1/posts/{id:integer}'));
    guard $r->add(linkRoute<LinkShow>('/posts/{id}'));
    guard $r->add(linkRoute<LinkFiles>('/files/{path*}'));
    guard $r->add(linkRoute<LinkArchive>('/archive/{year}/{month?}'));
    guard $r->add(linkRoute<LinkHome>('/'));
    // the first route an action got is where its links go
    expect($r->url<LinkShow>(['id' => '5'])->text())->is('/v1/posts/5');
    // names the pattern lacks become query pairs, in name order
    expect($r->url<LinkShow>(['page' => '2', 'id' => '5', 'include' => 'a b'])->text())->is('/v1/posts/5?include=a%20b&page=2');
    expect($r->url<LinkFiles>(['path' => 'a b/c'])->text())->is('/files/a%20b/c');
    expect($r->url<LinkFiles>()->text())->is('/files');
    expect($r->url<LinkFiles>(['path' => ''])->text())->is('/files');
    expect($r->url<LinkArchive>(['year' => '2026'])->text())->is('/archive/2026');
    expect($r->url<LinkArchive>(['year' => '2026', 'month' => '11'])->text())->is('/archive/2026/11');
    expect($r->url<LinkHome>()->text())->is('/');
    expect($r->url<LinkHome>()->with('q', 'x')->text())->is('/?q=x');
    expect($r->routed<LinkShow>())->yes(says: 'LinkShow is routed');
    expect($r->routed<Route>())->no(says: 'no route was added for the Route type');
}

test a_constrained_rest_links_what_it_matches
{
    $r = Router();
    guard $r->add(linkRoute<LinkSlugs>('/docs/{path:slug*}'));
    expect($r->url<LinkSlugs>(['path' => 'a-b/c-d'])->text())->is('/docs/a-b/c-d');
}

test router_builds_absolute_links_on_the_origin
{
    $r = Router();
    guard $r->add(linkRoute<LinkShow>('/v1/posts/{id}'));
    expect($r->origin())->none();
    Url $base = guard Url::parse('https://example.com/api');
    $r->origin($base);
    expect($r->absoluteUrl<LinkShow>(['id' => '5'])->text())->is('https://example.com/api/v1/posts/5');
    Url $client = guard Url::parse('http://localhost:8080');
    expect($r->url<LinkShow>(['id' => '5'])->on($client)->text())->is('http://localhost:8080/v1/posts/5');
}

test hand_built_routes_are_not_linked
{
    $r = Router();
    array<Method> $get = [.get];
    guard $r->add(routerRoute($get, '/raw', 'Raw'));
    expect($r->routed<Route>())->no(says: 'a hand-built route links no action type');
    expect($r->count())->is(1);
}

// the deaths below cannot match their message yet, so each one calls only
// what the passing link tests above already run, then the one bad link

#[tests: expects death]
test a_link_without_a_required_param_dies
{
    $r = Router();
    guard $r->add(linkRoute<LinkShow>('/v1/posts/{id}'));
    $r->url<LinkShow>();
}

#[tests: expects death]
test a_link_its_constraint_refuses_dies
{
    $r = Router();
    guard $r->add(linkRoute<LinkShow>('/v1/posts/{id:integer}'));
    $r->url<LinkShow>(['id' => 'five']);
}

#[tests: expects death]
test a_link_to_an_unrouted_action_dies
{
    $r = Router();
    guard $r->add(linkRoute<LinkShow>('/v1/posts/{id}'));
    $r->url<LinkFiles>();
}

#[tests: expects death]
test an_absolute_link_without_an_origin_dies
{
    $r = Router();
    guard $r->add(linkRoute<LinkShow>('/v1/posts/{id}'));
    $r->absoluteUrl<LinkShow>(['id' => '5']);
}

#[tests: expects death]
test a_relative_origin_dies
{
    $r = Router();
    $r->origin(Url(path: '/api'));
}
