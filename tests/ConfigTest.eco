/**
 * Env sources and typed settings.
 */

use nexus::{Env, Settings, ConfigError, BootError};
use std::time;
use ecotest::expect;

test dotenv_parses_lines
{
    $out = map<string, string>();
    string $text = "# comment\nexport DB_URL=mysql://x\nNAME = 'quoted value'\nEMPTY=\n";
    guard Env::parse('.env', $text, $out);
    expect($out->get('DB_URL'))->is('mysql://x');
    expect($out->get('NAME'))->is('quoted value');
    expect($out->get('EMPTY'))->is('');
    $bad = map<string, string>();
    expect(Env::parse('.env', "JUSTAWORD\n", $bad))->fails();
}

test dotenv_drops_inline_comments_and_keeps_quoted_text
{
    $out = map<string, string>();
    string $text = "URL=\"https://example.com\" # public origin\nKEY=abc # note\nHASH=abc#def\nTAB=x\t# tabbed\nSINGLE='a # b' # kept inside\nESC=\"say \\\"hi\\\" \\\\ \\n\"\n";
    guard Env::parse('.env', $text, $out);
    expect($out->get('URL'))->is('https://example.com');
    expect($out->get('KEY'))->is('abc');
    expect($out->get('HASH'))->is('abc#def');
    expect($out->get('TAB'))->is('x');
    expect($out->get('SINGLE'))->is('a # b');
    expect($out->get('ESC'))->is("say \"hi\" \\ \\n");
    $open = map<string, string>();
    expect(Env::parse('.env', "OPEN=\"never closed\n", $open))->fails();
    $after = map<string, string>();
    expect(Env::parse('.env', "AFTER=\"a\"b\n", $after))->fails();
}

test settings_read_types_and_collect_errors
{
    map<string, string> $vars = ['POOL' => '16', 'DEBUG' => 'yes', 'TIMEOUT' => '5m', 'PORT' => '99999', 'RATIO' => 'x'];
    $s = Settings(Env(fixed: $vars));
    expect($s->uint32('POOL', required: true))->some(16);
    expect($s->bool('DEBUG', required: false))->some(true);
    expect($s->duration('TIMEOUT', required: true))->some(time::duration::mins(5));
    expect($s->uint16('PORT', required: true))->none();
    expect($s->float64('RATIO', required: false))->none();
    expect($s->string('DB_URL', required: true))->none();
    expect($s->string('OPTIONAL', required: false))->none();
    status<BootError> $done = $s->done();
    array<string> $lines = expect($done)->fails()->lines();
    expect($lines)->size(3);
    expect($lines[2])->is('config: DB_URL is required but not set');
}

test a_required_setting_set_to_nothing_is_missing
{
    map<string, string> $vars = ['DB_URL' => '', 'KEY' => '  ', 'POOL' => '', 'NOTE' => ''];
    $s = Settings(Env(fixed: $vars));
    expect($s->string('DB_URL', required: true))->none();
    expect($s->string('KEY', required: true))->none();
    expect($s->uint32('POOL', required: true))->none();
    // an optional setting keeps its empty value
    expect($s->string('NOTE', required: false))->some('');
    array<string> $lines = expect($s->done())->fails()->lines();
    expect($lines)->size(3);
    expect($lines[0])->is('config: DB_URL is required but not set');
    expect($lines[1])->is('config: KEY is required but not set');
    expect($lines[2])->is('config: POOL is required but not set');
}

test env_overrides_win
{
    map<string, string> $vars = ['A' => '1'];
    $e = Env(fixed: $vars);
    $e->set('A', '2');
    expect($e->get('A'))->some('2');
    expect($e->get('B'))->none();
}

test durations_read_units_or_bare_seconds
{
    expect(Settings::span('250ms'))->some(time::duration::millis(250));
    expect(Settings::span('30'))->some(time::duration::secs(30));
    expect(Settings::span('2h'))->some(time::duration::hours(2));
    expect(Settings::span('1d'))->some(time::duration::hours(24));
    expect(Settings::span('5x'))->none();
    expect(Settings::span('m'))->none();
}
