/**
 * Events reach their listeners by type, in order, through the registry the kernel boots with; the
 * first problem stops the rest.
 */

use std::thread;
use nexus::{Kernel, Tables, Extension, Services, Events, ConfigTable, Mode, Logger, Env, Payload, Problem, Serve, BootError};
use ecotest::expect;

internal struct ESaid
{
    public string $text;
}

internal struct EOther
{
    public int64 $n;
}

#[atomic]
internal class ETrace
{
    public thread::mutex<array<string>> $seen = thread::mutex<array<string>>(array<string>());
    public atomic<int32> $started = atomic<int32>(0);
    public atomic<int32> $drained = atomic<int32>(0);

    public function add(const string& $line) : void
    {
        $l = $this->seen->lock();
        $l->value[] = $line;
    }

    public function all() : array<string>
    {
        $l = $this->seen->lock();
        return $l->value;
    }
}

internal class EApp : Extension
{
    public ETrace $trace;
    public bool $refuse = false;

    public constructor(ETrace $trace)
    {
        $this->trace = $trace;
    }

    public function name() : string
    {
        return 'events-test';
    }

    public function start(Kernel $k, const Serve& $o) : status<BootError>
    {
        $this->trace->started->add(1);
        if ($this->refuse) {
            return .error(.extension('events-test', 'refused to start'));
        }
        return .ok;
    }

    public function drain(Kernel $k) : void
    {
        $this->trace->drained->add(1);
    }
}

internal class EListeners : Extension
{
    public ETrace $trace;
    public bool $refuse;

    public constructor(ETrace $trace, bool $refuse)
    {
        $this->trace = $trace;
        $this->refuse = $refuse;
    }

    public function name() : string
    {
        return 'events-listeners';
    }

    public function services(Services& $s) : status<BootError>
    {
        ETrace $trace = $this->trace;
        bool $refuse = $this->refuse;
        $s->bind<ETrace>(put: $trace);
        $s->on<ESaid>('first', function[$trace](Payload& $payload, const ESaid& $e) : status<Problem> {
            $trace->add("first {$e->text}");
            return .ok;
        });
        $s->on<ESaid>('second', function[$trace, $refuse](Payload& $payload, const ESaid& $e) : status<Problem> {
            if ($refuse) {
                return .error(.conflict('no'));
            }
            $trace->add("second {$e->text}");
            return .ok;
        });
        $s->on<ESaid>('third', function[$trace](Payload& $payload, const ESaid& $e) : status<Problem> {
            $trace->add("third {$e->text}");
            return .ok;
        });
        $s->listen<EOther, ECounted>();
        return .ok;
    }
}

internal struct ECounted : nexus::Listener<EOther>
{
    public static function handle(Payload& $payload, const EOther& $e) : status<Problem>
    {
        $trace = $payload->get<ETrace>();
        $trace->add("counted {$e->n}");
        return .ok;
    }
}

internal function eBoot(array<Extension> $exts, ETrace $trace, bool $refuse) : Kernel
{
    array<Extension> $all = [EListeners($trace, $refuse)];
    foreach ($exts as const &$ext) {
        $all[] = $ext;
    }
    array<ConfigTable> $configs = [];
    $tables = Tables($configs: $configs);
    $vars = map<string, string>();
    Kernel $k = guard Kernel::boot(mv $all, .testing, .silent(), Env(fixed: $vars), tables: $tables);
    return $k;
}

test listeners_run_in_order_by_type
{
    $trace = ETrace();
    array<Extension> $exts = [];
    Kernel $k = eBoot($exts, $trace, false);
    $payload = $k->background('test', 'abc');
    guard Events::emit($payload, ESaid('hi'));
    guard Events::emit($payload, EOther(3));
    Kernel::finish($payload);
    array<string> $seen = $trace->all();
    expect($seen)->size(4);
    expect($seen[0])->is('first hi');
    expect($seen[2])->is('third hi');
    expect($seen[3])->is('counted 3');
    $ev = $k->services->get<Events>();
    expect($ev->count<ESaid>())->is(3);
    expect($ev->count<EOther>())->is(1);
    expect($ev->listeners())->size(4);
    // no generated table names ECounted here
    expect($ev->listeners()[3])->is('a listener');
}

test a_problem_stops_the_rest
{
    $trace = ETrace();
    array<Extension> $exts = [];
    Kernel $k = eBoot($exts, $trace, true);
    Payload $payload = $k->background('test', 'abc');
    status<Problem> $s = Events::emit($payload, ESaid('hi'));
    Kernel::finish($payload);
    expect(eRefused($s))->is(409);
    array<string> $seen = $trace->all();
    expect($seen)->size(1);
}

test a_background_payload_has_its_own_scope
{
    $trace = ETrace();
    array<Extension> $exts = [];
    Kernel $k = eBoot($exts, $trace, false);
    Payload $payload = $k->background('blog::SendWelcome', 'task1');
    expect($payload->request->id)->is('task1');
    expect($payload->action)->is('blog::SendWelcome');
    expect($payload->request->path)->is('/blog::SendWelcome');
    Kernel::finish($payload);
}

test a_failed_start_drains_the_extensions_already_started
{
    $trace = ETrace();
    $ok = EApp($trace);
    $bad = EApp($trace);
    $bad->refuse = true;
    array<Extension> $exts = [$ok, $bad];
    Kernel $k = eBoot($exts, $trace, false);
    $o = Serve();
    status<BootError> $s = $k->start($o);
    expect(eStarted($s))->no(says: 'the kernel refuses to start when an extension does');
    expect($trace->started->load())->is(2);
    expect($trace->drained->load())->is(1);
}

internal function eRefused(status<Problem> $s) : int32
{
    guard $s else ($p) {
        return $p->status();
    };
    return 0;
}

internal function eStarted(status<BootError> $s) : bool
{
    guard $s else {
        return false;
    };
    return true;
}
