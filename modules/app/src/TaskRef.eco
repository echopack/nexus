namespace nexus::app;

/**
 * The task type `bindTask` just bound, for its queue, tries and schedule:
 *
 * ```echo
 * $app->bindTask<SendWelcome>()->queue('mail')->tries(5);
 * $app->bindTask<PruneAuth>()->cron('0 3 * * *');
 * ```
 *
 * Each call binds the task again with what is set so far; a scheduled task is pushed with its
 * defaults.
 */
public class TaskRef<T>
{
    internal nexus::Services $services;
    internal string $queue = 'default';
    internal int64 $tries = 3;
    internal string $every = '';
    internal string $cron = '';

    internal constructor(nexus::Services $services)
    {
        $this->services = $services;
        $this->bind();
    }

    /**
     * The queue the task goes to, like `mail`.
     */
    public function queue(const string& $queue) : TaskRef<T>
    {
        $this->queue = $queue;
        $this->bind();
        return $this;
    }

    /**
     * How often the task is tried, 1 to 100.
     */
    public function tries(int64 $tries) : TaskRef<T>
    {
        $this->tries = $tries;
        $this->bind();
        return $this;
    }

    /**
     * Pushes the task every `$every`, like `15m`.
     */
    public function every(const string& $every) : TaskRef<T>
    {
        $this->every = $every;
        $this->bind();
        return $this;
    }

    /**
     * Pushes the task on the cron schedule `$cron`, like `0 3 * * *`.
     */
    public function cron(const string& $cron) : TaskRef<T>
    {
        $this->cron = $cron;
        $this->bind();
        return $this;
    }

    private function bind() : void
    {
        nexus::work::Tasks::bind<T>($this->services, queue: $this->queue, tries: $this->tries, every: $this->every, cron: $this->cron);
    }
}
