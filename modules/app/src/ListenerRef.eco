namespace nexus::app;

/**
 * The listener `bindListener` just took, for the events that run it:
 *
 * ```echo
 * $app->bindListener<WelcomeNewUser>()->on<UserRegistered>();
 * ```
 */
public class ListenerRef<L>
{
    internal nexus::Services $services;

    internal constructor(nexus::Services $services)
    {
        $this->services = $services;
    }

    /**
     * Runs `L::handle` whenever an `E` is emitted. Call it again for another event `L` handles.
     */
    public function on<E>() : ListenerRef<L>
    {
        $this->services->listen<E, L>();
        return $this;
    }
}
