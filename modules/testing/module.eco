/*
 * nexus-testing: drive a nexus app in process. Boot the app's extensions with fixed config, send
 * requests through ecotest-http's `Api` straight into the kernel (no socket, and coverage counts
 * the app's code), check the replies and what was logged.
 *
 * ecotest-http is required here, and with it ecotest itself, so a test target that depends on this
 * module needs no `requires` of its own for either.
 */

#[module: "nexus-testing"]
#[version: "0.1.0"]
#[epm::license: "MIT"]
#[epm::description: "In-process API tests and log checks for nexus apps, on ecotest-http"]

#[depends: "../.."]
#[requires: "echopack/container" { version: "^0.1.0", source: git "https://github.com/echopack/container" }]
#[requires: "echolang/libjson" { version: "^0.3.0", source: git "https://github.com/echolang/libjson" }]
#[requires: "echolang/ecotest" { version: "^0.3.4", source: git "https://github.com/echolang/ecotest" }]
#[requires: "echolang/ecotest/modules/http" { version: "^0.3.4", source: git "https://github.com/echolang/ecotest" }]

#[sources: "src/*.eco"]

#[target: test] {
    #[sources: "tests/*.eco"]
}
