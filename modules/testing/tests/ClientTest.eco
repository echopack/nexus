/**
 * The test client against a tiny app with a hand-written route table.
 */

use nexus::testing::TestApp;
use container::Container;
use ecotest::expect;

internal class TEcho : nexus::Action
{
    public function handle(nexus::Payload& $payload) : nexus::Response
    {
        $o = json::object();
        $o['method'] = json::str($payload->request->method->verb());
        $o['body'] = json::str($payload->request->body);
        $o['who'] = json::str($payload->request->header('X-Who') ?? '');
        return nexus::Response(json: $o);
    }
}

internal class TApp : nexus::Extension
{
    public function name() : string
    {
        return 'tapp';
    }

    public function services(nexus::Services& $s) : status<nexus::BootError>
    {
        $s->bind<TEcho>(scope: function() : TEcho {
            return TEcho();
        });
        testingRoutes($s);
        return .ok;
    }
}

internal function testingRoutes(nexus::Services& $s) : void
{
    array<nexus::Method> $m = [nexus::Method::get, nexus::Method::post];
    array<nexus::MiddlewareRef> $w = [];
    function<nexus::Response(nexus::Payload&)> $d = function(nexus::Payload& $payload) : nexus::Response {
        $a = $payload->get<TEcho>();
        return $a->handle($payload);
    };
    function<bool(Container)> $b = function(Container $services) : bool {
        return $services->has<TEcho>();
    };
    $s->route(nexus::Route($m, '/echo', 'TEcho', $d, $b, $w));
}

internal function tBoot() : TestApp
{
    array<nexus::Extension> $exts = [TApp()];
    return TestApp($exts);
}

test client_sends_and_asserts
{
    $app = tBoot();
    $c = $app->client()->with('X-Who', 'tester');
    array<string> $method = ['method'];
    array<string> $who = ['who'];
    $c->get('/echo')->assertStatus(200)->assertJson($method, 'GET')->assertJson($who, 'tester');
    $doc = json::object();
    $doc['a'] = 1;
    array<string> $body = ['body'];
    $c->post('/echo', json: $doc)->assertStatus(200)->assertJson($method, 'POST')->assertJson($body, '{"a":1}');
    expect($app->logged('GET /echo 200'))->yes(says: 'the request was logged as GET /echo 200');
}

test problems_assert
{
    $app = tBoot();
    $app->client()->get('/nope')->assertProblem(404);
    $app->client()->delete('/echo')->assertProblem(405)->assertHeader('Allow', 'GET, POST, OPTIONS, HEAD');
}

#[tests: expects death]
test failed_assertion_stops_the_test
{
    $app = tBoot();
    $app->client()->get('/echo')->assertStatus(500);
}
