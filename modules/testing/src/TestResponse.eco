namespace nexus::testing;

/**
 * A response with assertions. Every assertion stops the test with a message that says what was
 * expected and what came back; each returns the response, so they chain.
 */
public class TestResponse
{
    public const nexus::Response $response;

    public constructor(nexus::Response $response)
    {
        $this->response = mv $response;
    }

    /**
     * The value of header `$name`, or null.
     */
    public const function header(const string& $name) : string?
    {
        return $this->response->header($name);
    }

    /**
     * The body parsed as JSON. Stops the test when it is not JSON.
     */
    public const function json() : json::Value
    {
        $doc = guard json::parse($this->response->body) else ($e) {
            die("nexus-testing: the body is not JSON ({$e->message()}): {$this->response->body}");
        };
        return $doc;
    }

    public const function assertStatus(int32 $want) : TestResponse
    {
        if ($this->response->status != $want) {
            die("nexus-testing: expected status {$want}, got {$this->response->status}: {$this->response->body}");
        }
        return $this;
    }

    public const function assertHeader(const string& $name, const string& $want) : TestResponse
    {
        string $got = $this->response->header($name) ?? '(none)';
        if ($got != $want) {
            die("nexus-testing: expected header {$name}: {$want}, got {$got}");
        }
        return $this;
    }

    public const function assertBody(const string& $want) : TestResponse
    {
        if ($this->response->body != $want) {
            die("nexus-testing: expected the body {$want}, got {$this->response->body}");
        }
        return $this;
    }

    public const function assertBodyContains(const string& $part) : TestResponse
    {
        if (!$this->response->body->contains($part)) {
            die("nexus-testing: expected the body to contain {$part}: {$this->response->body}");
        }
        return $this;
    }

    /**
     * The string at a JSON path (`['data', 'title']`) is `$want`.
     */
    public const function assertJson(const array<string>& $path, const string& $want) : TestResponse
    {
        string $got = TestResponse::text(TestResponse::walk($this->json(), $path));
        if ($got != $want) {
            string $at = str::join($path, '.');
            die("nexus-testing: expected {$at} to be {$want}, got {$got}");
        }
        return $this;
    }

    /**
     * The integer at a JSON path is `$want`.
     */
    public const function assertJson(const array<string>& $path, int64 $want) : TestResponse
    {
        int64? $got = TestResponse::walk($this->json(), $path)?->asInt();
        if ($got == null || ($got ?? 0) != $want) {
            string $at = str::join($path, '.');
            die("nexus-testing: expected {$at} to be {$want}: {$this->response->body}");
        }
        return $this;
    }

    /**
     * The JSON body is an array with `$n` items.
     */
    public const function assertCount(usize $n) : TestResponse
    {
        $doc = $this->json();
        if (!$doc->isArray() || $doc->count() != $n) {
            die("nexus-testing: expected a JSON array of {$n}: {$this->response->body}");
        }
        return $this;
    }

    /**
     * The value at `$path` is an array with `$n` items: `['data']` for a rest document.
     */
    public const function assertCount(const array<string>& $path, usize $n) : TestResponse
    {
        string $where = str::join($path, '.');
        $at = guard TestResponse::walk($this->json(), $path) else {
            die("nexus-testing: nothing at {$where}: {$this->response->body}");
        };
        if (!$at->isArray() || $at->count() != $n) {
            die("nexus-testing: expected an array of {$n} at {$where}: {$this->response->body}");
        }
        return $this;
    }

    /**
     * The response is problem details with this status.
     */
    public const function assertProblem(int32 $status) : TestResponse
    {
        $this->assertStatus($status);
        string $type = $this->response->header('Content-Type') ?? '';
        if ($type != 'application/problem+json') {
            die("nexus-testing: expected application/problem+json, got {$type}");
        }
        return $this;
    }

    /**
     * The response is a 422 that refuses `$field` with `$code`.
     */
    public const function assertInvalid(const string& $field, const string& $code) : TestResponse
    {
        $this->assertProblem(422);
        $errors = $this->json()->get('errors')?->asArray() ?? array<json::Value>();
        foreach ($errors as const &$e) {
            if (TestResponse::text($e->get('field')) == $field && TestResponse::text($e->get('code')) == $code) {
                return $this;
            }
        }
        die("nexus-testing: expected field {$field} refused with {$code}: {$this->response->body}");
        return $this;
    }

    /**
     * The value at `$path`: object keys by name, array items by index.
     */
    public static function walk(const json::Value& $doc, const array<string>& $path) : json::Value?
    {
        $at = $doc->clone();
        foreach ($path as const &$step) {
            json::Value? $next = null;
            if ($at->isArray()) {
                uint64 $index = guard str::uint($step) else {
                    return null;
                };
                $next = $at->at($index as usize);
            } else {
                $next = $at->get($step);
            }
            $found = guard $next else {
                return null;
            };
            $at = $found;
        }
        return $at;
    }

    internal static function text(json::Value? $v) : string
    {
        $there = guard $v else {
            return '(missing)';
        };
        return $there->asStr() ?? json::dump($there->clone());
    }
}
