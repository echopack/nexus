namespace nexus::testing;

/**
 * Sends requests straight into the kernel, no socket in between. Headers
 * set with `with` go on every request.
 */
public class Client
{
    private nexus::Kernel $kernel;
    private nexus::Headers $defaults = nexus::Headers();

    public constructor(nexus::Kernel $kernel)
    {
        $this->kernel = $kernel;
    }

    /**
     * Adds a header every later request carries, and returns the client.
     */
    public function with(const string& $name, const string& $value) : Client
    {
        $this->defaults->set($name, $value);
        return $this;
    }

    public function get(const string& $target) : TestResponse
    {
        return $this->send(nexus::Request(nexus::Method::get, $target));
    }

    public function head(const string& $target) : TestResponse
    {
        return $this->send(nexus::Request(nexus::Method::head, $target));
    }

    public function delete(const string& $target) : TestResponse
    {
        return $this->send(nexus::Request(nexus::Method::delete, $target));
    }

    public function post(const string& $target, json: json::Value $doc) : TestResponse
    {
        return $this->send(nexus::Request(nexus::Method::post, $target, body: json::dump($doc), type: 'application/json'));
    }

    public function post(const string& $target, body: const string& $body, type: const string& $type) : TestResponse
    {
        return $this->send(nexus::Request(nexus::Method::post, $target, body: $body, type: $type));
    }

    public function post(const string& $target, form: const string& $encoded) : TestResponse
    {
        return $this->send(nexus::Request(nexus::Method::post, $target, body: $encoded, type: 'application/x-www-form-urlencoded'));
    }

    public function put(const string& $target, json: json::Value $doc) : TestResponse
    {
        return $this->send(nexus::Request(nexus::Method::put, $target, body: json::dump($doc), type: 'application/json'));
    }

    public function patch(const string& $target, json: json::Value $doc) : TestResponse
    {
        return $this->send(nexus::Request(nexus::Method::patch, $target, body: json::dump($doc), type: 'application/json'));
    }

    /**
     * Sends a request as built, plus the default headers it does not set
     * itself.
     */
    public function send(nexus::Request $request) : TestResponse
    {
        nexus::Request $r = $request;
        foreach ($this->defaults->items as const &$h) {
            if (!$r->headers->has($h->name)) {
                $r->headers->add($h->name, $h->value);
            }
        }
        $r->peer = '127.0.0.1:0';
        return TestResponse($this->kernel->handle($r));
    }
}
