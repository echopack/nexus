namespace nexus::testing;

use ecotest::http::Api;

/**
 * A booted app for tests: the kernel with the program's generated route and config tables, fixed
 * config values instead of the environment, and a log that keeps every entry. `api()` sends it
 * requests in process, checked with ecotest-http.
 *
 * ```echo
 * $app = TestApp($extensions, ['BLOG_TITLE' => 'Testing blog']);
 * $app->api()->get('/health')->status(200)->json('$.title', 'Testing blog');
 * $app->expectLogged(.info, 'GET /health 200');
 * ```
 */
public class TestApp
{
    public nexus::Kernel $kernel;
    public nexus::log::Memory $log;

    // where opened streams and sockets take their ids from
    private atomic<int64> $opened = atomic<int64>(0);

    /**
     * Boots `$extensions` with nothing but `$vars` as config. A failed boot stops the test with
     * every reason; `attempt` hands the reasons back.
     */
    public constructor(const array<nexus::Extension>& $extensions, map<string, string> $vars = [])
    {
        $app = TestApp::must($extensions, mv $vars);
        $this->kernel = $app->kernel;
        $this->log = $app->log;
    }

    /**
     * Boots `$extensions`, then `$replace` on their services, as an extension listed last would:
     * where a test swaps what reaches outside the process for a fake, and keeps the app's own list.
     *
     * ```echo
     * $google = nexus::connect::ScriptedFetch();
     * $app = TestApp(Blog::extensions(), $vars, replace: $google->replacing());
     * ```
     */
    public constructor(const array<nexus::Extension>& $extensions, map<string, string> $vars, replace: function<void(nexus::Services&)> $replace)
    {
        array<nexus::Extension> $all = $extensions;
        $all[] = Replacements($replace);
        $app = TestApp::must($all, mv $vars);
        $this->kernel = $app->kernel;
        $this->log = $app->log;
    }

    /**
     * The app around a kernel that booted, logging into `$log`.
     */
    internal constructor(booted: nexus::Kernel $kernel, nexus::log::Memory $log)
    {
        $this->kernel = $kernel;
        $this->log = $log;
    }

    /**
     * Boots in `$mode` and hands back why it failed, for tests about boot itself, and for a test
     * about what a mode allows: what prod refuses at boot.
     */
    public static function attempt(const array<nexus::Extension>& $extensions, map<string, string> $vars, mode: nexus::Mode $mode = .testing) : result<TestApp, nexus::BootError>
    {
        $sink = nexus::log::Memory();
        array<nexus::log::Sink> $sinks = [$sink];
        $log = nexus::Logger($sinks, .trace);
        $k = try nexus::Kernel::boot($extensions, $mode, $log, nexus::Env(fixed: mv $vars));
        return .ok(TestApp(booted: $k, $sink));
    }

    /**
     * The booted app; a failed boot stops the test with every reason.
     */
    internal static function must(const array<nexus::Extension>& $extensions, map<string, string> $vars) : TestApp
    {
        $app = guard TestApp::attempt($extensions, mv $vars) else ($e) {
            string $lines = str::join($e->lines(), '; ');
            die("nexus-testing: the app did not boot: {$lines}");
        };
        return $app;
    }

    /**
     * The app as an ecotest-http `Api`: every request goes straight into the kernel, no socket in
     * between, from `127.0.0.1`. `with` and `bearer` hand back a copy that sends more headers.
     */
    public const function api() : Api
    {
        return Api(transport: KernelTransport($this->kernel), base: 'http://app');
    }

    /**
     * The app as an `Api` whose every request carries the `Authorization` that `signed` makes from
     * its method, target and body (`SignedTransport`): requests signed with a session.
     */
    public const function api(signed: function<string(string, string, string)> $sign) : Api
    {
        return Api(transport: SignedTransport(KernelTransport($this->kernel), $sign), base: 'http://app');
    }

    /**
     * Opens the event stream a GET of `$target` answers with, in process: the app's open hook runs
     * with a stream that keeps every event sent to it. An answer that is no event stream (a 401, a
     * 404) comes back as a stream that never opened, with its status and body.
     */
    public function events(const string& $target, map<string, string> $headers = []) : TestEventStream
    {
        nexus::Response $got = $this->kernel->handle($this->opening($target, $headers));
        $s = TestEventStream($got, $this->opened->add(1) + 1);
        $s->start();
        return $s;
    }

    /**
     * `events`, the request signed by `$sign` as `api(signed:)` signs.
     */
    public function events(const string& $target, signed: function<string(string, string, string)> $sign, map<string, string> $headers = []) : TestEventStream
    {
        map<string, string> $all = $headers;
        $all['Authorization'] = $sign('GET', $target, '');
        return $this->events($target, $all);
    }

    /**
     * Opens the websocket a GET of `$target` upgrades to, in process: the app's open hook runs,
     * `say` hands it messages and every message it sends is kept. An answer that is no upgrade
     * comes back as a socket that never opened, with its status and body.
     */
    public function socket(const string& $target, map<string, string> $headers = []) : TestSocket
    {
        map<string, string> $all = $headers;
        $all['Upgrade'] = 'websocket';
        $all['Connection'] = 'Upgrade';
        $all['Sec-WebSocket-Version'] = '13';
        $all['Sec-WebSocket-Key'] = 'dGhlIHNhbXBsZSBub25jZQ==';
        nexus::Response $got = $this->kernel->handle($this->opening($target, $all));
        $s = TestSocket($got, $this->opened->add(1) + 1);
        $s->start();
        return $s;
    }

    /**
     * `socket`, the request signed by `$sign` as `api(signed:)` signs.
     */
    public function socket(const string& $target, signed: function<string(string, string, string)> $sign, map<string, string> $headers = []) : TestSocket
    {
        map<string, string> $all = $headers;
        $all['Authorization'] = $sign('GET', $target, '');
        return $this->socket($target, $all);
    }

    /**
     * A GET of `$target` from a loopback client, as a socket client sends it.
     */
    private function opening(const string& $target, const map<string, string>& $headers) : nexus::Request
    {
        $in = nexus::Request(.get, KernelTransport::target($target));
        $in->peer = '127.0.0.1';
        $in->headers->add('Host', 'app');
        $in->headers->add('Accept', '*/*');
        foreach ($headers as $name => const &$value) {
            $in->headers->set($name, $value);
        }
        return $in;
    }

    /**
     * Whether a log entry with exactly this message was written.
     */
    public function logged(const string& $message) : bool
    {
        return $this->log->saw($message);
    }

    /**
     * Whether a log entry with exactly this message was written at `$level`.
     */
    public function logged(nexus::log::Level $level, const string& $message) : bool
    {
        return $this->log->saw($level, $message);
    }

    /**
     * An entry with exactly this message was written at `$level`. A failure lists what was logged.
     */
    #[caller]
    public function expectLogged(nexus::log::Level $level, const string& $message) : TestApp
    {
        ecotest::checked();
        if (!$this->logged($level, $message)) {
            ecotest::fail("expected '{$message}' logged at {$level->name()}", std::src::caller(), $detail: $this->logLines());
        }
        return $this;
    }

    /**
     * No entry with exactly this message was written, at any level.
     */
    #[caller]
    public function expectNotLogged(const string& $message) : TestApp
    {
        ecotest::checked();
        if ($this->logged($message)) {
            ecotest::fail("expected '{$message}' not to be logged", std::src::caller(), $detail: $this->logLines());
        }
        return $this;
    }

    /**
     * Every entry so far, one per line, for a failure that says what was logged instead.
     */
    private function logLines() : string
    {
        array<string> $all = [];
        foreach ($this->log->entries() as const &$e) {
            $all[] = "{$e->level->name()} {$e->message}";
        }
        if ($all->empty()) {
            return 'nothing was logged';
        }
        return str::join($all, "\n");
    }
}
