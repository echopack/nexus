namespace nexus::testing;

/**
 * A booted app for tests: the kernel with the program's generated route and config tables, fixed
 * config values instead of the environment, and a log that keeps every entry.
 *
 * ```echo
 * $app = TestApp($extensions, ['BLOG_KEY' => 'k']);
 * $app->client()->get('/health')->assertStatus(200);
 * ```
 */
public class TestApp
{
    public nexus::Kernel $kernel;
    public nexus::log::Memory $log;

    /**
     * Boots `$extensions` with nothing but `$vars` as config. A failed boot stops the test with
     * every reason; `attempt` hands the reasons back.
     */
    public constructor(const array<nexus::Extension>& $extensions, map<string, string> $vars = [])
    {
        $app = guard TestApp::attempt($extensions, mv $vars) else ($e) {
            string $lines = str::join($e->lines(), '; ');
            die("nexus-testing: the app did not boot: {$lines}");
        };
        $this->kernel = $app->kernel;
        $this->log = $app->log;
    }

    /**
     * The app around a kernel that booted, logging into `$log`.
     */
    internal constructor(booted: nexus::Kernel $kernel, nexus::log::Memory $log)
    {
        $this->kernel = $kernel;
        $this->log = $log;
    }

    /**
     * Boots and hands back why it failed, for tests about boot itself.
     */
    public static function attempt(const array<nexus::Extension>& $extensions, map<string, string> $vars) : result<TestApp, nexus::BootError>
    {
        $sink = nexus::log::Memory();
        array<nexus::log::Sink> $sinks = [$sink];
        $log = nexus::Logger($sinks, .trace);
        $k = try nexus::Kernel::boot($extensions, nexus::Mode::testing, $log, nexus::Env(fixed: mv $vars));
        return .ok(TestApp(booted: $k, $sink));
    }

    /**
     * A client with no default headers.
     */
    public const function client() : Client
    {
        return Client($this->kernel);
    }

    /**
     * Whether a log entry with exactly this message was written.
     */
    public function logged(const string& $message) : bool
    {
        return $this->log->saw($message);
    }

    /**
     * Whether a log entry with exactly this message was written at `$level`.
     */
    public function logged(nexus::log::Level $level, const string& $message) : bool
    {
        return $this->log->saw($level, $message);
    }

    /**
     * Stops the test unless an entry with exactly this message was written at `$level`.
     */
    public function assertLogged(nexus::log::Level $level, const string& $message) : TestApp
    {
        if (!$this->logged($level, $message)) {
            string $got = $this->logLines();
            die("nexus-testing: expected a {$level->name()} log entry '{$message}', got: {$got}");
        }
        return $this;
    }

    /**
     * Stops the test if an entry with exactly this message was written.
     */
    public function assertNotLogged(const string& $message) : TestApp
    {
        if ($this->logged($message)) {
            die("nexus-testing: expected no log entry '{$message}'");
        }
        return $this;
    }

    /**
     * Every message so far, for a failure that says what was logged instead.
     */
    private function logLines() : string
    {
        array<string> $all = [];
        foreach ($this->log->entries() as const &$e) {
            $all[] = "{$e->level->name()} {$e->message}";
        }
        if ($all->empty()) {
            return '(nothing)';
        }
        return str::join($all, '; ');
    }
}
