/*
 * nexus-carbon: a carbon database for a nexus app.
 *
 * The app says how its database opens, from the NEXUS_DATABASE_URL setting, and
 * registers its repositories on it; the extension seals it, binds it, and
 * gives every request a carbon::Session of its own, with a pooled
 * connection that goes back when the request ends. Repositories come from
 * the request's session; `migrate` and its siblings run the app's
 * migrations from the app binary.
 */

#[module: "nexus-carbon"]
#[version: "0.1.0"]
#[epm::license: "MIT"]
#[epm::description: "carbon databases for nexus apps: a session per request, migrations from the app binary"]

#[depends: "../.."]
#[requires: "echopack/carbon" { version: "^0.2.1", source: git "https://github.com/echopack/carbon" }]
#[requires: "echopack/container" { version: "^0.1.0", source: git "https://github.com/echopack/container" }]
#[requires: "echolang/libjson" { version: "^0.3.0", source: git "https://github.com/echolang/libjson" }]

#[hook: before_build { run: "nexus", args: ["gen"] }]

#[sources: "src/*.eco"]
#[if: !NEXUS_NOGEN]
#[sources: ".nexus/*.eco"]
#[end]

#[target: test] {
    #[requires: "echopack/carbon/fake" { version: "^0.2.1", source: git "https://github.com/echopack/carbon" }]
    #[depends: "../testing"]
    #[sources: "tests/*.eco"]
}
