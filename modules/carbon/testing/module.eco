/*
 * nexus-carbon-testing: a MySQL database of its own for each integration test. `Database` creates
 * one on a server, migrates it with the app's migrations, and drops it when the test ends, even
 * when a check stops the test first. Boot the app on its `url` with nexus-testing's `TestApp`.
 *
 * The server comes from the first variable a test names that is set (an app's own, such as
 * `BLOG_TEST_DATABASE_URL`, then `ECOTEST_MYSQL_URL` from an ecotest.json service); without one
 * the test is skipped.
 */

#[module: "nexus-carbon-testing"]
#[version: "0.1.0"]
#[epm::license: "MIT"]
#[epm::description: "Throwaway, migrated MySQL databases for nexus integration tests"]

#[depends: "../../../../carbon"]
#[depends: "../../../../carbon/drivers/mysql"]
#[depends: "../../../../ecotest"]

#[sources: "src/*.eco"]

#[target: test] {
    #[sources: "tests/*.eco"]
}
