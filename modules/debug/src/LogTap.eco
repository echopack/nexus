namespace nexus::debug;

/**
 * Hands every log entry of the app to the `logs` topic. Tapped into the root logger at boot, so it
 * sees what the console's sinks see, at the level `NEXUS_LOG` lets through. The console's own
 * requests log untapped (see `Recorder`), so they never reach it.
 */
#[atomic]
public class LogTap : nexus::log::Sink
{
    private Topic $topic;

    public constructor(Topic $topic)
    {
        $this->topic = $topic;
    }

    public function write(const nexus::log::Entry& $e) : void
    {
        $this->topic->publish(Entries::json($e, $e->all()));
    }
}
