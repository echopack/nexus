namespace nexus::debug;

use std::time;

/**
 * One event of a topic: its number in the topic (from 1, never reused), when it happened and its
 * data, already encoded as a JSON object.
 */
public struct Event
{
    public uint64 $seq;
    public time::timestamp $at;
    public string $data;

    /**
     * The event as the API writes it: `{"seq": 7, "at": "...", "data": {...}}`.
     */
    public const function json() : string
    {
        string $at = nexus::log::Stamp::rfc3339($this->at);
        return "\{\"seq\":{$this->seq},\"at\":\"{$at}\",\"data\":{$this->data}}";
    }
}
