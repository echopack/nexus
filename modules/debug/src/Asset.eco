namespace nexus::debug;

/**
 * One file of the embedded web app: its path under the console, its content type, its bytes, the
 * same gzipped (empty when that saves nothing) and its entity tag.
 */
public struct Asset
{
    public string $path;
    public string $type;
    public string::view $body;
    public string::view $gzip;
    public string $etag;
}
