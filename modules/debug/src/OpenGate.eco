namespace nexus::debug;

/**
 * Lets in whoever asks from this machine, with no sign in: for the developer at their desk. Refused
 * at boot in prod; a request from any other address, through a proxy, or for a host name that is
 * not this machine's gets a 403.
 */
#[atomic]
public class OpenGate : Gate
{
    public function name() : string
    {
        return 'open';
    }

    public function admit(nexus::Payload& $payload) : result<Viewer, nexus::Response>
    {
        if (!Gates::loopback($payload->request->peer)) {
            return .error($payload->fail(.forbidden('the open debug console answers localhost only')));
        }
        // a proxy on this machine makes every client look local; a page on another site whose
        // name now points here (DNS rebinding) still says its own name
        if ($payload->request->header('X-Forwarded-For') != null || $payload->request->header('Forwarded') != null) {
            return .error($payload->fail(.forbidden('the open debug console answers localhost only, not through a proxy')));
        }
        if (!Gates::localName($payload->request->header('Host') ?? '')) {
            return .error($payload->fail(.forbidden('the open debug console answers localhost only; open it as localhost')));
        }
        return .ok(Viewer('open', 'localhost'));
    }

    public function signIn() : json::Value
    {
        $o = json::object();
        $o['kind'] = json::str('open');
        return $o;
    }

    public function check(nexus::Kernel $kernel) : status<nexus::BootError>
    {
        if ($kernel->mode == nexus::Mode::prod) {
            return .error(.extension('nexus-debug', 'the open debug console is for dev; set NEXUS_DEBUG_TOKEN or pass a gate'));
        }
        return .ok;
    }
}
