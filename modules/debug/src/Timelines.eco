namespace nexus::debug;

use std::thread;

/**
 * The timelines of the last requests, by request id, for the request sheet's Timeline tab: a fixed
 * number of slots, a new one past the size taking the oldest one's place. Kept apart from the
 * `requests` topic so the live feed stays small.
 */
#[atomic]
public class Timelines
{
    public const usize $size;
    private thread::mutex<Shelf> $shelf = thread::mutex<Shelf>(Shelf());

    public constructor(usize $size)
    {
        usize $n = $size;
        if ($n == 0) {
            $n = 1;
        }
        $this->size = $n;
    }

    /**
     * Keeps `$data`, a JSON document, as request `$id`'s timeline.
     */
    public function put(const string& $id, string $data) : void
    {
        thread::locked<Shelf> $held = $this->shelf->lock();
        $k = Kept($id, mv $data);
        if ($held->value->slots->count() < $this->size) {
            $held->value->slots[] = mv $k;
            return;
        }
        $held->value->slots[$held->value->next] = mv $k;
        $held->value->next = ($held->value->next + 1) % $this->size;
    }

    /**
     * Request `$id`'s timeline as it was kept, or null when it is unknown or was pushed out.
     */
    public const function find(const string& $id) : string?
    {
        thread::locked<Shelf> $held = $this->shelf->lock();
        foreach ($held->value->slots as const &$k) {
            if ($k->id == $id) {
                return $k->data;
            }
        }
        return null;
    }
}

internal struct Kept
{
    public string $id;
    public string $data;
}

// the kept timelines and the slot the next one overwrites once all are taken
internal struct Shelf
{
    public array<Kept> $slots = [];
    public usize $next = 0;
}
