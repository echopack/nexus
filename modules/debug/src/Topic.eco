namespace nexus::debug;

use std::thread;
use std::time;

/**
 * A live feed of the console: the log, the requests, the jobs. Whatever has something to tell
 * publishes a record to it, or a JSON object; readers follow it as server-sent events (`follow`)
 * or ask for what came after the last event they saw.
 */
#[atomic]
public class Topic
{
    public const string $name;
    public const string $title;
    public Ring $ring;

    // the event streams following the topic, and how many there are: a publish hands its event
    // to the sender only when somebody follows
    private nexus::EventStreams $streams = nexus::EventStreams();
    private atomic<int64> $followers = atomic<int64>(0);

    // the topic's own thread: it encodes each event and hands it to the streams, so the thread
    // that published it (a request, a log call) never pays for the encoding
    private nexus::Mailbox<TopicJob> $mail;

    // held across a publish and across a follow's catch up, so a follower gets every event once
    private thread::mutex<bool> $gate = thread::mutex<bool>(false);

    public constructor(const string& $name, const string& $title, usize $keep)
    {
        $this->name = $name;
        $this->title = $title;
        $this->ring = Ring($keep);
        $sender = TopicSender($name, $this->streams);
        $this->mail = nexus::Mailbox<TopicJob>(function[$sender](TopicJob $job) : void {
            $sender->run($job);
        });
    }

    /**
     * Adds an event with `$data`, encoded now; answers its number.
     */
    public function publish(const json::Value& $data) : uint64
    {
        return $this->publish(Encoded(json::dump($data)));
    }

    /**
     * Adds an event saying `$record`, encoded when someone reads it; answers its number. What a
     * busy publisher uses, a request or a log line.
     */
    public function publish(Record $record) : uint64
    {
        thread::locked<bool> $held = $this->gate->lock();
        Event $e = $this->ring->publish($record);
        if ($this->followers->load() > 0) {
            $this->mail->put(TopicJob::publish($e));
        }
        return $e->seq;
    }

    /**
     * Sends `$s` every kept event after number `$after` (at most `$limit`), then each new one as it
     * is published, until it ends. A stream opened with credential `$who` is ended when that
     * credential ends (`end`); one with a `$life` is ended before the first event after it went
     * by, so its client comes back through the gate.
     */
    public function follow(nexus::EventStream $s, uint64 $after, usize $limit, nexus::auth::Identity? $who = null, time::duration $life = time::duration::zero()) : void
    {
        thread::locked<bool> $held = $this->gate->lock();
        $this->followers->add(1);
        $this->mail->put(TopicJob::join($s, $this->ring->since($after, $limit), Follower($s, $who, $life, time::instant::now())));
    }

    /**
     * Ends the streams following the topic that were opened with a credential `$e` covers.
     */
    public function end(const nexus::auth::Ending& $e) : void
    {
        $this->mail->put(TopicJob::end($e));
    }

    /**
     * Stops sending to `$s`; its stream's close hook calls this.
     */
    public function unfollow(nexus::EventStream $s) : void
    {
        thread::locked<bool> $held = $this->gate->lock();
        $this->followers->sub(1);
        $this->mail->put(TopicJob::leave($s));
    }

    /**
     * How many streams follow the topic.
     */
    public function following() : int64
    {
        return $this->followers->load();
    }

    /**
     * Waits until every event published so far went out to the followers.
     */
    public function settle() : void
    {
        $this->mail->settle();
        $this->streams->settle();
    }
}

internal enum TopicJob
{
    case publish(Event $e);
    case join(nexus::EventStream $stream, array<Event> $backlog, Follower $follower);
    case leave(nexus::EventStream $stream);
    case end(nexus::auth::Ending $ending);
}

/**
 * A stream following a topic: who opened it and since when, so it ends with their credential or
 * once its life went by.
 */
internal struct Follower
{
    public nexus::EventStream $stream;
    public nexus::auth::Identity? $who;
    public time::duration $life;
    public time::instant $since;

    public const function expired() : bool
    {
        return $this->life > time::duration::zero() && $this->since->elapsed() >= $this->life;
    }

    public const function covered(const nexus::auth::Ending& $e) : bool
    {
        nexus::auth::Identity $id = guard $this->who else {
            return false;
        };
        return $e->covers($id);
    }
}

/**
 * What a topic's thread works on: it encodes events and hands them to the streams, in the order
 * the topic put them, and ends the streams whose credential ended or whose life went by.
 */
#[atomic]
internal class TopicSender
{
    private string $name;
    private nexus::EventStreams $streams;

    // the streams following, by id; only the topic's thread touches it
    private map<int64, Follower> $followers = [];

    public constructor(const string& $name, nexus::EventStreams $streams)
    {
        $this->name = $name;
        $this->streams = $streams;
    }

    public function run(TopicJob $job) : void
    {
        match ($job) {
            TopicJob::publish($e) => {
                // a stream past its life gets nothing more; its client comes back through the gate
                $this->endWhere(function(const Follower& $f) : bool {
                    return $f->expired();
                });
                $this->streams->publish($this->event($e));
            },
            TopicJob::join($s, $backlog, $follower) => {
                $this->followers[$s->id()] = $follower;
                array<nexus::ServerEvent> $encoded = [];
                foreach ($backlog as const &$e) {
                    $encoded[] = $this->event($e);
                }
                $this->streams->join($s, mv $encoded);
            },
            TopicJob::leave($s) => {
                $this->followers->remove($s->id());
                $this->streams->remove($s);
            },
            TopicJob::end($ending) => {
                $this->endWhere(function[$ending](const Follower& $f) : bool {
                    return $f->covered($ending);
                });
            },
        }
    }

    // closes and forgets the streams `$ends` picks
    private function endWhere(function<bool(const Follower&)> $ends) : void
    {
        array<int64> $gone = [];
        foreach ($this->followers as $id => const &$f) {
            if ($ends($f)) {
                $gone[] = $id;
                $this->streams->close($f->stream);
            }
        }
        foreach ($gone as const &$id) {
            $this->followers->remove($id);
        }
    }

    /**
     * `$e` as a server-sent event: its number as the id, the topic as the name.
     */
    private const function event(const Event& $e) : nexus::ServerEvent
    {
        return nexus::ServerEvent($e->json(), $event: $this->name, $id: "{$e->seq}");
    }
}
