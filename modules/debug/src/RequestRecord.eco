namespace nexus::debug;

/**
 * One answered request as the `requests` topic keeps it: what the request and its answer said, the
 * timeline it was traced on and what it logged. Copied out of the request when it is answered and
 * encoded only when the console reads it, as a row of the request tables (`json`) or as the
 * request's timeline (`detail`).
 */
#[atomic]
public class RequestRecord : Record
{
    public const string $id;
    public const string $method;
    public const string $target;
    public const string $path;
    public const string $peer;
    public const string $action;
    public const int64 $status;
    public const float64 $ms;
    public const nexus::Headers $headers;
    public const nexus::Headers $responseHeaders;
    public const nexus::trace::Trace $trace;
    public const Capture $logs;

    public constructor(const nexus::Request& $req, const nexus::Response& $res, const string& $action, float64 $ms, nexus::trace::Trace $trace, Capture $logs)
    {
        $this->id = $req->id;
        $this->method = $req->method->verb();
        $this->target = RequestRecord::scrubbed($req->target);
        $this->path = $req->path;
        $this->peer = $req->peer;
        $this->action = $action;
        $this->status = $res->status as int64;
        $this->ms = $ms;
        $this->headers = $req->headers;
        $this->responseHeaders = $res->headers;
        $this->trace = $trace;
        $this->logs = $logs;
    }

    /**
     * The row: the summary, the path and peer, the headers with their credentials masked and what
     * the request logged.
     */
    public const function json() : json::Value
    {
        json::Value $logs = $this->logs->json();
        $o = $this->summary();
        $o['path'] = json::str($this->path);
        $o['peer'] = json::str($this->peer);
        $o['headers'] = RequestRecord::masked($this->headers);
        $o['responseHeaders'] = RequestRecord::masked($this->responseHeaders);
        $o['logs'] = mv $logs;
        uint64 $dropped = $this->logs->dropped();
        if ($dropped > 0) {
            $o['logsDropped'] = json::int($dropped as int64);
        }
        return $o;
    }

    public const function key() : string
    {
        return $this->id;
    }

    /**
     * The timeline: the summary, the trace's marks and the logs, for the request sheet's Timeline
     * tab.
     */
    public const function detail() : json::Value?
    {
        $doc = json::object();
        $doc['request'] = $this->summary();
        $doc['timeline'] = $this->trace->json();
        $doc['logs'] = $this->logs->json();
        return $doc;
    }

    // what the row and the timeline both start with
    private const function summary() : json::Value
    {
        nexus::trace::Tally $db = $this->trace->sum(.query);
        $o = json::object();
        $o['id'] = json::str($this->id);
        $o['method'] = json::str($this->method);
        $o['target'] = json::str($this->target);
        $o['status'] = json::int($this->status);
        $o['ms'] = json::float($this->ms);
        $o['action'] = json::str($this->action);
        $o['queries'] = json::int($db->count as int64);
        $o['dbMs'] = json::float($db->ms);
        return $o;
    }

    /**
     * `$h` as an object of name to value, a credential replaced by `***`: a header that carries
     * one whole, or a query parameter that carries one in a header whose value is a URL (a
     * redirect to a presigned S3 link, the page a request came from).
     */
    public static function masked(const nexus::Headers& $h) : json::Value
    {
        $o = json::object();
        foreach ($h->items as const &$item) {
            string $value = $item->value;
            if (RequestRecord::secret($item->name)) {
                $value = '***';
            } else if (RequestRecord::linked($item->name)) {
                $value = RequestRecord::scrubbed($value);
            }
            $o[$item->name] = json::str($value);
        }
        return $o;
    }

    /**
     * `$target` with the value of every query parameter that carries a credential replaced by
     * `***`: signed file links, sign in codes and states, socket tickets.
     */
    public static function scrubbed(const string& $target) : string
    {
        usize $q = $target->find('?');
        if ($q == $target->size()) {
            return $target;
        }
        string $out = $target->sub(0, $q + 1)->clone();
        $pieces = str::split($target->sub($q + 1, $target->size() - $q - 1), '&')->owned();
        usize $i = 0;
        foreach ($pieces as const &$piece) {
            if ($i > 0) {
                $out->push(38);
            }
            $i = $i + 1;
            usize $eq = $piece->find('=');
            if ($eq < $piece->size() && RequestRecord::secretParam($piece->sub(0, $eq)->clone())) {
                $out->append($piece->sub(0, $eq + 1));
                $out->append('***');
            } else {
                $out->append($piece);
            }
        }
        return $out;
    }

    /**
     * Whether a query parameter carries a credential: one of the names signed links, sign ins and
     * sockets use, or any name with `token`, `secret`, `signature`, `password` or `credential` in
     * it, any case.
     */
    public static function secretParam(const string& $name) : bool
    {
        string $n = str::lower($name);
        array<string> $secret = ['sig', 'code', 'state', 'key', 'ticket', 'api_key', 'apikey', 'x-amz-signature', 'x-amz-credential', 'x-goog-signature', 'x-goog-credential'];
        foreach ($secret as const &$s) {
            if ($n == $s) {
                return true;
            }
        }
        return RequestRecord::mentions($n, ['token', 'secret', 'signature', 'password', 'credential']);
    }

    /**
     * Whether a header carries a credential: the ones that always do (`Authorization`, `Cookie`,
     * `X-Api-Key`, ...), and any name with `token`, `secret`, `api-key`, `apikey` or `password` in
     * it, any case (`X-Auth-Token`, `X-Amz-Security-Token`, `X-Client-Secret`).
     */
    public static function secret(const string& $name) : bool
    {
        string $n = str::lower($name);
        if ($n == 'authorization' || $n == 'proxy-authorization' || $n == 'cookie' || $n == 'set-cookie' || $n == 'x-accesstoken') {
            return true;
        }
        return RequestRecord::mentions($n, ['token', 'secret', 'api-key', 'apikey', 'password']);
    }

    /**
     * Whether a header's value is a URL, whose query may carry a credential: `Location`,
     * `Content-Location`, `Referer`, `Refresh`.
     */
    public static function linked(const string& $name) : bool
    {
        string $n = str::lower($name);
        return $n == 'location' || $n == 'content-location' || $n == 'referer' || $n == 'refresh';
    }

    // whether `$name`, lower case already, has one of `$parts` in it
    private static function mentions(const string& $name, const array<string>& $parts) : bool
    {
        foreach ($parts as const &$p) {
            if ($name->find($p) < $name->size()) {
                return true;
            }
        }
        return false;
    }
}
