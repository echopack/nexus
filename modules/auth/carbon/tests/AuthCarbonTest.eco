/**
 * nexus-auth's stores in a carbon database, on carbon's fake driver: each test queues what the
 * database answers and reads back what was sent.
 */

use nexus::auth::{Identity, Guards, Tokens, Sessions, Issued, Opened, Pruning, Pruned};
use nexus::auth::carbon::{AuthToken, AuthTokenTable, AuthSession, AuthSessionTable};
use nexus::testing::TestApp;
use carbon::fake;
use hydrahon::Mysql;
use std::time;
use ecotest::expect;

internal const KEY = 'a-test-key-of-at-least-thirty-two-chars';
internal const START = 1700000000;

internal class Rig
{
    public fake::Driver<Mysql> $fake;
    public calendar::ManualClock $clock;
    public TestApp $app;

    public constructor(bool $register)
    {
        $driver = fake::Driver<Mysql>();
        $clock = calendar::ManualClock(time::timestamp::from_unix_secs(START));
        $this->fake = $driver;
        $this->clock = $clock;
        $db = nexus::carbon::Extension(function[$driver, $clock, $register](nexus::carbon::DatabaseConfig $cfg) : result<carbon::DB, carbon::Error> {
            $made = carbon::DB($driver, clock: $clock);
            if ($register) {
                try nexus::auth::carbon::Tables::wire($made);
            }
            return .ok($made);
        });
        array<nexus::Extension> $exts = [$db, nexus::auth::Extension('t', stores: .provided, clock: $clock, cost: crypto::PasswordCost(8, 1)), nexus::auth::carbon::Extension()];
        map<string, string> $vars = ['NEXUS_AUTH_KEY' => KEY, 'NEXUS_AUTH_SESSIONS' => '2h'];
        $this->app = TestApp($exts, $vars);
    }

    public function payload(nexus::Request $req) : nexus::Payload
    {
        return nexus::Payload($request: mv $req, $services: $this->app->kernel->services->child(), $mode: .testing, $log: nexus::Logger([], .info));
    }

    public function get() : nexus::Payload
    {
        return $this->payload(nexus::Request(.get, '/'));
    }

    public function with(const string& $name, const string& $value) : nexus::Payload
    {
        $req = nexus::Request(.get, '/');
        $req->headers->set($name, $value);
        return $this->payload(mv $req);
    }
}

internal function subject(nexus::Payload& $payload) : string
{
    Identity? $found = guard $payload->get<Guards>()->identify($payload) else ($p) {
        return "{$p->status()}";
    };
    Identity $id = guard $found else {
        return '401';
    };
    return "{$id->via}:{$id->subject}";
}

test issuing_a_token_inserts_its_hash
{
    $r = Rig(true);
    $r->fake->written();
    nexus::Payload $payload = $r->get();
    Issued $t = guard $payload->get<Tokens>()->issue('7', 'laptop');
    expect($r->fake->last())->starts('INSERT INTO `auth_tokens`');
    expect($r->fake->count())->is(1);
    expect($r->fake->last())->lacks($t->token);
}

test a_token_is_found_by_its_id
{
    $r = Rig(true);
    $r->fake->written();
    Issued $t = guard $r->get()->get<Tokens>()->issue('7');
    $r->fake->rows([AuthTokenTable()->row(.of($t->stored))]);
    expect(subject($r->with('Authorization', "Bearer {$t->token}")))->is('bearer:7');
    expect($r->fake->last())->has('FROM `auth_tokens` WHERE `auth_tokens`.`id` = ?');
    $r->fake->rows([]);
    expect(subject($r->with('Authorization', "Bearer {$t->token}")))->is('401');
}

test revoking_deletes_the_row
{
    $r = Rig(true);
    $r->fake->written()->written();
    nexus::Payload $payload = $r->get();
    guard $payload->get<Tokens>()->revoke('abcdefabcdef');
    expect($r->fake->last())->is('DELETE FROM `auth_tokens` WHERE `auth_tokens`.`id` = ?');
    guard $payload->get<Tokens>()->revokeAll('7');
    expect($r->fake->last())->is('DELETE FROM `auth_tokens` WHERE `auth_tokens`.`subject` = ?');
}

test a_signed_session_is_stored_and_slides
{
    $r = Rig(true);
    $r->fake->written();
    Opened $o = guard $r->get()->get<Sessions>()->open('7');
    expect($r->fake->last())->starts('INSERT INTO `auth_sessions`');
    expect($r->fake->last())->lacks($o->secret);
    $r->clock->advance(.mins(30));
    $r->fake->rows([AuthSessionTable()->row(.of($o->stored))])->written();
    string $auth = $o->signer()->header('GET', '/', $r->clock->now()->unix_secs(), '');
    expect(subject($r->with('Authorization', $auth)))->is('signed:7');
    expect($r->fake->last())->starts('UPDATE `auth_sessions` SET `expires_at` = ?');
    // a forged signature never reaches the database
    usize $before = $r->fake->count();
    $forged = nexus::auth::Signer($o->stored->id, 'guess');
    expect(subject($r->with('Authorization', $forged->header('GET', '/', $r->clock->now()->unix_secs(), ''))))->is('401');
    expect($r->fake->count())->is($before);
}

test signing_in_on_a_session_for_nobody_writes_the_subject
{
    $r = Rig(true);
    $r->fake->written();
    Opened $o = guard $r->get()->get<Sessions>()->open();
    expect($o->stored->subject)->none();
    $r->fake->written(1);
    usize $before = $r->fake->count();
    guard $r->get()->get<Sessions>()->attach($o->stored->id, '7');
    expect($r->fake->count())->is($before + 1);
    expect($r->fake->last())->is('UPDATE `auth_sessions` SET `subject` = ?, `expires_at` = ? WHERE `auth_sessions`.`id` = ? AND `auth_sessions`.`subject` IS NULL AND `auth_sessions`.`expires_at` > ?');
    // nothing changed: one read says why
    nexus::auth::StoredSession $taken = $o->stored;
    $taken->subject = '8';
    $r->fake->written(0)->rows([AuthSessionTable()->row(.of($taken))]);
    status<nexus::Problem> $again = $r->get()->get<Sessions>()->attach($o->stored->id, '7');
    guard $again else ($p) {
        expect($p->status())->is(409);
        return;
    };
    die('signing in on a taken session worked');
}

test prune_deletes_what_expired
{
    $r = Rig(true);
    $r->fake->written(3)->written(1);
    nexus::Payload $payload = $r->get();
    array<Pruned> $done = guard $payload->get<Pruning>()->run($payload);
    expect($done[0]->count)->is(3);
    expect($done[1]->count)->is(1);
    array<string> $texts = $r->fake->texts();
    expect($texts[$texts->count() - 2])->is('DELETE FROM `auth_tokens` WHERE `auth_tokens`.`expires_at` < ?');
    expect($r->fake->last())->is('DELETE FROM `auth_sessions` WHERE `auth_sessions`.`expires_at` < ?');
}

test boot_wants_the_repositories_registered
{
    $driver = fake::Driver<Mysql>();
    $db = nexus::carbon::Extension(function[$driver](nexus::carbon::DatabaseConfig $cfg) : result<carbon::DB, carbon::Error> {
        return .ok(carbon::DB($driver));
    });
    array<nexus::Extension> $exts = [$db, nexus::auth::Extension('t', stores: .provided, cost: crypto::PasswordCost(8, 1)), nexus::auth::carbon::Extension()];
    map<string, string> $vars = ['NEXUS_AUTH_KEY' => KEY];
    nexus::BootError $e = expect(TestApp::attempt($exts, $vars))->fails();
    expect(str::join($e->lines(), ';'))->has('Tables::wire');
}
