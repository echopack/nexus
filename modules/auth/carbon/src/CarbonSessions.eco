namespace nexus::auth::carbon;

use std::time;

/**
 * Signed sessions in `auth_sessions`, through a request's carbon session.
 */
public class CarbonSessions : nexus::auth::SessionStore
{
    internal carbon::Session $session;

    public constructor(carbon::Session $session)
    {
        $this->session = $session;
    }

    public function find(const string& $id) : result<nexus::auth::StoredSession?, nexus::Problem>
    {
        AuthSessionRepository $repo = try $this->repo();
        AuthSession? $found = try $repo->find()->get($id);
        if ($found == null) {
            return .ok(null);
        }
        AuthSession $s = guard $found;
        return .ok($s->stored());
    }

    public function create(const nexus::auth::StoredSession& $session) : status<nexus::Problem>
    {
        AuthSessionRepository $repo = try $this->repo();
        try $repo->create(.of($session));
        return .ok;
    }

    public function touch(const string& $id, time::timestamp $expiresAt) : status<nexus::Problem>
    {
        AuthSessionRepository $repo = try $this->repo();
        $set = hydrahon::Values();
        $set[AuthSessionTable::$expiresAt] = $expiresAt;
        try $repo->find()->where(AuthSessionTable::$id == $id)->update($set);
        return .ok;
    }

    public function claim(const string& $id, const string& $subject, time::timestamp $now, time::timestamp $expiresAt) : result<bool, nexus::Problem>
    {
        AuthSessionRepository $repo = try $this->repo();
        $set = hydrahon::Values();
        $set[AuthSessionTable::$subject] = $subject;
        $set[AuthSessionTable::$expiresAt] = $expiresAt;
        uint64 $n = try $repo->find()
            ->where(AuthSessionTable::$id == $id)
            ->where(AuthSessionTable::$subject->isNull())
            ->where(AuthSessionTable::$expiresAt > $now)
            ->update($set);
        return .ok($n == 1);
    }

    public function remove(const string& $id) : status<nexus::Problem>
    {
        AuthSessionRepository $repo = try $this->repo();
        try $repo->find()->where(AuthSessionTable::$id == $id)->purge();
        return .ok;
    }

    public function removeAll(const string& $subject) : status<nexus::Problem>
    {
        AuthSessionRepository $repo = try $this->repo();
        try $repo->find()->where(AuthSessionTable::$subject == $subject)->purge();
        return .ok;
    }

    public function prune(std::time::timestamp $now) : result<uint64, nexus::Problem>
    {
        AuthSessionRepository $repo = try $this->repo();
        uint64 $gone = try $repo->find()->where(AuthSessionTable::$expiresAt < $now)->purge();
        return .ok($gone);
    }

    internal function repo() : result<AuthSessionRepository, nexus::Problem>
    {
        AuthSessionRepository $repo = try $this->session->repo<AuthSessionRepository>();
        return .ok($repo);
    }
}
