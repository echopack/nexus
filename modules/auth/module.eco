/*
 * nexus-auth: who is calling a nexus app.
 *
 * Guards read a request's credential and name its caller: prefixed bearer
 * tokens, kept as a hash, and signed sessions, where every request carries
 * an HMAC of itself under a secret the server derives and never stores.
 * A client opens a session for nobody first and signs everything with it;
 * signing in puts the user on that session. Middleware asks the guards:
 * `RequireSession` lets through only requests with a session (anonymous
 * too), `Authenticate` only signed in callers, leaving their `Identity` in
 * the payload, an app's own middleware loads its user on top. The action names the middleware in
 * `#[nexus::through]` and reads what it left with `$payload->state<T>()`.
 * Passwords are Argon2id, checked against a decoy when the account is
 * unknown, and logins are throttled per address and per account.
 *
 * `Resources` are the parts of the app OAuth clients get tokens for (the
 * MCP endpoint, a public API), each with its metadata (RFC 9728). A token
 * issued for one resource opens that resource only; the app's own tokens
 * and sessions open everything. `Pruning` gathers every auth store that
 * expires, for one `auth:prune`.
 *
 * The stores here keep tokens and sessions in memory; nexus-auth-carbon
 * keeps them in the app's database.
 */

#[module: "nexus-auth"]
#[version: "0.1.0"]
#[epm::license: "MIT"]
#[epm::description: "Bearer tokens, signed sessions, passwords and login throttling for nexus apps"]

#[depends: "../.."]
#[requires: "echopack/container" { version: "^0.1.0", source: git "https://github.com/echopack/container" }]
#[requires: "echolang/libjson" { version: "^0.3.0", source: git "https://github.com/echolang/libjson" }]
#[requires: "echolang/libcrypto" { version: "^0.3.3", source: git "https://github.com/echolang/libcrypto" }]
#[requires: "echopack/calendar" { version: "^0.1.2", source: git "https://github.com/echopack/calendar" }]

#[hook: before_build { run: "nexus", args: ["gen"] }]

#[sources: "src/*.eco"]
#[if: !NEXUS_NOGEN]
#[sources: ".nexus/*.eco"]
#[end]

#[target: test] {
    #[depends: "../testing"]
    #[sources: "tests/*.eco"]
}
