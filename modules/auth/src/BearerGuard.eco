namespace nexus::auth;

/**
 * Reads `Authorization: Bearer <prefix>_<id>_<secret>`. A bearer token in another shape (another
 * prefix) is left to the guards after it; when none claims it, the request has no credential.
 */
#[atomic]
public class BearerGuard : Guard
{
    public const string NAME = 'bearer';

    public function name() : string
    {
        return BearerGuard::NAME;
    }

    /**
     * The token of `Authorization: Bearer <token>`, or null when `$request` carries none.
     */
    public static function token(const nexus::Request& $request) : string?
    {
        string $header = guard $request->header('Authorization') else {
            return null;
        };
        if ($header->size() < 7 || str::lower($header->sub(0, 7)->clone()) != 'bearer ') {
            return null;
        }
        return str::trim($header->sub(7, $header->size() - 7)->clone());
    }

    public function identify(nexus::Payload& $payload) : result<Identity?, nexus::Problem>
    {
        string $text = guard BearerGuard::token($payload->request) else {
            return .ok(null);
        };
        Tokens $tokens = $payload->get<Tokens>();
        if (Token::parse($tokens->prefix, $text) == null) {
            return .ok(null);
        }
        Identity $id = try $tokens->check($text);
        return .ok($id);
    }

    public function holds(nexus::Payload& $payload, const Identity& $id) : result<bool, nexus::Problem>
    {
        return $payload->get<Tokens>()->holds($id->credential, $id->subject);
    }

    public function revoke(nexus::Payload& $payload, const Identity& $id) : status<nexus::Problem>
    {
        return $payload->get<Tokens>()->revoke($id->credential);
    }
}
