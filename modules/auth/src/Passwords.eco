namespace nexus::auth;

/**
 * Argon2id password hashes, in the PHC string format every Argon2 implementation reads. Holds a
 * decoy hash so a login for an unknown account costs as long as one for a known account.
 */
#[atomic]
public class Passwords
{
    public const crypto::PasswordCost $cost;

    /**
     * The shortest and the longest password accepted, in bytes.
     */
    public const usize $min;
    public const usize $max;
    internal const string $decoy;

    public constructor(crypto::PasswordCost $cost = .standard(), usize $min = 10, usize $max = 200)
    {
        $this->cost = $cost;
        $this->min = $min;
        $this->max = $max;
        string $decoy = guard crypto::hashPassword(Secrets::hex(16), $cost) else {
            die('nexus-auth: the decoy password hash failed');
        };
        $this->decoy = $decoy;
    }

    /**
     * The hash to store for `$plain`.
     */
    public const function hash(const string& $plain) : result<string, nexus::Problem>
    {
        string $h = guard crypto::hashPassword($plain, $this->cost) else {
            return .error(.server('hashing a password failed'));
        };
        return .ok($h);
    }

    /**
     * Whether `$plain` is the password `$encoded` was made from.
     */
    public const function verify(const string& $plain, const string& $encoded) : bool
    {
        return crypto::verifyPassword($plain, $encoded);
    }

    /**
     * Checks `$plain` against the decoy and says no: for an account that does not exist, so the
     * answer takes as long as for one that does.
     */
    public const function decoy(const string& $plain) : bool
    {
        crypto::verifyPassword($plain, $this->decoy);
        return false;
    }

    /**
     * Whether `$encoded` was made at another cost: hash the password again after a login that went
     * well.
     */
    public const function needsRehash(const string& $encoded) : bool
    {
        return crypto::needsRehash($encoded, $this->cost);
    }

    /**
     * A 422 on `$field` when `$plain` is too short or too long.
     */
    public const function acceptable(const string& $plain, const string& $field = 'password') : status<nexus::Problem>
    {
        if ($plain->size() < $this->min) {
            return .error(.field($field, 'min', "a password has at least {$this->min} characters"));
        }
        if ($plain->size() > $this->max) {
            return .error(.field($field, 'max', "a password has at most {$this->max} characters"));
        }
        return .ok;
    }
}
