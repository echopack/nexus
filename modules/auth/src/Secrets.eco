namespace nexus::auth;

/**
 * Random hex from the operating system, and the check for it.
 */
public struct Secrets
{
    /**
     * `$bytes` random bytes as lowercase hex. A machine with no randomness to give cannot issue
     * credentials, so it stops the program.
     */
    public static function hex(usize $bytes) : string
    {
        string $raw = guard crypto::random($bytes) else {
            die('nexus-auth: the operating system has no randomness to give');
        };
        return crypto::hex($raw);
    }

    /**
     * Whether `$text` is all lowercase hex.
     */
    public static function isHex(const string& $text) : bool
    {
        foreach (0 .. $text->size() as $i) {
            uint8 $b = $text->byte($i);
            if (!(($b >= 48 && $b <= 57) || ($b >= 97 && $b <= 102))) {
                return false;
            }
        }
        return true;
    }

    /**
     * Whether `$prefix` can start a token: 1 to 16 lowercase letters and digits, so a token reads
     * as one word and a scanner can find it.
     */
    public static function isPrefix(const string& $prefix) : bool
    {
        if ($prefix->empty() || $prefix->size() > 16) {
            return false;
        }
        foreach (0 .. $prefix->size() as $i) {
            uint8 $b = $prefix->byte($i);
            if (!(($b >= 48 && $b <= 57) || ($b >= 97 && $b <= 122))) {
                return false;
            }
        }
        return true;
    }
}
