namespace nexus::auth;

use std::time;

/**
 * Password logins with their throttles, failures only: per client address (30 in 15 minutes), per
 * account from one address (10 in 15 minutes) and per account from everywhere (100 an hour). An
 * account is locked from one address long before a stranger elsewhere can lock its owner out.
 * Ask for it in the login action.
 *
 * ```echo
 * try $this->logins->attempt($payload, $in->email);
 * User? $found = ...;
 * User $u = guard $found else {
 *     return .error($this->logins->unknown($in->password));
 * };
 * try $this->logins->verify($payload, $in->email, $in->password, $u->passwordHash);
 * ```
 */
#[atomic]
public class Logins
{
    public const Passwords $passwords;
    public Throttle $peers;
    public Throttle $pairs;
    public Throttle $accounts;
    public calendar::Clock $clock;

    public constructor(Passwords $passwords, calendar::Clock $clock)
    {
        $this->passwords = $passwords;
        $this->clock = $clock;
        $this->peers = Throttle(30, .mins(15));
        $this->pairs = Throttle(10, .mins(15));
        $this->accounts = Throttle(100, .hours(1));
    }

    /**
     * Counts a login for `$account` from this request's address: a 429 when the address, the
     * account from it, or the account from everywhere has failed too often. Call it before looking the account up, so a flood never reaches the database.
     */
    public function attempt(nexus::Payload& $payload, const string& $account) : status<nexus::Problem>
    {
        time::timestamp $now = $this->clock->now();
        string $peer = $payload->request->peer;
        string $key = str::lower($account);
        string $pair = "{$key}\n{$peer}";
        if (!$this->peers->take($peer, $now)) {
            return .error(.tooMany($this->peers->wait($peer, $now)));
        }
        if (!$this->pairs->take($pair, $now)) {
            $this->peers->refund($peer);
            return .error(.tooMany($this->pairs->wait($pair, $now)));
        }
        if (!$this->accounts->take($key, $now)) {
            $this->peers->refund($peer);
            $this->pairs->refund($pair);
            return .error(.tooMany($this->accounts->wait($key, $now)));
        }
        return .ok;
    }

    /**
     * A 401 unless `$plain` is the password of `$encoded`; a login that went well gives its attempt
     * back.
     */
    public function verify(nexus::Payload& $payload, const string& $account, const string& $plain, const string& $encoded) : status<nexus::Problem>
    {
        if (!$this->passwords->verify($plain, $encoded)) {
            return .error(Logins::refused());
        }
        string $peer = $payload->request->peer;
        string $key = str::lower($account);
        $this->peers->refund($peer);
        $this->pairs->refund("{$key}\n{$peer}");
        $this->accounts->refund($key);
        return .ok;
    }

    /**
     * The answer for an account that does not exist, after the time a real check takes.
     */
    public const function unknown(const string& $plain) : nexus::Problem
    {
        $this->passwords->decoy($plain);
        return Logins::refused();
    }

    internal static function refused() : nexus::Problem
    {
        return .unauthorized('the email or the password is wrong', $reason: 'wrong_credentials');
    }
}
