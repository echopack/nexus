namespace nexus::auth;

use container::{Builder, Container};
use std::time;

/**
 * Who is calling the app. Binds `Guards` (the built-in ones `guards` names, then `extra`, then those
 * other extensions add), the `Authenticate` middleware, `Resources` (the parts of the app OAuth
 * clients get tokens for), `Pruning` and `auth:prune`, `Tokens` and `Sessions` per request on the
 * stores, `Passwords` and `Logins`. `NEXUS_AUTH_KEY` must be set: signed session secrets are derived
 * from it.
 *
 * ```echo
 * nexus::Kernel::main([
 *     nexus::http::Extension(),
 *     nexus::auth::Extension('blog'),
 *     blog::App(),
 * ]);
 * ```
 *
 * `$prefix` starts every token (`blog_3f9a1c2e5d7b_...`). With `stores: .provided` another
 * extension binds `TokenStore` and `SessionStore`; `guards: [.bearer]` takes bearer tokens only;
 * `compat: true` also accepts `X-AccessToken` signatures.
 */
public class Extension : nexus::Extension
{
    public const string $prefix;
    public const Stores $stores;
    public const bool $compat;
    public calendar::Clock $clock;
    public const crypto::PasswordCost $cost;
    public array<BuiltinGuard> $builtin;
    public array<Guard> $extra;

    /**
     * How far a signed request's time may be from the server's.
     */
    public time::duration $window;

    public constructor(
        const string& $prefix,
        stores: Stores $stores = .memory,
        compat: bool $compat = false,
        clock: calendar::Clock $clock = calendar::SystemClock(),
        cost: crypto::PasswordCost $cost = .standard(),
        guards: array<BuiltinGuard> $guards = [BuiltinGuard::signed, BuiltinGuard::bearer],
        extra: array<Guard> $extra = array<Guard>()
    )
    {
        $this->prefix = $prefix;
        $this->stores = $stores;
        $this->compat = $compat;
        $this->clock = $clock;
        $this->cost = $cost;
        $this->builtin = mv $guards;
        $this->extra = mv $extra;
        $this->window = .mins(5);
    }

    public function name() : string
    {
        return 'nexus-auth';
    }

    public function services(nexus::Services& $s) : status<nexus::BootError>
    {
        AuthConfig $config = $s->get<AuthConfig>();
        if (!Secrets::isPrefix($this->prefix)) {
            return .error(.extension('nexus-auth', "the token prefix '{$this->prefix}' must be 1 to 16 lowercase letters and digits"));
        }
        if (Secrets::reserved($this->prefix)) {
            return .error(.extension('nexus-auth', "the token prefix '{$this->prefix}' is reserved for OAuth access and refresh tokens"));
        }
        if ($config->key->size() < 32) {
            return .error(.extension('nexus-auth', 'NEXUS_AUTH_KEY must be set, at least 32 characters: signed session secrets are derived from it'));
        }
        if ($this->stores == Stores::memory) {
            $s->bind<MemoryTokens>(put: MemoryTokens());
            $s->bind<MemorySessions>(put: MemorySessions());
            $s->alias<TokenStore, MemoryTokens>();
            $s->alias<SessionStore, MemorySessions>();
        }
        array<Guard> $all = [];
        foreach ($this->builtin as $b) {
            if ($b == BuiltinGuard::signed) {
                $all[] = SignedGuard($this->compat);
            }
            if ($b == BuiltinGuard::bearer) {
                $all[] = BearerGuard();
            }
        }
        foreach ($this->extra as const &$g) {
            $all[] = $g;
        }
        $resources = Resources();
        $s->bind<Resources>(put: $resources);
        $s->bind<ResourceMetadata>(scope: function[$resources]() : ResourceMetadata {
            return ResourceMetadata($resources);
        });
        $guards = Guards(mv $all, $resources);
        $s->bind<Guards>(put: $guards);
        $s->bind<Authenticate>(put: Authenticate($guards));
        $pruning = Pruning($this->clock);
        $pruning->add('tokens', function(Container $c, time::timestamp $now) : result<uint64, nexus::Problem> {
            return $c->get<TokenStore>()->prune($now);
        });
        $pruning->add('sessions', function(Container $c, time::timestamp $now) : result<uint64, nexus::Problem> {
            return $c->get<SessionStore>()->prune($now);
        });
        $s->bind<Pruning>(put: $pruning);
        $passwords = Passwords($this->cost);
        $s->bind<Passwords>(put: $passwords);
        $s->bind<Logins>(put: Logins($passwords, $this->clock));
        string $prefix = $this->prefix;
        calendar::Clock $clock = $this->clock;
        time::duration $window = $this->window;
        $endings = Endings();
        $s->bind<Endings>(put: $endings);
        $s->bind<Tokens>(scope: function[$prefix, $config, $clock, $endings](Container $c) : Tokens {
            return Tokens($c->get<TokenStore>(), $prefix, $config->tokens, $clock, $endings);
        });
        $s->bind<Sessions>(scope: function[$config, $clock, $window, $endings](Container $c) : Sessions {
            return Sessions($c->get<SessionStore>(), $config->key, $config->sessions, $config->guests, $window, $clock, $endings);
        });
        return .ok;
    }

    public function commands(nexus::Commands& $cmds) : void
    {
        $cmds->add(PruneCommand());
    }

    public function boot(nexus::Kernel $kernel) : status<nexus::BootError>
    {
        Resources $resources = $kernel->services->get<Resources>();
        if (!$resources->all()->empty() && $resources->issued()) {
            try $kernel->needsOrigin('nexus-auth', 'the resource URLs and the metadata a 401 points clients to');
        }
        return .ok;
    }
}
