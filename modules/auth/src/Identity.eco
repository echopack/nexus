namespace nexus::auth;

/**
 * Who a request's credential names: the subject the token or session was issued to (a user id, as
 * text), the guard that read it (`via`), the credential's own id (to revoke it), the scopes it
 * carries, and for a token an OAuth client holds, the resource it was issued for (`audience`) and
 * the client (`client`). `Authenticate` leaves it in the payload, and an app's middleware builds its user on it:
 *
 * ```echo
 * public function handle(nexus::Payload& $payload, nexus::Next $next) : nexus::Response
 * {
 *     nexus::auth::Identity? $found = guard $this->guards->identify($payload) else ($p) {
 *         return $payload->fail($p);
 *     };
 *     nexus::auth::Identity $id = guard $found else {
 *         return $payload->fail(.unauthorized('this needs a signed in caller', $reason: 'signed_in_required'));
 *     };
 *     int64 $key = guard $id->number() else { ... };
 *     User? $user = guard $this->users->find()->get($key) else { ... };
 *     ...
 *     $payload->put<Caller>(Caller($id, $user));
 *     return $next->run($payload);
 * }
 * ```
 */
public struct Identity
{
    public string $via;

    /**
     * Who the credential names; empty for a guest.
     */
    public string $subject;
    public string $credential;
    public array<string> $scopes = [];

    /**
     * The resource the credential was issued for (`Resource::name`); empty for the app's own tokens
     * and sessions, which open every part of it.
     */
    public string $audience = '';

    /**
     * The OAuth client that holds the credential; empty for the app's own.
     */
    public string $client = '';

    /**
     * Whether the credential is a session nobody signed in on yet.
     */
    public bool $guest = false;

    /**
     * Whether the credential names nobody: a session the client opened before signing in.
     */
    public const function anonymous() : bool
    {
        return $this->guest;
    }

    /**
     * The subject as a number, for apps that key users by an integer id.
     */
    public const function number() : int64?
    {
        return str::int($this->subject);
    }

    /**
     * Whether the app issued the credential to its own frontend or command line, not to an OAuth
     * client for one resource.
     */
    public const function firstParty() : bool
    {
        return $this->audience->empty();
    }

    /**
     * Whether the credential carries `$scope`. One the app issued without scopes carries every
     * one; a token an OAuth client holds carries what it was granted; a session for nobody carries
     * none.
     */
    public const function has(const string& $scope) : bool
    {
        if ($this->anonymous()) {
            return false;
        }
        if ($this->scopes->empty() && $this->firstParty()) {
            return true;
        }
        foreach ($this->scopes as const &$s) {
            if ($s == $scope) {
                return true;
            }
        }
        return false;
    }

    /**
     * A 403 unless the credential carries `$scope`.
     */
    public const function require(const string& $scope) : status<nexus::Problem>
    {
        if (!$this->has($scope)) {
            return .error(.forbidden("this needs the {$scope} scope"));
        }
        return .ok;
    }
}
