namespace nexus::auth;

use std::time;

/**
 * A signed session as its store keeps it. Its secret is not here: it is derived from the id and the
 * server's key whenever a request needs it.
 */
public struct StoredSession
{
    public string $id;
    public string $subject;
    public array<string> $scopes = array<string>();
    public time::timestamp $createdAt;

    /**
     * Moves forward as the session is used.
     */
    public time::timestamp $expiresAt;
}
