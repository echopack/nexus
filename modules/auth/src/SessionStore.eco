namespace nexus::auth;

use std::time;

/**
 * Where signed sessions are kept. `MemorySessions` keeps them in the process; nexus-auth-carbon
 * keeps them in the app's database.
 */
public interface SessionStore
{
    function find(const string& $id) : result<StoredSession?, nexus::Problem>;

    function create(const StoredSession& $session) : status<nexus::Problem>;

    /**
     * Moves the expiry of session `$id` to `$expiresAt`.
     */
    function touch(const string& $id, time::timestamp $expiresAt) : status<nexus::Problem>;

    /**
     * Puts `$subject` on session `$id` and moves its expiry to `$expiresAt`, for a sign in, but only
     * while nobody is on it and it has not expired by `$now`, in one step so two sign ins cannot
     * both win. Answers whether it did.
     */
    function claim(const string& $id, const string& $subject, time::timestamp $now, time::timestamp $expiresAt) : result<bool, nexus::Problem>;

    function remove(const string& $id) : status<nexus::Problem>;

    function removeAll(const string& $subject) : status<nexus::Problem>;

    /**
     * Removes the sessions that expired before `$now`, and says how many.
     */
    function prune(time::timestamp $now) : result<uint64, nexus::Problem>;
}
