namespace nexus::auth;

/**
 * What a signed request signs, and how. The text is the method, the target
 * as sent (path and query), the unix time in seconds and the hex sha256 of
 * the body, one per line:
 *
 * ```
 * POST
 * /v1/posts?draft=1
 * 1730540000
 * 9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
 * ```
 *
 * and the signature is the hex HMAC-SHA256 of that text under the
 * session's secret. The compat form is `METHOD:target:time`, without the
 * body, as older clients sign it.
 */
public struct Signature
{
    public static function text(const string& $method, const string& $target, int64 $time, const string& $body) : string
    {
        string $digest = crypto::hex(crypto::sha256($body));
        return "{$method}\n{$target}\n{$time}\n{$digest}";
    }

    public static function compat(const string& $method, const string& $target, int64 $time) : string
    {
        return "{$method}:{$target}:{$time}";
    }

    public static function sign(const string& $secret, const string& $text) : string
    {
        return crypto::hex(crypto::hmacSha256($secret, $text));
    }
}
