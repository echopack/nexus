namespace nexus::auth;

use std::time;

/**
 * Issues and revokes bearer tokens, on this request's `TokenStore`. Ask for it in an action's
 * constructor.
 *
 * ```echo
 * nexus::auth::Issued $t = try $this->tokens->issue("{$user->id}", name: 'cli');
 * ```
 */
public class Tokens
{
    public TokenStore $store;
    public const string $prefix;
    public const time::duration $lifetime;
    public calendar::Clock $clock;
    private Endings $endings;

    public constructor(TokenStore $store, const string& $prefix, time::duration $lifetime, calendar::Clock $clock, Endings $endings)
    {
        $this->store = $store;
        $this->endings = $endings;
        $this->prefix = $prefix;
        $this->lifetime = $lifetime;
        $this->clock = $clock;
    }

    /**
     * A new token for `$subject`, expiring after the configured lifetime (never, when that is
     * zero), with `$scopes` (none means all).
     */
    public function issue(const string& $subject, const string& $name = '', const array<string>& $scopes = array<string>()) : result<Issued, nexus::Problem>
    {
        $t = Token(fresh: $this->prefix);
        time::timestamp $now = $this->clock->now();
        $s = StoredToken($id: $t->id, $hash: $t->hash(), $subject: $subject, $name: $name, $scopes: $scopes, $createdAt: $now);
        if ($this->lifetime > time::duration::zero()) {
            $s->expiresAt = $now + $this->lifetime;
        }
        try $this->store->create($s);
        return .ok(Issued($t->text(), mv $s));
    }

    /**
     * Revokes token `$id`, and tells `Endings`.
     */
    public function revoke(const string& $id) : status<nexus::Problem>
    {
        try $this->store->remove($id);
        $this->endings->ended(Ending::credential(BearerGuard::NAME, $id));
        return .ok;
    }

    /**
     * Revokes every token of `$subject`, and tells `Endings`.
     */
    public function revokeAll(const string& $subject) : status<nexus::Problem>
    {
        try $this->store->removeAll($subject);
        $this->endings->ended(Ending::subject(BearerGuard::NAME, $subject));
        return .ok;
    }

    /**
     * Whether token `$id` is still stored, unexpired, for `$subject`.
     */
    public function holds(const string& $id, const string& $subject) : result<bool, nexus::Problem>
    {
        StoredToken? $found = try $this->store->find($id);
        StoredToken $s = guard $found else {
            return .ok(false);
        };
        return .ok(!$s->expired($this->clock->now()) && $s->subject == $subject);
    }

    /**
     * Who the token `$text` was issued to: a 401 for a token that is malformed, unknown, expired or
     * not the stored one.
     */
    public function check(const string& $text) : result<Identity, nexus::Problem>
    {
        Token $t = guard Token::parse($this->prefix, $text) else {
            return .error(.unauthorized('the token is not valid', $reason: 'token_invalid'));
        };
        StoredToken? $found = try $this->store->find($t->id);
        StoredToken $s = guard $found else {
            return .error(.unauthorized('the token is not valid', $reason: 'token_invalid'));
        };
        if (!$t->matches($s->hash) || $s->expired($this->clock->now())) {
            return .error(.unauthorized('the token is not valid', $reason: 'token_invalid'));
        }
        return .ok(Identity($via: BearerGuard::NAME, $subject: $s->subject, $credential: $s->id, $scopes: $s->scopes));
    }
}
