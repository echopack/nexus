namespace nexus::auth;

/**
 * Lets only signed in callers through: a 401 for anybody else, and for a credential that does not
 * hold. It leaves the caller's `Identity` for the action, which names it in `#[nexus::through]` and
 * reads it as state:
 *
 * ```echo
 * #[nexus::through: ["nexus::auth::Authenticate"]]
 * public class Logout : nexus::Action
 * {
 *     public function handle(nexus::Payload& $payload) : status<nexus::Problem>
 *     {
 *         $me = try $payload->state<nexus::auth::Identity>();
 *         ...
 *     }
 * }
 * ```
 *
 * A 401 under a protected resource points the client at the resource's metadata
 * (`Resources::challenge`). An app with users of its own writes a middleware like this one that
 * loads its user too, with the repository in its constructor.
 */
#[atomic]
public class Authenticate : nexus::Middleware
{
    private Guards $guards;

    public constructor(Guards $guards)
    {
        $this->guards = $guards;
    }

    public function handle(nexus::Payload& $payload, nexus::Next $next) : nexus::Response
    {
        Identity $id = guard $this->guards->demand($payload) else ($refused) {
            return $refused;
        };
        $payload->put<Identity>($id);
        return $next->run($payload);
    }
}
