namespace nexus::cache;

/**
 * The cache an app reads and writes, bound by the extension: string values under string keys,
 * each kept for a `Lifetime`. The lifetime comes before the value or the callback; without one,
 * `NEXUS_CACHE_TTL` applies.
 *
 * ```echo
 * $cache = $payload->get<nexus::cache::Cache>();
 * string $list = $cache->get('posts:recent', .expires(.mins(5)), () => recent($repo));
 * string $flags = $cache->get('flags', .forever, () => loadFlags());
 * guard $cache->put('greeting', .expires(.secs(30)), 'hello');
 * ```
 *
 * The `get` with a callback never fails on the cache's account: a read that fails is a miss and a
 * write that fails is a warning in the log, so a cache that is down makes the app slower, not
 * broken.
 */
#[atomic]
public class Cache
{
    /**
     * The lifetime of an entry written without one.
     */
    public const Lifetime $lifetime;

    private Store $store;
    private nexus::Logger $log;

    /**
     * Where a watched request's timeline is found, to mark each call on it.
     */
    private nexus::trace::Traces $traces;

    public constructor(Store $store, Lifetime $lifetime, nexus::Logger $log, traces: nexus::trace::Traces $traces = nexus::trace::Traces())
    {
        $this->store = $store;
        $this->lifetime = $lifetime;
        $this->log = $log;
        $this->traces = $traces;
    }

    /**
     * Where entries are kept, like `memory:`.
     */
    public const function describe() : string
    {
        return $this->store->describe();
    }

    /**
     * The value under `$key`, or null when there is none.
     */
    public function get(const string& $key) : result<string?, CacheError>
    {
        nexus::trace::Timed $m = $this->mark('cache get', $key);
        string? $hit = guard $this->store->get($key) else ($e) {
            $m->fail();
            return .error($e);
        };
        $m->note(Cache::seen($hit != null));
        return .ok($hit);
    }

    /**
     * The value under `$key`; when there is none, what `$make` returns, kept for the default
     * lifetime.
     */
    public function get(const string& $key, function<string()> $make) : string
    {
        Lifetime $life = $this->lifetime;
        return $this->get($key, $life, $make);
    }

    /**
     * The value under `$key`; when there is none, what `$make` returns, kept for `$life`.
     */
    public function get(const string& $key, const Lifetime& $life, function<string()> $make) : string
    {
        string? $hit = $this->read($key);
        if ($hit != null) {
            string $v = guard $hit;
            return $v;
        }
        string $made = $make();
        $this->keep($key, $life, $made);
        return $made;
    }

    /**
     * The value under `$key`; when there is none, what `$make` returns, kept for `$life` when it is
     * a value. Its error comes back as it is, and nothing is kept.
     */
    public function get<E>(const string& $key, const Lifetime& $life, function<result<string, E>()> $make) : result<string, E>
    {
        string? $hit = $this->read($key);
        if ($hit != null) {
            string $v = guard $hit;
            return .ok($v);
        }
        string $made = try $make();
        $this->keep($key, $life, $made);
        return .ok($made);
    }

    /**
     * Keeps `$value` under `$key` for the default lifetime.
     */
    public function put(const string& $key, const string& $value) : status<CacheError>
    {
        Lifetime $life = $this->lifetime;
        return $this->put($key, $life, $value);
    }

    /**
     * Keeps `$value` under `$key` for `$life`. A lapsed lifetime keeps nothing: the key is
     * forgotten.
     */
    public function put(const string& $key, const Lifetime& $life, const string& $value) : status<CacheError>
    {
        nexus::trace::Timed $m = $this->mark('cache put', $key);
        if ($life->lapsed()) {
            return $this->store->forget($key);
        }
        return $this->store->put($key, $value, $life);
    }

    public function forget(const string& $key) : status<CacheError>
    {
        nexus::trace::Timed $m = $this->mark('cache forget', $key);
        return $this->store->forget($key);
    }

    /**
     * Forgets every entry.
     */
    public function flush() : status<CacheError>
    {
        nexus::trace::Timed $m = $this->mark('cache flush', '');
        return $this->store->flush();
    }

    // a failed read is a miss
    private function read(const string& $key) : string?
    {
        nexus::trace::Timed $m = $this->mark('cache get', $key);
        string? $hit = guard $this->store->get($key) else ($e) {
            $m->fail();
            $this->log->warn('cache read failed', ['key' => $key, 'error' => $e->message()]);
            return null;
        };
        $m->note(Cache::seen($hit != null));
        return $hit;
    }

    // a failed write is only logged
    private function keep(const string& $key, const Lifetime& $life, const string& $value) : void
    {
        guard $this->put($key, $life, $value) else ($e) {
            $this->log->warn('cache write failed', ['key' => $key, 'error' => $e->message()]);
            return;
        };
    }

    // a mark on the watched request's timeline, open until it goes out of scope
    private const function mark(const string& $name, const string& $key) : nexus::trace::Timed
    {
        return nexus::trace::Timed($this->traces->here(), .cache, $name, $key);
    }

    private static function seen(bool $hit) : string
    {
        if ($hit) {
            return 'hit';
        }
        return 'miss';
    }
}
