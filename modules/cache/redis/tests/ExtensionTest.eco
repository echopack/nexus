/**
 * The extension without a server: what it leaves alone, and what stops the boot.
 */

use nexus::testing::TestApp;
use ecotest::expect;

test without_a_redis_url_the_memory_cache_stays
{
    $app = TestApp([nexus::cache::Extension(), nexus::cache::redis::Extension()], []);
    nexus::cache::Cache $cache = $app->kernel->services->get<nexus::cache::Cache>();
    expect($cache->describe())->is('memory:');
}

test a_server_that_does_not_answer_stops_the_boot
{
    nexus::BootError $e = expect(TestApp::attempt([nexus::cache::Extension(), nexus::cache::redis::Extension()], ['NEXUS_CACHE_URL' => 'redis://127.0.0.1:1/0']))->fails();
    expect(str::join($e->lines(), '; '))->has('cannot reach redis://127.0.0.1:1/0');
}

test tls_is_refused_until_the_client_speaks_it
{
    nexus::BootError $e = expect(TestApp::attempt([nexus::cache::Extension(), nexus::cache::redis::Extension()], ['NEXUS_CACHE_URL' => 'rediss://127.0.0.1:6380']))->fails();
    expect(str::join($e->lines(), '; '))->has('NEXUS_CACHE_URL');
}
