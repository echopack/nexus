namespace nexus::files::s3;

/**
 * Just enough XML for S3's answers: the text of named elements, in order. S3 never nests an
 * element inside one of the same name, so a scan for `<Tag>` ... `</Tag>` is exact for what is
 * read here.
 */
public struct Xml
{
    /**
     * The raw inner text of every `<tag>` element.
     */
    public static function blocks(const string& $text, const string& $tag) : array<string>
    {
        array<string> $out = [];
        string $open = "<{$tag}>";
        string $close = "</{$tag}>";
        usize $at = 0;
        while (true) {
            usize $start = $text->find($open, $at);
            if ($start >= $text->size()) {
                return $out;
            }
            usize $from = $start + $open->size();
            usize $end = $text->find($close, $from);
            if ($end >= $text->size()) {
                return $out;
            }
            $out[] = $text->sub($from, $end - $from);
            $at = $end + $close->size();
        }
        return $out;
    }

    /**
     * The text of the first `<tag>`, entities decoded; null when there is none.
     */
    public static function value(const string& $text, const string& $tag) : string?
    {
        array<string> $found = Xml::blocks($text, $tag);
        if ($found->empty()) {
            return null;
        }
        return Xml::decode($found[0]);
    }

    /**
     * The five named entities and the numeric references (`&#13;`, `&#x2F;`) undone, once; anything
     * else kept as it is.
     */
    public static function decode(const string& $text) : string
    {
        if ($text->find('&') >= $text->size()) {
            return $text;
        }
        string $out = '';
        usize $i = 0;
        while ($i < $text->size()) {
            uint8 $b = $text->byte($i);
            if ($b != 38) {
                $out->push($b);
                $i = $i + 1;
                continue;
            }
            usize $semi = $text->find(';', $i);
            if ($semi >= $text->size()) {
                $out->push($b);
                $i = $i + 1;
                continue;
            }
            string $name = $text->sub($i + 1, $semi - $i - 1);
            if ($name == 'amp') {
                $out->push(38);
            } else if ($name == 'lt') {
                $out->push(60);
            } else if ($name == 'gt') {
                $out->push(62);
            } else if ($name == 'quot') {
                $out->push(34);
            } else if ($name == 'apos') {
                $out->push(39);
            } else if ($name->starts('#')) {
                uint64? $found = Xml::code($name);
                if ($found == null) {
                    $out->append($text->sub($i, $semi - $i + 1));
                } else {
                    uint64 $code = guard $found;
                    Xml::utf8($out, $code);
                }
            } else {
                $out->append($text->sub($i, $semi - $i + 1));
            }
            $i = $semi + 1;
        }
        return $out;
    }

    // the character `#38` or `#x26` names; null for none, a surrogate or past U+10FFFF
    internal static function code(const string& $name) : uint64?
    {
        string $digits = $name->sub(1, $name->size() - 1);
        bool $hex = $digits->starts('x') || $digits->starts('X');
        if ($hex) {
            $digits = $digits->sub(1, $digits->size() - 1);
        }
        // seven digits hold any character, and keep the sum from wrapping
        if ($digits->empty() || $digits->size() > 7) {
            return null;
        }
        uint64 $n = 0;
        usize $i = 0;
        while ($i < $digits->size()) {
            uint8 $b = $digits->byte($i);
            uint64 $d = 0;
            if ($b >= 48 && $b <= 57) {
                $d = ($b - 48) as uint64;
            } else if ($hex && $b >= 97 && $b <= 102) {
                $d = ($b - 87) as uint64;
            } else if ($hex && $b >= 65 && $b <= 70) {
                $d = ($b - 55) as uint64;
            } else {
                return null;
            }
            if ($hex) {
                $n = $n * 16 + $d;
            } else {
                $n = $n * 10 + $d;
            }
            $i++;
        }
        if ($n == 0 || $n > 0x10FFFF || ($n >= 0xD800 && $n <= 0xDFFF)) {
            return null;
        }
        return $n;
    }

    // `$code` onto `$out` in UTF-8
    internal static function utf8(string& $out, uint64 $code) : void
    {
        if ($code < 0x80) {
            $out->push($code as uint8);
        } else if ($code < 0x800) {
            $out->push((0xC0 | ($code >> 6)) as uint8);
            $out->push((0x80 | ($code & 0x3F)) as uint8);
        } else if ($code < 0x10000) {
            $out->push((0xE0 | ($code >> 12)) as uint8);
            $out->push((0x80 | (($code >> 6) & 0x3F)) as uint8);
            $out->push((0x80 | ($code & 0x3F)) as uint8);
        } else {
            $out->push((0xF0 | ($code >> 18)) as uint8);
            $out->push((0x80 | (($code >> 12) & 0x3F)) as uint8);
            $out->push((0x80 | (($code >> 6) & 0x3F)) as uint8);
            $out->push((0x80 | ($code & 0x3F)) as uint8);
        }
    }
}
