/**
 * nexus-connect's stores in a carbon database, on carbon's fake driver: each test queues what the
 * database answers and reads back what was sent.
 */

use nexus::connect::{AttemptStore, Attempt, ExternalIdentity, LinkStore, Link, Oidc};
use nexus::connect::carbon::{AttemptRow, AttemptRowTable, LinkRow, LinkRowTable, HashConnectLinks, AddConnectProof};
use nexus::testing::TestApp;
use carbon::fake;
use hydrahon::{Mysql, Value, DateTime};
use std::time;
use ecotest::expect;

internal const int64 START = 1793588340;
internal const KEY = 'a-test-key-of-at-least-thirty-two-chars';

internal class Rig
{
    public fake::Driver<Mysql> $fake;
    public calendar::ManualClock $clock;
    public TestApp $app;

    public constructor(bool $register)
    {
        $driver = fake::Driver<Mysql>();
        $clock = calendar::ManualClock(time::timestamp::from_unix_secs(START));
        $this->fake = $driver;
        $this->clock = $clock;
        $db = nexus::carbon::Extension(function[$driver, $clock, $register](nexus::carbon::DatabaseConfig $cfg) : result<carbon::DB, carbon::Error> {
            $made = carbon::DB($driver, clock: $clock);
            if ($register) {
                try nexus::connect::carbon::Tables::wire($made);
            }
            return .ok($made);
        });
        array<nexus::connect::Connector> $providers = [Oidc('acme', issuer: 'https://id.acme.test', client: 'c', secret: 's', authorize: 'https://id.acme.test/a', token: 'https://id.acme.test/t')];
        array<nexus::Extension> $exts = [$db, nexus::auth::Extension('test'), nexus::connect::Extension(connectors: $providers, stores: .provided, clock: $clock), nexus::connect::carbon::Extension()];
        map<string, string> $vars = ['NEXUS_AUTH_KEY' => KEY];
        $this->app = TestApp($exts, $vars);
    }

    public function attempts() : AttemptStore
    {
        nexus::Payload $payload = $this->app->kernel->background('test', 'c');
        AttemptStore $s = $payload->get<AttemptStore>();
        return $s;
    }

    public function links() : LinkStore
    {
        nexus::Payload $payload = $this->app->kernel->background('test', 'c');
        LinkStore $s = $payload->get<LinkStore>();
        return $s;
    }

    public function attempt() : Attempt
    {
        return Attempt($id: 'a1', $provider: 'acme', $stateHash: 's1', $bindingHash: 'b1', $nonce: 'n1', $verifier: 'v1',
            $expiresAt: $this->clock->now() + time::duration::mins(10));
    }
}

internal function spent(AttemptStore $s, const string& $id) : bool
{
    bool $mine = guard $s->spend($id);
    return $mine;
}

test an_attempt_keeps_who_signed_in
{
    $r = Rig(true);
    Attempt $a = $r->attempt();
    $r->fake->written();
    guard $r->attempts()->start($a);
    expect($r->fake->last())->starts('INSERT INTO `connect_attempts`');
    json::Value $claims = json::object();
    $claims['picture'] = json::str('https://pics.test/ann');
    $a->identity = ExternalIdentity($provider: 'acme', $subject: 'p1', $email: 'ann@example.com', $emailVerified: true, $name: 'Ann', $claims: $claims);
    $a->proofHash = nexus::auth::Secrets::hash('the-proof');
    $r->fake->written();
    bool $mine = guard $r->attempts()->settle($a);
    expect($mine)->yes(says: 'the first settle writes the row');
    expect($r->fake->last())->starts('UPDATE `connect_attempts` SET `error` = ?, `proof_hash` = ?, `external_subject` = ?');
    $r->fake->written(0);
    bool $again = guard $r->attempts()->settle($a);
    expect($again)->no(says: 'a settled row is not written again');

    $r->fake->rows([AttemptRowTable()->row(.of($a))]);
    Attempt? $found = guard $r->attempts()->find('a1');
    Attempt $back = expect($found)->some();
    ExternalIdentity $who = expect($back->identity)->some();
    expect($who->email)->is('ann@example.com');
    expect($who->emailVerified)->yes(says: 'the flag survives the row');
    expect(json::dump($who->claims))->has('pics.test');
    expect($back->proofHash)->is(nexus::auth::Secrets::hash('the-proof'));

    $r->fake->written(1);
    expect(spent($r->attempts(), 'a1'))->yes(says: 'the delete that removed the row spent it');
    expect($r->fake->last())->is('DELETE FROM `connect_attempts` WHERE `connect_attempts`.`id` = ?');
    $r->fake->written(0);
    expect(spent($r->attempts(), 'a1'))->no(says: 'a second delete removes nothing');
}

test an_unsettled_attempt_has_no_identity
{
    $r = Rig(true);
    AttemptRow $row = .of($r->attempt());
    expect($row->attempt()->identity)->none();
    expect($row->attempt()->settled())->no(says: 'a fresh attempt is not settled');
}

test a_link_is_kept_once_per_outside_identity
{
    $r = Rig(true);
    $l = Link($provider: 'acme', $external: 'p1', $subject: '7', $email: 'ann@example.com', $createdAt: $r->clock->now());
    $r->fake->rows([])->written();
    guard $r->links()->link($l);
    expect($r->fake->last())->starts('INSERT INTO `connect_links`');
    $r->fake->rows([LinkRowTable()->row(.of($l))]);
    expect($r->links()->link($l))->fails();
    expect(LinkRow::of($l)->id)->is(nexus::auth::Secrets::hash('acme:p1'));
}

test a_link_is_keyed_so_no_collation_folds_one_person_into_another
{
    // MySQL's default collation finds `acme:alice` for `acme:Alice`; their hashes differ in more than case
    expect(LinkRow::key('acme', 'Alice'))->isNot(LinkRow::key('acme', 'alice'));
    expect(LinkRow::key('acme', 'Alice'))->length(64);
    expect(nexus::auth::Secrets::isHex(LinkRow::key('acme', 'Alice')))->yes(says: 'the key is lowercase hex');

    $r = Rig(true);
    $r->fake->rows([]);
    Link? $none = guard $r->links()->find('acme', 'Alice');
    expect($none)->none();
    array<Value> $byHash = [Value::from(LinkRow::key('acme', 'Alice'))];
    expect($r->fake->sent(0, $byHash))->yes(says: 'the lookup is by the hash');

    ecotest::step('the links of a subject are the ones with exactly that subject');
    $mine = Link($provider: 'acme', $external: 'p1', $subject: 'alice', $createdAt: $r->clock->now());
    $theirs = Link($provider: 'acme', $external: 'p2', $subject: 'Alice', $createdAt: $r->clock->now());
    $r->fake->rows([LinkRowTable()->row(.of($mine)), LinkRowTable()->row(.of($theirs))]);
    array<Link> $found = guard $r->links()->of('alice');
    expect($found)->size(1);
    expect($found[0]->external)->is('p1');
}

test the_migration_adds_the_proof_to_the_attempts
{
    $fake = fake::Driver<Mysql>();
    array<array<Value>> $locked = [[Value::from(1 as int64)]];
    $fake->rows($locked)->written(0)->rows([])->written()->written()->rows($locked);
    array<carbon::migrate::Step> $steps = [carbon::migrate::Step('20261117000700_add_connect_proof', AddConnectProof(), true)];
    carbon::Migrator $m = carbon::Migrator(carbon::DB($fake, clock: calendar::FixedClock(time::timestamp::from_unix_secs(0))), $steps, carbon::ddl::Mysql());
    array<string> $done = guard $m->up();
    expect($done)->size(1);
    expect($fake->texts()[3])->is("ALTER TABLE `connect_attempts` ADD COLUMN `proof_hash` VARCHAR(64) NOT NULL DEFAULT ''");
}

test the_migration_rekeys_the_links_by_their_hash
{
    $fake = fake::Driver<Mysql>();
    array<array<Value>> $links = [
        [Value::from('acme:p1'), Value::from('acme'), Value::from('p1')],
        [Value::from('google:Alice'), Value::from('google'), Value::from('Alice')],
    ];
    array<array<Value>> $locked = [[Value::from(1 as int64)]];
    $fake->rows($locked)->written(0)->rows([])
        ->rows($links)->written()->written()
        ->written()
        ->rows($locked);
    array<carbon::migrate::Step> $steps = [carbon::migrate::Step('20261117000710_hash_connect_links', HashConnectLinks(), true)];
    carbon::Migrator $m = carbon::Migrator(carbon::DB($fake, clock: calendar::FixedClock(time::timestamp::from_unix_secs(0))), $steps, carbon::ddl::Mysql());
    array<string> $done = guard $m->up();
    expect($done)->size(1);
    array<string> $sent = $fake->texts();
    expect($sent[3])->is('SELECT `connect_links`.`id`, `connect_links`.`provider`, `connect_links`.`external` FROM `connect_links`');
    expect($sent[4])->is('UPDATE `connect_links` SET `id` = ? WHERE `connect_links`.`id` = ?');
    array<Value> $first = [Value::from(nexus::auth::Secrets::hash('acme:p1')), Value::from('acme:p1')];
    array<Value> $second = [Value::from(nexus::auth::Secrets::hash('google:Alice')), Value::from('google:Alice')];
    expect($fake->sent(4, $first) || $fake->sent(5, $first))->yes(says: 'acme:p1 is rekeyed by its hash');
    expect($fake->sent(4, $second) || $fake->sent(5, $second))->yes(says: 'google:Alice is rekeyed by its hash');

    ecotest::step('down puts the text back');
    $fake->rows($locked)->written(0)->rows([[Value::from('20261117000710_hash_connect_links'), Value::from(1 as int64), Value::from(DateTime(2026, 11, 17))]])
        ->rows([[Value::from(nexus::auth::Secrets::hash('acme:p1')), Value::from('acme'), Value::from('p1')]])->written()
        ->written()
        ->rows($locked);
    usize $before = $fake->count();
    array<string> $undone = guard $m->down();
    expect($undone)->size(1);
    expect($fake->sent($before + 4, [Value::from('acme:p1'), Value::from(nexus::auth::Secrets::hash('acme:p1'))]))->yes(says: 'the hash goes back to the text');
}

test prune_drops_expired_attempts
{
    $r = Rig(true);
    $r->fake->written(3);
    uint64 $n = guard $r->attempts()->prune($r->clock->now());
    expect($n)->is(3);
    expect($r->fake->last())->is('DELETE FROM `connect_attempts` WHERE `connect_attempts`.`expires_at` < ?');
}

test boot_refuses_a_database_without_the_tables
{
    $driver = fake::Driver<Mysql>();
    $db = nexus::carbon::Extension(function[$driver](nexus::carbon::DatabaseConfig $cfg) : result<carbon::DB, carbon::Error> {
        return .ok(carbon::DB($driver));
    });
    array<nexus::connect::Connector> $providers = [Oidc('acme', issuer: 'https://id.acme.test', client: 'c', secret: 's', authorize: 'https://id.acme.test/a', token: 'https://id.acme.test/t')];
    array<nexus::Extension> $exts = [$db, nexus::auth::Extension('test'), nexus::connect::Extension(connectors: $providers, stores: .provided), nexus::connect::carbon::Extension()];
    map<string, string> $vars = ['NEXUS_AUTH_KEY' => KEY];
    nexus::BootError $e = expect(TestApp::attempt($exts, $vars))->fails();
    expect($e->lines()[0])->has('Tables::wire');
}
