/*
 * nexus-connect-carbon: nexus-connect's sign in attempts and links in the
 * app's carbon database.
 *
 * Two tables, `connect_attempts` and `connect_links`, in migrations the app
 * adds to its own. An attempt is claimed with a delete that only one caller
 * wins; a link is keyed by a hash, so no collation folds two people into one.
 */

#[module: "nexus-connect-carbon"]
#[version: "0.1.0"]
#[epm::license: "MIT"]
#[epm::description: "nexus-connect sign in attempts and links in a carbon database"]

#[depends: "../../.."]
#[depends: ".."]
#[depends: "../../auth"]
#[depends: "../../carbon"]
#[requires: "echopack/carbon" { version: "^0.2.1", source: git "https://github.com/echopack/carbon" }]
#[requires: "echopack/container" { version: "^0.1.0", source: git "https://github.com/echopack/container" }]
#[requires: "echolang/libjson" { version: "^0.3.0", source: git "https://github.com/echolang/libjson" }]

#[hook: before_build { run: "nexus", args: ["gen"] }]

#[sources: "src/*.eco"]
#[if: !NEXUS_NOGEN]
#[sources: ".nexus/*.eco"]
#[end]
#[if: !CARBON_NOGEN]
#[sources: ".carbon/*.eco"]
#[end]

#[target: test] {
    #[requires: "echopack/carbon/fake" { version: "^0.2.1", source: git "https://github.com/echopack/carbon" }]
    #[depends: "../../testing"]
    #[sources: "tests/*.eco"]
}
