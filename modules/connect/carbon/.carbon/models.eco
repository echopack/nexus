        if ($missing->count() > 0) {
            return .error(.unregistered(str::join($missing, ', ')));
        }
        $db->store<nexus::connect::carbon::AttemptRow, string, nexus::connect::carbon::AttemptRowTable>();
        $db->store<nexus::connect::carbon::LinkRow, string, nexus::connect::carbon::LinkRowTable>();
        return .ok();
    }
}
