namespace nexus::connect;

use std::thread;

// one URL's answers still to give, and the last one given, which repeats once they run out
internal struct Script
{
    public array<Fetched> $queued = [];
    public Fetched? $last = null;
}

/**
 * A provider in a test: answers what the test told it to, by URL, and keeps what was sent. A URL
 * nobody scripted is a 503, as an unreachable provider is. `signedIn` scripts the answer of a
 * sign in that went well, so a test speaks in claims, not in HTTP:
 *
 * ```echo
 * $google = nexus::connect::ScriptedFetch();
 * $app = TestApp($extensions, $vars, replace: $google->replacing());
 * // the start answered `$url`, where the browser goes to sign in
 * $google->signedIn(nexus::connect::Google::TOKEN, $url, json::object(['iss' => 'https://accounts.google.com', 'sub' => 'g-1']));
 * ```
 */
#[atomic]
public class ScriptedFetch : Fetch
{
    private thread::mutex<map<string, Script>> $answers;
    private thread::mutex<array<Sent>> $log;

    public constructor()
    {
        $this->answers = thread::mutex<map<string, Script>>(map<string, Script>());
        $this->log = thread::mutex<array<Sent>>(array<Sent>());
    }

    /**
     * Puts this in place of the app's `Fetch`, as `TestApp(replace:)` takes it.
     */
    public function replacing() : function<void(nexus::Services&)>
    {
        ScriptedFetch $me = $this;
        return function[$me](nexus::Services& $s) : void {
            $s->replace<Fetch>(once: function[$me]() : Fetch {
                return $me;
            });
        };
    }

    /**
     * The next request to `$url` gets `$status` and `$body`. Answers to one URL are given in the
     * order they were scripted; the last one repeats until another is scripted.
     */
    public function answer(const string& $url, int32 $status, const string& $body) : ScriptedFetch
    {
        thread::locked<map<string, Script>> $held = $this->answers->lock();
        if (!$held->value->has($url)) {
            $held->value[$url] = Script();
        }
        Script& $script = $held->value->at($url);
        $script->queued[] = Fetched($status, $body);
        return $this;
    }

    /**
     * Token endpoint `$token` answers as a provider does once the person signed in: with an ID
     * token of `$claims`, filled in from the authorization URL `$url` the sign in went to (its
     * `nonce`, its `client_id` as `aud`) and with `iat` and `exp` from now, unless the claims name
     * their own.
     */
    public function signedIn(const string& $token, const string& $url, json::Value $claims) : ScriptedFetch
    {
        nexus::Query $asked = ScriptedFetch::query($url);
        if ($claims->get('nonce') == null) {
            $claims['nonce'] = json::str($asked->get('nonce') ?? '');
        }
        if ($claims->get('aud') == null) {
            $claims['aud'] = json::str($asked->get('client_id') ?? '');
        }
        int64 $now = std::time::timestamp::now()->unix_secs();
        if ($claims->get('iat') == null) {
            $claims['iat'] = json::int($now);
        }
        if ($claims->get('exp') == null) {
            $claims['exp'] = json::int($now + 3600);
        }
        json::Value $o = json::object();
        $o['access_token'] = json::str('at');
        $o['id_token'] = json::str(ScriptedFetch::idToken($claims));
        return $this->answer($token, 200, json::dump($o));
    }

    /**
     * An ID token carrying `$claims`, with a signature nobody checks: nexus-connect reads the
     * tokens it fetched itself over TLS without one (OIDC Core 3.1.3.7 (6)).
     */
    public static function idToken(const json::Value& $claims) : string
    {
        string $header = crypto::base64url('{"alg":"RS256","typ":"JWT"}');
        string $body = crypto::base64url(json::dump($claims));
        return "{$header}.{$body}.c2lnbmF0dXJl";
    }

    /**
     * What was sent, in order.
     */
    public function sent() : array<Sent>
    {
        thread::locked<array<Sent>> $held = $this->log->lock();
        return $held->value;
    }

    public function get(const string& $url) : result<Fetched, nexus::Problem>
    {
        $this->note(Sent('GET', $url, nexus::Query()));
        return $this->next($url);
    }

    public function post(const string& $url, const nexus::Query& $form) : result<Fetched, nexus::Problem>
    {
        $this->note(Sent('POST', $url, $form));
        return $this->next($url);
    }

    /**
     * Query parameter `$name` of `$url`, empty when it has none: what a test reads off the URL a
     * start sent the browser to.
     */
    public static function param(const string& $url, const string& $name) : string
    {
        return ScriptedFetch::query($url)->get($name) ?? '';
    }

    internal static function query(const string& $url) : nexus::Query
    {
        nexus::Url $at = guard nexus::Url::parse($url) else {
            return nexus::Query();
        };
        return $at->query;
    }

    internal function note(Sent $s) : void
    {
        thread::locked<array<Sent>> $held = $this->log->lock();
        $held->value[] = mv $s;
    }

    internal function next(const string& $url) : result<Fetched, nexus::Problem>
    {
        thread::locked<map<string, Script>> $held = $this->answers->lock();
        if (!$held->value->has($url)) {
            return .error(.unavailable("{$url} could not be reached: no answer scripted"));
        }
        Script& $script = $held->value->at($url);
        if (!$script->queued->empty()) {
            $script->last = $script->queued[0];
            $script->queued->remove(0);
        }
        Fetched $f = guard $script->last else {
            return .error(.unavailable("{$url} could not be reached: no answer scripted"));
        };
        return .ok($f);
    }
}
