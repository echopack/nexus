namespace nexus::connect;

use std::time;

/**
 * One sign in with a provider, from its start until the app claims it, at most ten minutes. The
 * store keeps hashes of the state, the binding and the proof, never them: the state is the
 * provider's echo of the attempt, the binding what proves the claim comes from the browser that
 * started it, the proof what proves it comes from the browser the provider sent back. The nonce
 * and the PKCE verifier are kept as they are, since the callback needs them.
 */
public struct Attempt
{
    public string $id;
    public string $provider;
    public string $stateHash;
    public string $bindingHash;
    public string $nonce;
    public string $verifier;
    public time::timestamp $expiresAt;

    /**
     * Who signed in, once the callback has run and the provider said so.
     */
    public ExternalIdentity? $identity = null;

    /**
     * Why the sign in failed (`access_denied`, `failed`), once the callback has run; empty
     * otherwise.
     */
    public string $error = '';

    /**
     * The hash of the proof the callback handed the browser it sent on to the app's page, once the
     * callback has run; empty otherwise.
     */
    public string $proofHash = '';

    /**
     * Whether the callback has run, well or not.
     */
    public const function settled() : bool
    {
        return $this->identity != null || !$this->error->empty();
    }
}
