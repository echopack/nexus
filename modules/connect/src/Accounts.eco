namespace nexus::connect;

/**
 * Which of the app's users a sign in with an outside provider is, per request on the link store:
 * the user the outside identity is linked to; else the user with the email the provider verified,
 * linked now as `$emailLinking` allows (by default when the app verified that user's email too);
 * else a new user, linked. An email the provider did not verify neither opens an account nor makes
 * one (some providers let anybody put any address on theirs, and an account made with somebody
 * else's address would be theirs to take later): that is a 403. A user the policy does not link by
 * email is a 409, and the person signs in with their password first.
 *
 * ```echo
 * nexus::connect::ExternalIdentity $who = try $this->connect->claim($in->value->attempt, $in->value->binding, $in->value->proof);
 * string $subject = try $this->accounts->of($who, BlogUsers($this->users, $this->signals, $payload->locale()));
 * ```
 *
 * The app's `Users` find and make its users; the policy is here, and `emailLinking` is the one
 * part of it an app chooses.
 */
public class Accounts
{
    public LinkStore $links;
    public calendar::Clock $clock;
    public const EmailLinking $emailLinking;

    public constructor(LinkStore $links, calendar::Clock $clock, emailLinking: EmailLinking $emailLinking = .verified)
    {
        $this->links = $links;
        $this->clock = $clock;
        $this->emailLinking = $emailLinking;
    }

    /**
     * The subject of the user `$who` signs in as, among `$users`. For an identity that is not linked
     * yet: a 403 when the provider shared no email or did not verify it, a 409 when a user has the
     * email but `emailLinking` does not link to them.
     */
    public function of(const ExternalIdentity& $who, Users $users) : result<string, nexus::Problem>
    {
        Link? $known = try $this->links->find($who->provider, $who->subject);
        if ($known != null) {
            Link $l = guard $known;
            bool $there = try $users->exists($l->subject);
            if ($there) {
                return .ok($l->subject);
            }
            // the user is gone; the link is stale
            try $this->links->unlink($who->provider, $who->subject);
        }
        if ($who->email->empty()) {
            return .error(.forbidden("{$who->provider} shared no email; allow it and try again"));
        }
        if (!$who->emailVerified) {
            return .error(Accounts::unverified($who->provider));
        }
        string? $same = try $users->withEmail($who->email);
        if ($same != null) {
            string $subject = guard $same;
            bool $links = try $this->links(by: $subject, $users);
            if (!$links) {
                return .error(Accounts::taken());
            }
            try $this->link($who, $subject);
            return .ok($subject);
        }
        string $made = try $users->create($who);
        try $this->link($who, $made);
        return .ok($made);
    }

    /**
     * The 409 for an email an account has already.
     */
    public static function taken() : nexus::Problem
    {
        return .conflict('an account has this email; sign in with its password first');
    }

    /**
     * The 403 for an identity whose email `$provider` did not verify: it neither makes a user nor
     * opens one.
     */
    public static function unverified(const string& $provider) : nexus::Problem
    {
        return .forbidden("{$provider} has not verified this email; verify it there, or sign in another way");
    }

    /**
     * Whether `emailLinking` links a verified sign in to user `$subject`, who has its email.
     */
    internal function links(by: const string& $subject, Users $users) : result<bool, nexus::Problem>
    {
        if ($this->emailLinking == EmailLinking::always) {
            return .ok(true);
        }
        if ($this->emailLinking == EmailLinking::never) {
            return .ok(false);
        }
        // both sides vouch for the address, or an account somebody opened with another person's
        // email would be handed to them
        return $users->emailVerified($subject);
    }

    internal function link(const ExternalIdentity& $who, const string& $subject) : status<nexus::Problem>
    {
        $l = Link($provider: $who->provider, $external: $who->subject, $subject: $subject, $email: $who->email,
            $createdAt: $this->clock->now());
        return $this->links->link($l);
    }
}
