namespace nexus::connect;

/**
 * Sends to the provider with libcurl, over TLS it verifies, ten seconds at most per request.
 */
#[atomic]
public class CurlFetch : Fetch
{
    public function get(const string& $url) : result<Fetched, nexus::Problem>
    {
        curl::Request $req = .get($url);
        return CurlFetch::send($req, $url);
    }

    public function post(const string& $url, const nexus::Query& $form) : result<Fetched, nexus::Problem>
    {
        curl::Request $req = .post($url, $form->encode());
        $req->headers->set('Content-Type', 'application/x-www-form-urlencoded');
        return CurlFetch::send($req, $url);
    }

    internal static function send(curl::Request& $req, const string& $url) : result<Fetched, nexus::Problem>
    {
        $req->headers->set('Accept', 'application/json');
        $req->userAgent('nexus-connect/0.1');
        $req->timeout(10000);
        curl::Response $res = guard curl::send($req) else ($e) {
            return .error(.unavailable("{$url} could not be reached: {$e->message()}"));
        };
        return .ok(Fetched($res->status as int32, $res->body));
    }
}
