namespace nexus::mcp;

use container::{Builder, Container};

/**
 * MCP for a nexus app: binds `Tools` (the tools `tools` gives by hand, and every one an extension
 * offers after it with `Tools::offer`), the offers `nexus gen` wrote, routes the endpoint at `/mcp`
 * and declares it nexus-auth's resource `mcp` (scope `mcp`), so with nexus-oauth an MCP client
 * signs in by itself. List it after nexus-auth, whose guards say who calls, and before the app.
 *
 * ```echo
 * nexus::auth::Extension('blog'),
 * nexus::mcp::Extension(name: 'blog', instructions: 'A blog; start with list_posts.'),
 * ```
 *
 * `name`, `title`, `version` and `instructions` are how the server introduces itself; the ones
 * not given keep `McpConfig`'s defaults.
 */
public class Extension : nexus::Extension
{
    public array<ToolSpec> $tools;
    internal string? $named;
    internal string? $title;
    internal string? $version;
    internal string? $instructions;

    public constructor(
        tools: array<ToolSpec> $tools = array<ToolSpec>(),
        name: string? $name = null,
        title: string? $title = null,
        version: string? $version = null,
        instructions: string? $instructions = null
    )
    {
        $this->tools = mv $tools;
        $this->named = $name;
        $this->title = $title;
        $this->version = $version;
        $this->instructions = $instructions;
    }

    public function name() : string
    {
        return 'nexus-mcp';
    }

    public function services(nexus::Services& $s) : status<nexus::BootError>
    {
        if ($s->find<nexus::auth::Guards>() == null) {
            return .error(.extension('nexus-mcp', 'every MCP call needs a signed in caller; list nexus::auth::Extension() before nexus::mcp::Extension()'));
        }
        // what the app gave here, over what the environment and the defaults say
        McpConfig $config = $s->get<McpConfig>();
        $config->name = $this->named ?? $config->name;
        $config->title = $this->title ?? $config->title;
        $config->version = $this->version ?? $config->version;
        $config->instructions = $this->instructions ?? $config->instructions;
        $s->replace<McpConfig>(put: $config);
        array<string> $scopes = ['mcp'];
        string $title = $config->title;
        if ($title->empty()) {
            $title = $config->name;
        }
        $s->get<nexus::auth::Resources>()->add($s, nexus::auth::Resource('mcp', '/mcp', $scopes, $title));
        $offers = Offers();
        foreach (attr::of<ToolTable>('nexus::mcp::tools') as const &$t) {
            function<void(Offers)> $add = $t->call;
            $add($offers);
        }
        $s->bind<Offers>(put: $offers);
        $all = Tools();
        foreach ($this->tools as const &$t) {
            $all->add($t);
        }
        $s->bind<Tools>(put: $all);
        $s->bindAction<Endpoint>(method: .post, path: '/mcp', function(Container $c) : Endpoint {
            return Endpoint($c->get<Tools>(), $c->get<McpConfig>(), $c->get<nexus::auth::Guards>());
        });
        $s->bindAction<Refused>(method: .get, path: '/mcp');
        $s->route<Refused>(method: .delete, path: '/mcp');
        return .ok;
    }

    public function boot(nexus::Kernel $kernel) : status<nexus::BootError>
    {
        foreach ($kernel->services->get<Tools>()->all() as const &$t) {
            function<bool(Container)> $bound = $t->bound;
            if (!$bound($kernel->services)) {
                return .error(.extension('nexus-mcp', "tool {$t->name} runs {$t->owner}, which has no binding; bind it in the app's services"));
            }
            foreach ($t->through as const &$ref) {
                function<bool(Container)> $has = $ref->bound;
                if (!$has($kernel->services)) {
                    return .error(.extension('nexus-mcp', "tool {$t->name} goes through {$ref->name}, which is not bound; bind it in the app's services"));
                }
            }
        }
        return .ok;
    }
}
