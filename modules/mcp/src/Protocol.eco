namespace nexus::mcp;

/**
 * The MCP revisions spoken here. They differ in ways a stateless server
 * of tools never meets, so each gets the same answers; a client asking for
 * another is offered the latest.
 */
public enum Protocol : uint8
{
    case v20251125 = 1;
    case v20250618 = 2;
    case v20250326 = 3;

    public const function name() : string
    {
        return match ($this) {
            Protocol::v20251125 => '2025-11-25',
            Protocol::v20250618 => '2025-06-18',
            Protocol::v20250326 => '2025-03-26',
        };
    }

    public static function latest() : Protocol
    {
        return Protocol::v20251125;
    }

    public static function parse(const string& $text) : Protocol?
    {
        array<Protocol> $all = [Protocol::v20251125, Protocol::v20250618, Protocol::v20250326];
        foreach ($all as const &$p) {
            if ($p->name() == $text) {
                return $p;
            }
        }
        return null;
    }
}
