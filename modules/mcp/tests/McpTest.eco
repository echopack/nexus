/**
 * nexus-mcp through its extension: the endpoint's handshake, the tool list and calls of a
 * hand-written tool, and what is refused on the way, with nexus-auth's memory tokens saying who
 * calls.
 */

use nexus::mcp::{ToolSpec, Tools, Schema};
use ecotest::expect;
use ecotest::http::{Api, Reply};
use nexus::testing::TestApp;

internal const KEY = 'a-test-key-of-at-least-thirty-two-chars';

/**
 * Says back what it is given.
 */
internal class TEcho
{
    public function handle(nexus::Payload& $payload, const string& $text) : nexus::Response
    {
        json::Value $o = json::object();
        $o['said'] = json::str($text);
        $o['by'] = json::str($payload->door->name());
        nexus::auth::Identity $id = guard $payload->state<nexus::auth::Identity>() else ($p) {
            return nexus::Response(json: $o);
        };
        $o['who'] = json::str($id->subject);
        return nexus::Response(json: $o);
    }
}

/**
 * What `nexus gen` would write for a tool `echo_text` taking `text`.
 */
internal struct TEchoMcp
{
    public static function spec() : ToolSpec
    {
        function<nexus::Response(nexus::Payload&, nexus::Fields&)> $run = function(nexus::Payload& $payload, nexus::Fields& $args) : nexus::Response {
            return TEchoMcp::call($payload, $args);
        };
        function<bool(container::Container)> $bound = function(container::Container $services) : bool {
            return $services->find<TEcho>() != null;
        };
        $t = ToolSpec('echo_text', 'TEcho', Schema::of('{"type":"object","properties":{"text":{"type":"string","minLength":1}},"required":["text"],"additionalProperties":false}'), $run, $bound);
        $t->title = 'Echo';
        $t->description = 'Says the text back.';
        $t->annotations = Schema::of('{"readOnlyHint":true}');
        $t->through = [nexus::MiddlewareRef::of<nexus::auth::Authenticate>('nexus::auth::Authenticate')];
        return $t;
    }

    /**
     * The same tool behind a middleware that refuses everyone.
     */
    public static function locked() : ToolSpec
    {
        ToolSpec $t = TEchoMcp::spec();
        $t->name = 'locked_echo';
        $t->through = [nexus::MiddlewareRef::of<TLocked>('TLocked')];
        return $t;
    }

    public static function call(nexus::Payload& $payload, nexus::Fields& $args) : nexus::Response
    {
        $args->check->at('text', 'string', '');
        string? $text = $args->string('text', required: true);
        if ($text != null) {
            string $t = guard $text;
            $args->check->minLength($t, 1);
        }
        guard $args->done() else ($p) {
            return nexus::Reply::problem($payload, $p);
        };
        string $said = guard $text;
        TEcho $tool = $payload->get<TEcho>();
        return $tool->handle($payload, $said);
    }
}

#[atomic]
internal class TLocked : nexus::Middleware
{
    public function handle(nexus::Payload& $payload, nexus::Next $next) : nexus::Response
    {
        return $payload->fail(nexus::Problem::forbidden('this one is locked'));
    }
}

internal class TExt : nexus::Extension
{
    public bool $binds;

    public constructor(bool $binds)
    {
        $this->binds = $binds;
    }

    public function name() : string
    {
        return 'test';
    }

    public function services(nexus::Services& $s) : status<nexus::BootError>
    {
        if ($this->binds) {
            $s->bind<TEcho>(scope: function() : TEcho {
                return TEcho();
            });
            $s->bind<TLocked>(once: () => TLocked());
        }
        return .ok;
    }
}

internal class Rig
{
    public TestApp $app;

    /**
     * The app as the signed in caller: every request carries the test token.
     */
    public Api $api;

    public constructor()
    {
        map<string, string> $vars = ['NEXUS_AUTH_KEY' => KEY];
        array<ToolSpec> $tools = [TEchoMcp::spec(), TEchoMcp::locked()];
        array<nexus::Extension> $exts = [nexus::auth::Extension('test', cost: crypto::PasswordCost(8, 1)), nexus::mcp::Extension(tools: $tools, name: 'tests', instructions: 'Call echo_text.'), TExt(true)];
        $this->app = TestApp($exts, $vars);
        nexus::Payload $payload = $this->app->kernel->background('issue', 'test');
        nexus::auth::Issued $issued = guard $payload->get<nexus::auth::Tokens>()->issue('7');
        nexus::Kernel::finish($payload);
        $this->api = $this->app->api()->bearer($issued->token);
    }

    /**
     * Posts one JSON-RPC message with the test token, `$params` given as JSON text.
     */
    public function rpc(const string& $method, const string& $params = '{}') : Reply
    {
        json::Value $p = guard json::parse($params);
        return $this->send($method, mv $p);
    }

    /**
     * Calls tool `$tool` with `$args` given as JSON text.
     */
    public function call(const string& $tool, const string& $args = '{}') : Reply
    {
        json::Value $arguments = guard json::parse($args);
        json::Value $p = json::object();
        $p['name'] = json::str($tool);
        $p['arguments'] = mv $arguments;
        return $this->send('tools/call', mv $p);
    }

    /**
     * Posts the JSON-RPC envelope around `$params` with the test token.
     */
    private function send(const string& $method, mv json::Value $params) : Reply
    {
        json::Value $o = json::object();
        $o['jsonrpc'] = json::str('2.0');
        $o['id'] = json::int(1);
        $o['method'] = json::str($method);
        $o['params'] = mv $params;
        return $this->api->post('/mcp', json: $o);
    }
}

test a_caller_without_a_credential_is_pointed_at_oauth
{
    $r = Rig();
    $r->app->api()->with('Host', 'blog.test')->post('/mcp', json: '{"jsonrpc":"2.0","id":1,"method":"ping"}')
        ->status(401)
        ->header('WWW-Authenticate', 'Bearer resource_metadata="http://blog.test/.well-known/oauth-protected-resource/mcp"');
}

test initialize_answers_the_asked_revision_and_the_server
{
    $r = Rig();
    $r->rpc('initialize', '{"protocolVersion":"2025-06-18"}')
        ->status(200)
        ->json('$.result.protocolVersion', '2025-06-18')
        ->json('$.result.serverInfo.name', 'tests')
        ->json('$.result.instructions', 'Call echo_text.');

    $r->rpc('initialize', '{"protocolVersion":"1999-01-01"}')->json('$.result.protocolVersion', '2025-11-25');
}

test tools_are_listed_with_their_schema
{
    $r = Rig();
    $r->rpc('tools/list')
        ->count('$.result.tools', 2)
        ->json('$.result.tools[0].name', 'echo_text')
        ->json('$.result.tools[0].title', 'Echo')
        ->json('$.result.tools[0].inputSchema.required[0]', 'text')
        ->json('$.result.tools[0].annotations.readOnlyHint', true);
}

test a_call_runs_the_tool_on_the_mcp_door
{
    $r = Rig();
    $r->call('echo_text', '{"text":"hello"}')
        ->status(200)
        ->json('$.result.structuredContent.said', 'hello')
        ->json('$.result.structuredContent.by', 'mcp')
        ->json('$.result.isError', false);
}

test bad_arguments_are_a_tool_error_the_model_reads
{
    $r = Rig();
    $r->call('echo_text', '{"text":"hi","loud":true}')->json('$.result.isError', true)->has('echo_text takes no loud');
    $r->call('echo_text')->json('$.result.isError', true)->has('is required');
    $r->call('no_such_tool')->json('$.error.code', -32602);
}

test a_tools_middleware_answers_for_it
{
    $r = Rig();
    $r->call('locked_echo', '{"text":"hello"}')
        ->status(200)
        ->json('$.result.isError', true)
        ->has('this one is locked');
}

test the_endpoint_refuses_what_it_does_not_speak
{
    $r = Rig();
    $r->rpc('resources/list')->json('$.error.code', -32601);
    $r->app->api()->get('/mcp')->status(405)->header('Allow', 'POST');
    $r->api->post('/mcp', body: '{}', type: 'text/plain')->status(415);
    $r->api->with('MCP-Protocol-Version', '2024-01-01')->post('/mcp', json: '{}')->status(400);
    $r->api->post('/mcp', json: '{"jsonrpc":"2.0","method":"notifications/initialized"}')->status(202);
    $r->api->post('/mcp', body: 'nope', type: 'application/json')->json('$.error.code', -32700);
}

test boot_refuses_a_tool_without_a_binding
{
    map<string, string> $vars = ['NEXUS_AUTH_KEY' => KEY];
    array<ToolSpec> $tools = [TEchoMcp::spec()];
    array<nexus::Extension> $exts = [nexus::auth::Extension('test'), nexus::mcp::Extension(tools: $tools), TExt(false)];
    $r = TestApp::attempt($exts, $vars);
    expect($r)->fails();
}

test boot_needs_nexus_auth
{
    map<string, string> $vars = ['NEXUS_AUTH_KEY' => KEY];
    array<nexus::Extension> $exts = [nexus::mcp::Extension(), TExt(true)];
    $r = TestApp::attempt($exts, $vars);
    expect($r)->fails();
}
