namespace nexus::rest;

/**
 * Turns a model into the answer of an action. A transformer is a plain, shared `#[atomic]` class
 * that conforms to this and to the mapping `nexus gen` writes from the model's `#[nexus::expose]`
 * fields (`PostMapping`, or `UserAdminMapping` for a named shape). The mapping brings `name()`,
 * `map()` and the includes; the transformer's own `transform()` hook gets every item after `map()`
 * and may add, replace or remove keys. The rest comes with it: `createResponse()` and
 * `createCollectionResponse()` answer with a response in the format the request accepts, the model
 * under `data`, and `transformInto()` and `transformCollectionInto()` nest it inside another
 * transformer's model, `transformReferenceInto()` with meta keys next to its `data`.
 *
 * Transformers live in the app's `TransformerNetwork`, one per model, registered with
 * `Transformers::add`. One that nests another asks the network for it through the
 * `TransformerContext`, which also carries what the action knows beyond the model (who is viewing,
 * say) to every `transform` down the tree.
 *
 * ```echo
 * // the model says what it exposes
 * #[carbon::model: 'posts']
 * public class Post : carbon::Model<Post, PostRepository>
 * {
 *     #[carbon::key]
 *     #[nexus::expose: { attribute: true }]
 *     public int64 $id = 0;
 *
 *     #[nexus::expose]
 *     public string $title;
 *
 *     #[carbon::belongsTo: 'authorId']
 *     #[nexus::expose]
 *     public carbon::One<User> $author = .unloaded();
 * }
 *
 * // a provider's register
 * $app->bindTransformer<Post, PostTransformer>();
 *
 * #[atomic]
 * public class PostTransformer : nexus::rest::Transformer<Post>, PostMapping
 * {
 *     public function transform(const Post& $p, nexus::rest::Item& $item, const nexus::rest::TransformerContext& $ctx) : void
 *     {
 *         $item->text('url', "/v1/posts/{$p->id}");
 *     }
 * }
 *
 * // in an action
 * $p = try $this->posts->find($id);
 * return $this->transformer->createResponse($payload, $p);
 * ```
 *
 * Without a mapping, a transformer writes `name()`, `map()`, `availableIncludes()` and
 * `defaultIncludes()` itself.
 */
public interface Transformer<M>
{
    /**
     * The per-item hook: runs after the mapping wrote the model's exposed fields into `$item`, and
     * may add, replace or remove keys. Does nothing unless the transformer has its own.
     */
    function transform(const M& $m, Item& $item, const TransformerContext& $ctx) : void
    {
    }

    /**
     * Includes the `transform()` hook adds beyond the mapping's own, nested paths spelled out:
     * `['author.posts']`. The generated mapping's `availableIncludes()` lists these after its
     * relations.
     */
    function extraIncludes() : array<string>
    {
        array<string> $none = [];
        return $none;
    }

    /**
     * The includes the request asks for: a 400 for one `availableIncludes()` does not name. Check
     * it before a write, so a bad `?include=` stops the request before anything changed.
     */
    function requestedIncludes(nexus::Payload& $payload) : result<EchoPack::Rest::Includes, nexus::Problem>
    {
        EchoPack::Rest::Allow $allow = .of($this->availableIncludes());
        $all = $allow->always($this->defaultIncludes());
        $found = guard $all->parse($payload->request->query->get('include') ?? '') else ($e) {
            return .error(.badRequest("include: {$e->message()}"));
        };
        return .ok($found);
    }

    /**
     * `$m` as the answer, with the includes the request asks for:
     * `createResponse($payload, $post, status: 201)` for one just made.
     */
    function createResponse(nexus::Payload& $payload, const M& $m, status: int32 $status = 200) : result<nexus::Response, nexus::Problem>
    {
        $ctx = TransformerContext();
        return $this->createResponse($payload, $m, $ctx, status: $status);
    }

    /**
     * `$m` as the answer, transformed with `$ctx`.
     */
    function createResponse(nexus::Payload& $payload, const M& $m, const TransformerContext& $ctx, status: int32 $status = 200) : result<nexus::Response, nexus::Problem>
    {
        $none = Meta();
        return $this->createResponse($payload, $m, $none, $ctx, status: $status);
    }

    /**
     * `$m` as the answer, `$meta`'s keys before `data`, transformed with `$ctx`.
     */
    function createResponse(nexus::Payload& $payload, const M& $m, const Meta& $meta, const TransformerContext& $ctx, status: int32 $status = 200) : result<nexus::Response, nexus::Problem>
    {
        $inc = try $this->requestedIncludes($payload);
        return .ok($this->createResponse($payload, $m, $meta, $ctx, mv $inc, status: $status));
    }

    /**
     * `$m` as the answer, with includes already checked.
     */
    function createResponse(nexus::Payload& $payload, const M& $m, EchoPack::Rest::Includes $inc, status: int32 $status = 200) : nexus::Response
    {
        $ctx = TransformerContext();
        return $this->createResponse($payload, $m, $ctx, mv $inc, status: $status);
    }

    /**
     * `$m` as the answer, transformed with `$ctx`, includes already checked.
     */
    function createResponse(nexus::Payload& $payload, const M& $m, const TransformerContext& $ctx, EchoPack::Rest::Includes $inc, status: int32 $status = 200) : nexus::Response
    {
        $none = Meta();
        return $this->createResponse($payload, $m, $none, $ctx, mv $inc, status: $status);
    }

    /**
     * `$m` as the answer, `$meta`'s keys before `data`, transformed with `$ctx`, includes already
     * checked.
     */
    function createResponse(nexus::Payload& $payload, const M& $m, const Meta& $meta, const TransformerContext& $ctx, EchoPack::Rest::Includes $inc, status: int32 $status = 200) : nexus::Response
    {
        $o = Out($payload, mv $inc);
        $o->begin($meta);
        $this->transformEntity($o, $ctx, $m);
        $res = $o->end();
        $res->status = $status;
        return $res;
    }

    /**
     * `$ms` as the answer, a list under `data`.
     */
    function createCollectionResponse(nexus::Payload& $payload, const array<M>& $ms) : result<nexus::Response, nexus::Problem>
    {
        $none = Meta();
        return $this->createCollectionResponse($payload, $ms, $none);
    }

    /**
     * `$ms` as the answer, `$meta`'s keys before `data`.
     */
    function createCollectionResponse(nexus::Payload& $payload, const array<M>& $ms, const Meta& $meta) : result<nexus::Response, nexus::Problem>
    {
        $ctx = TransformerContext();
        return $this->createCollectionResponse($payload, $ms, $meta, $ctx);
    }

    /**
     * `$ms` as the answer, `$meta`'s keys before `data`, transformed with `$ctx`.
     */
    function createCollectionResponse(nexus::Payload& $payload, const array<M>& $ms, const Meta& $meta, const TransformerContext& $ctx) : result<nexus::Response, nexus::Problem>
    {
        $inc = try $this->requestedIncludes($payload);
        return .ok($this->createCollectionResponse($payload, $ms, $meta, $ctx, mv $inc));
    }

    /**
     * `$ms` as the answer, with includes already checked.
     */
    function createCollectionResponse(nexus::Payload& $payload, const array<M>& $ms, const Meta& $meta, EchoPack::Rest::Includes $inc, status: int32 $status = 200) : nexus::Response
    {
        $ctx = TransformerContext();
        return $this->createCollectionResponse($payload, $ms, $meta, $ctx, mv $inc, status: $status);
    }

    /**
     * `$ms` as the answer, transformed with `$ctx`, includes already checked.
     */
    function createCollectionResponse(nexus::Payload& $payload, const array<M>& $ms, const Meta& $meta, const TransformerContext& $ctx, EchoPack::Rest::Includes $inc, status: int32 $status = 200) : nexus::Response
    {
        $o = Out($payload, mv $inc);
        $o->begin($meta);
        $o->list('');
        foreach ($ms as const &$m) {
            $this->transformEntity($o, $ctx, $m);
        }
        $o->close();
        $res = $o->end();
        $res->status = $status;
        return $res;
    }

    /**
     * `$m` nested under `$key` of the model another transformer writes, null when there is none.
     * Left out past the depth limit.
     */
    function transformInto(Out& $o, const TransformerContext& $ctx, const string& $key, M? $m) : void
    {
        if (!$o->enter($key)) {
            return;
        }
        M $present = guard $m else {
            $o->nil($key);
            $o->leave();
            return;
        };
        $o->key($key);
        $this->transformEntity($o, $ctx, $present);
        $o->leave();
    }

    /**
     * `$ms` nested under `$key` as a list. Left out past the depth limit.
     */
    function transformCollectionInto(Out& $o, const TransformerContext& $ctx, const string& $key, const array<M>& $ms) : void
    {
        if (!$o->enter($key)) {
            return;
        }
        $o->key($key);
        $o->list('');
        foreach ($ms as const &$m) {
            $this->transformEntity($o, $ctx, $m);
        }
        $o->close();
        $o->leave();
    }

    /**
     * `$m` nested under `$key` wrapped, `$meta`'s keys next to its `data` (null when there is
     * none): `"user": {"is_cached": true, "data": {…}}`. Left out past the depth limit.
     */
    function transformReferenceInto(Out& $o, const TransformerContext& $ctx, const string& $key, M? $m, const Meta& $meta) : void
    {
        if (!$o->enter($key)) {
            return;
        }
        $o->key($key);
        $o->open($key);
        $o->meta($meta);
        M $present = guard $m else {
            $o->nil('data');
            $o->close();
            $o->leave();
            return;
        };
        $o->key('data');
        $this->transformEntity($o, $ctx, $present);
        $o->close();
        $o->leave();
    }

    /**
     * `$ms` nested under `$key` wrapped, `$meta`'s keys next to the list under `data`. Left out
     * past the depth limit.
     */
    function transformReferenceCollectionInto(Out& $o, const TransformerContext& $ctx, const string& $key, const array<M>& $ms, const Meta& $meta) : void
    {
        if (!$o->enter($key)) {
            return;
        }
        $o->key($key);
        $o->open($key);
        $o->meta($meta);
        $o->key('data');
        $o->list('');
        foreach ($ms as const &$m) {
            $this->transformEntity($o, $ctx, $m);
        }
        $o->close();
        $o->close();
        $o->leave();
    }

    /**
     * `$m` as one entity: opened under its name, mapped, handed to the `transform()` hook, written,
     * closed.
     */
    function transformEntity(Out& $o, const TransformerContext& $ctx, const M& $m) : void
    {
        $o->open($this->name());
        $item = Item($o);
        $this->map($m, $item, $ctx);
        $this->transform($m, $item, $ctx);
        $item->flush($o, $ctx);
        $o->close();
    }
}
