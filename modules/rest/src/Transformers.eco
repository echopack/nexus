namespace nexus::rest;

/**
 * Transformers in the container and in the app's `TransformerNetwork`.
 */
public struct Transformers
{
    /**
     * Registers a `T()` as the transformer of model `M` and binds it shared, as what actions and
     * cruds ask for. One line per transformer, in any order:
     *
     * ```echo
     * nexus::rest::Transformers::add<User, UserTransformer>($s);
     * nexus::rest::Transformers::add<Post, PostTransformer>($s);
     * ```
     */
    public static function add<M, T>(nexus::Services& $s) : void
    {
        Transformers::add<M, T>($s, T());
    }

    /**
     * Registers `$made` as the transformer of model `M`: for one that takes constructor arguments.
     */
    public static function add<M, T>(nexus::Services& $s, T $made) : void
    {
        if (!$s->has<TransformerNetwork>()) {
            $s->bind<TransformerNetwork>(put: TransformerNetwork());
        }
        $net = $s->get<TransformerNetwork>();
        $net->add<M>($made);
        $s->bind<T>(put: $made);
    }
}
