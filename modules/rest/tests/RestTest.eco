/**
 * nexus-rest with hand-written mappings: negotiated JSON and XML, lists with meta, includes checked
 * against the transformer, nested models through the transformer network (cycles included), wrapped
 * references with meta, the depth limit, and the context handed down the tree.
 */

use nexus::testing::{TestApp, TestResponse};
use container::{Builder, Container};
use ecotest::expect;

internal class TOwner
{
    public int64 $id;
    public string $name;
    public TOwner? $boss = null;
    public array<TItem> $items = [];

    public constructor(int64 $id, const string& $name)
    {
        $this->id = $id;
        $this->name = $name;
    }
}

internal struct TItem
{
    public int64 $id;
    public string $name;
    public array<string> $tags = [];
    public TOwner? $owner = null;
}

/**
 * Who is asking, as an action hands it to the transformers.
 */
internal struct TViewer
{
    public int64 $id;
}

/**
 * Fields written by a hand-written `map`, what the generated mapping does, and the viewer added by
 * the `transform` hook.
 */
#[atomic]
internal class TOwnerTransformer : nexus::rest::Transformer<TOwner>
{
    public constructor()
    {
    }

    public function name() : string
    {
        return 'owner';
    }

    public function availableIncludes() : array<string>
    {
        return ['boss', 'items'];
    }

    public function defaultIncludes() : array<string>
    {
        array<string> $none = [];
        return $none;
    }

    public function map(const TOwner& $m, nexus::rest::Item& $item, const nexus::rest::TransformerContext& $ctx) : void
    {
        $item->attribute('id', $m->id);
        $item->text('name', $m->name);
        $item->include<TOwner>('boss', $m->boss);
        $item->includeCollection<TItem>('items', $m->items);
    }

    public function transform(const TOwner& $m, nexus::rest::Item& $item, const nexus::rest::TransformerContext& $ctx) : void
    {
        TViewer $v = guard $ctx->find<TViewer>() else {
            return;
        };
        $item->bool('mine', $v->id == $m->id);
    }
}

#[atomic]
internal class TItemTransformer : nexus::rest::Transformer<TItem>
{
    public constructor()
    {
    }

    public function name() : string
    {
        return 'item';
    }

    public function availableIncludes() : array<string>
    {
        return ['owner', 'owner.boss', 'owner.items', 'holder'];
    }

    public function defaultIncludes() : array<string>
    {
        array<string> $none = [];
        return $none;
    }

    public function map(const TItem& $m, nexus::rest::Item& $item, const nexus::rest::TransformerContext& $ctx) : void
    {
        // the include first: it is still written after the fields
        $item->include<TOwner>('owner', $m->owner);
        $item->attribute('id', $m->id);
        $item->text('name', $m->name);
        $item->texts('tags', $m->tags, item: 'tag');
        $meta = nexus::rest::Meta();
        $meta->with('is_cached', json::bool(true));
        $item->includeReference<TOwner>('holder', $m->owner, $meta);
    }
}

internal class TShow : nexus::Action
{
    public TItemTransformer $items;

    public constructor(TItemTransformer $items)
    {
        $this->items = $items;
    }

    public function handle(nexus::Payload& $payload) : result<nexus::Response, nexus::Problem>
    {
        $one = TItem($id: 1, $name: 'one', $tags: ['a', 'b']);
        $one->owner = TOwner(7, 'Ann');
        return $this->items->createResponse($payload, $one);
    }
}

internal class TApp : nexus::Extension
{
    public function name() : string
    {
        return 'tapp';
    }

    public function services(nexus::Services& $s) : status<nexus::BootError>
    {
        // in any order: the network resolves while it writes
        nexus::rest::Transformers::add<TItem, TItemTransformer>($s);
        nexus::rest::Transformers::add<TOwner, TOwnerTransformer>($s);
        $s->bind<TShow>(scope: function(Container $c) : TShow {
            return TShow($c->get<TItemTransformer>());
        });
        restTestRoutes($s);
        return .ok;
    }
}

internal function restTestRoutes(nexus::Services& $s) : void
{
    array<nexus::Method> $get = [nexus::Method::get];
    array<nexus::MiddlewareRef> $w = [];
    function<bool(Container)> $bound = function(Container $services) : bool {
        return true;
    };
    $s->route(nexus::Route($get, '/item', 'TShow', function(nexus::Payload& $payload) : nexus::Response {
        $a = $payload->get<TShow>();
        return nexus::Reply::of($payload, $a->handle($payload));
    }, $bound, $w));
    $s->route(nexus::Route($get, '/items', 'TList', function(nexus::Payload& $payload) : nexus::Response {
        array<TItem> $items = [TItem($id: 1, $name: 'one'), TItem($id: 2, $name: 'two')];
        $meta = nexus::rest::Meta();
        $meta->with('total', json::int(41));
        $t = $payload->get<TItemTransformer>();
        return nexus::Reply::of($payload, $t->createCollectionResponse($payload, $items, $meta));
    }, $bound, $w));
    $s->route(nexus::Route($get, '/viewed', 'TViewed', function(nexus::Payload& $payload) : nexus::Response {
        $one = TItem($id: 1, $name: 'one');
        $one->owner = TOwner(7, 'Ann');
        $ctx = nexus::rest::TransformerContext();
        $ctx->set<TViewer>($id: 7);
        $t = $payload->get<TItemTransformer>();
        return nexus::Reply::of($payload, $t->createResponse($payload, $one, $ctx));
    }, $bound, $w));
    $s->route(nexus::Route($get, '/cycle', 'TCycle', function(nexus::Payload& $payload) : nexus::Response {
        $ann = TOwner(7, 'Ann');
        $ann->items = [TItem($id: 2, $name: 'two')];
        $one = TItem($id: 1, $name: 'one');
        $one->owner = $ann;
        $t = $payload->get<TItemTransformer>();
        return nexus::Reply::of($payload, $t->createResponse($payload, $one));
    }, $bound, $w));
    $s->route(nexus::Route($get, '/orphan', 'TOrphan', function(nexus::Payload& $payload) : nexus::Response {
        $one = TItem($id: 1, $name: 'one');
        $t = $payload->get<TItemTransformer>();
        return nexus::Reply::of($payload, $t->createResponse($payload, $one));
    }, $bound, $w));
    $s->route(nexus::Route($get, '/cached', 'TCached', function(nexus::Payload& $payload) : nexus::Response {
        $one = TItem($id: 1, $name: 'one');
        $meta = nexus::rest::Meta();
        $meta->with('cached', json::bool(true));
        $ctx = nexus::rest::TransformerContext();
        $t = $payload->get<TItemTransformer>();
        return nexus::Reply::of($payload, $t->createResponse($payload, $one, $meta, $ctx));
    }, $bound, $w));
    $s->route(nexus::Route($get, '/deep', 'TDeep', function(nexus::Payload& $payload) : nexus::Response {
        $top = TOwner(1, 'top');
        $at = $top;
        foreach (2 .. 20 as $i) {
            $next = TOwner($i as int64, 'next');
            $at->boss = $next;
            $at = $next;
        }
        // every level asked for: past the depth limit the boss is left out
        array<string> $paths = [];
        string $path = 'boss';
        foreach (0 .. 20 as $_) {
            $paths[] = $path;
            $path = "{$path}.boss";
        }
        array<TOwner> $owners = [$top];
        $none = nexus::rest::Meta();
        $t = $payload->get<TOwnerTransformer>();
        return $t->createCollectionResponse($payload, $owners, $none, EchoPack::Rest::Includes::of($paths));
    }, $bound, $w));
}

internal function tApp() : TestApp
{
    array<nexus::Extension> $exts = [TApp()];
    return TestApp($exts);
}

test an_item_answers_as_json_by_default
{
    $r = tApp()->client()->get('/item');
    $r->assertStatus(200)->assertHeader('Content-Type', 'application/json; charset=utf-8');
    $r->assertBody('{"data":{"id":1,"name":"one","tags":["a","b"]}}');
}

test xml_when_the_request_prefers_it
{
    $r = tApp()->client()->with('Accept', 'application/xml')->get('/item?include=owner');
    $r->assertStatus(200)->assertHeader('Content-Type', 'application/xml; charset=utf-8');
    $r->assertBody('<?xml version="1.0" encoding="UTF-8"?><response><data id="1"><name>one</name><tags><tag>a</tag><tag>b</tag></tags><owner id="7"><name>Ann</name></owner></data></response>');
}

test lists_carry_their_meta_first
{
    $list = tApp()->client()->get('/items');
    $list->assertStatus(200)->assertBody('{"total":41,"data":[{"id":1,"name":"one","tags":[]},{"id":2,"name":"two","tags":[]}]}');
    $xml = tApp()->client()->with('Accept', 'application/xml')->get('/items');
    $xml->assertBodyContains('<total>41</total><data><item id="1"><name>one</name><tags/></item>');
}

test includes_are_checked_against_the_transformer
{
    $app = tApp();
    array<string> $owner = ['data', 'owner', 'name'];
    $app->client()->get('/item?include=owner')->assertStatus(200)->assertJson($owner, 'Ann');
    $app->client()->get('/item?include=owner.boss')->assertStatus(200)->assertBody('{"data":{"id":1,"name":"one","tags":["a","b"],"owner":{"id":7,"name":"Ann","boss":null}}}');
    $app->client()->get('/item?include=secrets')->assertProblem(400)->assertBodyContains('secrets');
    $app->client()->get('/item?include=..')->assertProblem(400);
}

test nesting_stops_at_the_limit
{
    $r = tApp()->client()->get('/deep');
    $r->assertStatus(200);
    // eight levels of boss below the top one, the ninth left out
    array<string> $eighth = ['data', '0', 'boss', 'boss', 'boss', 'boss', 'boss', 'boss', 'boss', 'boss', 'id'];
    $r->assertJson($eighth, 9);
    $r->assertBodyContains('"id":9,"name":"next"}');
}

test the_context_reaches_nested_transformers
{
    $app = tApp();
    $app->client()->get('/viewed?include=owner')->assertStatus(200)->assertBody('{"data":{"id":1,"name":"one","tags":[],"owner":{"id":7,"name":"Ann","mine":true}}}');
    // without a context nothing knows the viewer
    $app->client()->get('/item?include=owner')->assertBodyContains('"owner":{"id":7,"name":"Ann"}}');
}

test a_context_keeps_one_value_per_type
{
    $ctx = nexus::rest::TransformerContext();
    expect($ctx->has<TViewer>())->no(says: 'a fresh context holds no viewer');
    expect($ctx->find<TViewer>())->none();
    $ctx->set<TViewer>($id: 1);
    $ctx->set<TViewer>($id: 2);
    $ctx->set<string>('other');
    expect($ctx->has<TViewer>())->yes(says: 'the context holds a viewer');
    expect($ctx->get<TViewer>()->id)->is(2);
    expect($ctx->get<string>())->is('other');
}

test the_network_resolves_cycles
{
    $app = tApp();
    $app->client()->get('/cycle?include=owner.items')->assertStatus(200)->assertBody('{"data":{"id":1,"name":"one","tags":[],"owner":{"id":7,"name":"Ann","items":[{"id":2,"name":"two","tags":[]}]}}}');
}

test a_network_holds_one_transformer_per_model
{
    $net = nexus::rest::TransformerNetwork();
    expect($net->has<TOwner>())->no(says: 'a fresh network holds no TOwner transformer');
    expect($net->find<TOwner>())->none();
    $net->add<TOwner>(TOwnerTransformer());
    expect($net->has<TOwner>())->yes(says: 'the network holds the added TOwner transformer');
    expect($net->has<TItem>())->no(says: 'the network holds no TItem transformer');
    expect($net->get<TOwner>() instanceof TOwnerTransformer)->yes(says: 'the TOwner transformer is a TOwnerTransformer');
}

test a_reference_carries_meta_next_to_its_data
{
    $app = tApp();
    $app->client()->get('/cycle?include=holder')->assertStatus(200)->assertBody('{"data":{"id":1,"name":"one","tags":[],"holder":{"is_cached":true,"data":{"id":7,"name":"Ann"}}}}');
    $app->client()->with('Accept', 'application/xml')->get('/cycle?include=holder')->assertBody('<?xml version="1.0" encoding="UTF-8"?><response><data id="1"><name>one</name><tags/><holder><is_cached>true</is_cached><data id="7"><name>Ann</name></data></holder></data></response>');
}

test a_reference_to_nothing_keeps_its_meta
{
    tApp()->client()->get('/orphan?include=holder')->assertStatus(200)->assertBody('{"data":{"id":1,"name":"one","tags":[],"holder":{"is_cached":true,"data":null}}}');
}

test an_item_answer_carries_meta_first
{
    tApp()->client()->get('/cached')->assertStatus(200)->assertBody('{"cached":true,"data":{"id":1,"name":"one","tags":[]}}');
}

test an_item_replaces_in_place_and_appends_new_keys
{
    $item = nexus::rest::Item();
    $item->text('a', '1');
    $item->int('b', 2);
    $item->text('a', 'again');
    $item->bool('c', true);
    $item->remove('b');
    $item->remove('missing');
    expect($item->keys())->is(['a', 'c']);
    expect($item->has('a'))->yes(says: 'the item keeps a');
    expect($item->has('b'))->no(says: 'the item dropped b');
}

test an_item_writes_attributes_first_and_includes_last
{
    $item = nexus::rest::Item();
    $item->text('name', 'one');
    $item->attribute('id', 1);
    $item->nil('gone');
    $o = nexus::rest::Out(EchoPack::Rest::Format::json, EchoPack::Rest::Includes());
    $ctx = nexus::rest::TransformerContext();
    $none = nexus::rest::Meta();
    $o->begin($none);
    $o->open('thing');
    $item->flush($o, $ctx);
    $o->close();
    expect($o->end()->body)->is('{"data":{"id":1,"name":"one","gone":null}}');
}

test an_include_the_request_did_not_ask_for_is_left_out
{
    $item = nexus::rest::Item();
    TOwner? $none = null;
    $item->include<TOwner>('boss', $none);
    expect($item->has('boss'))->no(says: 'the unasked include boss is left out');
}

test a_revealed_sensitive_key_is_written
{
    $item = nexus::rest::Item();
    $item->protect(['email']);
    $item->reveal('email');
    $item->text('email', 'ann@example.com');
    expect($item->has('email'))->yes(says: 'the revealed email is written');
}

#[tests: expects death]
test a_sensitive_key_without_reveal_stops_the_program
{
    $item = nexus::rest::Item();
    $item->protect(['email']);
    $item->text('email', 'ann@example.com');
}
