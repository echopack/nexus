/*
 * nexus-ecotest: an ecotest-http transport that hands requests straight to a nexus kernel. The
 * same `Api` tests then run in process, with no socket, and coverage counts the app's code.
 *
 * vendor/ is checked in as two symlinks, not filled by epm: vendor/echolang/libjson and
 * vendor/echolang/libcurl point at ../../../../../libjson and ../../../../../libcurl, the same
 * checkouts nexus itself depends on. echoc refuses two modules with one name, so ecotest-http's
 * `requires` has to resolve to nexus's own libjson. Do not run `epm install` here; it would
 * replace the links with a second copy. The lasting fix is for nexus core to `requires` libjson
 * and libcommand instead of depending on sibling paths.
 */

#[module: "nexus-ecotest"]
#[version: "0.1.0"]
#[epm::license: "MIT"]
#[epm::description: "Run ecotest-http tests against a nexus app in process"]

#[depends: "../.."]
#[depends: "../../../ecotest/modules/http"]

#[sources: "src/*.eco"]

#[target: test] {
    #[sources: "tests/*.eco"]
    #[depends: "../testing"]
    #[depends: "../../../container"]
}
