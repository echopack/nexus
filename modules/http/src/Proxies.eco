namespace nexus::http;

/**
 * The reverse proxies whose `X-Forwarded-For` is believed. Everything after the app's own proxies
 * is the client's to write, so the header is read from the right and the first address that is not
 * a trusted proxy is the client. An entry is an address or a range (`10.0.0.0/8`, `fd00::/8`), for
 * load balancers whose addresses change.
 */
public struct Proxies
{
    public array<string> $trusted = [];
    private array<AddressRange> $ranges = [];

    /**
     * No proxy: every request comes from its socket peer.
     */
    public constructor()
    {
    }

    /**
     * The addresses of a comma separated list: `Proxies(parse: '10.0.0.2, 10.0.0.3')`.
     */
    public constructor(parse: const string& $list)
    {
        foreach (str::split($list, ',') as const &$part) {
            $address = string::from(str::trim($part));
            if ($address->empty()) {
                continue;
            }
            AddressRange? $range = AddressRange::parse($address);
            if ($range != null) {
                AddressRange $r = guard $range;
                $this->ranges[] = $r;
            }
            $this->trusted[] = mv $address;
        }
    }

    public const function trusts(const string& $address) : bool
    {
        foreach ($this->trusted as const &$t) {
            if ($t == $address) {
                return true;
            }
        }
        foreach ($this->ranges as const &$r) {
            if ($r->holds($address)) {
                return true;
            }
        }
        return false;
    }

    /**
     * The address a request from socket peer `$peer` (`address:port`) comes from, without a port
     * (it changes with every connection): the peer's unless it is a trusted proxy, else the
     * rightmost address of `$forwarded` that is not one.
     */
    public const function client(const string& $peer, const string& $forwarded) : string
    {
        $address = Proxies::address($peer);
        return $this->client(address: $address, trusted: $this->trusts($address), $forwarded);
    }

    /**
     * `client` for a peer already stripped to `$address` and checked against the trusted list, so
     * the transport asks `trusts` once for the address and the scheme.
     */
    public const function client(address: const string& $address, trusted: bool $trusted, const string& $forwarded) : string
    {
        if (!$trusted || $forwarded->empty()) {
            return $address;
        }
        array<string> $hops = [];
        foreach (str::split($forwarded, ',') as const &$part) {
            $hops[] = Proxies::hop(string::from(str::trim($part)));
        }
        usize $i = $hops->count();
        while ($i > 0) {
            $i = $i - 1;
            if (!$hops[$i]->empty() && !$this->trusts($hops[$i])) {
                return $hops[$i];
            }
        }
        return $address;
    }

    /**
     * `https` when the peer is a `$trusted` proxy and the last entry of `$forwarded`
     * (X-Forwarded-Proto) says so, else `http`. The last entry is the one the app's own proxy
     * wrote; one that appends instead of replacing leaves the client's own guess before it.
     */
    public static function scheme(trusted: bool $trusted, const string& $forwarded) : string
    {
        if (!$trusted) {
            return 'http';
        }
        string $last = '';
        foreach (str::split($forwarded, ',') as const &$part) {
            $entry = str::trim($part);
            if (!$entry->empty()) {
                $last = string($entry);
            }
        }
        if (str::iequals($last, 'https')) {
            return 'https';
        }
        return 'http';
    }

    /**
     * One `X-Forwarded-For` entry as a bare address. Some proxies write the port too
     * (`203.0.113.9:51234`, `[2001:db8::1]:443`), and it changes with every connection, so a
     * bracketed IPv6 entry loses its brackets and port and an IPv4 one (exactly one colon) loses its
     * port. A bare IPv6 entry has more colons and stays as it is.
     */
    public static function hop(const string& $entry) : string
    {
        if ($entry->starts('[')) {
            usize $close = $entry->find(']');
            if ($close < $entry->size()) {
                return $entry->sub(1, $close - 1)->clone();
            }
            return $entry;
        }
        usize $colon = $entry->find(':');
        if ($colon < $entry->size() && $entry->find(':', $colon + 1) == $entry->size()) {
            return $entry->sub(0, $colon)->clone();
        }
        return $entry;
    }

    /**
     * `$peer` without its port, and an IPv6 one without its brackets (`[::1]:5000` is `::1`), the
     * way `X-Forwarded-For` and the trusted list spell it.
     */
    public static function address(const string& $peer) : string
    {
        if ($peer->starts('[')) {
            usize $close = $peer->find(']');
            if ($close < $peer->size()) {
                return $peer->sub(1, $close - 1)->clone();
            }
        }
        usize $i = $peer->size();
        while ($i > 0) {
            $i = $i - 1;
            if ($peer->byte($i) == 58) {
                return $peer->sub(0, $i)->clone();
            }
        }
        return $peer;
    }
}
