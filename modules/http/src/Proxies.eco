namespace nexus::http;

/**
 * The reverse proxies whose `X-Forwarded-For` is believed. Everything
 * after the app's own proxies is the client's to write, so the header is
 * read from the right and the first address that is not a trusted proxy
 * is the client.
 */
public struct Proxies
{
    public array<string> $trusted = array<string>();

    /**
     * The addresses of a comma separated list.
     */
    public static function parse(const string& $list) : Proxies
    {
        Proxies $p = Proxies();
        foreach (str::split($list, ',') as const &$part) {
            string $address = string::from(str::trim($part));
            if (!$address->empty()) {
                $p->trusted[] = $address;
            }
        }
        return $p;
    }

    public const function trusts(const string& $address) : bool
    {
        foreach ($this->trusted as const &$t) {
            if ($t == $address) {
                return true;
            }
        }
        return false;
    }

    /**
     * Who a request from socket peer `$peer` (`address:port`) comes from:
     * the peer itself unless it is a trusted proxy, else the rightmost
     * address of `$forwarded` that is not one.
     */
    public const function client(const string& $peer, const string& $forwarded) : string
    {
        string $address = Proxies::address($peer);
        if (!$this->trusts($address) || $forwarded->empty()) {
            return $peer;
        }
        array<string> $hops = [];
        foreach (str::split($forwarded, ',') as const &$part) {
            $hops[] = string::from(str::trim($part));
        }
        usize $i = $hops->count();
        while ($i > 0) {
            $i = $i - 1;
            if (!$hops[$i]->empty() && !$this->trusts($hops[$i])) {
                return $hops[$i];
            }
        }
        return $address;
    }

    /**
     * `$peer` without its port.
     */
    public static function address(const string& $peer) : string
    {
        usize $i = $peer->size();
        while ($i > 0) {
            $i = $i - 1;
            if ($peer->byte($i) == 58) {
                return $peer->sub(0, $i)->clone();
            }
        }
        return $peer;
    }
}
