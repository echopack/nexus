namespace nexus::http;

/**
 * The HTTP settings: `HTTP_TRUSTED_PROXIES`, the addresses of the reverse proxies in front of the
 * app, comma separated. A request from one of them comes from the client its `X-Forwarded-For`
 * names; from anywhere else the header is ignored.
 */
#[nexus::config: "http"]
public struct HttpConfig
{
    public string $trustedProxies = '';
}
