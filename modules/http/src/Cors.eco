namespace nexus::http;

/**
 * Cross-origin resource sharing. Answers preflight requests itself and adds the allow headers to
 * every response for an allowed origin, and `Vary: Origin` to every response unless the list is a
 * plain `*`. Add it first in an extension's `middleware` hook:
 *
 *     array<string> $origins = ['https://app.example.com'];
 *     $p->add(nexus::http::Cors($origins));
 */
#[atomic]
public class Cors : nexus::Middleware
{
    private array<string> $origins;
    public array<string> $methods = ['GET', 'HEAD', 'POST', 'PUT', 'PATCH', 'DELETE'];
    public array<string> $headers = ['Content-Type', 'Authorization', 'X-Request-Id'];
    public array<string> $expose = ['X-Request-Id'];
    public bool $credentials = false;
    public int64 $maxAge = 600;

    /**
     * Allows `$origins` exactly; `*` allows any origin (and then never sends credentials).
     */
    public constructor(array<string> $origins)
    {
        $this->origins = mv $origins;
    }

    public function handle(nexus::Payload& $payload, nexus::Next $next) : nexus::Response
    {
        $origin = guard $payload->request->header('Origin') else {
            $r = $next->run($payload);
            $this->vary($r);
            return $r;
        };
        if (!$this->allows($origin)) {
            $r = $next->run($payload);
            $this->vary($r);
            return $r;
        }
        bool $preflight = $payload->request->method == nexus::Method::options && $payload->request->header('Access-Control-Request-Method') != null;
        if ($preflight) {
            $r = nexus::Response(204);
            $this->stamp($r, $origin);
            $this->vary($r);
            $r->header('Access-Control-Allow-Methods', str::join($this->methods, ', '));
            $r->header('Access-Control-Allow-Headers', str::join($this->headers, ', '));
            $r->header('Access-Control-Max-Age', str::from($this->maxAge));
            return $r;
        }
        $r = $next->run($payload);
        $this->stamp($r, $origin);
        $this->vary($r);
        if (!$this->expose->empty()) {
            $r->header('Access-Control-Expose-Headers', str::join($this->expose, ', '));
        }
        return $r;
    }

    public const function allows(const string& $origin) : bool
    {
        foreach ($this->origins as const &$o) {
            if ($o == '*' || $o == $origin) {
                return true;
            }
        }
        return false;
    }

    private const function stamp(nexus::Response& $r, const string& $origin) : void
    {
        bool $any = $this->any();
        if ($any && !$this->credentials) {
            $r->header('Access-Control-Allow-Origin', '*');
        } else {
            $r->header('Access-Control-Allow-Origin', $origin);
        }
        if ($this->credentials && !$any) {
            $r->header('Access-Control-Allow-Credentials', 'true');
        }
    }

    /**
     * Whether the allow list holds `*`.
     */
    private const function any() : bool
    {
        foreach ($this->origins as const &$o) {
            if ($o == '*') {
                return true;
            }
        }
        return false;
    }

    /**
     * Adds `Origin` to the response's `Vary`, kept after what is there already. The answer depends
     * on the request's origin whether or not it is allowed, so a cache must not hand one origin's
     * answer (or the answer to no origin) to another. A plain `*` without credentials answers every
     * origin the same and varies on nothing.
     */
    private const function vary(nexus::Response& $r) : void
    {
        if ($this->any() && !$this->credentials) {
            return;
        }
        array<string> $lines = $r->headers->all('Vary');
        foreach ($lines as const &$line) {
            foreach (str::split($line, ',') as const &$part) {
                $token = str::trim($part);
                if (str::iequals($token, 'Origin') || $token == '*') {
                    return;
                }
            }
        }
        $lines[] = 'Origin';
        $r->header('Vary', str::join($lines, ', '));
    }
}
