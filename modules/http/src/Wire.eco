namespace nexus::http;

use http;

/**
 * Converts between libhttp's request and response and nexus's own.
 */
public struct Wire
{
    /**
     * The nexus method of a wire method, or null for a verb nexus does not route.
     */
    public static function method(const http::Method& $m) : nexus::Method?
    {
        return match ($m) {
            http::Method::get => nexus::Method::get,
            http::Method::post => nexus::Method::post,
            http::Method::put => nexus::Method::put,
            http::Method::patch => nexus::Method::patch,
            http::Method::delete => nexus::Method::delete,
            http::Method::head => nexus::Method::head,
            http::Method::options => nexus::Method::options,
            http::Method::other($name) => nexus::Method::parse($name),
        };
    }

    /**
     * The nexus request for a wire request, or null for an unknown verb.
     */
    public static function request(const http::Request& $in) : nexus::Request?
    {
        return Wire::request($in, Proxies());
    }

    /**
     * The nexus request for a wire request, its peer the client behind `$proxies`, or null for an
     * unknown verb.
     */
    public static function request(const http::Request& $in, const Proxies& $proxies) : nexus::Request?
    {
        $m = guard Wire::method($in->method) else {
            return null;
        };
        $r = nexus::Request($m, $in->target);
        $r->path = $in->path;
        $r->queryString = $in->queryString;
        // nexus's own parser, so a test request built from the same target reads the same query
        $r->query = nexus::Query(parse: $in->queryString);
        foreach ($in->headers->items as const &$h) {
            $r->headers->add($h->name, $h->value);
        }
        $r->body = $in->body;
        string $address = Proxies::address($in->peer);
        bool $trusted = $proxies->trusts($address);
        $r->peer = $proxies->client(address: $address, trusted: $trusted, Wire::forwarded($r->headers, 'X-Forwarded-For'));
        $r->scheme = Proxies::scheme(trusted: $trusted, Wire::forwarded($r->headers, 'X-Forwarded-Proto'));
        return $r;
    }

    /**
     * Every line of a forwarding header as one list, in the order they came. A proxy that adds a
     * line of its own instead of extending the client's leaves the client's first, so reading the
     * first line alone would believe the client.
     */
    internal static function forwarded(const nexus::Headers& $headers, const string& $name) : string
    {
        array<string> $lines = $headers->all($name);
        return str::join($lines, ', ');
    }

    /**
     * The wire response for a nexus response: a streamed one streams, chunked; a file body goes
     * out from the file, with sendfile where it can; an event stream opens an outlet; a websocket
     * upgrades. An answer to HEAD says the length of the body it left out, or no length when that
     * was a stream.
     */
    public static function response(const nexus::Response& $out) : http::Response
    {
        $r = http::Response($out->status, $out->body);
        if ($out->omitted != null) {
            int64 $length = guard $out->omitted;
            // libhttp never runs the stream of an answer to HEAD, it only frames the head with it
            $none = function(http::Writer $w) : void {
            };
            if ($length >= 0) {
                $r = http::Response(stream: $none, length: $length as usize);
            } else {
                $r = http::Response(stream: $none);
            }
            $r->status = $out->status;
        } else if ($out->events != null) {
            nexus::EventHooks $hooks = guard $out->events;
            $r = http::Response(events: Wire::feed($hooks));
            $r->status = $out->status;
        } else if ($out->websocket != null) {
            nexus::SocketHooks $hooks = guard $out->websocket;
            $r = http::Response(websocket: Wire::channel($hooks), protocol: $out->protocol);
        } else if ($out->file != null) {
            nexus::FileBody $f = guard $out->file;
            $r = http::Response(file: $f->path, offset: $f->offset, length: $f->length);
            // the file went away or shrank since it was looked at: libhttp's own answer stands, with
            // nexus's headers (request id, CORS, security) but not the ones that describe the file
            if ($r->status != 200) {
                foreach ($out->headers->items as const &$h) {
                    if (!Wire::describes($h->name)) {
                        $r->headers->add($h->name, $h->value);
                    }
                }
                return $r;
            }
            $r->status = $out->status;
            // the nexus response says these itself; libhttp's own would go out twice
            $r->headers->remove('Content-Type');
            $r->headers->remove('Content-Range');
        } else if ($out->stream != null) {
            function<void(nexus::Writer)> $fn = guard $out->stream;
            $r = http::Response(stream: function[$fn](http::Writer $w) : void {
                $fn(WireWriter($w));
            });
            $r->status = $out->status;
        }
        foreach ($out->headers->items as const &$h) {
            $r->headers->add($h->name, $h->value);
        }
        return $r;
    }

    /**
     * Whether `$name` is a header that describes a file body, which libhttp's own error answer
     * says for itself.
     */
    internal static function describes(const string& $name) : bool
    {
        return str::iequals($name, 'Content-Type') || str::iequals($name, 'Content-Range') || str::iequals($name, 'Content-Length');
    }

    /**
     * libhttp's hooks for an event stream, each outlet handed on as a nexus stream.
     */
    public static function feed(nexus::EventHooks $hooks) : http::Feed
    {
        $feed = http::Feed();
        $feed->onOpen(function[$hooks](http::Outlet $o) : void {
            $hooks->open(WireEventStream($o));
        });
        $feed->onClose(function[$hooks](http::Outlet $o) : void {
            $hooks->close(WireEventStream($o));
        });
        return $feed;
    }

    /**
     * libhttp's hooks for a websocket, each socket handed on as a nexus socket.
     */
    public static function channel(nexus::SocketHooks $hooks) : http::Channel
    {
        $channel = http::Channel();
        $channel->onOpen(function[$hooks](http::Socket $s) : void {
            $hooks->opened(WireSocket($s));
        });
        $channel->onMessage(function[$hooks](http::Socket $s, http::Message $m) : void {
            nexus::SocketMessage $msg = match ($m) {
                http::Message::text($t) => nexus::SocketMessage::text($t),
                http::Message::binary($b) => nexus::SocketMessage::binary($b),
            };
            $hooks->received(WireSocket($s), $msg);
        });
        $channel->onClose(function[$hooks](http::Socket $s, http::Close $c) : void {
            $hooks->closed(WireSocket($s), nexus::SocketClose($c->code, $c->reason, $c->clean));
        });
        return $channel;
    }
}
