/**
 * Wire conversions between libhttp and nexus.
 */

use ecotest::expect;
use nexus::http::Wire;

test request_converts
{
    $q = http::Query();
    $q->add('page', '2');
    $h = http::Headers();
    $h->add('Content-Type', 'application/json');
    $in = http::Request(http::Method::post, '/v1/posts?page=2', '/v1/posts', 'page=2', mv $q, 'HTTP/1.1', mv $h, '{}', '127.0.0.1:5000');
    $r = expect(Wire::request($in))->some();
    expect($r->method == nexus::Method::post)->yes(says: 'the method converted to post');
    expect($r->path)->is('/v1/posts');
    expect($r->query->get('page'))->some('2');
    expect($r->contentType())->is('application/json');
    expect($r->body)->is('{}');
    expect($r->peer)->is('127.0.0.1');
}

test unknown_verb_is_null
{
    $in = http::Request(http::Method::other('BREW'), '/', '/', '', http::Query(), 'HTTP/1.1', http::Headers(), '', '');
    expect(Wire::request($in))->none();
}

test response_converts
{
    $out = nexus::Response(text: 'hi', status: 201);
    $out->headers->add('Set-Cookie', 'a=1');
    $out->headers->add('Set-Cookie', 'b=2');
    $r = Wire::response($out);
    expect($r->status)->is(201);
    expect($r->body)->is('hi');
    expect($r->headers->all('Set-Cookie'))->size(2);
}

internal function forwarded(const string& $peer, const string& $xff) : http::Request
{
    $h = http::Headers();
    if (!$xff->empty()) {
        $h->add('X-Forwarded-For', $xff);
    }
    return http::Request(http::Method::get, '/', '/', '', http::Query(), 'HTTP/1.1', mv $h, '', $peer);
}

test a_trusted_proxy_names_the_client
{
    $p = nexus::http::Proxies(parse: ' 10.0.0.2, 10.0.0.3 ,');
    expect($p->trusted)->size(2);
    $r = expect(Wire::request(forwarded('10.0.0.2:40000', '203.0.113.9'), $p))->some();
    expect($r->peer)->is('203.0.113.9');
    // what the client wrote itself stays to the left of what the proxies added
    $chain = expect(Wire::request(forwarded('10.0.0.2:40000', '1.1.1.1, 203.0.113.9, 10.0.0.3'), $p))->some();
    expect($chain->peer)->is('203.0.113.9');
}

test anyone_else_cannot_claim_an_address
{
    $p = nexus::http::Proxies(parse: '10.0.0.2');
    $r = expect(Wire::request(forwarded('198.51.100.7:5000', '203.0.113.9'), $p))->some();
    expect($r->peer)->is('198.51.100.7');
    $none = expect(Wire::request(forwarded('10.0.0.2:40000', ''), $p))->some();
    expect($none->peer)->is('10.0.0.2');
    $all = expect(Wire::request(forwarded('10.0.0.2:40000', '10.0.0.2'), $p))->some();
    expect($all->peer)->is('10.0.0.2');
    $plain = expect(Wire::request(forwarded('10.0.0.2:40000', '203.0.113.9')))->some();
    expect($plain->peer)->is('10.0.0.2');
}
