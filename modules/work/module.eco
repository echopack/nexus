/*
 * nexus-work: tasks, async and distributed queues, pipelines and a
 * scheduler for nexus apps.
 *
 * A task is a struct conforming to `nexus::work::Task`: its fields are its
 * data, its `handle(nexus::Payload&)` the work, and it says for itself how
 * often it is tried, whether it is exclusive (`.running` or `.unique`, on a
 * key), whether the tasks after it may go on when it fails, its priority,
 * its expiry and where its runs log. The same value runs inline on the
 * caller's payload (`Inline::run`), on an async queue (threads in this
 * process, kept in memory), or on a distributed queue (stored where every
 * server reaches it, claimed under a lease and fed into an async queue).
 * Tasks pushed together as a `Pipeline` wait for the ones they name; a task
 * may spawn more while it runs. `nexus gen` writes a codec per task, so a
 * distributed queue can store it. The scheduler pushes task values on an
 * `every` or `cron` schedule into a lane, once per slot across servers.
 *
 * A queue is named by a lane, an empty struct, and bound with nexus-app:
 *
 *   public struct WorkerLane : nexus::work::Lane {}
 *   public type WorkerQueue = nexus::work::AsyncQueue<WorkerLane>;
 *
 *   $app->bindAsyncQueue<WorkerLane>();   // NEXUS_WORK_THREADS threads, or threads: 4
 *   $app->bindDistributedQueue<JobLane>(store: nexus::work::MemoryStore())->into<WorkerLane>();
 *   $app->schedule(PruneAuth())->cron('0 3 * * *')->into<JobLane>();
 *
 * The store here is kept in memory (`MemoryStore`); nexus-work-carbon keeps
 * it in the app's database.
 */

#[module: "nexus-work"]
#[version: "0.1.0"]
#[epm::license: "MIT"]
#[epm::description: "Tasks, async and distributed queues, pipelines and a scheduler for nexus apps"]

#[depends: "../.."]
#[requires: "echopack/container" { version: "^0.1.0", source: git "https://github.com/echopack/container" }]
#[requires: "echolang/libjson" { version: "^0.3.0", source: git "https://github.com/echolang/libjson" }]
#[requires: "echopack/calendar" { version: "^0.1.2", source: git "https://github.com/echopack/calendar" }]

#[hook: before_build { run: "nexus", args: ["gen"] }]

#[sources: "src/*.eco"]
#[if: !NEXUS_NOGEN]
#[sources: ".nexus/*.eco"]
#[end]

#[target: test] {
    #[depends: "../testing"]
    #[sources: "tests/*.eco"]
}
