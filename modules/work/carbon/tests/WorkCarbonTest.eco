/**
 * nexus-work's queue in a carbon database, on carbon's fake driver: each test queues what the
 * database answers and reads back what was sent.
 */

use nexus::work::{Kind, Failure, Queue, StoredTask, Runner, Work, Pushed, Requeued};
use nexus::work::carbon::{QueuedTask, QueuedTaskTable, CarbonQueue};
use nexus::testing::TestApp;
use carbon::fake;
use hydrahon::Mysql;
use std::time;
use ecotest::expect;

internal const int64 START = 1793588340;

internal function quiet() : Kind
{
    return Kind('TQuiet', function(nexus::Payload& $payload, const string& $data) : status<Failure> {
        return .ok;
    });
}

internal class Rig
{
    public fake::Driver<Mysql> $fake;
    public calendar::ManualClock $clock;
    public TestApp $app;

    public constructor(bool $register)
    {
        $driver = fake::Driver<Mysql>();
        $clock = calendar::ManualClock(time::timestamp::from_unix_secs(START));
        $this->fake = $driver;
        $this->clock = $clock;
        $db = nexus::carbon::Extension(function[$driver, $clock, $register](nexus::carbon::DatabaseConfig $cfg) : result<carbon::DB, carbon::Error> {
            $made = carbon::DB($driver, clock: $clock);
            if ($register) {
                try nexus::work::carbon::Tables::wire($made);
            }
            return .ok($made);
        });
        array<Kind> $kinds = [quiet()];
        array<nexus::Extension> $exts = [$db, nexus::work::Extension(stores: .provided, clock: $clock, tasks: mv $kinds), nexus::work::carbon::Extension()];
        $this->app = TestApp($exts);
    }

    public function queue() : Queue
    {
        nexus::Payload $payload = $this->app->kernel->background('test', 'q');
        return $payload->get<Queue>();
    }

    public function task(const string& $key) : StoredTask
    {
        time::timestamp $now = $this->clock->now();
        return StoredTask($id: 'j1', $name: 'TQuiet', $queue: 'default', $data: '{}', $tries: 3, $key: $key, $createdAt: $now, $availableAt: $now);
    }
}

internal function claimOne(Queue $q, time::timestamp $now) : StoredTask?
{
    array<string> $queues = ['default', 'mail'];
    StoredTask? $j = guard $q->claim($queues, $now, $now + time::duration::mins(5));
    return $j;
}

/**
 * Whether the queue stored `$j`.
 */
internal function pushOne(Queue $q, const StoredTask& $j) : bool
{
    Pushed $p = guard $q->push($j);
    return $p == Pushed::stored;
}

test a_push_inserts_a_row
{
    $r = Rig(true);
    $r->fake->written();
    expect(pushOne($r->queue(), $r->task('')))->yes(says: 'the push is stored');
    expect($r->fake->count())->is(1);
    expect($r->fake->last())->starts('INSERT INTO `nexus_tasks`');
}

test a_keyed_push_is_stored_once
{
    $r = Rig(true);
    $r->fake->rows([])->written();
    expect(pushOne($r->queue(), $r->task('TQuiet@1')))->yes(says: 'the first keyed push is stored');
    expect($r->fake->texts()[0])->has('WHERE `nexus_tasks`.`unique_key` = ?');
    $r->fake->rows([QueuedTaskTable()->row(QueuedTask::of($r->task('TQuiet@1')))]);
    usize $before = $r->fake->count();
    expect(pushOne($r->queue(), $r->task('TQuiet@1')))->no(says: 'a push with a stored key is not stored again');
    expect($r->fake->count())->is($before + 1);
}

test a_claim_takes_a_due_row_by_its_attempt
{
    $r = Rig(true);
    $r->fake->rows([QueuedTaskTable()->row(QueuedTask::of($r->task('')))])->written(1);
    StoredTask $j = expect(claimOne($r->queue(), $r->clock->now()))->some();
    expect($j->id)->is('j1');
    expect($j->attempts)->is(1);
    string $select = $r->fake->texts()[0];
    expect($select)
        ->has('`nexus_tasks`.`queue` IN (?, ?)')
        ->has('`nexus_tasks`.`done_at` IS NULL')
        ->has('`nexus_tasks`.`reserved_until` IS NULL OR `nexus_tasks`.`reserved_until` < ?')
        ->has('ORDER BY `nexus_tasks`.`available_at` ASC LIMIT 5');
    expect($r->fake->last())->is('UPDATE `nexus_tasks` SET `attempts` = ?, `reserved_until` = ? WHERE `nexus_tasks`.`id` = ? AND `nexus_tasks`.`attempts` = ?');
}

test a_claim_lost_to_another_worker_moves_on
{
    $r = Rig(true);
    $r->fake->rows([QueuedTaskTable()->row(QueuedTask::of($r->task('')))])->written(0);
    expect(claimOne($r->queue(), $r->clock->now()))->none();
}

test the_runner_claims_runs_and_deletes
{
    $r = Rig(true);
    $r->fake->rows([QueuedTaskTable()->row(QueuedTask::of($r->task('')))])->written(1)->written(1);
    expect(Runner::step($r->app->kernel, $r->app->kernel->services->get<Work>()))->yes(says: 'the runner ran a task');
    expect($r->fake->last())->is('DELETE FROM `nexus_tasks` WHERE `nexus_tasks`.`id` = ? AND `nexus_tasks`.`attempts` = ?');
    expect($r->fake->pending())->is(0);
    expect($r->app->logged('task done'))->yes(says: "the log holds 'task done'");
}

test a_done_scheduled_run_is_kept
{
    $r = Rig(true);
    $r->fake->written(1);
    StoredTask $j = $r->task('TQuiet@1');
    $j->attempts = 1;
    guard $r->queue()->done($j, $r->clock->now());
    expect($r->fake->last())->is('UPDATE `nexus_tasks` SET `done_at` = ?, `reserved_until` = ? WHERE `nexus_tasks`.`id` = ? AND `nexus_tasks`.`attempts` = ?');
}

test failures_retries_and_prunes
{
    $r = Rig(true);
    $r->fake->written()->written()->written(1)->written(4);
    Queue $q = $r->queue();
    StoredTask $j = $r->task('');
    $j->attempts = 2;
    guard $q->retry($j, $r->clock->now(), 'busy');
    expect($r->fake->last())->is('UPDATE `nexus_tasks` SET `available_at` = ?, `reserved_until` = ?, `error` = ? WHERE `nexus_tasks`.`id` = ? AND `nexus_tasks`.`attempts` = ?');
    guard $q->fail($j, $r->clock->now(), 'gone');
    expect($r->fake->last())->starts('UPDATE `nexus_tasks` SET `failed_at` = ?');
    Requeued $sent = guard $q->again('j1', $r->clock->now());
    expect($sent == Requeued::sent)->yes(says: 'the failed task was sent back');
    expect($r->fake->last())->is('UPDATE `nexus_tasks` SET `failed_at` = ?, `attempts` = ?, `available_at` = ? WHERE `nexus_tasks`.`id` = ? AND `nexus_tasks`.`failed_at` IS NOT NULL');
    uint64 $gone = guard $q->prune($r->clock->now());
    expect($gone)->is(4);
    expect($r->fake->last())->is('DELETE FROM `nexus_tasks` WHERE `nexus_tasks`.`done_at` < ?');
}

test boot_wants_the_table_wired
{
    $driver = fake::Driver<Mysql>();
    $db = nexus::carbon::Extension(function[$driver](nexus::carbon::DatabaseConfig $cfg) : result<carbon::DB, carbon::Error> {
        return .ok(carbon::DB($driver));
    });
    array<nexus::Extension> $exts = [$db, nexus::work::Extension(stores: .provided), nexus::work::carbon::Extension()];
    expect(bootWhy($exts))->is('nexus-work-carbon: wire the tasks table on the database: nexus::work::carbon::Tables::wire($db)');
}

internal function bootWhy(array<nexus::Extension> $exts) : string
{
    guard TestApp::attempt($exts, map<string, string>()) else ($e) {
        return str::join($e->lines(), '; ');
    };
    return '';
}
