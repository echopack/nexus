/**
 * The carbon task store on carbon's fake driver: each test queues what the database answers and
 * reads back what was sent.
 */

use nexus::work::{StoredTask, Batch, Edge, Pushed, TaskStatus, Hold, Lane, Queues, Distributed};
use nexus::work::carbon::{QueuedTask, QueuedTaskTable, TaskEdge, TaskEdgeTable, Store};
use nexus::testing::TestApp;
use container::Container;
use carbon::fake;
use hydrahon::Mysql;
use std::time;
use ecotest::expect;

internal const int64 START = 1793588340;

internal struct CWorkers : Lane {}
internal struct CJobs : Lane {}

internal class CLanes : nexus::Extension
{
    public function name() : string
    {
        return 'carbon-lanes';
    }

    public function services(nexus::Services& $s) : status<nexus::BootError>
    {
        Queues::bindAsync<CWorkers>($s, threads: 1, name: 'workers');
        Distributed $d = Queues::bindDistributed<CJobs>($s, Store($s->get<carbon::DB>()), name: 'jobs');
        $d->into = 'workers';
        return .ok;
    }
}

internal class Rig
{
    public fake::Driver<Mysql> $fake;
    public calendar::ManualClock $clock;
    public TestApp $app;

    public constructor(bool $register)
    {
        $driver = fake::Driver<Mysql>();
        $clock = calendar::ManualClock(time::timestamp::from_unix_secs(START));
        $this->fake = $driver;
        $this->clock = $clock;
        $db = nexus::carbon::Extension(function[$driver, $clock, $register](nexus::carbon::DatabaseConfig $cfg) : result<carbon::DB, carbon::Error> {
            $made = carbon::DB($driver, clock: $clock);
            if ($register) {
                try nexus::work::carbon::Tables::wire($made);
            }
            return .ok($made);
        });
        array<nexus::Extension> $exts = [$db, nexus::work::Extension(clock: $clock), nexus::work::carbon::Extension(), CLanes()];
        $this->app = TestApp($exts);
    }

    public function store() : nexus::work::Store
    {
        Distributed $d = guard $this->app->kernel->services->get<nexus::work::Work>()->lanes->store('jobs');
        return $d->store;
    }

    public function task(const string& $id) : StoredTask
    {
        time::timestamp $now = $this->clock->now();
        return StoredTask($id: $id, $name: 'TQuiet', $lane: 'jobs', $data: '{}', $tries: 3, $createdAt: $now, $availableAt: $now);
    }

    /**
     * `$t` as a row the fake answers with.
     */
    public function row(const StoredTask& $t) : array<hydrahon::Value>
    {
        return QueuedTaskTable()->row(QueuedTask::of($t));
    }

    /**
     * `$t` as claimed: running, its first attempt.
     */
    public function claimed(const string& $id) : StoredTask
    {
        StoredTask $t = $this->task($id);
        $t->attempts = 1;
        $t->status = .running;
        return $t;
    }
}

internal function pushed(nexus::work::Store $s, const Batch& $b) : Pushed
{
    Pushed $p = guard $s->push($b) else ($e) {
        die("the push failed: {$e->detail(.dev)}");
    };
    return $p;
}

internal function claimed(nexus::work::Store $s, time::timestamp $now, uint32 $max) : array<StoredTask>
{
    array<StoredTask> $all = guard $s->claim('jobs', $now, $now + time::duration::mins(5), $max) else ($e) {
        die("the claim failed: {$e->detail(.dev)}");
    };
    return $all;
}

internal function fine(status<nexus::Problem> $s) : bool
{
    guard $s else ($e) {
        die("expected success: {$e->detail(.dev)}");
    };
    return true;
}

internal function bootWhy(array<nexus::Extension> $exts) : string
{
    guard TestApp::attempt($exts, map<string, string>()) else ($e) {
        return str::join($e->lines(), '; ');
    };
    return '';
}

test a_push_stores_tasks_and_edges_in_one_transaction
{
    $r = Rig(true);
    $r->fake->written()->written()->written();
    Batch $b = Batch();
    $b->tasks[] = $r->task('a');
    StoredTask $then = $r->task('b');
    $then->pending = 1;
    $b->tasks[] = $then;
    $b->edges[] = Edge('b', 'a');
    Pushed $p = pushed($r->store(), $b);
    expect($p->id())->some('a');
    array<string> $sent = $r->fake->texts();
    expect($sent)->size(5);
    expect($sent[0])->is('BEGIN');
    expect($sent[1])->starts('INSERT INTO `nexus_tasks`');
    expect($sent[3])->starts('INSERT INTO `nexus_task_edges`');
    expect($sent[4])->is('COMMIT');
}

test keyed_and_unique_pushes_are_checked_first
{
    $r = Rig(true);
    StoredTask $slot = $r->task('s');
    $slot->key = 'Tick@60';
    $r->fake->rows([])->written();
    expect(pushed($r->store(), Batch([$slot]))->queued())->yes(says: 'the first slot is stored');
    expect($r->fake->texts()[0])->has('WHERE `nexus_tasks`.`unique_key` = ?');
    $r->fake->rows([$r->row($slot)]);
    expect(pushed($r->store(), Batch([$slot]))->queued())->no(says: 'a stored slot is skipped');

    StoredTask $u = $r->task('u');
    $u->hold = .unique;
    $u->holdKey = 'TSay#5';
    $r->fake->rows([$r->row($u)]);
    expect(pushed($r->store(), Batch([$u]))->queued())->no(says: 'a live unique key is skipped');
    expect($r->fake->last())->has('WHERE `nexus_tasks`.`unique_live` = ?');
}

test a_claim_takes_due_rows_by_priority_and_attempt
{
    $r = Rig(true);
    $r->fake->rows([$r->row($r->task('a')), $r->row($r->task('b'))])->written(1)->written(0);
    array<StoredTask> $got = claimed($r->store(), $r->clock->now(), 2);
    expect($got)->size(1);
    expect($got[0]->id)->is('a');
    expect($got[0]->attempts)->is(1);
    expect($got[0]->status == TaskStatus::running)->yes(says: 'the claimed task runs');
    expect($r->fake->texts()[0])
        ->has('`nexus_tasks`.`pending` = ?')
        ->has('`nexus_tasks`.`expires_at` IS NULL OR `nexus_tasks`.`expires_at` > ?')
        ->has('ORDER BY `nexus_tasks`.`priority` DESC, `nexus_tasks`.`available_at` ASC LIMIT 12');
    expect($r->fake->texts()[1])->is('UPDATE `nexus_tasks` SET `status` = ?, `attempts` = ?, `reserved_until` = ? WHERE `nexus_tasks`.`id` = ? AND `nexus_tasks`.`attempts` = ? AND `nexus_tasks`.`status` = ?');
}

test a_running_key_is_a_lock_row
{
    $r = Rig(true);
    StoredTask $t = $r->task('a');
    $t->hold = .running;
    $t->holdKey = 'TSay';
    $r->fake->rows([$r->row($t)])->fails(.driver(carbon::Failure($fault: .duplicate, $message: 'lock_key taken')))->written(0);
    expect(claimed($r->store(), $r->clock->now(), 1))->empty();
    expect($r->fake->texts()[1])->starts('INSERT INTO `nexus_task_locks`');
    expect($r->fake->last())->is('UPDATE `nexus_task_locks` SET `holder` = ?, `held_until` = ? WHERE `nexus_task_locks`.`lock_key` = ? AND (`nexus_task_locks`.`held_until` < ? OR `nexus_task_locks`.`holder` = ?)');
}

test done_lets_the_waiting_tasks_go_and_a_stale_claim_changes_nothing
{
    $r = Rig(true);
    StoredTask $a = $r->claimed('a');
    $r->fake->written(1)->rows([TaskEdgeTable()->row(TaskEdge::of(Edge('b', 'a')))])->written(1);
    expect(fine($r->store()->done($a, $r->clock->now(), Batch())))->yes(says: 'done is stored');
    expect($r->fake->texts()[1])->starts('UPDATE `nexus_tasks` SET `status` = ?, `done_at` = ?');
    // the database counts down, so settles on two servers at once both count
    expect($r->fake->texts()[3])->is('UPDATE `nexus_tasks` SET `pending` = `nexus_tasks`.`pending` + ? WHERE `nexus_tasks`.`id` = ?');
    expect($r->fake->pending())->is(0);

    $stale = Rig(true);
    $stale->fake->written(0);
    expect(fine($stale->store()->done($a, $stale->clock->now(), Batch())))->yes(says: 'a stale done is no error');
    expect($stale->fake->texts())->size(3);
}

test retries_failures_again_and_prune
{
    $r = Rig(true);
    StoredTask $t = $r->claimed('a');
    $r->fake->written(1)->written(1);
    expect(fine($r->store()->retry($t, $r->clock->now(), 'busy')))->yes(says: 'the retry is stored');
    expect($r->fake->texts()[1])->starts('UPDATE `nexus_tasks` SET `status` = ?, `available_at` = ?, `reserved_until` = ?, `error` = ?');
    expect(fine($r->store()->fail($t, $r->clock->now(), 'gone')))->yes(says: 'the failure is stored');
    expect($r->fake->last())->is('COMMIT');

    StoredTask $failed = $r->task('a');
    $failed->status = .failed;
    $r->fake->rows([$r->row($failed)])->written(1);
    StoredTask? $sent = guard $r->store()->again('a', $r->clock->now());
    StoredTask $back = expect($sent)->some();
    expect($back->status == TaskStatus::waiting)->yes(says: 'the failed task was sent back');

    $r->fake->rows([])->rows([])->written(0);
    uint64 $gone = guard $r->store()->prune($r->clock->now(), $r->clock->now());
    expect($gone)->is(0);
}

test every_failed_task_of_a_lane_goes_back_in_one_update
{
    $r = Rig(true);
    StoredTask $a = $r->task('a');
    $a->status = .failed;
    StoredTask $b = $r->task('b');
    $b->status = .failed;
    $r->fake->rows([$r->row($a), $r->row($b)])->written(2);
    array<StoredTask> $sent = guard $r->store()->againAll('jobs', $r->clock->now());
    expect($sent)->size(2);
    expect($sent[1]->status == TaskStatus::waiting)->yes(says: 'each task sent back waits');
    expect($r->fake->last())->starts('UPDATE `nexus_tasks` SET `status` = ?');
    expect($r->fake->last())->has('`nexus_tasks`.`id` IN (?, ?)');
}

test a_unique_failed_task_goes_back_without_a_second_read
{
    $r = Rig(true);
    StoredTask $u = $r->task('u');
    $u->status = .failed;
    $u->hold = .unique;
    $u->holdKey = 'report';
    $r->fake->rows([$r->row($u)])->written(1);
    usize $before = $r->fake->count();
    array<StoredTask> $sent = guard $r->store()->againAll('jobs', $r->clock->now());
    expect($sent)->size(1);
    expect($r->fake->count())->is($before + 2);
    expect($r->fake->last())->has('`unique_live` = ?');
}

test cancelling_reads_a_level_of_the_graph_at_a_time
{
    $r = Rig(true);
    $r->fake->rows([$r->row($r->task('a'))])->written(1)
        ->rows([TaskEdgeTable()->row(TaskEdge::of(Edge('b', 'a'))), TaskEdgeTable()->row(TaskEdge::of(Edge('c', 'a')))])
        ->rows([$r->row($r->task('b')), $r->row($r->task('c'))])->written(2)->rows([]);
    usize $before = $r->fake->count();
    array<StoredTask> $gone = guard $r->store()->cancel('a', $r->clock->now());
    expect($gone)->size(3);
    expect($gone[0]->id)->is('a');
    expect($gone[2]->status == TaskStatus::cancelled)->yes(says: 'what waited for it is cancelled too');
    // a read, an update and the edges for each of the two levels
    expect($r->fake->count())->is($before + 6);
    expect($r->fake->texts()[$before + 4])->starts('UPDATE `nexus_tasks` SET `status` = ?');
    expect($r->fake->texts()[$before + 4])->has('`nexus_tasks`.`id` IN (?, ?)');
}

test a_cancel_another_server_won_answers_nothing
{
    $r = Rig(true);
    $r->fake->rows([$r->row($r->task('a'))])->written(0)->rows([]);
    usize $before = $r->fake->count();
    array<StoredTask> $gone = guard $r->store()->cancel('a', $r->clock->now());
    expect($gone)->size(0);
    expect($r->fake->count())->is($before + 3);
}

test boot_wants_the_tables_wired
{
    $driver = fake::Driver<Mysql>();
    $db = nexus::carbon::Extension(function[$driver](nexus::carbon::DatabaseConfig $cfg) : result<carbon::DB, carbon::Error> {
        return .ok(carbon::DB($driver));
    });
    array<nexus::Extension> $exts = [$db, nexus::work::Extension(), nexus::work::carbon::Extension()];
    expect(bootWhy($exts))->is('nexus-work-carbon: wire the task tables on the database: nexus::work::carbon::Tables::wire($db)');
}

test the_store_lists_recent_tasks
{
    $r = Rig(true);
    StoredTask $failed = $r->task('a');
    $failed->status = .failed;
    $r->fake->rows([$r->row($failed)]);
    array<StoredTask> $listed = guard $r->store()->recent('jobs', TaskStatus::failed, 20);
    expect($listed)->size(1);
    expect($listed[0]->id)->is('a');
    expect($r->fake->last())->has('WHERE `nexus_tasks`.`lane` = ? AND `nexus_tasks`.`status` = ?');
    expect($r->fake->last())->has('ORDER BY `nexus_tasks`.`created_at` DESC LIMIT 20');

    $r->fake->rows([]);
    array<StoredTask> $none = guard $r->store()->recent('', null, 5);
    expect($none)->size(0);
    expect($r->fake->last())->lacks('WHERE');
}
