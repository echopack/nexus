/*
 * nexus-work-carbon: nexus-work's queue in the app's carbon database.
 *
 * One table, `nexus_tasks`, in one migration the app adds to its own. A
 * task pushed during a request is written on the request's database
 * session, so it commits or rolls back with the request's own writes.
 * Workers claim a task with a conditional update on its attempt count, so
 * two workers, or two processes, never both hold it.
 */

#[module: "nexus-work-carbon"]
#[version: "0.1.0"]
#[epm::license: "MIT"]
#[epm::description: "The nexus-work queue in a carbon database"]

#[depends: "../../.."]
#[depends: ".."]
#[depends: "../../carbon"]
#[depends: "../../../../carbon"]
#[depends: "../../../../container"]
#[depends: "../../../../libjson"]

#[hook: before_build { run: "nexus", args: ["gen"] }]

#[sources: "src/*.eco"]
#[if: !NEXUS_NOGEN]
#[sources: ".nexus/*.eco"]
#[end]
#[if: !CARBON_NOGEN]
#[sources: ".carbon/*.eco"]
#[end]

#[target: test] {
    #[depends: "../../../../carbon/fake"]
    #[depends: "../../testing"]
    #[sources: "tests/*.eco"]
    #[requires: "echolang/ecotest" { version: "^0.3", source: git "https://github.com/echolang/ecotest" }]
}
