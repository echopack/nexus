/*
 * nexus-work-carbon: the store of a nexus-work distributed queue in the
 * app's carbon database.
 *
 * Three tables in one migration the app adds to its own: the tasks, what
 * they wait for, and the `.running` keys held. A task pushed during a
 * request is written on the request's database session, so it commits or
 * rolls back with the request's own writes. Servers claim a task with a
 * conditional update on its attempt count, so two of them never both hold
 * it.
 */

#[module: "nexus-work-carbon"]
#[version: "0.1.0"]
#[epm::license: "MIT"]
#[epm::description: "The nexus-work distributed queue store in a carbon database"]

#[depends: "../../.."]
#[depends: ".."]
#[depends: "../../carbon"]
#[requires: "echopack/carbon" { version: "^0.2.1", source: git "https://github.com/echopack/carbon" }]
#[requires: "echopack/container" { version: "^0.1.0", source: git "https://github.com/echopack/container" }]
#[requires: "echolang/libjson" { version: "^0.3.0", source: git "https://github.com/echolang/libjson" }]

#[hook: before_build { run: "nexus", args: ["gen"] }]

#[sources: "src/*.eco"]
#[if: !NEXUS_NOGEN]
#[sources: ".nexus/*.eco"]
#[end]
#[if: !CARBON_NOGEN]
#[sources: ".carbon/*.eco"]
#[end]

#[target: test] {
    #[requires: "echopack/carbon/fake" { version: "^0.2.1", source: git "https://github.com/echopack/carbon" }]
    #[requires: "echopack/carbon/drivers/mysql" { version: "^0.2.1", source: git "https://github.com/echopack/carbon" }]
    #[depends: "../../testing"]
    #[sources: "tests/*.eco"]
}
