namespace nexus::work::carbon;

use std::time;

/**
 * A row of `nexus_tasks`.
 */
#[carbon::model: 'nexus_tasks']
public class QueuedTask : carbon::Model<QueuedTask, QueuedTaskRepository>
{
    public carbon::Link $link = .detached();

    #[carbon::key]
    public string $id;

    public string $name;
    public string $lane;
    public string $data;
    public int64 $tries;
    public int64 $attempts = 0;
    public int64 $status = 0;
    public int64 $hold = 0;
    public string $holdKey = '';

    /**
     * The `.unique` key while the task waits or runs, null otherwise; unique, so a second live one
     * cannot be stored.
     */
    public string? $uniqueLive = null;
    public bool $allowFailure = false;
    public int64 $priority = 0;
    public int64 $pending = 0;
    public bool $released = false;
    public string $parent = '';

    /**
     * The scheduler's `name@slot`, unique; null for none.
     */
    public string? $uniqueKey = null;
    public time::timestamp $createdAt;
    public time::timestamp $availableAt;
    public time::timestamp? $expiresAt = null;
    public time::timestamp? $reservedUntil = null;
    public time::timestamp? $doneAt = null;
    public time::timestamp? $failedAt = null;
    public string $error = '';

    public function link() : carbon::Link&
    {
        return $this->link;
    }

    public static function of(const nexus::work::StoredTask& $t) : QueuedTask
    {
        string? $key = null;
        if (!$t->key->empty()) {
            $key = $t->key;
        }
        string? $live = null;
        if ($t->hold == nexus::work::Hold::unique && $t->live()) {
            $live = $t->holdKey;
        }
        return QueuedTask(
            $id: $t->id,
            $name: $t->name,
            $lane: $t->lane,
            $data: $t->data,
            $tries: $t->tries,
            $attempts: $t->attempts,
            $status: SessionStore::status($t->status),
            $hold: SessionStore::hold($t->hold),
            $holdKey: $t->holdKey,
            $uniqueLive: $live,
            $allowFailure: $t->allowFailure,
            $priority: $t->priority as int64,
            $pending: $t->pending,
            $released: $t->released,
            $parent: $t->parent,
            $uniqueKey: $key,
            $createdAt: $t->createdAt,
            $availableAt: $t->availableAt,
            $expiresAt: $t->expiresAt,
            $reservedUntil: $t->reservedUntil,
            $doneAt: $t->doneAt,
            $failedAt: $t->failedAt,
            $error: $t->error
        );
    }

    public const function stored() : nexus::work::StoredTask
    {
        nexus::work::TaskStatus $status = nexus::work::TaskStatus::from($this->status as uint8) ?? nexus::work::TaskStatus::waiting;
        nexus::work::Hold $hold = nexus::work::Hold::from($this->hold as uint8) ?? nexus::work::Hold::none;
        return nexus::work::StoredTask(
            $id: $this->id,
            $name: $this->name,
            $lane: $this->lane,
            $data: $this->data,
            $tries: $this->tries,
            $attempts: $this->attempts,
            $status: $status,
            $hold: $hold,
            $holdKey: $this->holdKey,
            $allowFailure: $this->allowFailure,
            $priority: $this->priority as int32,
            $pending: $this->pending,
            $released: $this->released,
            $parent: $this->parent,
            $key: $this->uniqueKey ?? '',
            $createdAt: $this->createdAt,
            $availableAt: $this->availableAt,
            $expiresAt: $this->expiresAt,
            $reservedUntil: $this->reservedUntil,
            $doneAt: $this->doneAt,
            $failedAt: $this->failedAt,
            $error: $this->error
        );
    }
}
