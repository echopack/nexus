namespace nexus::work::carbon;

use std::time;
use carbon;

/**
 * The task store on one carbon session: what `Store` does for each call, in that call's own
 * session. Its writes run in a transaction of their own, or in the one the session has open.
 */
internal class SessionStore : nexus::work::Store
{
    /**
     * How many rows a sweep reads or deletes at once.
     */
    internal const uint64 SWEPT = 1000;

    /**
     * How many times a sweep reads or deletes `SWEPT` rows at most, each of its two steps.
     */
    internal const int32 ROUNDS = 20;

    internal carbon::Session $session;

    public constructor(carbon::Session $session)
    {
        $this->session = $session;
    }

    public function push(const nexus::work::Batch& $batch) : result<nexus::work::Pushed, nexus::Problem>
    {
        bool $free = try $this->free($batch);
        if (!$free) {
            return .ok(.skipped);
        }
        SessionStore $self = $this;
        nexus::work::Batch $all = $batch;
        status<carbon::Error> $saved = $this->atomic(function[$self, $all]() : status<carbon::Error> {
            return $self->insert($all, '');
        });
        guard $saved else ($e) {
            // another server stored the same key in between
            if ($e->duplicate()) {
                return .ok(.skipped);
            }
            return .error(nexus::carbon::Problems::of($e));
        };
        return .ok(.queued($batch->tasks[0]->id));
    }

    public function claim(const string& $lane, time::timestamp $now, time::timestamp $until, uint32 $max) : result<array<nexus::work::StoredTask>, nexus::Problem>
    {
        array<nexus::work::StoredTask> $out = try $this->take($lane, $now, $until, $max);
        return .ok($out);
    }

    public function extend(const nexus::work::StoredTask& $task, time::timestamp $until) : status<nexus::Problem>
    {
        try $this->hold($task, $until);
        return .ok;
    }

    /**
     * Checks what `$task` spawned before its transaction, as a push does: a `.unique` key a live
     * task other than `$task` holds skips all of it. When another server took one of their keys in
     * between, the insert rolls the whole settle back, and it settles again without them.
     */
    public function done(const nexus::work::StoredTask& $task, time::timestamp $now, const nexus::work::Batch& $spawned) : result<bool, nexus::Problem>
    {
        nexus::work::Batch $kids = $spawned;
        bool $stored = true;
        if (!$spawned->tasks->empty()) {
            bool $free = try $this->free($spawned, except: $task->id);
            if (!$free) {
                $kids = nexus::work::Batch();
                $stored = false;
            }
        }
        status<carbon::Error> $saved = $this->settle($task, $now, $kids);
        guard $saved else ($e) {
            if (!$e->duplicate() || $kids->tasks->empty()) {
                return .error(nexus::carbon::Problems::of($e));
            }
            try $this->settle($task, $now, nexus::work::Batch());
            return .ok(false);
        };
        return .ok($stored);
    }

    public function retry(const nexus::work::StoredTask& $task, time::timestamp $at, const string& $error) : status<nexus::Problem>
    {
        SessionStore $self = $this;
        nexus::work::StoredTask $t = $task;
        string $why = $error;
        try $this->atomic(function[$self, $t, $at, $why]() : status<carbon::Error> {
            $set = hydrahon::Values();
            $set[QueuedTaskTable::$status] = SessionStore::status(.waiting);
            $set[QueuedTaskTable::$availableAt] = $at;
            $set[QueuedTaskTable::$reservedUntil] = SessionStore::never();
            $set[QueuedTaskTable::$error] = $why;
            uint64 $n = try $self->change($t, mv $set);
            if ($n == 1) {
                try $self->unlock($t);
            }
            return .ok;
        });
        return .ok;
    }

    public function defer(const nexus::work::StoredTask& $task, time::timestamp $at, const string& $why) : status<nexus::Problem>
    {
        SessionStore $self = $this;
        nexus::work::StoredTask $t = $task;
        string $reason = $why;
        try $this->atomic(function[$self, $t, $at, $reason]() : status<carbon::Error> {
            $set = hydrahon::Values();
            $set[QueuedTaskTable::$status] = SessionStore::status(.waiting);
            $set[QueuedTaskTable::$attempts] = $t->attempts - 1;
            $set[QueuedTaskTable::$availableAt] = $at;
            $set[QueuedTaskTable::$reservedUntil] = SessionStore::never();
            $set[QueuedTaskTable::$error] = $reason;
            uint64 $n = try $self->change($t, mv $set);
            if ($n == 1) {
                try $self->unlock($t);
            }
            return .ok;
        });
        return .ok;
    }

    public function fail(const nexus::work::StoredTask& $task, time::timestamp $now, const string& $error) : status<nexus::Problem>
    {
        SessionStore $self = $this;
        nexus::work::StoredTask $t = $task;
        string $why = $error;
        try $this->atomic(function[$self, $t, $now, $why]() : status<carbon::Error> {
            $set = hydrahon::Values();
            $set[QueuedTaskTable::$status] = SessionStore::status(.failed);
            $set[QueuedTaskTable::$failedAt] = $now;
            $set[QueuedTaskTable::$reservedUntil] = SessionStore::never();
            $set[QueuedTaskTable::$uniqueLive] = SessionStore::none();
            $set[QueuedTaskTable::$error] = $why;
            uint64 $n = try $self->change($t, mv $set);
            if ($n != 1) {
                return .ok;
            }
            try $self->unlock($t);
            if ($t->allowFailure && !$t->released) {
                return $self->release($t->id);
            }
            return .ok;
        });
        return .ok;
    }

    public function upstream(const string& $id) : result<array<nexus::work::Upstream>, nexus::Problem>
    {
        array<nexus::work::Upstream> $out = try $this->before($id);
        return .ok($out);
    }

    public function failed(const string& $lane, uint64 $limit) : result<array<nexus::work::StoredTask>, nexus::Problem>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        array<QueuedTask> $rows = try $tasks->find()
            ->where(QueuedTaskTable::$lane == $lane)
            ->where(QueuedTaskTable::$status == SessionStore::status(.failed))
            ->order(desc: QueuedTaskTable::$failedAt)
            ->limit($limit)
            ->get();
        return .ok(SessionStore::stored($rows));
    }

    public function again(const string& $id, time::timestamp $now) : result<nexus::work::StoredTask?, nexus::Problem>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        QueuedTask? $found = try $tasks->find()->where(QueuedTaskTable::$id == $id)->where(QueuedTaskTable::$status == SessionStore::status(.failed))->first();
        QueuedTask $row = guard $found else {
            return .ok(null);
        };
        bool $sent = try $this->sendBack($row, $now);
        if (!$sent) {
            return .ok(null);
        }
        nexus::work::StoredTask $back = $row->stored();
        $back->requeue($now);
        return .ok($back);
    }

    /**
     * Sends the failed tasks of `$lane` back with one update; a `.unique` task goes back on its own,
     * taking its key again. Only what this call sent back is answered: a task another server sent
     * back in between is not.
     */
    public function againAll(const string& $lane, time::timestamp $now) : result<array<nexus::work::StoredTask>, nexus::Problem>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        array<QueuedTask> $rows = try $tasks->find()
            ->where(QueuedTaskTable::$lane == $lane)
            ->where(QueuedTaskTable::$status == SessionStore::status(.failed))
            ->get();
        array<string> $plain = [];
        foreach ($rows as const &$r) {
            if ($r->hold != SessionStore::hold(.unique)) {
                $plain[] = $r->id;
            }
        }
        map<string, bool> $sent = [];
        if (!$plain->empty()) {
            uint64 $n = try $tasks->find()->where(QueuedTaskTable::$id in $plain)->where(QueuedTaskTable::$status == SessionStore::status(.failed))->update(SessionStore::requeued($now));
            array<string> $mine = $plain;
            if ($n < $plain->count() as uint64) {
                // another server sent some back in between: keep the ones this update did
                array<QueuedTask> $back = try $tasks->find()->where(QueuedTaskTable::$id in $plain)->where(QueuedTaskTable::$status == SessionStore::status(.waiting))->where(QueuedTaskTable::$availableAt == $now)->get();
                $mine = SessionStore::ids($back);
            }
            foreach ($mine as const &$id) {
                $sent[$id] = true;
            }
        }
        array<nexus::work::StoredTask> $out = [];
        foreach ($rows as const &$r) {
            if ($r->hold == SessionStore::hold(.unique)) {
                bool $one = try $this->sendBack($r, $now);
                if (!$one) {
                    continue;
                }
            } else if (!$sent->has($r->id)) {
                continue;
            }
            nexus::work::StoredTask $back = $r->stored();
            $back->requeue($now);
            $out[] = mv $back;
        }
        return .ok($out);
    }

    /**
     * Cancels waiting task `$id` and every waiting task after it, a level of the graph at a time:
     * one read, one update and one read of the edges per level. Answers what this call cancelled,
     * `$id` first.
     */
    public function cancel(const string& $id, time::timestamp $now) : result<array<nexus::work::StoredTask>, nexus::Problem>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        TaskEdgeRepository $edges = try $this->session->repo<TaskEdgeRepository>();
        map<string, bool> $seen = [$id => true];
        array<string> $frontier = [$id];
        array<nexus::work::StoredTask> $out = [];
        while (!$frontier->empty()) {
            array<QueuedTask> $rows = try $tasks->find()->where(QueuedTaskTable::$id in $frontier)->where(QueuedTaskTable::$status == SessionStore::status(.waiting))->get();
            if ($rows->empty()) {
                break;
            }
            array<string> $ids = SessionStore::ids($rows);
            $set = hydrahon::Values();
            $set[QueuedTaskTable::$status] = SessionStore::status(.cancelled);
            $set[QueuedTaskTable::$doneAt] = $now;
            $set[QueuedTaskTable::$uniqueLive] = SessionStore::none();
            uint64 $n = try $tasks->find()->where(QueuedTaskTable::$id in $ids)->where(QueuedTaskTable::$status == SessionStore::status(.waiting))->update(mv $set);
            array<QueuedTask> $won = mv $rows;
            if ($n < $ids->count() as uint64) {
                // another server took some in between: keep the ones this update cancelled
                array<QueuedTask> $kept = try $tasks->find()->where(QueuedTaskTable::$id in $ids)->where(QueuedTaskTable::$status == SessionStore::status(.cancelled))->where(QueuedTaskTable::$doneAt == $now)->get();
                $won = mv $kept;
                $ids = SessionStore::ids($won);
            }
            foreach ($won as const &$row) {
                nexus::work::StoredTask $t = $row->stored();
                $t->status = .cancelled;
                $t->doneAt = $now;
                $out[] = mv $t;
            }
            array<string> $next = [];
            if (!$ids->empty()) {
                array<TaskEdge> $after = try $edges->find()->where(TaskEdgeTable::$afterId in $ids)->get();
                foreach ($after as const &$e) {
                    if (!$seen->has($e->taskId)) {
                        $seen[$e->taskId] = true;
                        $next[] = $e->taskId;
                    }
                }
            }
            $frontier = mv $next;
        }
        return .ok($out);
    }

    public function graph(const string& $id, uint32 $depth) : result<nexus::work::Graph, nexus::Problem>
    {
        nexus::work::Graph $g = try $this->connected($id, $depth);
        return .ok($g);
    }

    public function prune(time::timestamp $now, time::timestamp $before) : result<uint64, nexus::Problem>
    {
        uint64 $n = try $this->sweep($now, $before);
        return .ok($n);
    }

    public function waiting(const string& $lane) : result<uint64, nexus::Problem>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        uint64 $n = try $tasks->find()
            ->where(QueuedTaskTable::$lane == $lane)
            ->where(QueuedTaskTable::$status == SessionStore::status(.waiting) || QueuedTaskTable::$status == SessionStore::status(.running))
            ->count();
        return .ok($n);
    }

    public function recent(const string& $lane, nexus::work::TaskStatus? $status, uint64 $limit) : result<array<nexus::work::StoredTask>, nexus::Problem>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        $q = $tasks->find();
        if (!$lane->empty()) {
            $q = $q->where(QueuedTaskTable::$lane == $lane);
        }
        if ($status != null) {
            nexus::work::TaskStatus $want = guard $status;
            $q = $q->where(QueuedTaskTable::$status == SessionStore::status($want));
        }
        array<QueuedTask> $rows = try $q->order(desc: QueuedTaskTable::$createdAt)->limit($limit)->get();
        return .ok(SessionStore::stored($rows));
    }

    /**
     * Whether `$batch` can be stored: no key a stored task has, no `.unique` key a live task holds,
     * none twice. The key of task `$except` does not count: it lets go of it as it settles done.
     */
    internal function free(const nexus::work::Batch& $batch, except: const string& $except = '') : result<bool, carbon::Error>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        map<string, bool> $mine = map<string, bool>();
        foreach ($batch->tasks as const &$t) {
            if (!$t->key->empty()) {
                QueuedTask? $have = try $tasks->find()->where(QueuedTaskTable::$uniqueKey == $t->key)->first();
                if ($have != null) {
                    return .ok(false);
                }
            }
            if ($t->hold == nexus::work::Hold::unique) {
                if ($mine->has($t->holdKey)) {
                    return .ok(false);
                }
                $mine[$t->holdKey] = true;
                $q = $tasks->find()->where(QueuedTaskTable::$uniqueLive == $t->holdKey);
                if (!$except->empty()) {
                    $q = $q->where(QueuedTaskTable::$id != $except);
                }
                QueuedTask? $live = try $q->first();
                if ($live != null) {
                    return .ok(false);
                }
            }
        }
        return .ok(true);
    }

    /**
     * Inserts every task of `$batch` (spawned by `$parent` when it is not empty) and its edges.
     */
    internal function insert(const nexus::work::Batch& $batch, const string& $parent) : status<carbon::Error>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        TaskEdgeRepository $edges = try $this->session->repo<TaskEdgeRepository>();
        foreach ($batch->tasks as const &$t) {
            QueuedTask $row = QueuedTask::of($t);
            if (!$parent->empty()) {
                $row->parent = $parent;
            }
            try $tasks->create(mv $row);
        }
        foreach ($batch->edges as const &$e) {
            try $edges->create(TaskEdge::of($e));
        }
        return .ok;
    }

    /**
     * Claims up to `$max` due tasks of `$lane`. A read leaves out the tasks whose `.running` key
     * another task holds, so a busy key never crowds out the tasks that can run; it reads again
     * while it took something and there may be more.
     */
    internal function take(const string& $lane, time::timestamp $now, time::timestamp $until, uint32 $max) : result<array<nexus::work::StoredTask>, carbon::Error>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        int64 $looked = ($max as int64) * 4 + 4;
        $held = hydrahon::Select(from: TaskLockTable())
            ->where(TaskLockTable::$lockKey == QueuedTaskTable::$holdKey)
            ->where(TaskLockTable::$heldUntil >= $now);
        array<nexus::work::StoredTask> $out = [];
        map<string, bool> $mine = map<string, bool>();
        int32 $reads = 0;
        while (($out->count() as uint32) < $max && $reads < 4) {
            $reads++;
            array<QueuedTask> $due = try $tasks->find()
                ->where(QueuedTaskTable::$lane == $lane)
                ->where(QueuedTaskTable::$pending == 0)
                ->where(QueuedTaskTable::$availableAt <= $now)
                ->where(QueuedTaskTable::$expiresAt->isNull() || QueuedTaskTable::$expiresAt > $now)
                ->where(QueuedTaskTable::$status == SessionStore::status(.waiting) || (QueuedTaskTable::$status == SessionStore::status(.running) && QueuedTaskTable::$reservedUntil < $now))
                ->where(QueuedTaskTable::$hold != SessionStore::hold(.running) || !$held->exists())
                ->order(desc: QueuedTaskTable::$priority)
                ->order(asc: QueuedTaskTable::$availableAt)
                ->limit($looked as uint64)
                ->get();
            usize $before = $out->count();
            foreach ($due as const &$row) {
                if (($out->count() as uint32) >= $max) {
                    break;
                }
                bool $locks = $row->hold == SessionStore::hold(.running);
                if ($locks) {
                    // this read took the key already
                    if ($mine->has($row->holdKey)) {
                        continue;
                    }
                    bool $got = try $this->lock($row->holdKey, $row->id, $now, $until);
                    if (!$got) {
                        continue;
                    }
                }
                $set = hydrahon::Values();
                $set[QueuedTaskTable::$status] = SessionStore::status(.running);
                $set[QueuedTaskTable::$attempts] = $row->attempts + 1;
                $set[QueuedTaskTable::$reservedUntil] = $until;
                uint64 $taken = try $tasks->find()
                    ->where(QueuedTaskTable::$id == $row->id)
                    ->where(QueuedTaskTable::$attempts == $row->attempts)
                    ->where(QueuedTaskTable::$status == $row->status)
                    ->update(mv $set);
                if ($taken != 1) {
                    if ($locks) {
                        try $this->unlockKey($row->holdKey, $row->id);
                    }
                    continue;
                }
                if ($locks) {
                    $mine[$row->holdKey] = true;
                }
                nexus::work::StoredTask $t = $row->stored();
                $t->attempts = $row->attempts + 1;
                $t->status = .running;
                $t->reservedUntil = $until;
                $out[] = mv $t;
            }
            // a short read had every due row; one that took nothing would only read the same again
            if ($due->count() < ($looked as usize) || $out->count() == $before) {
                break;
            }
        }
        return .ok($out);
    }

    /**
     * Takes `.running` key `$key` for `$holder` until `$until`: a fresh row, or one whose holder let
     * its lease run out. False when another task holds it. Steal only on expiry, never because the
     * holder string matches: two claimers of the same task share the task id as holder.
     */
    internal function lock(const string& $key, const string& $holder, time::timestamp $now, time::timestamp $until) : result<bool, carbon::Error>
    {
        TaskLockRepository $locks = try $this->session->repo<TaskLockRepository>();
        guard $locks->create(TaskLock($lockKey: $key, $holder: $holder, $heldUntil: $until)) else ($e) {
            if (!$e->duplicate()) {
                return .error($e);
            }
            $set = hydrahon::Values();
            $set[TaskLockTable::$holder] = $holder;
            $set[TaskLockTable::$heldUntil] = $until;
            uint64 $n = try $locks->find()
                ->where(TaskLockTable::$lockKey == $key)
                ->where(TaskLockTable::$heldUntil < $now)
                ->update(mv $set);
            return .ok($n == 1);
        };
        return .ok(true);
    }

    internal function unlock(const nexus::work::StoredTask& $t) : status<carbon::Error>
    {
        if ($t->hold != nexus::work::Hold::running) {
            return .ok;
        }
        return $this->unlockKey($t->holdKey, $t->id);
    }

    internal function unlockKey(const string& $key, const string& $holder) : status<carbon::Error>
    {
        TaskLockRepository $locks = try $this->session->repo<TaskLockRepository>();
        try $locks->find()->where(TaskLockTable::$lockKey == $key)->where(TaskLockTable::$holder == $holder)->purge();
        return .ok;
    }

    /**
     * Holds claimed `$task` until `$until`, its `.running` key too.
     */
    internal function hold(const nexus::work::StoredTask& $task, time::timestamp $until) : status<carbon::Error>
    {
        $set = hydrahon::Values();
        $set[QueuedTaskTable::$reservedUntil] = $until;
        uint64 $n = try $this->change($task, mv $set);
        if ($n != 1 || $task->hold != nexus::work::Hold::running) {
            return .ok;
        }
        TaskLockRepository $locks = try $this->session->repo<TaskLockRepository>();
        $lock = hydrahon::Values();
        $lock[TaskLockTable::$heldUntil] = $until;
        try $locks->find()->where(TaskLockTable::$lockKey == $task->holdKey)->where(TaskLockTable::$holder == $task->id)->update(mv $lock);
        return .ok;
    }

    /**
     * Marks claimed `$t` done with what it spawned (`$kids`), in a transaction of its own.
     */
    internal function settle(const nexus::work::StoredTask& $task, time::timestamp $now, const nexus::work::Batch& $spawned) : status<carbon::Error>
    {
        SessionStore $self = $this;
        nexus::work::StoredTask $t = $task;
        nexus::work::Batch $kids = $spawned;
        return $this->atomic(function[$self, $t, $kids, $now]() : status<carbon::Error> {
            return $self->finish($t, $now, $kids);
        });
    }

    /**
     * Marks claimed `$t` done, stores what it spawned, and lets the tasks waiting for it go.
     */
    internal function finish(const nexus::work::StoredTask& $t, time::timestamp $now, const nexus::work::Batch& $spawned) : status<carbon::Error>
    {
        $set = hydrahon::Values();
        $set[QueuedTaskTable::$status] = SessionStore::status(.done);
        $set[QueuedTaskTable::$doneAt] = $now;
        $set[QueuedTaskTable::$reservedUntil] = SessionStore::never();
        $set[QueuedTaskTable::$uniqueLive] = SessionStore::none();
        uint64 $n = try $this->change($t, mv $set);
        if ($n != 1) {
            return .ok;
        }
        try $this->unlock($t);
        array<string> $after = try $this->after($t->id);
        nexus::work::Batch $kids = $spawned;
        foreach ($spawned->tasks as const &$s) {
            foreach ($after as const &$a) {
                $kids->edges[] = nexus::work::Edge($a, $s->id);
            }
        }
        try $this->insert($kids, $t->id);
        int64 $by = $spawned->tasks->count() as int64;
        if (!$t->released) {
            $by = $by - 1;
        }
        return $this->shift($after, $by);
    }

    /**
     * The tasks waiting for `$id` go ahead: it failed and allows failure.
     */
    internal function release(const string& $id) : status<carbon::Error>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        $set = hydrahon::Values();
        $set[QueuedTaskTable::$released] = true;
        try $tasks->find()->where(QueuedTaskTable::$id == $id)->update(mv $set);
        array<string> $after = try $this->after($id);
        return $this->shift($after, -1);
    }

    /**
     * Adds `$by` to what each task of `$ids` waits for. The database adds to the row it locks, so
     * tasks settling at once on several servers all count, whatever their transactions read
     * before. Rows are taken in id order, so two settles never lock them the other way round.
     */
    internal function shift(const array<string>& $ids, int64 $by) : status<carbon::Error>
    {
        if ($by == 0) {
            return .ok;
        }
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        array<string> $ordered = $ids;
        $ordered->sort();
        foreach ($ordered as const &$id) {
            $set = hydrahon::Values();
            $set[QueuedTaskTable::$pending] = QueuedTaskTable::$pending + $by;
            try $tasks->find()->where(QueuedTaskTable::$id == $id)->update(mv $set);
        }
        return .ok;
    }

    /**
     * Sends failed task `$row` back, a `.unique` one taking its key again; answers whether it was
     * still failed, so this call sent it, and its key was free.
     */
    internal function sendBack(const QueuedTask& $row, time::timestamp $now) : result<bool, carbon::Error>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        $set = SessionStore::requeued($now);
        if ($row->hold == SessionStore::hold(.unique)) {
            $set[QueuedTaskTable::$uniqueLive] = $row->holdKey;
        }
        uint64 $n = guard $tasks->find()->where(QueuedTaskTable::$id == $row->id)->where(QueuedTaskTable::$status == SessionStore::status(.failed))->update(mv $set) else ($e) {
            // a task holding the same `.unique` key waits or runs: this one stays failed
            if ($e->duplicate()) {
                return .ok(false);
            }
            return .error($e);
        };
        return .ok($n == 1);
    }

    /**
     * The ids of `$rows`, in order.
     */
    internal static function ids(const array<QueuedTask>& $rows) : array<string>
    {
        array<string> $out = [];
        foreach ($rows as const &$r) {
            $out[] = $r->id;
        }
        return $out;
    }

    /**
     * The tasks waiting for task `$id`.
     */
    internal function after(const string& $id) : result<array<string>, carbon::Error>
    {
        TaskEdgeRepository $edges = try $this->session->repo<TaskEdgeRepository>();
        array<TaskEdge> $rows = try $edges->find()->where(TaskEdgeTable::$afterId == $id)->get();
        array<string> $out = [];
        foreach ($rows as const &$e) {
            $out[] = $e->taskId;
        }
        return .ok($out);
    }

    internal function before(const string& $id) : result<array<nexus::work::Upstream>, carbon::Error>
    {
        TaskEdgeRepository $edges = try $this->session->repo<TaskEdgeRepository>();
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        array<TaskEdge> $rows = try $edges->find()->where(TaskEdgeTable::$taskId == $id)->get();
        array<nexus::work::Upstream> $out = [];
        if ($rows->empty()) {
            return .ok($out);
        }
        array<string> $ids = [];
        foreach ($rows as const &$e) {
            $ids[] = $e->afterId;
        }
        array<QueuedTask> $ups = try $tasks->find()->where(QueuedTaskTable::$id in $ids)->get();
        foreach ($ups as const &$u) {
            $out[] = nexus::work::Upstream($u->id, $u->name, $failed: $u->status == SessionStore::status(.failed), $error: $u->error);
        }
        return .ok($out);
    }

    internal function connected(const string& $id, uint32 $depth) : result<nexus::work::Graph, carbon::Error>
    {
        TaskEdgeRepository $edges = try $this->session->repo<TaskEdgeRepository>();
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        map<string, bool> $seen = [$id => true];
        array<string> $frontier = [$id];
        uint32 $hops = 0;
        while (!$frontier->empty() && $hops < $depth) {
            array<TaskEdge> $rows = try $edges->find()->where(TaskEdgeTable::$taskId in $frontier || TaskEdgeTable::$afterId in $frontier)->get();
            array<string> $next = [];
            foreach ($rows as const &$e) {
                if (!$seen->has($e->taskId)) {
                    $seen[$e->taskId] = true;
                    $next[] = $e->taskId;
                }
                if (!$seen->has($e->afterId)) {
                    $seen[$e->afterId] = true;
                    $next[] = $e->afterId;
                }
            }
            $frontier = mv $next;
            $hops = $hops + 1;
        }
        array<string> $ids = [];
        foreach ($seen as $k => const &$v) {
            $ids[] = $k;
        }
        nexus::work::Graph $g = nexus::work::Graph();
        array<QueuedTask> $rows = try $tasks->find()->where(QueuedTaskTable::$id in $ids)->order(asc: QueuedTaskTable::$createdAt)->get();
        $g->tasks = SessionStore::stored($rows);
        array<TaskEdge> $links = try $edges->find()->where(TaskEdgeTable::$taskId in $ids)->get();
        foreach ($links as const &$e) {
            if ($seen->has($e->afterId)) {
                $g->edges[] = nexus::work::Edge($e->taskId, $e->afterId);
            }
        }
        return .ok($g);
    }

    /**
     * Fails the tasks that expired, then deletes the finished ones, `SWEPT` rows at a time until
     * fewer are left, at most `ROUNDS` times each: a busy queue never outgrows its sweeps.
     */
    internal function sweep(time::timestamp $now, time::timestamp $before) : result<uint64, carbon::Error>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        TaskEdgeRepository $edges = try $this->session->repo<TaskEdgeRepository>();
        int32 $round = 0;
        while ($round < self::ROUNDS) {
            $round++;
            uint64 $read = try $this->expire($now);
            if ($read < self::SWEPT) {
                break;
            }
        }
        uint64 $gone = 0;
        $round = 0;
        while ($round < self::ROUNDS) {
            $round++;
            array<QueuedTask> $old = try $tasks->find()
                ->where(QueuedTaskTable::$status == SessionStore::status(.done) || QueuedTaskTable::$status == SessionStore::status(.cancelled))
                ->where(QueuedTaskTable::$doneAt < $before)
                ->limit(self::SWEPT)
                ->get();
            if ($old->empty()) {
                break;
            }
            array<string> $ids = SessionStore::ids($old);
            try $edges->find()->where(TaskEdgeTable::$taskId in $ids || TaskEdgeTable::$afterId in $ids)->purge();
            uint64 $n = try $tasks->find()->where(QueuedTaskTable::$id in $ids)->purge();
            $gone = $gone + $n;
            if (($old->count() as uint64) < self::SWEPT) {
                break;
            }
        }
        return .ok($gone);
    }

    /**
     * Fails up to `SWEPT` of the tasks that expired by `$now`: waiting ones, and running ones whose
     * server let the lease run out, since nobody may claim them again. Answers how many it read.
     */
    internal function expire(time::timestamp $now) : result<uint64, carbon::Error>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        array<QueuedTask> $expired = try $tasks->find()
            ->where(QueuedTaskTable::$expiresAt <= $now)
            ->where(QueuedTaskTable::$status == SessionStore::status(.waiting) || (QueuedTaskTable::$status == SessionStore::status(.running) && QueuedTaskTable::$reservedUntil < $now))
            ->limit(self::SWEPT)
            ->get();
        SessionStore $self = $this;
        foreach ($expired as const &$row) {
            nexus::work::StoredTask $t = $row->stored();
            try $this->atomic(function[$self, $t, $now]() : status<carbon::Error> {
                return $self->lapse($t, $now);
            });
        }
        return .ok($expired->count() as uint64);
    }

    /**
     * Fails task `$t`, read expired at `$now`, while it still waits or still runs with its lease
     * out: lets go of its keys and, when it allows failure, of the tasks waiting for it.
     */
    internal function lapse(const nexus::work::StoredTask& $t, time::timestamp $now) : status<carbon::Error>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        bool $running = $t->status == nexus::work::TaskStatus::running;
        $set = hydrahon::Values();
        $set[QueuedTaskTable::$status] = SessionStore::status(.failed);
        $set[QueuedTaskTable::$failedAt] = $now;
        $set[QueuedTaskTable::$reservedUntil] = SessionStore::never();
        $set[QueuedTaskTable::$uniqueLive] = SessionStore::none();
        if ($running) {
            $set[QueuedTaskTable::$error] = 'expired before it finished';
        } else {
            $set[QueuedTaskTable::$error] = 'expired before it ran';
        }
        $q = $tasks->find()
            ->where(QueuedTaskTable::$id == $t->id)
            ->where(QueuedTaskTable::$status == SessionStore::status($t->status))
            ->where(QueuedTaskTable::$attempts == $t->attempts);
        if ($running) {
            // a server that renewed the lease in between still runs it
            $q = $q->where(QueuedTaskTable::$reservedUntil < $now);
        }
        uint64 $n = try $q->update(mv $set);
        if ($n != 1) {
            return .ok;
        }
        if ($running) {
            try $this->unlock($t);
        }
        if ($t->allowFailure && !$t->released) {
            return $this->release($t->id);
        }
        return .ok;
    }

    /**
     * Applies `$set` to `$task`'s row while the claim it names still holds; answers the rows
     * changed, 0 when the claim was lost.
     */
    internal function change(const nexus::work::StoredTask& $task, hydrahon::Values $set) : result<uint64, carbon::Error>
    {
        QueuedTaskRepository $tasks = try $this->session->repo<QueuedTaskRepository>();
        return $tasks->find()
            ->where(QueuedTaskTable::$id == $task->id)
            ->where(QueuedTaskTable::$attempts == $task->attempts)
            ->where(QueuedTaskTable::$status == SessionStore::status(.running))
            ->update(mv $set);
    }

    /**
     * Runs `$work` in a transaction, or in the one the session has open. A transaction of its own
     * runs again, up to five times, when the database rolled it back for one that changed the same
     * rows (a deadlock, a lock wait timeout, a stale snapshot): settles racing on several servers
     * then all land.
     */
    internal function atomic(function<status<carbon::Error>()> $work) : status<carbon::Error>
    {
        if ($this->session->inTransaction()) {
            return $work();
        }
        int32 $tries = 1;
        while (true) {
            status<carbon::Error> $done = $this->session->transaction($work);
            guard $done else ($e) {
                if (!$e->retryable() || $tries >= 5) {
                    return .error($e);
                }
                $tries++;
                continue;
            };
            return .ok;
        }
    }

    /**
     * What sending a failed task back sets: due at `$now` with its tries fresh.
     */
    internal static function requeued(time::timestamp $now) : hydrahon::Values
    {
        $set = hydrahon::Values();
        $set[QueuedTaskTable::$status] = SessionStore::status(.waiting);
        $set[QueuedTaskTable::$failedAt] = SessionStore::never();
        $set[QueuedTaskTable::$expiresAt] = SessionStore::never();
        $set[QueuedTaskTable::$attempts] = 0;
        $set[QueuedTaskTable::$availableAt] = $now;
        return $set;
    }

    internal static function stored(const array<QueuedTask>& $rows) : array<nexus::work::StoredTask>
    {
        array<nexus::work::StoredTask> $out = arr::room<nexus::work::StoredTask>($rows->count());
        foreach ($rows as const &$r) {
            $out[] = $r->stored();
        }
        return $out;
    }

    internal static function status(nexus::work::TaskStatus $s) : int64
    {
        return $s->value() as int64;
    }

    internal static function hold(nexus::work::Hold $h) : int64
    {
        return $h->value() as int64;
    }

    /**
     * No time: clears a nullable time column.
     */
    internal static function never() : hydrahon::DateTime?
    {
        return null;
    }

    /**
     * No text: clears a nullable text column.
     */
    internal static function none() : string?
    {
        return null;
    }
}
