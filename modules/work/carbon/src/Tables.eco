namespace nexus::work::carbon;

/**
 * The task tables on the app's database: one call in the function that opens it, before it is
 * sealed.
 *
 * ```echo
 * guard nexus::work::carbon::Tables::wire($db) else ($e) {
 *     return .error($e);
 * };
 * ```
 */
public struct Tables
{
    /**
     * Registers the task, edge and lock repositories on `$db`.
     */
    public static function wire(carbon::DB $db) : status<carbon::Error>
    {
        try Carbon::register($db);
        return Carbon::check($db);
    }

    /**
     * The migration of the three tables, to add to the app's own.
     */
    public static function migrations() : array<carbon::migrate::Step>
    {
        return Carbon::migrations();
    }
}
