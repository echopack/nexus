namespace nexus::work::carbon;

/**
 * Checks at boot that the tables of the carbon task store are wired on the app's database. The app
 * wires them where it opens the database, runs the migration with its own, and binds a distributed
 * queue on the store:
 *
 * ```echo
 * // the database the app opens
 * guard nexus::work::carbon::Tables::wire($db) else ($e) { return .error($e); };
 *
 * // a provider
 * $app->bindDistributedQueue<JobsLane>(store: nexus::work::carbon::Store($app->get<carbon::DB>()))
 *     ->into<WorkersLane>();
 * ```
 *
 * List it after nexus-carbon.
 */
public class Extension : nexus::Extension
{
    public function name() : string
    {
        return 'nexus-work-carbon';
    }

    public function boot(nexus::Kernel $kernel) : status<nexus::BootError>
    {
        carbon::DB $db = $kernel->services->get<carbon::DB>();
        if (!$db->has<QueuedTaskRepository>() || !$db->has<TaskEdgeRepository>() || !$db->has<TaskLockRepository>()) {
            return .error(.extension('nexus-work-carbon', 'wire the task tables on the database: nexus::work::carbon::Tables::wire($db)'));
        }
        return .ok;
    }
}
