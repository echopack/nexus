namespace nexus::work;

/**
 * The app's work, bound once: how each task type is stored, every lane, the scheduler, the clock
 * and the zone cron lines are read in.
 */
#[atomic]
public class Work
{
    public WorkConfig $config;
    public calendar::Clock $clock;
    public calendar::Zone $zone;
    public Codecs $codecs;
    public Lanes $lanes = Lanes();
    public TaskScheduler $scheduler = TaskScheduler();
}
