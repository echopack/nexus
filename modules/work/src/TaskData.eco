namespace nexus::work;

/**
 * A task's fields as a JSON object: written by the generated `encode`, read back by the generated
 * `decode`, which notes every missing or mistyped field and answers them together from `done()`.
 */
public struct TaskData
{
    internal json::Value $object = .object();
    internal array<FieldError> $errors = [];

    /**
     * Reads a task's data; it must be a JSON object.
     */
    public static function parse(const string& $text) : result<TaskData, DataError>
    {
        json::Value $v = guard json::parse($text) else {
            return .error(.notJson);
        };
        if (!$v->isObject()) {
            return .error(.notObject);
        }
        return .ok(TaskData($object: mv $v));
    }

    public function put(const string& $name, int64 $value) : void
    {
        $this->object[$name] = .int($value);
    }

    /**
     * Stores an unsigned value: as a JSON integer while it fits an int64, as its decimal digits in a
     * string past that, so the top half of the range comes back as it went in.
     */
    public function put(const string& $name, uint64 $value) : void
    {
        if ($value <= (int64::max() as uint64)) {
            $this->object[$name] = .int($value as int64);
            return;
        }
        $this->object[$name] = .str(str::from($value));
    }

    /**
     * Stores a float. NaN and the infinities are no JSON numbers, so they are kept as the strings
     * `nan`, `inf` and `-inf`, which `float64` reads back.
     */
    public function put(const string& $name, float64 $value) : void
    {
        if ($value != $value) {
            $this->object[$name] = .str('nan');
        } else if ($value - $value != 0.0) {
            if ($value > 0.0) {
                $this->object[$name] = .str('inf');
            } else {
                $this->object[$name] = .str('-inf');
            }
        } else {
            $this->object[$name] = .float($value);
        }
    }

    public function put(const string& $name, bool $value) : void
    {
        $this->object[$name] = .bool($value);
    }

    public function put(const string& $name, const string& $value) : void
    {
        $this->object[$name] = .str($value);
    }

    public function put(const string& $name, const array<string>& $value) : void
    {
        json::Value $list = .arr();
        foreach ($value as const &$s) {
            $list[] = .str($s);
        }
        $this->object[$name] = mv $list;
    }

    public function put(const string& $name, const array<int64>& $value) : void
    {
        json::Value $list = .arr();
        foreach ($value as const &$n) {
            $list[] = .int($n);
        }
        $this->object[$name] = mv $list;
    }

    public function nil(const string& $name) : void
    {
        $this->object[$name] = .nil();
    }

    /**
     * The object as JSON text.
     */
    public const function text() : string
    {
        return json::dump($this->object);
    }

    public function string(const string& $name, required: bool $required) : string?
    {
        json::Value $v = guard $this->present($name, $required) else {
            return null;
        };
        string? $s = $v->asStr();
        if ($s == null) {
            $this->errors[] = .mistyped($name, 'a string');
        }
        return $s;
    }

    public function bool(const string& $name, required: bool $required) : bool?
    {
        json::Value $v = guard $this->present($name, $required) else {
            return null;
        };
        bool? $b = $v->asBool();
        if ($b == null) {
            $this->errors[] = .mistyped($name, 'true or false');
        }
        return $b;
    }

    public function float64(const string& $name, required: bool $required) : float64?
    {
        json::Value $v = guard $this->present($name, $required) else {
            return null;
        };
        float64? $f = $v->asFloat();
        if ($f != null) {
            return $f;
        }
        // NaN and the infinities, as `put` keeps them
        string $s = $v->asStr() ?? '';
        if ($s == 'nan' || $s == 'inf' || $s == '-inf') {
            return str::float($s);
        }
        $this->errors[] = .mistyped($name, 'a number');
        return null;
    }

    public function int64(const string& $name, required: bool $required) : int64?
    {
        json::Value $v = guard $this->present($name, $required) else {
            return null;
        };
        int64? $n = $v->asInt();
        if ($n == null) {
            $this->errors[] = .mistyped($name, 'an integer');
        }
        return $n;
    }

    public function int32(const string& $name, required: bool $required) : int32?
    {
        int64 $n = guard $this->int64($name, required: $required) else {
            return null;
        };
        if ($n < -2147483648 || $n > 2147483647) {
            $this->errors[] = .overflow($name, 'an int32');
            return null;
        }
        int32 $out = $n as int32;
        return $out;
    }

    public function uint16(const string& $name, required: bool $required) : uint16?
    {
        int64 $n = guard $this->int64($name, required: $required) else {
            return null;
        };
        if ($n < 0 || $n > 65535) {
            $this->errors[] = .overflow($name, 'a uint16');
            return null;
        }
        uint16 $out = $n as uint16;
        return $out;
    }

    public function uint32(const string& $name, required: bool $required) : uint32?
    {
        int64 $n = guard $this->int64($name, required: $required) else {
            return null;
        };
        if ($n < 0 || $n > 4294967295) {
            $this->errors[] = .overflow($name, 'a uint32');
            return null;
        }
        uint32 $out = $n as uint32;
        return $out;
    }

    /**
     * An unsigned value: a JSON integer, or the decimal digits `put` writes for one past int64.
     */
    public function uint64(const string& $name, required: bool $required) : uint64?
    {
        json::Value $v = guard $this->present($name, $required) else {
            return null;
        };
        string? $text = $v->asStr();
        if ($text != null) {
            string $digits = guard $text;
            uint64 $big = guard str::uint($digits) else {
                $this->errors[] = .mistyped($name, 'an integer');
                return null;
            };
            return $big;
        }
        int64 $n = guard $v->asInt() else {
            $this->errors[] = .mistyped($name, 'an integer');
            return null;
        };
        if ($n < 0) {
            $this->errors[] = .negative($name);
            return null;
        }
        uint64 $out = $n as uint64;
        return $out;
    }

    public function strings(const string& $name, required: bool $required) : array<string>?
    {
        json::Value $v = guard $this->present($name, $required) else {
            return null;
        };
        array<json::Value> $items = guard $v->asArray() else {
            $this->errors[] = .mistyped($name, 'a list');
            return null;
        };
        array<string> $out = [];
        foreach ($items as const &$item) {
            string $s = guard $item->asStr() else {
                $this->errors[] = .item($name, 'a string');
                return null;
            };
            $out[] = mv $s;
        }
        return $out;
    }

    public function ints(const string& $name, required: bool $required) : array<int64>?
    {
        json::Value $v = guard $this->present($name, $required) else {
            return null;
        };
        array<json::Value> $items = guard $v->asArray() else {
            $this->errors[] = .mistyped($name, 'a list');
            return null;
        };
        array<int64> $out = [];
        foreach ($items as const &$item) {
            int64 $n = guard $item->asInt() else {
                $this->errors[] = .item($name, 'an integer');
                return null;
            };
            $out[] = $n;
        }
        return $out;
    }

    /**
     * Whether the object holds `$name` as an explicit null, which an optional field with a default
     * reads as null rather than as its default.
     */
    public const function nulled(const string& $name) : bool
    {
        json::Value $v = guard $this->object->get($name) else {
            return false;
        };
        return $v->isNull();
    }

    /**
     * Every field error noted, together.
     */
    public const function done() : status<DataError>
    {
        if ($this->errors->empty()) {
            return .ok;
        }
        return .error(.fields($this->errors));
    }

    /**
     * The field's value when it is there and not null; notes a missing required one.
     */
    internal function present(const string& $name, bool $required) : json::Value?
    {
        json::Value $v = $this->object->get($name) ?? .nil();
        if ($v->isNull()) {
            if ($required) {
                $this->errors[] = .missing($name);
            }
            return null;
        }
        return $v;
    }
}
