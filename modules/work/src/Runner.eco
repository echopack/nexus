namespace nexus::work;

use std::time;

/**
 * Runs tasks: claims one that is due, runs it on a background payload of
 * its own (a fresh child container, a log stamped with the task), and
 * records how it went.
 */
public struct Runner
{
    /**
     * Claims one due task and runs it. False when none was due, or the
     * queue could not be read.
     */
    public static function step(nexus::Kernel $k, Work $w) : bool
    {
        time::timestamp $now = $w->clock->now();
        nexus::Payload $claiming = $k->background('work', nexus::Kernel::id());
        Queue $q = $claiming->get<Queue>();
        StoredTask? $claimed = guard $q->claim($w->queues, $now, $now + $w->config->lease) else ($p) {
            $claiming->log->error('the queue cannot be read', ['detail' => $p->detail(nexus::Mode::dev)]);
            nexus::Kernel::finish($claiming);
            return false;
        };
        nexus::Kernel::finish($claiming);
        StoredTask $task = guard $claimed else {
            return false;
        };
        Runner::run($k, $w, $task);
        return true;
    }

    /**
     * Runs claimed `$task` and records the outcome.
     */
    public static function run(nexus::Kernel $k, Work $w, const StoredTask& $task) : void
    {
        nexus::Payload $payload = $k->background($task->name, $task->id);
        Queue $q = $payload->get<Queue>();
        if ($task->attempts > $task->tries) {
            // every try was claimed and none came back: the process died with it
            Runner::record($payload, $q, $task, $w->clock->now(), .giveUp("gave up after {$task->tries} tries that never finished"));
            nexus::Kernel::finish($payload);
            return;
        }
        Kind? $found = $w->kinds->find($task->name);
        if ($found == null) {
            Runner::record($payload, $q, $task, $w->clock->now(), .giveUp("no task named {$task->name} in this program"));
            nexus::Kernel::finish($payload);
            return;
        }
        Kind $kind = guard $found;
        time::instant $start = time::instant::now();
        function<status<Failure>(nexus::Payload&, const string&)> $run = $kind->run;
        status<Failure> $outcome = $run($payload, $task->data);
        float64 $ms = ($start->elapsed()->as_micros() as float64) / 1000.0;
        time::timestamp $now = $w->clock->now();
        guard $outcome else ($f) {
            Runner::record($payload, $q, $task, $now, $f);
            nexus::Kernel::finish($payload);
            return;
        };
        guard $q->done($task, $now) else ($p) {
            $payload->log->error('the queue cannot mark a task done', ['detail' => $p->detail(nexus::Mode::dev)]);
            nexus::Kernel::finish($payload);
            return;
        };
        $payload->log->info('task done', ['ms' => $ms, 'attempt' => $task->attempts]);
        nexus::Kernel::finish($payload);
    }

    /**
     * Retries `$task` or keeps it with the failed ones, as `$f` and its
     * tries left say.
     */
    internal static function record(nexus::Payload& $payload, Queue $q, const StoredTask& $task, time::timestamp $now, const Failure& $f) : void
    {
        time::duration? $wait = match ($f) {
            Failure::retry($why) => Failure::backoff($task->attempts),
            Failure::later($after, $why) => $after,
            Failure::giveUp($why) => null,
        };
        string $why = $f->why();
        if ($wait != null && $task->attempts < $task->tries) {
            time::duration $d = guard $wait;
            guard $q->retry($task, $now + $d, $why) else ($p) {
                $payload->log->error('the queue cannot retry a task', ['detail' => $p->detail(nexus::Mode::dev)]);
                return;
            };
            $payload->log->warn('task will retry', ['why' => $why, 'attempt' => $task->attempts, 'in' => $d->as_secs()]);
            return;
        }
        guard $q->fail($task, $now, $why) else ($p) {
            $payload->log->error('the queue cannot fail a task', ['detail' => $p->detail(nexus::Mode::dev)]);
            return;
        };
        $payload->log->error('task failed', ['why' => $why, 'attempt' => $task->attempts]);
    }
}
