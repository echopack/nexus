namespace nexus::work;

use std::thread;
use std::time;

/**
 * Pushes scheduled tasks when they are due. Each push carries the key
 * `name@slot`, and the queue keeps a key once, so any number of processes
 * may schedule and a slot still runs once. Slots missed while nothing
 * ran are not caught up, except the one a restart lands in within a
 * minute. Once an hour it deletes done runs older than `WORK_KEEP`.
 */
#[atomic]
public class Scheduler
{
    internal Work $work;
    internal thread::mutex<map<string, time::timestamp>> $last = thread::mutex<map<string, time::timestamp>>(map<string, time::timestamp>());
    internal time::timestamp $from;
    internal thread::mutex<time::timestamp?> $pruned = thread::mutex<time::timestamp?>(null);
    internal nexus::Flag $halt = nexus::Flag();
    internal thread::mutex<array<thread::handle>> $threads = thread::mutex<array<thread::handle>>(array<thread::handle>());

    /**
     * Slots after `$from` count as due.
     */
    public constructor(Work $work, time::timestamp $from)
    {
        $this->work = $work;
        $this->from = $from;
    }

    /**
     * Pushes every scheduled task due by `$now` that this scheduler has not
     * pushed yet; answers how many the queue stored (another process may
     * have stored a slot first).
     */
    public function tick(nexus::Kernel $k, time::timestamp $now) : uint32
    {
        uint32 $stored = 0;
        foreach ($this->work->planned as const &$p) {
            time::timestamp $after = $this->lastOf($p->kind->name);
            time::timestamp $slot = guard $p->schedule->due($after, $now, $this->work->zone) else {
                continue;
            };
            int64 $secs = $slot->unix_secs();
            string $key = "{$p->kind->name}@{$secs}";
            nexus::Payload $payload = $k->background('scheduler', nexus::Kernel::id());
            bool $fresh = guard Tasks::store($payload, $p->kind, $p->kind->data, $slot, $key) else ($e) {
                $payload->log->error('cannot push a scheduled task', ['task' => $p->kind->name, 'detail' => $e->detail(nexus::Mode::dev)]);
                nexus::Kernel::finish($payload);
                continue;
            };
            if ($fresh) {
                $payload->log->info('scheduled', ['task' => $p->kind->name, 'slot' => $secs]);
                $stored = $stored + 1;
            }
            nexus::Kernel::finish($payload);
            thread::locked<map<string, time::timestamp>> $held = $this->last->lock();
            $held->value[$p->kind->name] = $slot;
        }
        $this->prune($k, $now);
        return $stored;
    }

    /**
     * Ticks every second on a thread of its own until `stop`.
     */
    public function start(nexus::Kernel $k) : status<nexus::BootError>
    {
        Scheduler $self = $this;
        calendar::Clock $clock = $this->work->clock;
        thread::handle $t = guard thread::spawn(function[$self, $k, $clock]() : void {
            while (!$self->halt->raised()) {
                $self->tick($k, $clock->now());
                Workers::nap($self->halt, time::duration::secs(1));
            }
        }) else {
            return .error(.extension('nexus-work', 'cannot start the scheduler thread'));
        };
        thread::locked<array<thread::handle>> $held = $this->threads->lock();
        $held->value[] = $t;
        return .ok;
    }

    public function stop() : void
    {
        $this->halt->raise();
        thread::locked<array<thread::handle>> $held = $this->threads->lock();
        foreach ($held->value as &$t) {
            $t->join();
        }
        $held->value = array<thread::handle>();
    }

    internal function lastOf(const string& $name) : time::timestamp
    {
        thread::locked<map<string, time::timestamp>> $held = $this->last->lock();
        if ($held->value->has($name)) {
            return $held->value->get($name);
        }
        return $this->from;
    }

    internal function prune(nexus::Kernel $k, time::timestamp $now) : void
    {
        thread::locked<time::timestamp?> $held = $this->pruned->lock();
        if ($held->value != null) {
            time::timestamp $last = guard $held->value;
            if ($now < $last + time::duration::hours(1)) {
                return;
            }
        }
        $held->value = $now;
        nexus::Payload $payload = $k->background('scheduler', nexus::Kernel::id());
        Queue $q = $payload->get<Queue>();
        uint64 $gone = guard $q->prune($now - $this->work->config->keep) else ($e) {
            $payload->log->error('cannot prune done tasks', ['detail' => $e->detail(nexus::Mode::dev)]);
            nexus::Kernel::finish($payload);
            return;
        };
        if ($gone > 0) {
            $payload->log->info('pruned done tasks', ['count' => $gone as int64]);
        }
        nexus::Kernel::finish($payload);
    }
}
