namespace nexus::work;

/**
 * Marks a struct as a task: its public fields are its data, its `handle()` the work, run on a
 * worker with services from the task run's own child container. `nexus gen` writes a `<Task>Task`
 * companion, `SendWelcomeTask::push($payload, $user: 5)`; the app binds it with its queue, tries
 * and schedule where it is wired:
 *
 * ```echo
 * public struct SendWelcome : nexus::work::Task
 * {
 *     public int64 $user;
 *
 *     public function handle(nexus::Payload& $payload) : status<nexus::work::Failure> { ... }
 * }
 *
 * $app->bindTask<SendWelcome>()->queue('mail')->tries(5);
 * $app->bindTask<PruneAuth>()->cron('0 3 * * *');
 * ```
 *
 * A scheduled task is pushed with its defaults, so every field needs one.
 */
public interface Task
{
    function handle(nexus::Payload& $payload) : status<Failure>;
}
