namespace nexus::work;

use std::time;

/**
 * How a process works its queues. Read from `NEXUS_WORK_THREADS`, `NEXUS_WORK_POLL`,
 * `NEXUS_WORK_LEASE`, `NEXUS_WORK_GRACE` and `NEXUS_WORK_KEEP`.
 */
#[nexus::config: 'NEXUS_WORK']
public struct WorkConfig
{
    /**
     * Worker threads of each async queue bound without a count of its own.
     */
    #[nexus::env: 'THREADS']
    public uint32 $threads = 2;

    /**
     * How long a feeder with nothing to claim waits before it looks again.
     */
    #[nexus::env: 'POLL']
    public time::duration $poll = .secs(1);

    /**
     * How long a claimed task is held. A running task's lease is renewed every third of it, so a
     * task is claimed again only once the server running it stopped renewing.
     */
    #[nexus::env: 'LEASE']
    public time::duration $lease = .mins(5);

    /**
     * How long a stopping process waits for running tasks to finish. Stored ones still running
     * then run again once their lease has passed; async ones are lost.
     */
    #[nexus::env: 'GRACE']
    public time::duration $grace = .secs(30);

    /**
     * How long a done stored task is kept, so a scheduled slot is not pushed again and the graph
     * still shows it.
     */
    #[nexus::env: 'KEEP']
    public time::duration $keep = .hours(24);
}
