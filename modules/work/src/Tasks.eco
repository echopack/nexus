namespace nexus::work;

use std::time;

/**
 * Binds task types and puts tasks on the queue. The generated companions call `push`:
 * `SendWelcomeTask::push($payload, $user: 5)`. The task goes to the request's (or task's) `Queue`,
 * so with nexus-work-carbon it is written on the same database session as the work that pushed it.
 */
public struct Tasks
{
    /**
     * Binds task type `T` from what `nexus gen` wrote: the queue it goes to, how often it is tried,
     * and optionally a schedule, `every` (a duration like `15m`) or `cron` (five fields). A
     * scheduled task is pushed with its defaults. List nexus-work before the extension that binds;
     * a problem stops the boot.
     *
     * ```echo
     * nexus::work::Tasks::bind<SendWelcome>($s, queue: 'mail', tries: 5);
     * nexus::work::Tasks::bind<PruneAuth>($s, cron: '0 3 * * *');
     * ```
     */
    public static function bind<T>(
        nexus::Services& $s,
        queue: const string& $queue = 'default',
        tries: int64 $tries = 3,
        every: const string& $every = '',
        cron: const string& $cron = ''
    ) : void
    {
        string $name = $s->generated->nameOf<T>('a task');
        Work $w = guard $s->find<Work>() else {
            $s->fail(.extension('nexus-work', "{$name}: list nexus::work::Extension() before the extension that binds its tasks"));
            return;
        };
        Codec $codec = guard $s->get<Codecs>()->find<T>() else {
            $s->fail(.extension('nexus-work', "{$name}: nexus gen wrote nothing for it; is it a struct conforming to nexus::work::Task, and did nexus gen run?"));
            return;
        };
        if ($queue->empty()) {
            $s->fail(.extension('nexus-work', "{$codec->name}: the queue must be a name, like 'mail'"));
            return;
        }
        if ($tries < 1 || $tries > 100) {
            $s->fail(.extension('nexus-work', "{$codec->name}: tries must be 1 to 100"));
            return;
        }
        if (!$every->empty() && !$cron->empty()) {
            $s->fail(.extension('nexus-work', "{$codec->name}: give every or cron, not both"));
            return;
        }
        $k = Kind($codec->name, $codec->run, $queue: $queue, $tries: $tries, $every: $every, $cron: $cron);
        if ($k->scheduled()) {
            if ($codec->defaults->empty()) {
                $s->fail(.extension('nexus-work', "{$codec->name} is scheduled, so every field needs a default to push it with"));
                return;
            }
            $k->data = $codec->defaults;
        }
        guard Schedule::of($k) else ($e) {
            $s->fail(.extension('nexus-work', "{$codec->name}: {$e}"));
            return;
        };
        $w->kinds->bind<T>(mv $k);
    }

    /**
     * Queues a task of type `T`, as its generated companion encoded it, on the queue `T` was bound
     * with, to run once `$delay` has passed.
     */
    public static function push<T>(nexus::Payload& $payload, const string& $data, after: time::duration $delay = .zero()) : status<nexus::Problem>
    {
        Kind $kind = guard $payload->get<Work>()->kinds->of<T>() else {
            return .error(.server('a task was pushed whose type no extension binds; bind it with $app->bindTask'));
        };
        return Tasks::push($payload, $kind, $data, after: $delay);
    }

    /**
     * Queues a task of `$kind` to run once `$delay` has passed.
     */
    public static function push(nexus::Payload& $payload, const Kind& $kind, const string& $data, after: time::duration $delay = .zero()) : status<nexus::Problem>
    {
        time::timestamp $now = $payload->get<Work>()->clock->now();
        try Tasks::store($payload, $kind, $data, $now + $delay, '');
        return .ok;
    }

    /**
     * Stores a task of `$kind` due at `$at`, under `$key` when it is not empty; `duplicate` when a
     * task with that key is stored already.
     */
    public static function store(nexus::Payload& $payload, const Kind& $kind, const string& $data, time::timestamp $at, const string& $key) : result<Pushed, nexus::Problem>
    {
        time::timestamp $now = $payload->get<Work>()->clock->now();
        string $id = nexus::Kernel::id();
        $task = StoredTask($id: $id, $name: $kind->name, $queue: $kind->queue, $data: $data, $tries: $kind->tries, $key: $key, $createdAt: $now, $availableAt: $at);
        $pushed = try $payload->get<Queue>()->push($task);
        if ($pushed == Pushed::stored) {
            $payload->log->debug('task pushed', ['task' => $kind->name, 'id' => $id]);
        }
        return .ok($pushed);
    }
}
