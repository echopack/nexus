namespace nexus::work;

use std::io;

/**
 * `work:retry --id <id>`: sends a failed task back with its tries fresh, and with it the tasks held
 * back behind it; `--id all` sends every failed one.
 */
public class RetryCommand : nexus::Command
{
    public const function name() : string
    {
        return 'work:retry';
    }

    public const function summary() : string
    {
        return 'send failed tasks back to their queue';
    }

    public const function options() : array<nexus::CommandOption>
    {
        array<nexus::CommandOption> $out = [];
        $out[] = nexus::CommandOption(value: 'id', '<id|all>', 'the failed task, or all of them');
        $out[] = Picked::queue();
        return $out;
    }

    public function run(nexus::Invocation& $in) : int32
    {
        string $wanted = $in->value('id');
        if ($wanted->empty()) {
            io::eprintln('work:retry: --id wants a failed task id, or all');
            return 1;
        }
        nexus::Kernel $kernel = guard $in->kernel() else {
            return 1;
        };
        Distributed $d = guard Picked::lane($kernel, $in, 'work:retry') else {
            return 1;
        };
        Work $w = $kernel->services->get<Work>();
        Store $store = $d->store;
        array<string> $ids = [];
        if ($wanted == 'all') {
            array<StoredTask> $failed = guard $store->failed($d->lane, 10000) else ($p) {
                io::eprintln("work:retry: {$p->detail(.dev)}");
                return 1;
            };
            foreach ($failed as const &$j) {
                $ids[] = $j->id;
            }
        } else {
            $ids[] = $wanted;
        }
        uint32 $sent = 0;
        foreach ($ids as const &$id) {
            Requeued $requeued = guard $store->again($id, $w->clock->now()) else ($p) {
                io::eprintln("work:retry: {$p->detail(.dev)}");
                return 1;
            };
            if ($requeued == Requeued::sent) {
                $sent = $sent + 1;
            } else if ($wanted != 'all') {
                io::eprintln("work:retry: no failed task {$id}");
                return 1;
            }
        }
        io::println("sent back  {$sent} tasks");
        return 0;
    }
}
