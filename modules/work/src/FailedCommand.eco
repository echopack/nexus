namespace nexus::work;

use std::io;

/**
 * `work:failed`: lists the stored tasks that failed for good, the latest first.
 */
public class FailedCommand : nexus::Command
{
    public const function name() : string
    {
        return 'work:failed';
    }

    public const function summary() : string
    {
        return 'list the stored tasks that failed for good';
    }

    public const function options() : array<nexus::CommandOption>
    {
        array<nexus::CommandOption> $out = [Picked::queue()];
        return $out;
    }

    public function run(nexus::Invocation& $in) : int32
    {
        nexus::Kernel $kernel = guard $in->kernel() else {
            return 1;
        };
        Distributed $d = guard Picked::lane($kernel, $in, 'work:failed') else {
            return 1;
        };
        array<StoredTask> $failed = guard $d->store->failed($d->lane, 100) else ($p) {
            io::eprintln("work:failed: {$p->detail(.dev)}");
            return 1;
        };
        if ($failed->empty()) {
            io::println('no failed tasks');
            return 0;
        }
        foreach ($failed as const &$j) {
            string $when = '';
            if ($j->failedAt != null) {
                std::time::timestamp $at = guard $j->failedAt;
                $when = Stamp::text($at);
            }
            io::println("{$j->id}  {$j->name}  {$when}  after {$j->attempts} tries: {$j->error}");
        }
        return 0;
    }
}
