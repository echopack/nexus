namespace nexus::work;

use std::time;

/**
 * A task value the scheduler pushes on a schedule into a lane: `every` (a duration like `15m`) or
 * `cron` (five fields), set where it is wired and checked at boot.
 */
#[atomic]
public class Planned
{
    public Item $item;
    public string $every = '';
    public string $cron = '';

    /**
     * The lane it is pushed into.
     */
    public string $into = '';

    /**
     * The task type, known at boot.
     */
    internal string $name = '';

    /**
     * What its pushes are keyed by, so a slot is stored once across servers.
     */
    internal string $key = '';
    internal Schedule? $schedule = null;

    public constructor(Item $item)
    {
        $this->item = $item;
    }

    /**
     * The task type it pushes, known once the app booted.
     */
    public const function task() : string
    {
        return $this->name;
    }

    /**
     * When it pushes next after `$after`, read in `$zone`; null before boot or when the schedule
     * never comes round again.
     */
    public const function next(time::timestamp $after, const calendar::Zone& $zone) : time::timestamp?
    {
        Schedule $s = guard $this->schedule else {
            return null;
        };
        return $s->next($after, $zone);
    }

    /**
     * The schedule as written.
     */
    public const function text() : string
    {
        if (!$this->every->empty()) {
            return "every {$this->every}";
        }
        return $this->cron;
    }
}
