namespace nexus::work;

use container::Builder;
use std::time;

/**
 * Tasks for a nexus app: binds `Work` (every task type an extension binds
 * with `Tasks::bind`, from the codecs `nexus gen` writes) and, with
 * `stores: .memory`, a `MemoryQueue`. When `serve` (or `work`) starts, it starts `WORK_WORKERS`
 * worker threads and the scheduler; when it stops, the scheduler stops
 * and the workers finish their tasks within `WORK_GRACE`. Adds `work`,
 * `work:failed`, `work:retry` and `work:schedule`.
 *
 * ```echo
 * nexus::work::Extension(stores: .provided),     // the queue from nexus-work-carbon
 * nexus::work::carbon::Extension(),
 * ```
 *
 * Cron lines are read in `zone`, UTC unless given. `tasks` adds task types
 * written by hand, next to the bound ones. List it before the app, which
 * binds its tasks.
 */
public class Extension : nexus::Extension
{
    public Stores $stores;
    public calendar::Clock $clock;
    public calendar::Zone $zone;
    public array<Kind> $tasks;
    internal Workers? $workers = null;
    internal Scheduler? $scheduler = null;

    public constructor(
        stores: Stores $stores = Stores::memory,
        clock: calendar::Clock $clock = calendar::SystemClock(),
        zone: calendar::Zone $zone = calendar::Zone::utc(),
        tasks: array<Kind> $tasks = array<Kind>()
    )
    {
        $this->stores = $stores;
        $this->clock = $clock;
        $this->zone = $zone;
        $this->tasks = $tasks;
    }

    public function name() : string
    {
        return 'nexus-work';
    }

    public function services(nexus::Services& $s) : status<nexus::BootError>
    {
        WorkConfig $config = $s->get<WorkConfig>();
        Codecs $codecs = Codecs();
        foreach (attr::of<TaskTable>("nexus::tasks") as const &$t) {
            function<void(Codecs)> $add = $t->call;
            $add($codecs);
        }
        $s->bind<Codecs>(put: $codecs);
        Kinds $kinds = Kinds();
        foreach ($this->tasks as const &$k) {
            $kinds->add($k);
        }
        // the schedule and the queues once every extension has bound its tasks, at boot
        array<Planned> $planned = [];
        array<string> $queues = [];
        Work $w = Work($kinds, $planned, $queues, $config, $this->clock, $this->zone);
        $s->bind<Work>(put: $w);
        if ($this->stores == Stores::memory) {
            $s->bind<MemoryQueue>(put: MemoryQueue());
            $s->alias<Queue, MemoryQueue>();
        }
        return .ok;
    }

    public function boot(nexus::Kernel $kernel) : status<nexus::BootError>
    {
        if (!$kernel->services->has<Queue>()) {
            return .error(.extension('nexus-work', 'no queue is bound; use stores: .memory or add nexus::work::carbon::Extension()'));
        }
        Work $w = $kernel->services->get<Work>();
        array<Planned> $planned = [];
        foreach ($w->kinds->all() as const &$k) {
            Schedule? $found = guard Schedule::of($k) else ($e) {
                return .error(.extension('nexus-work', $e));
            };
            if ($found != null) {
                Schedule $schedule = guard $found;
                $planned[] = Planned($kind: $k, $schedule: $schedule);
            }
        }
        array<string> $queues = [];
        foreach (str::split($w->config->queues, ',') as const &$q) {
            string $name = string::from(str::trim($q));
            if (!$name->empty()) {
                $queues[] = $name;
            }
        }
        if ($queues->empty()) {
            $queues = $w->kinds->queues();
        }
        $w->planned = $planned;
        $w->queues = $queues;
        return .ok;
    }

    public function commands(nexus::Commands& $cmds) : void
    {
        $cmds->add(WorkCommand());
        $cmds->add(FailedCommand());
        $cmds->add(RetryCommand());
        $cmds->add(ScheduleCommand());
    }

    public function start(nexus::Kernel $kernel, const nexus::Serve& $options) : status<nexus::BootError>
    {
        Work $w = $kernel->services->get<Work>();
        if ($options->work && $w->config->workers > 0 && $w->kinds->count() > 0) {
            Workers $ws = Workers();
            guard $ws->start($kernel, $w, $w->config->workers) else ($e) {
                $ws->stop(time::duration::zero());
                return .error($e);
            };
            $this->workers = $ws;
            string $queues = str::join($w->queues, ', ');
            $kernel->log->info("working {$queues} with {$w->config->workers} workers");
        }
        if ($options->schedule && !$w->planned->empty()) {
            Scheduler $s = Scheduler($w, $w->clock->now() - time::duration::mins(1));
            guard $s->start($kernel) else ($e) {
                $this->drain($kernel);
                return .error($e);
            };
            $this->scheduler = $s;
            $kernel->log->info("scheduling {$w->planned->count()} tasks");
        }
        return .ok;
    }

    public function drain(nexus::Kernel $kernel) : void
    {
        if ($this->scheduler != null) {
            Scheduler $s = guard $this->scheduler;
            $s->stop();
            $this->scheduler = null;
        }
        if ($this->workers != null) {
            Workers $ws = guard $this->workers;
            Work $w = $kernel->services->get<Work>();
            if ($ws->stop($w->config->grace)) {
                $kernel->log->info('workers stopped');
            } else {
                $kernel->log->warn('tasks still running after the grace; they run again once their lease has passed', ['running' => $ws->running()]);
            }
            $this->workers = null;
        }
    }
}
