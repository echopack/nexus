namespace nexus::work;

use std::time;

/**
 * Tasks for a nexus app: binds `Work` (how every task type is stored, from the codecs `nexus gen`
 * writes, every lane and the scheduler) and `Codecs`. The app binds its queues and plans after it.
 * When `serve` (or `work`) starts, every async queue starts its threads, every distributed lane its
 * feeder, and the scheduler starts; when it stops, the scheduler and the feeders stop and the
 * queues finish their running tasks within `NEXUS_WORK_GRACE`. Adds `work`, `work:failed`,
 * `work:retry`, `work:cancel`, `work:graph` and `work:schedule`.
 *
 * ```echo
 * nexus::work::Extension(),
 * ```
 *
 * Cron lines are read in `zone`, UTC unless given.
 */
public class Extension : nexus::Extension
{
    public calendar::Clock $clock;
    public calendar::Zone $zone;
    internal bool $started = false;

    public constructor(clock: calendar::Clock $clock = calendar::SystemClock(), zone: calendar::Zone $zone = .utc())
    {
        $this->clock = $clock;
        $this->zone = mv $zone;
    }

    public function name() : string
    {
        return 'nexus-work';
    }

    public function services(nexus::Services& $s) : status<nexus::BootError>
    {
        WorkConfig $config = $s->get<WorkConfig>();
        Codecs $codecs = Codecs();
        foreach (attr::of<TaskTable>("nexus::tasks") as const &$t) {
            function<void(Codecs)> $add = $t->call;
            $add($codecs);
        }
        $s->bind<Codecs>(put: $codecs);
        $s->bind<Work>(put: Work($config, $this->clock, $this->zone, $codecs));
        return .ok;
    }

    public function boot(nexus::Kernel $kernel) : status<nexus::BootError>
    {
        Work $w = $kernel->services->get<Work>();
        array<Feeder> $feeders = [];
        foreach ($w->lanes->stores() as $d) {
            if ($d->into->empty()) {
                return .error(.extension('nexus-work', "{$d->lane}: a distributed queue needs an async queue to run on; give it ->into<Lane>()"));
            }
            Pool $into = guard $w->lanes->pool($d->into) else {
                return .error(.extension('nexus-work', "{$d->lane} runs into lane {$d->into}, which is not a bound async queue"));
            };
            $feeders[] = Feeder($d, $into, $w);
        }
        $w->lanes->feeders = mv $feeders;
        guard $w->scheduler->prepare($w->codecs, $w->lanes) else ($e) {
            return .error(.extension('nexus-work', $e));
        };
        foreach ($w->scheduler->plans as $p) {
            if ($w->lanes->pool($p->into) != null) {
                $kernel->log->warn("{$p->name} is scheduled into async lane {$p->into}, so every process that schedules pushes it");
            }
        }
        return .ok;
    }

    public function commands(nexus::Commands& $cmds) : void
    {
        $cmds->add(WorkCommand());
        $cmds->add(FailedCommand());
        $cmds->add(RetryCommand());
        $cmds->add(CancelCommand());
        $cmds->add(GraphCommand());
        $cmds->add(ScheduleCommand());
    }

    public function start(nexus::Kernel $kernel, const nexus::Serve& $options) : status<nexus::BootError>
    {
        Work $w = $kernel->services->get<Work>();
        if ($options->work) {
            array<string> $lines = [];
            foreach ($w->lanes->pools() as $p) {
                guard $p->start($kernel) else ($e) {
                    $this->drain($kernel);
                    return .error($e);
                };
                $lines[] = "{$p->lane} ({$p->threads} threads)";
                $this->started = true;
            }
            foreach ($w->lanes->feeders as $f) {
                guard $f->start($kernel) else ($e) {
                    $this->drain($kernel);
                    return .error($e);
                };
                $lines[] = "{$f->lane->lane} into {$f->lane->into}";
            }
            if (!$lines->empty()) {
                string $working = str::join($lines, ', ');
                $kernel->log->info("working {$working}");
            }
        }
        bool $plans = !$w->scheduler->plans->empty();
        if ($options->schedule && ($plans || !$w->lanes->stores->empty())) {
            guard $w->scheduler->start($kernel, $w) else ($e) {
                $this->drain($kernel);
                return .error($e);
            };
            $kernel->log->info("scheduling {$w->scheduler->plans->count()} tasks");
        }
        return .ok;
    }

    public function drain(nexus::Kernel $kernel) : void
    {
        Work $w = $kernel->services->get<Work>();
        $w->scheduler->stop();
        foreach ($w->lanes->feeders as $f) {
            $f->stop();
        }
        if (!$this->started) {
            return;
        }
        $this->started = false;
        bool $all = true;
        foreach ($w->lanes->pools() as $p) {
            if (!$p->stop($w->config->grace)) {
                $all = false;
                $kernel->log->warn('tasks still running after the grace', ['lane' => $p->lane, 'running' => $p->running()]);
            }
        }
        if ($all) {
            $kernel->log->info('workers stopped');
        }
    }
}
