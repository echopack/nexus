namespace nexus::work;

/**
 * What `nexus gen` wrote for one task type: its name (the struct's qualified name), how its data
 * runs, and the data of the task with every default, empty when a field has none.
 */
public struct Codec
{
    public string $name;
    public function<status<Failure>(nexus::Payload&, const string&)> $run;
    public string $defaults;
}
