namespace nexus::work;

/**
 * How one task type is stored: its name (the struct's qualified name), how a value of it becomes
 * text, and how text becomes an item again.
 */
public struct Codec
{
    public string $name;
    public function<string(const erased&)> $encode;
    public function<result<Item, DataError>(const string&)> $decode;
}
