namespace nexus::work;

use std::time;

/**
 * Times as the commands print them.
 */
internal struct Stamp
{
    /**
     * `$t` as RFC 3339 in UTC.
     */
    public static function text(time::timestamp $t) : string
    {
        calendar::Zoned $z = guard calendar::Zoned::of($t, calendar::Zone::utc()) else {
            return str::from($t->unix_secs());
        };
        return $z->format(calendar::Format::rfc3339());
    }
}
