namespace nexus::work;

use std::thread;
use std::time;

/**
 * Worker threads: each claims a due task, runs it, and looks again; an idle one waits `WORK_POLL`
 * between looks. `stop` lets every worker finish the task it holds.
 */
#[atomic]
public class Workers
{
    internal nexus::Flag $halt = nexus::Flag();
    internal atomic<int32> $alive = atomic<int32>(0);
    internal thread::mutex<array<thread::handle>> $threads = thread::mutex<array<thread::handle>>(array<thread::handle>());

    /**
     * Starts `$count` workers on the kernel's queue.
     */
    public function start(nexus::Kernel $k, Work $w, uint32 $count) : status<nexus::BootError>
    {
        $self = $this;
        uint32 $i = 0;
        while ($i < $count) {
            thread::handle $t = guard thread::spawn(function[$self, $k, $w]() : void {
                $self->loop($k, $w);
            }) else {
                return .error(.extension('nexus-work', 'cannot start a worker thread'));
            };
            thread::locked<array<thread::handle>> $held = $this->threads->lock();
            $held->value[] = $t;
            $i = $i + 1;
        }
        return .ok;
    }

    /**
     * Asks every worker to stop once its task is done and waits for them, at most `$grace`. True
     * when all stopped in time; the tasks of the others run again once their lease has passed.
     */
    public function stop(time::duration $grace) : bool
    {
        $this->halt->raise();
        time::instant $start = time::instant::now();
        while ($this->alive->load() > 0 && $start->elapsed() < $grace) {
            thread::sleep(20);
        }
        if ($this->alive->load() > 0) {
            return false;
        }
        thread::locked<array<thread::handle>> $held = $this->threads->lock();
        foreach ($held->value as &$t) {
            $t->join();
        }
        $held->value = array<thread::handle>();
        return true;
    }

    /**
     * How many workers are running.
     */
    public const function running() : int32
    {
        return $this->alive->load();
    }

    internal function loop(nexus::Kernel $k, Work $w) : void
    {
        $this->alive->add(1);
        while (!$this->halt->raised()) {
            if (!Runner::step($k, $w)) {
                Workers::nap($this->halt, $w->config->poll);
            }
        }
        $this->alive->add(-1);
    }

    /**
     * Sleeps `$d`, waking early when `$halt` is raised.
     */
    public static function nap(nexus::Flag $halt, time::duration $d) : void
    {
        int64 $left = $d->as_millis();
        while ($left > 0 && !$halt->raised()) {
            int64 $slice = 50;
            if ($left < $slice) {
                $slice = $left;
            }
            thread::sleep($slice as int32);
            $left = $left - $slice;
        }
    }
}
