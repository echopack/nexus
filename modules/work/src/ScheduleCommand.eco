namespace nexus::work;

use std::io;

/**
 * `work:schedule`: lists the scheduled tasks with their schedule, their lane and when they are next
 * due.
 */
public class ScheduleCommand : nexus::Command
{
    public const function name() : string
    {
        return 'work:schedule';
    }

    public const function summary() : string
    {
        return 'list the scheduled tasks and when they are next due';
    }

    public function run(nexus::Invocation& $in) : int32
    {
        nexus::Kernel $kernel = guard $in->kernel() else {
            return 1;
        };
        $w = $kernel->services->get<Work>();
        if ($w->scheduler->plans->empty()) {
            io::println('no scheduled tasks');
            return 0;
        }
        foreach ($w->scheduler->plans as $p) {
            string $next = 'never';
            std::time::timestamp? $at = $p->next($w->clock->now(), $w->zone);
            if ($at != null) {
                std::time::timestamp $due = guard $at;
                $next = Stamp::text($due);
            }
            io::println("{$p->name}  {$p->text()}  into {$p->into}  next {$next}");
        }
        return 0;
    }
}
