namespace nexus::work;

use std::io;

/**
 * `work:schedule`: lists the scheduled tasks with their schedule and when they are next due.
 */
public class ScheduleCommand : nexus::Command
{
    public const function name() : string
    {
        return 'work:schedule';
    }

    public const function summary() : string
    {
        return 'list the scheduled tasks and when they are next due';
    }

    public function run(nexus::Kernel $kernel, const nexus::Invocation& $in) : int32
    {
        $w = $kernel->services->get<Work>();
        if ($w->planned->empty()) {
            io::println('no scheduled tasks');
            return 0;
        }
        foreach ($w->planned as const &$p) {
            string $next = 'never';
            std::time::timestamp? $at = $p->schedule->next($w->clock->now(), $w->zone);
            if ($at != null) {
                std::time::timestamp $due = guard $at;
                $next = Stamp::text($due);
            }
            io::println("{$p->kind->name}  {$p->schedule->text}  next {$next}");
        }
        return 0;
    }
}
