namespace nexus::work;

use std::time;

/**
 * When a scheduled task is due: every so long, counted from the Unix
 * epoch so every process agrees on the slots, or at the minutes a cron
 * line matches, in the extension's zone.
 */
public struct Schedule
{
    public string $text;
    internal int64 $everySecs = 0;
    internal Cron? $cron = null;

    /**
     * The schedule of `$kind`, or null when it has none.
     */
    public static function of(const Kind& $kind) : result<Schedule?, string>
    {
        if (!$kind->every->empty()) {
            time::duration $d = guard nexus::Settings::span($kind->every) else {
                return .error("{$kind->name}: '{$kind->every}' is not a duration like 30s, 15m or 2h");
            };
            int64 $secs = $d->as_secs();
            if ($secs < 1 || $d != time::duration::secs($secs)) {
                return .error("{$kind->name}: '{$kind->every}' must be whole seconds, at least one");
            }
            Schedule $s = Schedule($text: "every {$kind->every}");
            $s->everySecs = $secs;
            return .ok($s);
        }
        if (!$kind->cron->empty()) {
            Cron $c = guard Cron::parse($kind->cron) else ($e) {
                return .error("{$kind->name}: {$e}");
            };
            Schedule $s = Schedule($text: $kind->cron);
            $s->cron = $c;
            return .ok($s);
        }
        return .ok(null);
    }

    /**
     * The latest slot after `$after` and no later than `$now`, or null when
     * none fell in between. A cron line looks back at most a day.
     */
    public const function due(time::timestamp $after, time::timestamp $now, const calendar::Zone& $zone) : time::timestamp?
    {
        if ($this->everySecs > 0) {
            time::timestamp $at = time::timestamp::from_unix_secs(Schedule::floor($now->unix_secs(), $this->everySecs));
            if ($at > $after) {
                return $at;
            }
            return null;
        }
        Cron $c = guard $this->cron else {
            return null;
        };
        int64 $minute = Schedule::floor($now->unix_secs(), 60);
        int32 $looked = 0;
        while ($looked < 1440) {
            time::timestamp $at = time::timestamp::from_unix_secs($minute);
            if ($at <= $after) {
                return null;
            }
            if (Schedule::hits($c, $at, $zone)) {
                return $at;
            }
            $minute = $minute - 60;
            $looked = $looked + 1;
        }
        return null;
    }

    /**
     * The first slot after `$after`, looking a year ahead at most.
     */
    public const function next(time::timestamp $after, const calendar::Zone& $zone) : time::timestamp?
    {
        if ($this->everySecs > 0) {
            int64 $slot = Schedule::floor($after->unix_secs(), $this->everySecs) + $this->everySecs;
            return time::timestamp::from_unix_secs($slot);
        }
        Cron $c = guard $this->cron else {
            return null;
        };
        int64 $minute = Schedule::floor($after->unix_secs(), 60) + 60;
        int64 $looked = 0;
        while ($looked < 527040) {
            time::timestamp $at = time::timestamp::from_unix_secs($minute);
            if (Schedule::hits($c, $at, $zone)) {
                return $at;
            }
            $minute = $minute + 60;
            $looked = $looked + 1;
        }
        return null;
    }

    internal static function hits(const Cron& $c, time::timestamp $at, const calendar::Zone& $zone) : bool
    {
        calendar::Zoned $z = guard calendar::Zoned::of($at, $zone) else {
            return false;
        };
        return $c->matches($z->local());
    }

    /**
     * `$n` rounded down to a multiple of `$step`, also below zero.
     */
    internal static function floor(int64 $n, int64 $step) : int64
    {
        int64 $r = $n % $step;
        if ($r < 0) {
            $r = $r + $step;
        }
        return $n - $r;
    }
}
