namespace nexus::work;

/**
 * Where a stored task stands. A waiting task with tasks before it left to settle is held back; one
 * whose task before it failed for good stays held back until that one is sent back and done.
 */
public enum TaskStatus : uint8
{
    case waiting = 0;
    case running = 1;
    case done = 2;
    case failed = 3;
    case cancelled = 4;

    public const function name() : string
    {
        return match ($this) {
            TaskStatus::waiting => 'waiting',
            TaskStatus::running => 'running',
            TaskStatus::done => 'done',
            TaskStatus::failed => 'failed',
            TaskStatus::cancelled => 'cancelled',
        };
    }

    /**
     * The status called `$name`, or null.
     */
    public static function parse(const string& $name) : TaskStatus?
    {
        array<TaskStatus> $all = [.waiting, .running, .done, .failed, .cancelled];
        foreach ($all as $s) {
            if ($s->name() == $name) {
                return $s;
            }
        }
        return null;
    }
}
