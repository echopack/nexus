namespace nexus::work;

use std::thread;
use std::time;

/**
 * The queue in memory: for tests, and for one process that may lose what
 * waits when it stops.
 */
#[atomic]
public class MemoryQueue : Queue
{
    private thread::mutex<array<StoredTask>> $tasks;

    public constructor()
    {
        $this->tasks = thread::mutex<array<StoredTask>>(array<StoredTask>());
    }

    public function push(const StoredTask& $task) : result<bool, nexus::Problem>
    {
        thread::locked<array<StoredTask>> $held = $this->tasks->lock();
        if (!$task->key->empty()) {
            foreach ($held->value as const &$j) {
                if ($j->key == $task->key) {
                    return .ok(false);
                }
            }
        }
        $held->value[] = $task;
        return .ok(true);
    }

    public function claim(const array<string>& $queues, time::timestamp $now, time::timestamp $until) : result<StoredTask?, nexus::Problem>
    {
        thread::locked<array<StoredTask>> $held = $this->tasks->lock();
        usize $best = $held->value->count();
        usize $i = 0;
        while ($i < $held->value->count()) {
            StoredTask $j = $held->value[$i];
            if ($j->due($now) && MemoryQueue::listed($queues, $j->queue)) {
                if ($best == $held->value->count() || $j->availableAt < $held->value[$best]->availableAt) {
                    $best = $i;
                }
            }
            $i = $i + 1;
        }
        if ($best == $held->value->count()) {
            return .ok(null);
        }
        $held->value[$best]->attempts = $held->value[$best]->attempts + 1;
        $held->value[$best]->reservedUntil = $until;
        StoredTask $claimed = $held->value[$best];
        return .ok($claimed);
    }

    public function done(const StoredTask& $task, time::timestamp $now) : status<nexus::Problem>
    {
        thread::locked<array<StoredTask>> $held = $this->tasks->lock();
        usize $i = guard MemoryQueue::held($held->value, $task) else {
            return .ok;
        };
        if ($task->key->empty()) {
            $held->value->remove($i);
            return .ok;
        }
        $held->value[$i]->doneAt = $now;
        $held->value[$i]->reservedUntil = null;
        return .ok;
    }

    public function retry(const StoredTask& $task, time::timestamp $at, const string& $error) : status<nexus::Problem>
    {
        thread::locked<array<StoredTask>> $held = $this->tasks->lock();
        usize $i = guard MemoryQueue::held($held->value, $task) else {
            return .ok;
        };
        $held->value[$i]->availableAt = $at;
        $held->value[$i]->reservedUntil = null;
        $held->value[$i]->error = $error;
        return .ok;
    }

    public function fail(const StoredTask& $task, time::timestamp $now, const string& $error) : status<nexus::Problem>
    {
        thread::locked<array<StoredTask>> $held = $this->tasks->lock();
        usize $i = guard MemoryQueue::held($held->value, $task) else {
            return .ok;
        };
        $held->value[$i]->failedAt = $now;
        $held->value[$i]->reservedUntil = null;
        $held->value[$i]->error = $error;
        return .ok;
    }

    public function failed(uint64 $limit) : result<array<StoredTask>, nexus::Problem>
    {
        thread::locked<array<StoredTask>> $held = $this->tasks->lock();
        array<StoredTask> $out = [];
        usize $i = $held->value->count();
        while ($i > 0 && ($out->count() as uint64) < $limit) {
            $i = $i - 1;
            if ($held->value[$i]->failedAt != null) {
                $out[] = $held->value[$i];
            }
        }
        return .ok($out);
    }

    public function again(const string& $id, time::timestamp $now) : result<bool, nexus::Problem>
    {
        thread::locked<array<StoredTask>> $held = $this->tasks->lock();
        usize $i = 0;
        while ($i < $held->value->count()) {
            if ($held->value[$i]->id == $id && $held->value[$i]->failedAt != null) {
                $held->value[$i]->failedAt = null;
                $held->value[$i]->attempts = 0;
                $held->value[$i]->availableAt = $now;
                return .ok(true);
            }
            $i = $i + 1;
        }
        return .ok(false);
    }

    public function prune(time::timestamp $before) : result<uint64, nexus::Problem>
    {
        thread::locked<array<StoredTask>> $held = $this->tasks->lock();
        array<StoredTask> $kept = [];
        uint64 $gone = 0;
        foreach ($held->value as const &$j) {
            bool $old = false;
            if ($j->doneAt != null) {
                time::timestamp $at = guard $j->doneAt;
                $old = $at < $before;
            }
            if ($old) {
                $gone = $gone + 1;
            } else {
                $kept[] = $j;
            }
        }
        $held->value = $kept;
        return .ok($gone);
    }

    public function waiting() : result<uint64, nexus::Problem>
    {
        thread::locked<array<StoredTask>> $held = $this->tasks->lock();
        uint64 $n = 0;
        foreach ($held->value as const &$j) {
            if ($j->doneAt == null && $j->failedAt == null) {
                $n = $n + 1;
            }
        }
        return .ok($n);
    }

    /**
     * Every task stored, for tests.
     */
    public function all() : array<StoredTask>
    {
        thread::locked<array<StoredTask>> $held = $this->tasks->lock();
        return $held->value;
    }

    internal static function listed(const array<string>& $queues, const string& $queue) : bool
    {
        foreach ($queues as const &$q) {
            if ($q == $queue) {
                return true;
            }
        }
        return false;
    }

    /**
     * Where `$task` is, while the claim it names still holds.
     */
    internal static function held(const array<StoredTask>& $all, const StoredTask& $task) : usize?
    {
        usize $i = 0;
        while ($i < $all->count()) {
            if ($all[$i]->id == $task->id) {
                if ($all[$i]->attempts != $task->attempts) {
                    return null;
                }
                usize $at = $i;
                return $at;
            }
            $i = $i + 1;
        }
        return null;
    }
}
