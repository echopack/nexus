/**
 * nexus-work in this process: the task data codec, failures and backoff, cron lines and schedules,
 * task policies, inline runs, and async queues with their retries, exclusive keys, pipelines,
 * subflows, priorities and run logs.
 */

use std::thread;
use std::time;
use ecotest::expect;
use nexus::work::{TaskData, Failure, Cron, Schedule, Exclusive, Hold, Policy, Priority, Inline, Pipeline, Step, Pushed, Run, RunLog, Settle};

internal function why(status<nexus::work::DataError> $s) : string
{
    guard $s else ($e) {
        return str::from($e);
    };
    return '';
}

internal function cronRefused(const string& $line) : bool
{
    guard Cron::parse($line) else {
        return true;
    };
    return false;
}

internal function scheduleOf(const string& $every, const string& $cron) : Schedule
{
    Schedule? $s = guard Schedule::of($every, $cron);
    Schedule $out = guard $s;
    return $out;
}

internal function scheduleRefused(const string& $every, const string& $cron) : bool
{
    guard Schedule::of($every, $cron) else {
        return true;
    };
    return false;
}

internal function at(int32 $hour, int32 $minute) : calendar::DateTime
{
    return calendar::DateTime(2026, .november, 2, $hour, $minute);
}

internal function kindOf(const Failure& $f) : string
{
    return match ($f) {
        Failure::retry($why) => 'retry',
        Failure::later($after, $why) => 'later',
        Failure::giveUp($why) => 'giveUp',
    };
}

internal function pushed(result<Pushed, nexus::Problem> $r) : Pushed
{
    Pushed $p = guard $r else ($e) {
        die("the push failed: {$e->detail(.dev)}");
    };
    return $p;
}

test task_data_round_trip
{
    $p = TaskData();
    $p->put('n', 42);
    $p->put('s', 'hé "x"');
    $p->put('b', true);
    $p->put('f', 1.5);
    array<string> $tags = ['a', 'b'];
    $p->put('tags', $tags);
    array<int64> $ids = [3, 4];
    $p->put('ids', $ids);
    $p->nil('none');
    TaskData $back = expect(TaskData::parse($p->text()))->ok();
    expect($back->int64('n', required: true))->some(42);
    expect($back->string('s', required: true))->some('hé "x"');
    expect($back->bool('b', required: true))->some(true);
    expect($back->float64('f', required: true))->some(1.5);
    array<string> $t = $back->strings('tags', required: true) ?? array<string>();
    expect($t)->size(2);
    expect($t[1])->is('b');
    array<int64> $i = $back->ints('ids', required: true) ?? array<int64>();
    expect($i)->size(2);
    expect($i[0])->is(3);
    expect($back->string('none', required: false))->none();
    expect($back->uint32('n', required: true))->some(42);
    expect($back->done())->fine();
}

test task_data_reports_missing_and_mistyped
{
    TaskData $p = expect(TaskData::parse('{"n":"x","big":5000000000}'))->ok();
    expect($p->int64('n', required: true))->none();
    expect($p->string('gone', required: true))->none();
    expect($p->int32('big', required: true))->none();
    expect($p->string('maybe', required: false))->none();
    expect(why($p->done()))->is('n is not an integer; gone is missing; big does not fit an int32');
    bool $bad = true;
    guard TaskData::parse('[1]') else {
        return;
    };
    expect($bad)->no(says: 'a JSON array is refused as task data');
}

test failure_from_problems_and_backoff
{
    Failure $server = .of(.unavailable('db down'));
    Failure $client = .of(.notFound('the user'));
    Failure $wait = .of(.tooMany(30));
    expect(kindOf($server))->is('retry');
    expect(kindOf($client))->is('giveUp');
    expect(kindOf($wait))->is('later');
    expect(Failure::backoff(1)->as_secs())->is(10);
    expect(Failure::backoff(2)->as_secs())->is(40);
    expect(Failure::backoff(3)->as_secs())->is(160);
    expect(Failure::backoff(9)->as_secs())->is(3600);
}

test settle_retries_while_tries_are_left
{
    time::timestamp $now = .from_unix_secs(START);
    status<Failure> $flaky = .error(.retry('x'));
    status<Failure> $later = .error(.later(time::duration::secs(30), 'busy'));
    status<Failure> $gone = .error(.giveUp('gone'));
    status<Failure> $fine = .ok;
    expect(settled(Settle::of($flaky, 1, 3, $now), $now))->is('retry in 10');
    expect(settled(Settle::of($later, 2, 3, $now), $now))->is('retry in 30');
    expect(settled(Settle::of($flaky, 3, 3, $now), $now))->is('fail: x');
    expect(settled(Settle::of($gone, 1, 3, $now), $now))->is('fail: gone');
    expect(settled(Settle::of($fine, 1, 3, $now), $now))->is('done');
}

internal function settled(const Settle& $s, time::timestamp $now) : string
{
    return match ($s) {
        Settle::done => 'done',
        Settle::retry($at, $why) => Settled::retry($at, $now),
        Settle::fail($why) => "fail: {$why}",
    };
}

internal struct Settled
{
    public static function retry(std::time::timestamp $at, std::time::timestamp $now) : string
    {
        int64 $secs = ($at - $now)->as_secs();
        return "retry in {$secs}";
    }
}

test cron_parses_and_matches
{
    Cron $nightly = expect(Cron::parse('0 3 * * *'))->ok();
    expect($nightly->matches(at(3, 0)))->yes(says: '0 3 * * * matches 03:00');
    expect($nightly->matches(at(3, 1)))->no(says: '0 3 * * * skips 03:01');

    Cron $office = expect(Cron::parse('*/15 8-18 * * 1-5'))->ok();
    expect($office->matches(at(8, 15)))->yes(says: 'office hours match Monday 08:15');
    expect($office->matches(at(8, 20)))->no(says: 'office hours skip 08:20');
    $saturday = calendar::DateTime(2026, .november, 7, 9, 0);
    expect($office->matches($saturday))->no(says: 'office hours skip Saturday');

    array<string> $bad = ['0 3 * *', '61 * * * *', '* 24 * * *', '*/0 * * * *', 'x * * * *', '5-1 * * * *'];
    foreach ($bad as const &$line) {
        expect(cronRefused($line))->yes(says: "the cron line '{$line}' is refused");
    }
}

test schedules_find_due_and_next_slots
{
    calendar::Zone $utc = .utc();
    Schedule $e = scheduleOf('15m', '');
    time::timestamp $t0 = .from_unix_secs(START);
    time::timestamp $last = expect($e->due(time::timestamp::from_unix_secs(START - 3600), $t0, $utc))->some();
    expect($last->unix_secs())->is(START - 840);
    expect($e->due($last, $t0, $utc))->none();
    time::timestamp $next = expect($e->next($t0, $utc))->some();
    expect($next->unix_secs())->is(START + 60);

    Schedule $c = scheduleOf('', '0 3 * * *');
    expect($c->due($t0 - time::duration::mins(1), $t0, $utc))->none();
    time::timestamp $three = expect($c->due($t0, $t0 + time::duration::secs(90), $utc))->some();
    expect($three->unix_secs())->is(START + 60);

    expect(scheduleRefused('1500ms', ''))->yes(says: 'an every of 1500ms is refused');
    expect(Schedule::of('', ''))->ok();
}

test exclusive_keys_default_to_the_task_type
{
    Exclusive $none = .none;
    Exclusive $type = .running('');
    Exclusive $user = .unique('user:5');
    expect($none->key('blog::SendWelcome'))->is('');
    expect($type->key('blog::SendWelcome'))->is('blog::SendWelcome');
    expect($user->key('blog::SendWelcome'))->is('blog::SendWelcome#user:5');
    expect($user->hold() == Hold::unique)->yes(says: 'a unique key holds as unique');
}

test a_task_declares_its_policy
{
    Policy $plain = Policy::of<TSay>(TSay('x'));
    expect($plain->tries)->is(3);
    expect($plain->allowFailure)->no(says: 'a task does not allow failure unless it says so');
    expect($plain->expires)->none();
    Policy $own = Policy::of<TSay>(TSay('x', $mode: 'unique', $key: 'k', $soft: true, $prio: 1, $ttl: 60, $limit: 7));
    expect($own->tries)->is(7);
    expect($own->allowFailure)->yes(says: 'the task allows failure');
    expect($own->priority == Priority::high)->yes(says: 'the task runs at high priority');
    expect($own->exclusive->key('TSay'))->is('TSay#k');
    time::duration $ttl = expect($own->expires)->some();
    expect($ttl->as_secs())->is(60);
}

test inline_runs_once_on_the_callers_payload
{
    $r = rig();
    nexus::Payload $payload = $r->payload();
    expect(Inline::run($payload, TSay('now')))->fine();
    status<Failure> $flaky = Inline::run($payload, TSay('flaky'));
    Failure $f = expect($flaky)->fails();
    expect($f->why())->is('flaky fails');
    expect($r->app->logged('heard flaky failed: flaky fails'))->yes(says: 'an inline failure is the last try');
    expect($r->app->logged('heard now failed: '))->no();
    expect($r->tally->all())->size(2);
    Run $run = got($payload->state<Run>());
    expect($run->name)->is('TSay');
    expect($run->attempt)->is(1);
}

test inline_runs_a_pipeline_in_order_and_stops_at_a_hard_failure
{
    $r = rig();
    nexus::Payload $payload = $r->payload();
    $p = Pipeline();
    Step $a = $p->add(TSay('a'));
    Step $b = $p->add(TSay('soft-doomed', $soft: true), after: [$a]);
    Step $c = $p->add(TSay('c', $spawn: 2), after: [$b]);
    $p->add(TSay('d'), after: [$c]);
    expect(Inline::run($payload, $p))->fine();
    array<string> $seen = $r->tally->all();
    expect(str::join($seen, ','))->is('a,soft-doomed,c,c after failed TSay,c.0,c.1,d');
    expect($a->id())->some();

    $hard = Pipeline();
    Step $x = $hard->add(TSay('doomed'));
    $hard->add(TSay('never'), after: [$x]);
    expect(Inline::run($payload, $hard))->fails();
    expect($r->tally->has('never'))->no(says: 'a task after a hard failure does not run');
}

test async_runs_pushed_tasks_on_threads
{
    $r = rig();
    $r->start();
    int32 $i = 0;
    while ($i < 8) {
        Pushed $p = pushed($r->workers()->push(TSay("say {$i}")));
        expect($p->queued())->yes(says: 'the task was queued');
        $i++;
    }
    $r->wait(8);
    $r->stop();
    expect($r->tally->all())->size(8);
    expect($r->app->logged('task done'))->yes(says: 'a run logs task done');
    expect($r->app->logged('working workers (2 threads), jobs into workers'))->yes(says: 'the start names the lanes');
    expect($r->app->logged('workers stopped'))->yes(says: 'the stop is logged');
}

test async_retries_with_backoff_then_fails
{
    $r = rig();
    $r->start();
    pushed($r->workers()->push(TSay('flaky'), tries: 2));
    $r->wait(1);
    thread::sleep(50);
    expect($r->tally->all())->size(1);
    expect($r->app->logged('task will retry'))->yes(says: 'the first try retries');
    expect($r->app->logged('heard flaky failed: flaky fails'))->no(says: 'a retry is not the end');
    $r->clock->advance(time::duration::secs(11));
    $r->wait(2);
    thread::sleep(50);
    $r->stop();
    expect($r->tally->all())->size(2);
    expect($r->app->logged(.error, 'task failed'))->yes(says: 'the last try fails');
    expect($r->app->logged('heard flaky failed: flaky fails'))->yes(says: 'the task hears its last try failed');
    expect($r->workers()->waiting())->is(0);
}

test async_refuses_tries_out_of_range
{
    $r = rig();
    expect($r->workers()->push(TSay('x'), tries: 101))->fails();
}

test a_running_key_lets_one_run_at_a_time
{
    $r = rig();
    $r->start();
    pushed($r->workers()->push(TSay('one', $mode: 'running', $hold: true)));
    pushed($r->workers()->push(TSay('two', $mode: 'running', $hold: true)));
    pushed($r->workers()->push(TSay('free')));
    $r->until('start one');
    $r->until('free');
    thread::sleep(50);
    expect($r->tally->has('start two'))->no(says: 'the second waits for the key');
    $r->gate->release();
    $r->wait(5);
    $r->stop();
    expect($r->tally->at('end one') < $r->tally->at('start two'))->yes(says: 'two starts after one ends');
}

test a_unique_key_skips_a_second_push
{
    $r = rig();
    Pushed $first = pushed($r->workers()->push(TSay('a', $mode: 'unique', $key: 'u')));
    Pushed $second = pushed($r->workers()->push(TSay('b', $mode: 'unique', $key: 'u')));
    Pushed $other = pushed($r->workers()->push(TSay('c', $mode: 'unique', $key: 'v')));
    expect($first->queued())->yes(says: 'the first push is queued');
    expect($second->queued())->no(says: 'the second push with the key is skipped');
    expect($other->queued())->yes(says: 'another key is queued');
    $r->start();
    $r->wait(2);
    thread::sleep(30);
    Pushed $again = pushed($r->workers()->push(TSay('d', $mode: 'unique', $key: 'u')));
    $r->wait(3);
    $r->stop();
    expect($again->queued())->yes(says: 'once it ran the key is free again');
}

test an_async_pipeline_runs_the_join_last_and_a_failure_takes_its_dependents
{
    $r = rig();
    $r->start();
    $p = Pipeline();
    Step $a = $p->add(TSay('a'));
    Step $b = $p->add(TSay('b'), after: [$a]);
    Step $c = $p->add(TSay('c'), after: [$a]);
    $p->add(TSay('d'), after: [$b, $c]);
    pushed($r->workers()->push($p));
    $r->until('d');
    expect($r->tally->at('a') < $r->tally->at('b'))->yes(says: 'b runs after a');
    expect($r->tally->at('c') < $r->tally->at('d'))->yes(says: 'd runs after c');

    $hard = Pipeline();
    Step $x = $hard->add(TSay('doomed'));
    Step $y = $hard->add(TSay('dropped'), after: [$x]);
    $hard->add(TSay('dropped too'), after: [$y]);
    pushed($r->workers()->push($hard));

    $soft = Pipeline();
    Step $s = $soft->add(TSay('soft-doomed', $soft: true));
    $soft->add(TSay('goes on'), after: [$s]);
    pushed($r->workers()->push($soft));
    $r->until('goes on');
    thread::sleep(50);
    $r->stop();
    expect($r->tally->has('dropped'))->no(says: 'a task after a hard failure is dropped');
    expect($r->tally->has('goes on after failed TSay'))->yes(says: 'the task after a soft failure sees it');
    expect($r->app->logged(.warn, 'tasks waiting for it were dropped'))->yes(says: 'the drop is logged');
}

test a_subflow_runs_before_the_tasks_waiting_for_its_parent
{
    $r = rig();
    $r->start();
    $p = Pipeline();
    Step $parent = $p->add(TSay('parent', $spawn: 2));
    $p->add(TSay('after'), after: [$parent]);
    pushed($r->workers()->push($p));
    $r->until('after');
    $r->stop();
    expect($r->tally->at('parent.0') < $r->tally->at('after'))->yes(says: 'the first child runs before after');
    expect($r->tally->at('parent.1') < $r->tally->at('after'))->yes(says: 'the second child runs before after');
}

test the_highest_priority_runs_first
{
    map<string, string> $vars = ['NEXUS_WORK_POLL' => '10ms'];
    $r = Rig($vars, $threads: 1);
    $r->start();
    pushed($r->workers()->push(TSay('blocker', $hold: true)));
    $r->until('start blocker');
    pushed($r->workers()->push(TSay('low', $prio: -1)));
    pushed($r->workers()->push(TSay('normal')));
    pushed($r->workers()->push(TSay('high', $prio: 1)));
    $r->gate->release();
    $r->until('low');
    $r->stop();
    expect(str::join($r->tally->all(), ','))->is('start blocker,end blocker,high,normal,low');
}

test a_task_that_waits_past_its_expiry_is_dropped
{
    map<string, string> $vars = ['NEXUS_WORK_POLL' => '10ms'];
    $r = Rig($vars, $threads: 1);
    $r->start();
    pushed($r->workers()->push(TSay('blocker', $hold: true)));
    $r->until('start blocker');
    pushed($r->workers()->push(TSay('stale', $ttl: 5)));
    $r->clock->advance(time::duration::secs(6));
    thread::sleep(60);
    $r->gate->release();
    $r->until('end blocker');
    thread::sleep(50);
    $r->stop();
    expect($r->tally->has('stale'))->no(says: 'the expired task did not run');
    expect($r->app->logged(.warn, 'tasks expired before they ran'))->yes(says: 'the expiry is logged');
}

test cancel_drops_a_waiting_task_and_its_dependents
{
    $r = rig();
    $p = Pipeline();
    Step $a = $p->add(TSay('a'));
    $p->add(TSay('b'), after: [$a]);
    pushed($r->workers()->push($p));
    string $id = expect($a->id())->some();
    expect($r->workers()->cancel($id))->is(2);
    expect($r->workers()->waiting())->is(0);
}

test a_run_logs_where_its_task_or_queue_says
{
    $r = rig();
    $own = nexus::log::Memory();
    nexus::work::Pool $pool = expect($r->work()->lanes->pool('workers'))->some();
    $pool->log = function[$own](const Run& $run) : RunLog {
        return .also($own);
    };
    $r->start();
    pushed($r->workers()->push(TSay('loud')));
    pushed($r->workers()->push(TSay('hush', $quiet: true)));
    $r->wait(2);
    thread::sleep(30);
    $r->stop();
    expect($own->find('said') != null)->yes(says: 'the queue sink got the run log');
    expect($own->find('task done') != null)->yes(says: 'the queue sink got the outcome');
    int32 $said = 0;
    foreach ($r->app->log->entries() as const &$e) {
        if ($e->message == 'said') {
            $said++;
        }
    }
    expect($said)->is(1);
}
