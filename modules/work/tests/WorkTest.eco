/**
 * nexus-work end to end on the memory queue: the task data codec, cron lines and schedules, the
 * queue's claims and leases, the runner's retries and failures, the scheduler's once-per-slot
 * pushes, and real worker threads.
 */

use std::thread;
use std::time;
use ecotest::expect;
use nexus::testing::TestApp;
use nexus::work::{Kind, Tasks, TaskData, Failure, Cron, Schedule, Queue, MemoryQueue, StoredTask, Runner, Scheduler, Workers, Work, Pushed, Requeued};

// 2026-11-02T02:59:00Z, a Monday
internal const int64 START = 1793588340;

#[atomic]
internal class Tally
{
    public thread::mutex<array<string>> $seen = thread::mutex<array<string>>(array<string>());

    public function add(const string& $s) : void
    {
        thread::locked<array<string>> $l = $this->seen->lock();
        $l->value[] = $s;
    }

    public const function all() : array<string>
    {
        thread::locked<array<string>> $l = $this->seen->lock();
        return $l->value;
    }
}

internal class TExt : nexus::Extension
{
    public Tally $tally;
    public MemoryQueue $queue;

    public constructor(Tally $tally, MemoryQueue $queue)
    {
        $this->tally = $tally;
        $this->queue = $queue;
    }

    public function name() : string
    {
        return 'work-test';
    }

    public function services(nexus::Services& $s) : status<nexus::BootError>
    {
        $s->bind<Tally>(put: $this->tally);
        $s->bind<MemoryQueue>(put: $this->queue);
        $s->alias<Queue, MemoryQueue>();
        return .ok;
    }
}

/**
 * A task the way an app writes one.
 */
internal struct TSay
{
    public string $text;
    public int64 $times = 1;

    public function handle(nexus::Payload& $payload) : status<Failure>
    {
        Tally $t = $payload->get<Tally>();
        $t->add($this->text);
        if ($this->text == 'flaky') {
            return .error(.retry('flaky fails'));
        }
        if ($this->text == 'doomed') {
            return .error(.giveUp('doomed'));
        }
        return .ok;
    }
}

/**
 * Its companion, the way nexus gen writes one.
 */
internal struct TSayTask
{
    public static function push(nexus::Payload& $payload, construct TSay $task) : status<nexus::Problem>
    {
        return Tasks::push($payload, TSayTask::kind(), TSayTask::encode($task));
    }

    public static function kind() : Kind
    {
        return Kind('TSay', function(nexus::Payload& $payload, const string& $data) : status<Failure> {
            return TSayTask::run($payload, $data);
        }, $tries: 3);
    }

    public static function encode(const TSay& $task) : string
    {
        $p = TaskData();
        $p->put('text', $task->text);
        $p->put('times', $task->times);
        return $p->text();
    }

    public static function decode(const string& $text) : result<TSay, nexus::work::DataError>
    {
        $p = try TaskData::parse($text);
        string? $vText = $p->string('text', required: true);
        int64 $okTimes = 1;
        int64? $vTimes = $p->int64('times', required: false);
        if ($vTimes != null) {
            int64 $xTimes = guard $vTimes;
            $okTimes = $xTimes;
        }
        try $p->done();
        string $okText = guard $vText;
        return .ok(TSay($text: $okText, $times: $okTimes));
    }

    internal static function run(nexus::Payload& $payload, const string& $data) : status<Failure>
    {
        TSay $task = guard TSayTask::decode($data) else ($e) {
            return .error(.giveUp("the task data does not decode: {$e}"));
        };
        return $task->handle($payload);
    }
}

internal function scheduled(const string& $name, const string& $every, const string& $cron) : Kind
{
    Kind $k = TSayTask::kind();
    $k->name = $name;
    $k->every = $every;
    $k->cron = $cron;
    $k->data = TSayTask::encode(TSay($text: $name));
    return $k;
}

internal class Rig
{
    public TestApp $app;
    public calendar::ManualClock $clock;
    public Tally $tally;
    public MemoryQueue $memory;

    public constructor(map<string, string> $vars)
    {
        $this->clock = calendar::ManualClock(time::timestamp::from_unix_secs(START));
        $this->tally = Tally();
        $this->memory = MemoryQueue();
        array<Kind> $kinds = [TSayTask::kind(), scheduled('TTick', '15m', ''), scheduled('TNightly', '', '0 3 * * *')];
        array<nexus::Extension> $exts = [nexus::work::Extension(stores: .provided, clock: $this->clock, tasks: mv $kinds), TExt($this->tally, $this->memory)];
        $this->app = TestApp($exts, $vars);
    }

    public function work() : Work
    {
        return $this->app->kernel->services->get<Work>();
    }

    public function say(const string& $text) : void
    {
        nexus::Payload $payload = $this->app->kernel->background('test', 'push');
        guard TSayTask::push($payload, $text: $text);
        nexus::Kernel::finish($payload);
    }

    public function step() : bool
    {
        return Runner::step($this->app->kernel, $this->work());
    }
}

internal function why(status<nexus::work::DataError> $s) : string
{
    guard $s else ($e) {
        return str::from($e);
    };
    return '';
}

internal function cronRefused(const string& $line) : bool
{
    guard Cron::parse($line) else {
        return true;
    };
    return false;
}

internal function scheduleOf(const Kind& $k) : Schedule
{
    Schedule? $s = guard Schedule::of($k);
    Schedule $out = guard $s;
    return $out;
}

internal function scheduleRefused(const Kind& $k) : bool
{
    guard Schedule::of($k) else {
        return true;
    };
    return false;
}

internal function claimed(MemoryQueue $q, const array<string>& $queues, time::timestamp $now) : StoredTask?
{
    StoredTask? $j = guard $q->claim($queues, $now, $now + time::duration::mins(1));
    return $j;
}

/**
 * Whether the queue stored `$j`.
 */
internal function pushed(MemoryQueue $q, const StoredTask& $j) : bool
{
    Pushed $p = guard $q->push($j);
    return $p == Pushed::stored;
}

internal function waiting(MemoryQueue $q) : uint64
{
    uint64 $n = guard $q->waiting();
    return $n;
}

internal function failedTasks(MemoryQueue $q) : array<StoredTask>
{
    array<StoredTask> $all = guard $q->failed(10);
    return $all;
}

internal function bootWhy(array<nexus::Extension> $exts) : string
{
    $none = map<string, string>();
    guard TestApp::attempt($exts, $none) else ($e) {
        return str::join($e->lines(), '; ');
    };
    return '';
}

internal function rig() : Rig
{
    return Rig(map<string, string>());
}

internal function at(int32 $hour, int32 $minute) : calendar::DateTime
{
    return calendar::DateTime(2026, .november, 2, $hour, $minute);
}

test task_data_round_trip
{
    $p = TaskData();
    $p->put('n', 42);
    $p->put('s', 'hé "x"');
    $p->put('b', true);
    $p->put('f', 1.5);
    array<string> $tags = ['a', 'b'];
    $p->put('tags', $tags);
    array<int64> $ids = [3, 4];
    $p->put('ids', $ids);
    $p->nil('none');
    TaskData $back = expect(TaskData::parse($p->text()))->ok();
    expect($back->int64('n', required: true))->some(42);
    expect($back->string('s', required: true))->some('hé "x"');
    expect($back->bool('b', required: true))->some(true);
    expect($back->float64('f', required: true))->some(1.5);
    array<string> $t = $back->strings('tags', required: true) ?? array<string>();
    expect($t)->size(2);
    expect($t[1])->is('b');
    array<int64> $i = $back->ints('ids', required: true) ?? array<int64>();
    expect($i)->size(2);
    expect($i[0])->is(3);
    expect($back->string('none', required: false))->none();
    expect($back->uint32('n', required: true))->some(42);
    expect($back->done())->fine();
}

test task_data_reports_missing_and_mistyped
{
    TaskData $p = expect(TaskData::parse('{"n":"x","big":5000000000}'))->ok();
    expect($p->int64('n', required: true))->none();
    expect($p->string('gone', required: true))->none();
    expect($p->int32('big', required: true))->none();
    expect($p->string('maybe', required: false))->none();
    expect(why($p->done()))->is('n is not an integer; gone is missing; big does not fit an int32');
    bool $bad = true;
    guard TaskData::parse('[1]') else {
        return;
    };
    expect($bad)->no(says: 'a JSON array is refused as task data');
}

test failure_from_problems_and_backoff
{
    Failure $server = .of(.unavailable('db down'));
    Failure $client = .of(.notFound('the user'));
    Failure $wait = .of(.tooMany(30));
    expect(kindOf($server))->is('retry');
    expect(kindOf($client))->is('giveUp');
    expect(kindOf($wait))->is('later');
    expect(Failure::backoff(1)->as_secs())->is(10);
    expect(Failure::backoff(2)->as_secs())->is(40);
    expect(Failure::backoff(3)->as_secs())->is(160);
    expect(Failure::backoff(9)->as_secs())->is(3600);
}

internal function kindOf(const Failure& $f) : string
{
    return match ($f) {
        Failure::retry($why) => 'retry',
        Failure::later($after, $why) => 'later',
        Failure::giveUp($why) => 'giveUp',
    };
}

test cron_parses_and_matches
{
    Cron $nightly = expect(Cron::parse('0 3 * * *'))->ok();
    expect($nightly->matches(at(3, 0)))->yes(says: '0 3 * * * matches 03:00');
    expect($nightly->matches(at(3, 1)))->no(says: '0 3 * * * skips 03:01');
    expect($nightly->matches(at(4, 0)))->no(says: '0 3 * * * skips 04:00');

    Cron $office = expect(Cron::parse('*/15 8-18 * * 1-5'))->ok();
    expect($office->matches(at(8, 15)))->yes(says: 'office hours match Monday 08:15');
    expect($office->matches(at(8, 20)))->no(says: 'office hours skip 08:20');
    expect($office->matches(at(19, 0)))->no(says: 'office hours skip 19:00');
    $saturday = calendar::DateTime(2026, .november, 7, 9, 0);
    expect($office->matches($saturday))->no(says: 'office hours skip Saturday');

    // both day and weekday restricted: either one matches
    Cron $either = expect(Cron::parse('0 0 13 * 5'))->ok();
    $friday = calendar::DateTime(2026, .november, 6, 0, 0);
    $thirteenth = calendar::DateTime(2026, .november, 13, 0, 0);
    expect($either->matches($friday))->yes(says: 'day or weekday matches a Friday');
    expect($either->matches($thirteenth))->yes(says: 'day or weekday matches the 13th');
    expect($either->matches(at(0, 0)))->no(says: 'day or weekday skips Monday the 2nd');

    Cron $sunday = expect(Cron::parse('30 6 * * 7'))->ok();
    $sun = calendar::DateTime(2026, .november, 8, 6, 30);
    expect($sunday->matches($sun))->yes(says: 'weekday 7 is Sunday');

    array<string> $bad = ['0 3 * *', '61 * * * *', '* 24 * * *', '*/0 * * * *', 'x * * * *', '5-1 * * * *'];
    foreach ($bad as const &$line) {
        expect(cronRefused($line))->yes(says: "the cron line '{$line}' is refused");
    }
}

test schedules_find_due_and_next_slots
{
    calendar::Zone $utc = .utc();
    Kind $every = scheduled('E', '15m', '');
    Schedule $e = scheduleOf($every);
    time::timestamp $t0 = .from_unix_secs(START);
    // 02:59 is after 02:45, before 03:00
    time::timestamp $last = expect($e->due(time::timestamp::from_unix_secs(START - 3600), $t0, $utc))->some();
    expect($last->unix_secs())->is(START - 840);
    expect($e->due($last, $t0, $utc))->none();
    time::timestamp $next = expect($e->next($t0, $utc))->some();
    expect($next->unix_secs())->is(START + 60);

    Kind $cron = scheduled('C', '', '0 3 * * *');
    Schedule $c = scheduleOf($cron);
    expect($c->due($t0 - time::duration::mins(1), $t0, $utc))->none();
    time::timestamp $three = expect($c->due($t0, $t0 + time::duration::secs(90), $utc))->some();
    expect($three->unix_secs())->is(START + 60);
    time::timestamp $tomorrow = expect($c->next($three, $utc))->some();
    expect($tomorrow->unix_secs())->is(START + 60 + 86400);

    Kind $bad = scheduled('B', '1500ms', '');
    expect(scheduleRefused($bad))->yes(says: 'an every of 1500ms is refused');
}

test queue_claims_the_longest_due_and_honours_leases
{
    $q = MemoryQueue();
    time::timestamp $now = .from_unix_secs(START);
    $later = StoredTask($id: 'b', $name: 'TSay', $queue: 'default', $data: '{}', $tries: 3, $createdAt: $now, $availableAt: $now + time::duration::secs(5));
    $first = StoredTask($id: 'a', $name: 'TSay', $queue: 'default', $data: '{}', $tries: 3, $createdAt: $now, $availableAt: $now - time::duration::secs(5));
    $elsewhere = StoredTask($id: 'c', $name: 'TSay', $queue: 'mail', $data: '{}', $tries: 3, $createdAt: $now, $availableAt: $now - time::duration::secs(9));
    guard $q->push($later);
    guard $q->push($first);
    guard $q->push($elsewhere);
    array<string> $queues = ['default'];
    StoredTask $one = expect(claimed($q, $queues, $now))->some();
    expect($one->id)->is('a');
    expect($one->attempts)->is(1);
    // held, and the other is not due yet
    expect(claimed($q, $queues, $now))->none();
    // the lease runs out: due longest, so claimed again first, a second attempt
    time::timestamp $after = $now + time::duration::mins(2);
    StoredTask $third = expect(claimed($q, $queues, $after))->some();
    expect($third->id)->is('a');
    expect($third->attempts)->is(2);
    StoredTask $again = expect(claimed($q, $queues, $after))->some();
    expect($again->id)->is('b');
    // the first claim is stale: its done changes nothing
    guard $q->done($one, $after);
    expect(waiting($q))->is(3);
    guard $q->done($third, $after);
    expect(waiting($q))->is(2);
}

test keyed_pushes_are_stored_once
{
    $q = MemoryQueue();
    time::timestamp $now = .from_unix_secs(START);
    $j = StoredTask($id: 'a', $name: 'TSay', $queue: 'default', $data: '{}', $tries: 3, $key: 'TSay@1', $createdAt: $now, $availableAt: $now);
    $twin = StoredTask($id: 'b', $name: 'TSay', $queue: 'default', $data: '{}', $tries: 3, $key: 'TSay@1', $createdAt: $now, $availableAt: $now);
    expect(pushed($q, $j))->yes(says: 'the first keyed push is stored');
    expect(pushed($q, $twin))->no(says: 'a push with the same key is not stored');
    array<string> $queues = ['default'];
    StoredTask $c = expect(claimed($q, $queues, $now))->some();
    guard $q->done($c, $now);
    // done but kept, so the slot is not pushed again
    expect(pushed($q, $twin))->no(says: 'a done task still holds its key');
    uint64 $gone = guard $q->prune($now + time::duration::secs(1));
    expect($gone)->is(1);
    expect(pushed($q, $twin))->yes(says: 'the key is free once pruned');
}

test runner_runs_a_pushed_task
{
    $r = rig();
    $r->say('hi');
    expect($r->step())->yes(says: 'a task ran');
    expect($r->step())->no(says: 'nothing is due');
    array<string> $seen = $r->tally->all();
    expect($seen)->size(1);
    expect($seen[0])->is('hi');
    expect($r->memory->all())->empty();
    expect($r->app->logged('task done'))->yes(says: "the log holds 'task done'");
}

test a_retry_backs_off_then_fails
{
    $r = rig();
    $r->say('flaky');
    expect($r->step())->yes(says: 'a task ran');
    StoredTask $j = $r->memory->all()[0];
    expect($j->attempts)->is(1);
    expect($j->error)->is('flaky fails');
    expect($j->availableAt->unix_secs())->is(START + 10);
    expect($r->step())->no(says: 'nothing is due');
    $r->clock->advance(time::duration::secs(10));
    expect($r->step())->yes(says: 'a task ran');
    expect($r->memory->all()[0]->availableAt->unix_secs())->is(START + 10 + 40);
    $r->clock->advance(time::duration::secs(40));
    expect($r->step())->yes(says: 'a task ran');
    StoredTask $failed = $r->memory->all()[0];
    expect($failed->failedAt)->some();
    expect($failed->attempts)->is(3);
    expect($r->step())->no(says: 'nothing is due');
    expect($r->tally->all())->size(3);
    expect($r->app->logged('task failed'))->yes(says: "the log holds 'task failed'");

    // sent back with its tries fresh
    Requeued $sent = guard $r->memory->again($failed->id, $r->clock->now());
    expect($sent == Requeued::sent)->yes(says: 'the failed task was sent back');
    expect($r->step())->yes(says: 'a task ran');
    expect($r->memory->all()[0]->attempts)->is(1);
}

test give_up_fails_at_once
{
    $r = rig();
    $r->say('doomed');
    expect($r->step())->yes(says: 'a task ran');
    array<StoredTask> $failed = failedTasks($r->memory);
    expect($failed)->size(1);
    expect($failed[0]->error)->is('doomed');
    expect($failed[0]->attempts)->is(1);
}

test unknown_and_broken_tasks_fail
{
    $r = rig();
    time::timestamp $now = $r->clock->now();
    $unknown = StoredTask($id: 'u', $name: 'Nope', $queue: 'default', $data: '{}', $tries: 3, $createdAt: $now, $availableAt: $now);
    $broken = StoredTask($id: 'x', $name: 'TSay', $queue: 'default', $data: '{"times":2}', $tries: 3, $createdAt: $now, $availableAt: $now - time::duration::secs(1));
    guard $r->memory->push($unknown);
    guard $r->memory->push($broken);
    expect($r->step())->yes(says: 'a task ran');
    expect($r->step())->yes(says: 'a task ran');
    array<StoredTask> $failed = failedTasks($r->memory);
    expect($failed)->size(2);
    foreach ($failed as const &$f) {
        if ($f->id == 'u') {
            expect($f->error)->is('no task named Nope in this program');
        } else {
            expect($f->error)->is('the task data does not decode: text is missing');
        }
    }
}

test a_lost_task_runs_again_after_its_lease
{
    map<string, string> $vars = ['WORK_LEASE' => '1m'];
    $r = Rig($vars);
    $r->say('hi');
    // a worker claims it and dies with it
    array<string> $queues = ['default'];
    time::timestamp $now = $r->clock->now();
    guard $r->memory->claim($queues, $now, $now + time::duration::mins(1));
    expect($r->step())->no(says: 'nothing is due');
    $r->clock->advance(time::duration::secs(61));
    expect($r->step())->yes(says: 'a task ran');
    expect($r->tally->all())->size(1);
    expect($r->memory->all())->empty();
}

test a_task_lost_on_every_try_gives_up
{
    $r = rig();
    $r->say('hi');
    array<string> $queues = ['default'];
    int32 $i = 0;
    while ($i < 3) {
        time::timestamp $now = $r->clock->now();
        guard $r->memory->claim($queues, $now, $now + time::duration::mins(1));
        $r->clock->advance(time::duration::mins(2));
        $i = $i + 1;
    }
    expect($r->step())->yes(says: 'a task ran');
    expect($r->tally->all())->empty();
    array<StoredTask> $failed = failedTasks($r->memory);
    expect($failed[0]->error)->is('gave up after 3 tries that never finished');
}

test the_scheduler_pushes_each_slot_once
{
    $r = rig();
    $k = $r->app->kernel;
    time::timestamp $from = $r->clock->now() - time::duration::mins(1);
    $one = Scheduler($r->work(), $from);
    $two = Scheduler($r->work(), $from);
    expect($one->tick($k, $r->clock->now()))->is(0);
    $r->clock->advance(time::duration::secs(90));
    expect($one->tick($k, $r->clock->now()))->is(2);
    expect($two->tick($k, $r->clock->now()))->is(0);
    expect($one->tick($k, $r->clock->now()))->is(0);
    expect($r->step())->yes(says: 'the first scheduled task ran');
    expect($r->step())->yes(says: 'the second scheduled task ran');
    expect($r->step())->no(says: 'nothing else was pushed');
    array<string> $seen = $r->tally->all();
    expect($seen)->size(2);
    $r->clock->advance(time::duration::mins(15));
    expect($two->tick($k, $r->clock->now()))->is(1);
    expect($r->step())->yes(says: 'a task ran');
    expect($r->tally->all()[2])->is('TTick');
}

test workers_run_tasks_on_threads
{
    map<string, string> $vars = ['WORK_POLL' => '20ms'];
    $r = Rig($vars);
    $ws = Workers();
    guard $ws->start($r->app->kernel, $r->work(), 3);
    int32 $i = 0;
    while ($i < 8) {
        $r->say("task {$i}");
        $i = $i + 1;
    }
    int32 $waited = 0;
    while ($r->tally->all()->count() < 8 && $waited < 250) {
        thread::sleep(20);
        $waited = $waited + 1;
    }
    expect($ws->stop(time::duration::secs(2)))->yes(says: 'the workers stopped within the grace');
    expect($r->tally->all())->size(8);
    expect($r->memory->all())->empty();
}

test serve_starts_and_drains_the_work
{
    map<string, string> $vars = ['WORK_POLL' => '20ms'];
    $r = Rig($vars);
    guard $r->app->kernel->start(nexus::Serve());
    $r->say('served');
    int32 $waited = 0;
    while ($r->tally->all()->empty() && $waited < 250) {
        thread::sleep(20);
        $waited = $waited + 1;
    }
    $r->app->kernel->drain();
    expect($r->tally->all())->size(1);
    expect($r->app->logged('working default with 2 workers'))->yes(says: "the log holds 'working default with 2 workers'");
    expect($r->app->logged('scheduling 2 tasks'))->yes(says: "the log holds 'scheduling 2 tasks'");
    expect($r->app->logged('workers stopped'))->yes(says: "the log holds 'workers stopped'");

    $quiet = nexus::Serve();
    $quiet->work = false;
    $quiet->schedule = false;
    $q = Rig($vars);
    guard $q->app->kernel->start($quiet);
    $q->say('waits');
    thread::sleep(100);
    $q->app->kernel->drain();
    expect($q->tally->all())->empty();
}

test boot_refuses_a_bad_cron
{
    array<Kind> $kinds = [scheduled('Bad', '', '61 * * * *')];
    array<nexus::Extension> $exts = [nexus::work::Extension(tasks: mv $kinds)];
    expect(bootWhy($exts))->is("nexus-work: Bad: '61' is outside the minutes 0 to 59");
}
