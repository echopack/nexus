/*
 * nexus-oauth-carbon: nexus-oauth's clients, requests, codes and grants in
 * the app's carbon database.
 *
 * Four tables, `oauth_clients`, `oauth_requests`, `oauth_codes` and
 * `oauth_grants`, in migrations the app adds to its own. A request is taken
 * with a delete that only one caller wins, a code is redeemed with an
 * update that only one caller wins (and kept, so one redeemed twice ends
 * its grant), and a refresh rotates the grant with an update on the
 * refresh hash it read, so several processes never both spend one.
 */

#[module: "nexus-oauth-carbon"]
#[version: "0.1.0"]
#[epm::license: "MIT"]
#[epm::description: "nexus-oauth clients, requests, codes and grants in a carbon database"]

#[depends: "../../.."]
#[depends: ".."]
#[depends: "../../carbon"]
#[requires: "echopack/carbon" { version: "^0.2.1", source: git "https://github.com/echopack/carbon" }]
#[requires: "echopack/container" { version: "^0.1.0", source: git "https://github.com/echopack/container" }]
#[requires: "echolang/libjson" { version: "^0.3.0", source: git "https://github.com/echolang/libjson" }]

#[hook: before_build { run: "nexus", args: ["gen"] }]

#[sources: "src/*.eco"]
#[if: !NEXUS_NOGEN]
#[sources: ".nexus/*.eco"]
#[end]
#[if: !CARBON_NOGEN]
#[sources: ".carbon/*.eco"]
#[end]

#[target: test] {
    #[requires: "echopack/carbon/fake" { version: "^0.2.1", source: git "https://github.com/echopack/carbon" }]
    #[depends: "../../testing"]
    #[depends: "../../auth"]
    #[sources: "tests/*.eco"]
}
