namespace nexus::oauth::carbon;

use std::time;
use carbon;

/**
 * A row of `oauth_codes`: an authorization code by its hash.
 */
#[carbon::model: 'oauth_codes']
public class CodeRow : carbon::Model<CodeRow, CodeRowRepository>
{
    public carbon::Link $link = .detached();

    #[carbon::key]
    public string $hash;

    public string $client;
    public string $subject;
    public string $redirect;
    public bool $named;
    public string $challenge;
    public string $scope;
    public string $resource;
    public time::timestamp $expiresAt;

    public function link() : carbon::Link&
    {
        return $this->link;
    }

    /**
     * The row that keeps `$c`. A static, since carbon builds a model with its implicit constructor
     * and refuses one written out.
     */
    public static function of(const nexus::oauth::Code& $c) : CodeRow
    {
        return CodeRow($hash: $c->hash, $client: $c->client, $subject: $c->subject, $redirect: $c->redirect, $named: $c->named,
            $challenge: $c->challenge, $scope: $c->scope, $resource: $c->resource, $expiresAt: $c->expiresAt);
    }

    /**
     * The code this row keeps.
     */
    public const function code() : nexus::oauth::Code
    {
        return nexus::oauth::Code($hash: $this->hash, $client: $this->client, $subject: $this->subject, $redirect: $this->redirect,
            $named: $this->named, $challenge: $this->challenge, $scope: $this->scope, $resource: $this->resource, $expiresAt: $this->expiresAt);
    }
}
