namespace nexus::oauth::carbon;

use std::time;

/**
 * nexus-oauth's store in the app's database, through a request's carbon session.
 */
public class CarbonOAuth : nexus::oauth::OAuthStore
{
    internal carbon::Session $session;

    public constructor(carbon::Session $session)
    {
        $this->session = $session;
    }

    public function client(const string& $id) : result<nexus::oauth::Client?, nexus::Problem>
    {
        ClientRowRepository $repo = try $this->clientRepo();
        ClientRow? $found = try $repo->find()->get($id);
        if ($found == null) {
            return .ok(null);
        }
        ClientRow $row = guard $found;
        return .ok($row->client());
    }

    public function register(const nexus::oauth::Client& $c) : status<nexus::Problem>
    {
        ClientRowRepository $repo = try $this->clientRepo();
        try $repo->create(.of($c));
        return .ok;
    }

    public function touch(const string& $id, time::timestamp $at) : status<nexus::Problem>
    {
        ClientRowRepository $repo = try $this->clientRepo();
        $set = hydrahon::Values();
        $set[ClientRowTable::$usedAt] = $at;
        try $repo->find()->where(ClientRowTable::$id == $id)->update($set);
        return .ok;
    }

    public function clients() : result<uint64, nexus::Problem>
    {
        ClientRowRepository $repo = try $this->clientRepo();
        uint64 $n = try $repo->find()->count();
        return .ok($n);
    }

    public function sweep(time::timestamp $before) : status<nexus::Problem>
    {
        ClientRowRepository $repo = try $this->clientRepo();
        try $repo->find()->where(ClientRowTable::$usedAt->isNull())->where(ClientRowTable::$createdAt < $before)->purge();
        return .ok;
    }

    public function ask(const nexus::oauth::AuthRequest& $r) : status<nexus::Problem>
    {
        RequestRowRepository $repo = try $this->requestRepo();
        try $repo->create(.of($r));
        return .ok;
    }

    public function request(const string& $id) : result<nexus::oauth::AuthRequest?, nexus::Problem>
    {
        RequestRowRepository $repo = try $this->requestRepo();
        RequestRow? $found = try $repo->find()->get($id);
        if ($found == null) {
            return .ok(null);
        }
        RequestRow $row = guard $found;
        return .ok($row->request());
    }

    /**
     * Reads the request, then deletes it; only the caller whose delete removed the row gets it.
     */
    public function answer(const string& $id) : result<nexus::oauth::AuthRequest?, nexus::Problem>
    {
        RequestRowRepository $repo = try $this->requestRepo();
        RequestRow? $found = try $repo->find()->get($id);
        if ($found == null) {
            return .ok(null);
        }
        RequestRow $row = guard $found;
        uint64 $gone = try $repo->find()->where(RequestRowTable::$id == $id)->purge();
        if ($gone != 1) {
            return .ok(null);
        }
        return .ok($row->request());
    }

    public function keep(const nexus::oauth::Code& $c) : status<nexus::Problem>
    {
        CodeRowRepository $repo = try $this->codeRepo();
        try $repo->create(.of($c));
        return .ok;
    }

    /**
     * Reads the code, then deletes it; only the caller whose delete removed the row gets it.
     */
    public function take(const string& $hash) : result<nexus::oauth::Code?, nexus::Problem>
    {
        CodeRowRepository $repo = try $this->codeRepo();
        CodeRow? $found = try $repo->find()->get($hash);
        if ($found == null) {
            return .ok(null);
        }
        CodeRow $row = guard $found;
        uint64 $gone = try $repo->find()->where(CodeRowTable::$hash == $hash)->purge();
        if ($gone != 1) {
            return .ok(null);
        }
        return .ok($row->code());
    }

    public function grant(const string& $id) : result<nexus::oauth::Grant?, nexus::Problem>
    {
        GrantRowRepository $repo = try $this->grantRepo();
        GrantRow? $found = try $repo->find()->get($id);
        if ($found == null) {
            return .ok(null);
        }
        GrantRow $row = guard $found;
        return .ok($row->grant());
    }

    public function open(const nexus::oauth::Grant& $g) : status<nexus::Problem>
    {
        GrantRowRepository $repo = try $this->grantRepo();
        try $repo->create(.of($g));
        return .ok;
    }

    /**
     * One update on the grant's id and the refresh hash it had: a second refresh with the same
     * token changes no row.
     */
    public function rotate(const nexus::oauth::Grant& $g, const string& $was) : result<nexus::oauth::Rotation, nexus::Problem>
    {
        GrantRowRepository $repo = try $this->grantRepo();
        $set = hydrahon::Values();
        $set[GrantRowTable::$accessHash] = $g->accessHash;
        $set[GrantRowTable::$accessExpiresAt] = $g->accessExpiresAt;
        $set[GrantRowTable::$refreshHash] = $g->refreshHash;
        $set[GrantRowTable::$refreshExpiresAt] = $g->refreshExpiresAt;
        $set[GrantRowTable::$previousHash] = $g->previousHash;
        $set[GrantRowTable::$usedAt] = $g->usedAt;
        uint64 $n = try $repo->find()->where(GrantRowTable::$id == $g->id)->where(GrantRowTable::$refreshHash == $was)->update($set);
        if ($n != 1) {
            return .ok(.lost);
        }
        return .ok(.won);
    }

    public function drop(const string& $id) : status<nexus::Problem>
    {
        GrantRowRepository $repo = try $this->grantRepo();
        try $repo->find()->where(GrantRowTable::$id == $id)->purge();
        return .ok;
    }

    public function grants(const string& $subject) : result<array<nexus::oauth::Grant>, nexus::Problem>
    {
        GrantRowRepository $repo = try $this->grantRepo();
        array<GrantRow> $rows = try $repo->find()->where(GrantRowTable::$subject == $subject)->order(asc: GrantRowTable::$createdAt)->get();
        array<nexus::oauth::Grant> $out = [];
        foreach ($rows as const &$row) {
            $out[] = $row->grant();
        }
        return .ok($out);
    }

    public function prune(time::timestamp $now) : result<uint64, nexus::Problem>
    {
        RequestRowRepository $requests = try $this->requestRepo();
        uint64 $asked = try $requests->find()->where(RequestRowTable::$expiresAt < $now)->purge();
        CodeRowRepository $codes = try $this->codeRepo();
        uint64 $coded = try $codes->find()->where(CodeRowTable::$expiresAt < $now)->purge();
        GrantRowRepository $grants = try $this->grantRepo();
        uint64 $ended = try $grants->find()->where(GrantRowTable::$refreshExpiresAt < $now)->purge();
        return .ok($asked + $coded + $ended);
    }

    internal function clientRepo() : result<ClientRowRepository, nexus::Problem>
    {
        ClientRowRepository $repo = try $this->session->repo<ClientRowRepository>();
        return .ok($repo);
    }

    internal function requestRepo() : result<RequestRowRepository, nexus::Problem>
    {
        RequestRowRepository $repo = try $this->session->repo<RequestRowRepository>();
        return .ok($repo);
    }

    internal function codeRepo() : result<CodeRowRepository, nexus::Problem>
    {
        CodeRowRepository $repo = try $this->session->repo<CodeRowRepository>();
        return .ok($repo);
    }

    internal function grantRepo() : result<GrantRowRepository, nexus::Problem>
    {
        GrantRowRepository $repo = try $this->session->repo<GrantRowRepository>();
        return .ok($repo);
    }
}
