namespace nexus::oauth::carbon;

use carbon;

/**
 * The OAuth tables on the app's database: one call in the function that opens it, before it is
 * sealed.
 *
 * ```echo
 * try nexus::oauth::carbon::Tables::wire($db);
 * ```
 */
public struct Tables
{
    /**
     * Registers the OAuth repositories on `$db`.
     */
    public static function wire(carbon::DB $db) : status<carbon::Error>
    {
        try Carbon::register($db);
        return Carbon::check($db);
    }

    /**
     * The OAuth migration, to add to the app's own.
     */
    public static function migrations() : array<carbon::migrate::Step>
    {
        return Carbon::migrations();
    }
}
