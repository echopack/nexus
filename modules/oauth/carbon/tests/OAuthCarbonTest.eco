/**
 * nexus-oauth's store in a carbon database, on carbon's fake driver: each test queues what the
 * database answers and reads back what was sent.
 */

use nexus::oauth::{OAuthStore, Client, Code, Grant, Rotation};
use nexus::oauth::carbon::{ClientRow, ClientRowTable, CodeRow, CodeRowTable, GrantRow, GrantRowTable};
use nexus::testing::TestApp;
use carbon::fake;
use hydrahon::Mysql;
use std::time;
use ecotest::expect;

internal const int64 START = 1793588340;
internal const KEY = 'a-test-key-of-at-least-thirty-two-chars';

internal class Rig
{
    public fake::Driver<Mysql> $fake;
    public calendar::ManualClock $clock;
    public TestApp $app;

    public constructor(bool $register)
    {
        $driver = fake::Driver<Mysql>();
        $clock = calendar::ManualClock(time::timestamp::from_unix_secs(START));
        $this->fake = $driver;
        $this->clock = $clock;
        $db = nexus::carbon::Extension(function[$driver, $clock, $register](nexus::carbon::DatabaseConfig $cfg) : result<carbon::DB, carbon::Error> {
            $made = carbon::DB($driver, clock: $clock);
            if ($register) {
                try nexus::oauth::carbon::Tables::wire($made);
            }
            return .ok($made);
        });
        array<nexus::Extension> $exts = [$db, nexus::auth::Extension('test'), nexus::oauth::Extension(stores: .provided, clock: $clock), nexus::oauth::carbon::Extension()];
        map<string, string> $vars = ['AUTH_KEY' => KEY];
        $this->app = TestApp($exts, $vars);
    }

    public function store() : OAuthStore
    {
        nexus::Payload $payload = $this->app->kernel->background('test', 'o');
        OAuthStore $s = $payload->get<OAuthStore>();
        return $s;
    }

    public function code() : Code
    {
        return Code($hash: 'h1', $client: 'c1', $subject: '7', $redirect: 'http://127.0.0.1/cb', $named: true, $challenge: 'x', $scope: 'mcp',
            $expiresAt: $this->clock->now() + time::duration::secs(60));
    }

    public function grant() : Grant
    {
        time::timestamp $now = $this->clock->now();
        return Grant($id: 'g1', $client: 'c1', $subject: '7', $scope: 'mcp', $accessHash: 'a1', $accessExpiresAt: $now,
            $refreshHash: 'r1', $refreshExpiresAt: $now, $createdAt: $now, $usedAt: $now);
    }
}

internal function takeOne(OAuthStore $s, const string& $hash) : Code?
{
    Code? $c = guard $s->take($hash);
    return $c;
}

internal function rotated(OAuthStore $s, const Grant& $g, const string& $was) : Rotation
{
    Rotation $done = guard $s->rotate($g, $was);
    return $done;
}

test a_client_is_registered_with_its_redirects_on_lines
{
    $r = Rig(true);
    $r->fake->written();
    array<string> $uris = ['http://127.0.0.1/cb', 'https://app.example/cb'];
    $c = Client($id: 'c1', $name: 'Tool', $redirects: mv $uris, $createdAt: $r->clock->now());
    guard $r->store()->register($c);
    expect($r->fake->last())->starts('INSERT INTO `oauth_clients`');
    ClientRow $row = .of($c);
    expect($row->redirectUris)->is("http://127.0.0.1/cb\nhttps://app.example/cb");
    expect($row->client()->redirects)->size(2);
}

test a_code_is_taken_by_the_delete_that_removes_it
{
    $r = Rig(true);
    $r->fake->rows([CodeRowTable()->row(.of($r->code()))])->written(1);
    Code $c = expect(takeOne($r->store(), 'h1'))->some();
    expect($c->subject)->is('7');
    expect($c->named)->yes(says: 'the code was taken for a named client');
    expect($r->fake->last())->is('DELETE FROM `oauth_codes` WHERE `oauth_codes`.`hash` = ?');

    $r->fake->rows([CodeRowTable()->row(.of($r->code()))])->written(0);
    expect(takeOne($r->store(), 'h1'))->none();
}

test a_refresh_rotates_on_the_hash_it_read
{
    $r = Rig(true);
    $r->fake->written(1);
    Grant $g = $r->grant();
    $g->previousHash = 'r1';
    $g->refreshHash = 'r2';
    expect(rotated($r->store(), $g, 'r1') == Rotation::won)->yes(says: 'the rotation on the hash it read wins');
    expect($r->fake->last())->is('UPDATE `oauth_grants` SET `access_hash` = ?, `access_expires_at` = ?, `refresh_hash` = ?, `refresh_expires_at` = ?, `previous_hash` = ?, `used_at` = ? WHERE `oauth_grants`.`id` = ? AND `oauth_grants`.`refresh_hash` = ?');
    $r->fake->written(0);
    expect(rotated($r->store(), $g, 'r1') == Rotation::lost)->yes(says: 'a rotation that changed no row loses');
}

test prune_drops_expired_codes_and_grants
{
    $r = Rig(true);
    $r->fake->written(2)->written(1);
    guard $r->store()->prune($r->clock->now());
    array<string> $sent = $r->fake->texts();
    expect($sent[$sent->count() - 2])->is('DELETE FROM `oauth_codes` WHERE `oauth_codes`.`expires_at` < ?');
    expect($sent[$sent->count() - 1])->is('DELETE FROM `oauth_grants` WHERE `oauth_grants`.`refresh_expires_at` < ?');
}

test boot_refuses_a_database_without_the_tables
{
    $driver = fake::Driver<Mysql>();
    $db = nexus::carbon::Extension(function[$driver](nexus::carbon::DatabaseConfig $cfg) : result<carbon::DB, carbon::Error> {
        return .ok(carbon::DB($driver));
    });
    array<nexus::Extension> $exts = [$db, nexus::auth::Extension('test'), nexus::oauth::Extension(stores: .provided), nexus::oauth::carbon::Extension()];
    map<string, string> $vars = ['AUTH_KEY' => KEY];
    result<TestApp, nexus::BootError> $r = TestApp::attempt($exts, $vars);
    expect($r)->fails();
}
