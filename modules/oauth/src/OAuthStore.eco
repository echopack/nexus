namespace nexus::oauth;

use std::time;

/**
 * Where clients, pending authorization requests, codes and grants are kept. `MemoryOAuth` keeps them in the process;
 * nexus-oauth-carbon in the app's database, per request.
 */
public interface OAuthStore
{
    function client(const string& $id) : result<Client?, nexus::Problem>;

    function register(const Client& $c) : status<nexus::Problem>;

    /**
     * Marks client `$id` as used at `$at`.
     */
    function touch(const string& $id, time::timestamp $at) : status<nexus::Problem>;

    /**
     * How many clients are registered.
     */
    function clients() : result<uint64, nexus::Problem>;

    /**
     * Removes the clients registered before `$before` that were never used.
     */
    function sweep(time::timestamp $before) : status<nexus::Problem>;

    /**
     * Keeps authorization request `$r` until the consent page answers it.
     */
    function ask(const AuthRequest& $r) : status<nexus::Problem>;

    /**
     * Authorization request `$id`, still there for the consent page to show.
     */
    function request(const string& $id) : result<AuthRequest?, nexus::Problem>;

    /**
     * Authorization request `$id`, removed as it is read: it is answered once.
     */
    function answer(const string& $id) : result<AuthRequest?, nexus::Problem>;

    function keep(const Code& $c) : status<nexus::Problem>;

    /**
     * The code with hash `$hash`, removed as it is read: two callers never both get it.
     */
    function take(const string& $hash) : result<Code?, nexus::Problem>;

    function grant(const string& $id) : result<Grant?, nexus::Problem>;

    function open(const Grant& $g) : status<nexus::Problem>;

    /**
     * Saves `$g` when the stored grant still has refresh hash `$was`, and says whether it did or
     * another refresh got there first.
     */
    function rotate(const Grant& $g, const string& $was) : result<Rotation, nexus::Problem>;

    function drop(const string& $id) : status<nexus::Problem>;

    /**
     * Removes every grant of `$subject` at once, and says how many.
     */
    function dropAll(const string& $subject) : result<uint64, nexus::Problem>;

    /**
     * Every grant of `$subject`.
     */
    function grants(const string& $subject) : result<array<Grant>, nexus::Problem>;

    /**
     * Removes the requests, codes and grants that expired before `$now`, and says how many.
     */
    function prune(time::timestamp $now) : result<uint64, nexus::Problem>;
}
