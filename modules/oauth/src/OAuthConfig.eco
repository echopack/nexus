namespace nexus::oauth;

/**
 * The authorization server's settings. The deploy's are read from `NEXUS_OAUTH_ACCESS`,
 * `NEXUS_OAUTH_REFRESH` and `NEXUS_OAUTH_CLIENTS`; the app names its consent page where it lists
 * the extension: `nexus::oauth::Extension(consent: '/connect')`. The issuer is the app's public
 * origin (`NEXUS_APP_URL`, else the request's), and the scopes are those of the resources.
 */
#[nexus::config: "NEXUS_OAUTH"]
public struct OAuthConfig
{
    /**
     * The app's page that asks the user, relative to the issuer or absolute. It gets
     * `?request=<id>`.
     */
    public string $consent = '/oauth/consent';

    /**
     * How long an access token lasts.
     */
    #[nexus::env: 'ACCESS']
    public std::time::duration $access = std::time::duration::hours(1);

    /**
     * How long a refresh token lasts from its last use.
     */
    #[nexus::env: 'REFRESH']
    public std::time::duration $refresh = std::time::duration::hours(720);

    /**
     * How many clients are registered at most at once.
     */
    #[nexus::env: 'CLIENTS']
    public uint32 $clients = 1000;
}
