namespace nexus::oauth;

/**
 * Why an authorization request is refused: shown to the user when the client or its redirect is in
 * doubt (sending the browser there is exactly what must not happen), or sent back to the client's
 * redirect with an OAuth error code otherwise.
 */
public enum Denial
{
    case shown(nexus::Problem $problem);
    case back(string $location);

    /**
     * The denial as a problem, for the consent page to show.
     */
    public const function problem() : nexus::Problem
    {
        return match ($this) {
            Denial::shown($p) => $p,
            Denial::back($location) => .badRequest('the request is not one this server grants'),
        };
    }

    /**
     * The denial as an action's answer: the problem, or the redirect back.
     */
    public const function answer() : result<nexus::Response, nexus::Problem>
    {
        return match ($this) {
            Denial::shown($p) => .error($p),
            Denial::back($location) => .ok(nexus::Response(redirect: $location)),
        };
    }
}
