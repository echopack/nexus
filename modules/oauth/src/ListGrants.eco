namespace nexus::oauth;

/**
 * The clients the signed in user allowed, for an account page: the grant id, the client's name, the
 * resource and scopes, when it was allowed and last used. Only the app's own credential without
 * scopes lists them (`Grants::user`).
 */
#[nexus::through: ["nexus::auth::Authenticate"]]
public class ListGrants : nexus::Action
{
    private Grants $grants;

    public constructor(Grants $grants)
    {
        $this->grants = $grants;
    }

    public function handle(nexus::Payload& $payload) : result<json::Value, nexus::Problem>
    {
        $me = try Grants::user($payload);
        array<Grant> $mine = try $this->grants->store->grants($me->subject);
        json::Value $items = json::arr();
        foreach ($mine as const &$g) {
            Client? $found = try $this->grants->client($g->client);
            string $name = 'a client no longer registered';
            if ($found != null) {
                Client $known = guard $found;
                $name = $known->name;
            }
            json::Value $o = json::object();
            $o['id'] = json::str($g->id);
            $o['client'] = json::str($g->client);
            $o['name'] = json::str($name);
            $o['resource'] = json::str($g->resource);
            $o['scopes'] = Metadata::strings(Scopes::split($g->scope));
            $o['created_at'] = json::int($g->createdAt->unix_secs());
            $o['used_at'] = json::int($g->usedAt->unix_secs());
            $items[] = mv $o;
        }
        json::Value $out = json::object();
        $out['items'] = mv $items;
        return .ok($out);
    }
}
