namespace nexus::oauth;

/**
 * Reads `Authorization: Bearer nxo_...`, the access tokens this server issues. Each is for one
 * resource (`Identity::audience`), and nexus-auth's `Guards` refuse it anywhere else. nexus-oauth
 * adds this guard after nexus-auth's own.
 */
#[atomic]
public class OAuthGuard : nexus::auth::Guard
{
    public const string NAME = 'oauth';

    public function name() : string
    {
        return OAuthGuard::NAME;
    }

    public function identify(nexus::Payload& $payload) : result<nexus::auth::Identity?, nexus::Problem>
    {
        string $text = guard nexus::auth::BearerGuard::token($payload->request) else {
            return .ok(null);
        };
        if (nexus::auth::Token::parse(Grants::ACCESS, $text) == null) {
            return .ok(null);
        }
        nexus::auth::Identity $id = try $payload->get<Grants>()->identify($text);
        return .ok($id);
    }

    public function holds(nexus::Payload& $payload, const nexus::auth::Identity& $id) : result<bool, nexus::Problem>
    {
        return $payload->get<Grants>()->holds($id->credential, $id->subject);
    }

    public function revoke(nexus::Payload& $payload, const nexus::auth::Identity& $id) : status<nexus::Problem>
    {
        return $payload->get<Grants>()->drop($id->credential);
    }
}
