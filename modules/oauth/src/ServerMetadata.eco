namespace nexus::oauth;

/**
 * Authorization server metadata (RFC 8414): the endpoints, PKCE with S256, public clients only, and
 * the scopes of every resource.
 */
public class ServerMetadata : nexus::Action
{
    private nexus::auth::Resources $resources;

    public constructor(nexus::auth::Resources $resources)
    {
        $this->resources = $resources;
    }

    public function handle(nexus::Payload& $payload) : nexus::Response
    {
        return nexus::Response(json: Metadata::ofServer($payload, $this->resources));
    }
}
