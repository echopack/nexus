namespace nexus::oauth;

/**
 * Authorization server metadata (RFC 8414), written for this request's origin, and the helpers it
 * shares. Each resource's own metadata (RFC 9728) is nexus-auth's.
 */
public struct Metadata
{
    public static function ofServer(nexus::Payload& $payload, const nexus::auth::Resources& $resources) : json::Value
    {
        string $issuer = $payload->origin();
        array<string> $scopes = [];
        foreach ($resources->all() as const &$r) {
            foreach ($r->scopes as const &$s) {
                if (!Scopes::has($scopes, $s)) {
                    $scopes[] = $s;
                }
            }
        }
        json::Value $o = json::object();
        $o['issuer'] = json::str($issuer);
        $o['authorization_endpoint'] = json::str("{$issuer}/oauth/authorize");
        $o['token_endpoint'] = json::str("{$issuer}/oauth/token");
        $o['registration_endpoint'] = json::str("{$issuer}/oauth/register");
        $o['revocation_endpoint'] = json::str("{$issuer}/oauth/revoke");
        $o['response_types_supported'] = Metadata::strings(['code']);
        $o['grant_types_supported'] = Metadata::strings(['authorization_code', 'refresh_token']);
        $o['code_challenge_methods_supported'] = Metadata::strings(['S256']);
        $o['token_endpoint_auth_methods_supported'] = Metadata::strings(['none']);
        $o['revocation_endpoint_auth_methods_supported'] = Metadata::strings(['none']);
        $o['scopes_supported'] = Metadata::strings($scopes);
        $o['authorization_response_iss_parameter_supported'] = json::bool(true);
        return $o;
    }

    public static function strings(const array<string>& $items) : json::Value
    {
        json::Value $list = json::arr();
        foreach ($items as const &$s) {
            $list[] = json::str($s);
        }
        return $list;
    }
}
