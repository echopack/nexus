namespace nexus::oauth;

use std::time;

/**
 * An authorization request (`/oauth/authorize?...`), checked: a registered client, one of its
 * redirects, PKCE with S256, one of the app's resources (the `resource` parameter of RFC 8707, or
 * the only one there is) and scopes that resource offers (all of them when none are asked for).
 */
public struct Asked
{
    public Client $client;

    /**
     * What is kept for the consent page.
     */
    public AuthRequest $request;

    public static function check(nexus::Payload& $payload, const nexus::Query& $q, Grants $grants, nexus::auth::Resources $resources) : result<Asked, Denial>
    {
        string $issuer = $payload->origin();
        string $clientId = $q->get('client_id') ?? '';
        Client? $found = guard $grants->client($clientId) else ($p) {
            return .error(.shown($p));
        };
        Client $client = guard $found else {
            return .error(.shown(.badRequest('this app is not registered here; remove it and connect it again')));
        };
        string $asked = $q->get('redirect_uri') ?? '';
        RedirectUri $redirect = guard $client->redirect($asked) else {
            return .error(.shown(.badRequest("{$client->name} asked to return to an address it did not register")));
        };
        string $state = $q->get('state') ?? '';
        if (($q->get('response_type') ?? '') != 'code') {
            return .error(.back(Asked::refusal($redirect, 'unsupported_response_type', 'response_type must be code', $state, $issuer)));
        }
        string $challenge = $q->get('code_challenge') ?? '';
        if ($challenge->size() < 43 || $challenge->size() > 128 || ($q->get('code_challenge_method') ?? '') != 'S256') {
            return .error(.back(Asked::refusal($redirect, 'invalid_request', 'use PKCE with S256', $state, $issuer)));
        }
        string $target = $q->get('resource') ?? '';
        nexus::auth::Resource $resource = guard Asked::resource($payload, $target, $resources) else {
            string $why = 'name the resource the token is for';
            if (!$target->empty()) {
                $why = "{$target} is not a resource of this server";
            }
            return .error(.back(Asked::refusal($redirect, 'invalid_target', $why, $state, $issuer)));
        };
        array<string> $scopes = Scopes::split($q->get('scope') ?? '');
        if ($scopes->empty()) {
            $scopes = $resource->scopes;
        }
        foreach ($scopes as const &$s) {
            if (!$resource->offers($s)) {
                string $offered = $resource->scope();
                return .error(.back(Asked::refusal($redirect, 'invalid_scope', "{$resource->path} offers {$offered}", $state, $issuer)));
            }
        }
        $r = AuthRequest($id: nexus::auth::Secrets::hex(16), $client: $client->id, $redirect: $redirect->text, $named: !$asked->empty(),
            $state: $state, $challenge: $challenge, $scope: str::join($scopes, ' '), $resource: $resource->name,
            $expiresAt: $grants->clock->now() + time::duration::mins(10));
        return .ok(Asked($client: $client, $request: mv $r));
    }

    /**
     * The resource `$url` names, or with none named the only one there is.
     */
    internal static function resource(nexus::Payload& $payload, const string& $url, nexus::auth::Resources $resources) : nexus::auth::Resource?
    {
        if (!$url->empty()) {
            return $resources->at($payload, $url);
        }
        array<nexus::auth::Resource> $all = $resources->all();
        if ($all->count() != 1) {
            return null;
        }
        return $all[0];
    }

    internal static function refusal(const RedirectUri& $redirect, const string& $code, const string& $why, const string& $state, const string& $issuer) : string
    {
        $params = nexus::Query();
        $params->add('error', $code);
        $params->add('error_description', $why);
        return AuthRequest::returning($redirect, mv $params, $state, $issuer);
    }
}
