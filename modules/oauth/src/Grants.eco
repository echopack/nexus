namespace nexus::oauth;

use std::time;

/**
 * The server's side of the flow, per request on the store: authorization requests read and
 * answered by the consent page, codes traded for grants, refresh tokens traded for new pairs,
 * access tokens checked (as an identity for the grant's resource only) and revoked. A grant that
 * ends is told to nexus-auth's `Endings`, so what was opened with it (a realtime socket) closes.
 */
public class Grants
{
    public const string ACCESS = 'nxo';
    public const string REFRESH = 'nxr';

    public OAuthStore $store;
    public Clients $clients;
    public const OAuthConfig $config;
    public calendar::Clock $clock;
    private nexus::auth::Endings $endings;

    public constructor(OAuthStore $store, Clients $clients, OAuthConfig $config, calendar::Clock $clock, nexus::auth::Endings $endings)
    {
        $this->store = $store;
        $this->clients = $clients;
        $this->config = $config;
        $this->clock = $clock;
        $this->endings = $endings;
    }

    /**
     * Client `$id`, one the app registers in code or one in the store, or null.
     */
    public function client(const string& $id) : result<Client?, nexus::Problem>
    {
        return $this->clients->find($this->store, $id);
    }

    /**
     * Authorization request `$id` and its client, while it can still be answered: one that is
     * gone, expired or whose client is no longer registered is a 404.
     */
    public function request(const string& $id) : result<Asked, nexus::Problem>
    {
        AuthRequest? $found = try $this->store->request($id);
        return $this->checked($found);
    }

    /**
     * Authorization request `$id` and its client, removed so it is answered once.
     */
    public function answer(const string& $id) : result<Asked, nexus::Problem>
    {
        AuthRequest? $found = try $this->store->answer($id);
        return $this->checked($found);
    }

    /**
     * A code for what `$r` asks, allowed by `$subject`: kept as its hash for a minute, handed out
     * once.
     */
    public function code(const AuthRequest& $r, const string& $subject) : result<string, nexus::Problem>
    {
        string $code = nexus::auth::Secrets::hex(32);
        $c = Code($hash: nexus::auth::Secrets::hash($code), $client: $r->client, $subject: $subject, $redirect: $r->redirect,
            $named: $r->named, $challenge: $r->challenge, $scope: $r->scope, $resource: $r->resource,
            $expiresAt: $this->clock->now() + time::duration::secs(60));
        try $this->store->keep($c);
        return .ok($code);
    }

    /**
     * Trades a code, with the verifier of its challenge, for a new grant.
     */
    public function exchange(const string& $code, const string& $client, const string& $redirect, const string& $verifier) : result<Pair, OAuthError>
    {
        Code? $taken = try $this->store->take(nexus::auth::Secrets::hash($code));
        Code $c = guard $taken else {
            return .error(.invalidGrant('the code is unknown, used or expired'));
        };
        time::timestamp $now = $this->clock->now();
        if ($c->expiresAt < $now) {
            return .error(.invalidGrant('the code expired'));
        }
        if ($c->client != $client) {
            return .error(.invalidGrant('the code was issued to another client'));
        }
        // RFC 6749 4.1.3: required, and the same, when the authorization request had one
        if (($c->named || !$redirect->empty()) && $redirect != $c->redirect) {
            return .error(.invalidGrant('redirect_uri differs from the one the code was issued for'));
        }
        if (!Pkce::verify($verifier, $c->challenge)) {
            return .error(.invalidGrant('the code_verifier does not match the code_challenge'));
        }
        Client? $known = try $this->client($client);
        if ($known == null) {
            return .error(.invalidClient('the client is no longer registered'));
        }
        $access = nexus::auth::Token(fresh: Grants::ACCESS);
        $refresh = nexus::auth::Token($prefix: Grants::REFRESH, $id: $access->id, $secret: nexus::auth::Secrets::hex(32));
        $g = Grant($id: $access->id, $client: $client, $subject: $c->subject, $scope: $c->scope, $resource: $c->resource,
            $accessHash: $access->hash(), $accessExpiresAt: $now + $this->config->access,
            $refreshHash: $refresh->hash(), $refreshExpiresAt: $now + $this->config->refresh,
            $createdAt: $now, $usedAt: $now);
        try $this->store->open($g);
        try $this->store->touch($client, $now);
        return .ok(Pair($access: $access->text(), $refresh: $refresh->text(), $expiresIn: $this->config->access->as_secs() as int64, $scope: $c->scope));
    }

    /**
     * Trades refresh token `$text` of `$client` for a new pair. The token is spent; one spent
     * before that comes back means a copy is out there, and the grant ends.
     */
    public function refresh(const string& $text, const string& $client) : result<Pair, OAuthError>
    {
        nexus::auth::Token $t = guard nexus::auth::Token::parse(Grants::REFRESH, $text) else {
            return .error(.invalidGrant('the refresh token is not valid'));
        };
        Grant? $found = try $this->store->grant($t->id);
        Grant $g = guard $found else {
            return .error(.invalidGrant('the refresh token is not valid'));
        };
        time::timestamp $now = $this->clock->now();
        if ($g->client != $client || $g->refreshExpiresAt < $now) {
            return .error(.invalidGrant('the refresh token is not valid'));
        }
        if (!$g->previousHash->empty() && $t->matches($g->previousHash)) {
            try $this->drop($g->id);
            return .error(.invalidGrant('the refresh token was already used; connect the app again'));
        }
        if (!$t->matches($g->refreshHash)) {
            return .error(.invalidGrant('the refresh token is not valid'));
        }
        string $was = $g->refreshHash;
        $access = nexus::auth::Token($prefix: Grants::ACCESS, $id: $g->id, $secret: nexus::auth::Secrets::hex(32));
        $next = nexus::auth::Token($prefix: Grants::REFRESH, $id: $g->id, $secret: nexus::auth::Secrets::hex(32));
        $g->previousHash = $was;
        $g->refreshHash = $next->hash();
        $g->accessHash = $access->hash();
        $g->accessExpiresAt = $now + $this->config->access;
        $g->refreshExpiresAt = $now + $this->config->refresh;
        $g->usedAt = $now;
        Rotation $rotation = try $this->store->rotate($g, $was);
        if ($rotation == Rotation::lost) {
            return .error(.invalidGrant('the refresh token was just used'));
        }
        try $this->store->touch($client, $now);
        return .ok(Pair($access: $access->text(), $refresh: $next->text(), $expiresIn: $this->config->access->as_secs() as int64, $scope: $g->scope));
    }

    /**
     * Who access token `$text` was issued to, for the grant's resource and scopes: a 401 for a token
     * that is malformed, unknown, replaced or expired.
     */
    public function identify(const string& $text) : result<nexus::auth::Identity, nexus::Problem>
    {
        nexus::auth::Token $t = guard nexus::auth::Token::parse(Grants::ACCESS, $text) else {
            return .error(.unauthorized('the token is not valid', $reason: 'token_invalid'));
        };
        Grant? $found = try $this->store->grant($t->id);
        Grant $g = guard $found else {
            return .error(.unauthorized('the token is not valid', $reason: 'token_invalid'));
        };
        if (!$t->matches($g->accessHash) || $g->accessExpiresAt <= $this->clock->now()) {
            return .error(.unauthorized('the token is not valid', $reason: 'token_invalid'));
        }
        return .ok(nexus::auth::Identity($via: OAuthGuard::NAME, $subject: $g->subject, $credential: $g->id, $scopes: Scopes::split($g->scope),
            $audience: $g->resource, $client: $g->client));
    }

    /**
     * Whether grant `$id` of `$subject` still holds: it was not revoked and its access token has not
     * lapsed. A refresh keeps it holding; what was opened with an access token lives as long as
     * the grant, not the one token.
     */
    public function holds(const string& $id, const string& $subject) : result<bool, nexus::Problem>
    {
        Grant? $found = try $this->store->grant($id);
        Grant $g = guard $found else {
            return .ok(false);
        };
        return .ok($g->subject == $subject && $g->accessExpiresAt > $this->clock->now());
    }

    /**
     * Ends grant `$id`: its tokens stop working, and `Endings` hears of it.
     */
    public function drop(const string& $id) : status<nexus::Problem>
    {
        try $this->store->drop($id);
        $this->endings->ended(nexus::auth::Ending::credential(OAuthGuard::NAME, $id));
        return .ok;
    }

    /**
     * Whether `$subject` already allowed client `$client` the scopes `$r` asks for on its
     * resource, so a consent page may skip the question.
     */
    public function granted(const AuthRequest& $r, const string& $subject) : result<bool, nexus::Problem>
    {
        array<Grant> $all = try $this->store->grants($subject);
        time::timestamp $now = $this->clock->now();
        array<string> $asked = $r->scopes();
        foreach ($all as const &$g) {
            if ($g->client == $r->client && $g->resource == $r->resource && $g->refreshExpiresAt > $now
                && Scopes::covers(Scopes::split($g->scope), $asked)) {
                return .ok(true);
            }
        }
        return .ok(false);
    }

    /**
     * Ends the grant an access or refresh token belongs to (RFC 7009); a token that is not one of
     * ours is no error.
     */
    public function revoke(const string& $text) : status<nexus::Problem>
    {
        nexus::auth::Token? $access = nexus::auth::Token::parse(Grants::ACCESS, $text);
        nexus::auth::Token? $refresh = nexus::auth::Token::parse(Grants::REFRESH, $text);
        nexus::auth::Token $t = guard ($access ?? $refresh) else {
            return .ok;
        };
        Grant? $found = try $this->store->grant($t->id);
        Grant $g = guard $found else {
            return .ok;
        };
        if ($t->matches($g->accessHash) || $t->matches($g->refreshHash)) {
            return $this->drop($g->id);
        }
        return .ok;
    }

    internal function checked(AuthRequest? $found) : result<Asked, nexus::Problem>
    {
        AuthRequest $r = guard $found else {
            return .error(Grants::gone());
        };
        if ($r->expiresAt < $this->clock->now()) {
            return .error(Grants::gone());
        }
        Client? $client = try $this->client($r->client);
        Client $c = guard $client else {
            return .error(Grants::gone());
        };
        return .ok(Asked($client: $c, $request: $r));
    }

    internal static function gone() : nexus::Problem
    {
        return .notFound('the authorization request (it is answered once, within ten minutes; connect the app again)');
    }
}
