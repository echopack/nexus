namespace nexus::oauth;

/**
 * Protected resource metadata (RFC 9728), at the well-known path and at the one for the MCP
 * endpoint, which a 401 from `/mcp` points at.
 */
public class ResourceMetadata : nexus::Action
{
    private OAuthConfig $config;

    public constructor(OAuthConfig $config)
    {
        $this->config = $config;
    }

    public function handle(nexus::Payload& $payload) : nexus::Response
    {
        return nexus::Response(json: Metadata::ofResource($this->config, $payload->request));
    }
}
