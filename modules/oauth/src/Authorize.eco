namespace nexus::oauth;

/**
 * Where a client sends the user: the request is checked, then the browser goes to the app's consent
 * page (`consent`) with the same query. A request whose client or redirect is in doubt is a
 * 400 here; anything else wrong goes back to the client as an OAuth error.
 */
public class Authorize : nexus::Action
{
    private OAuthStore $store;
    private OAuthConfig $config;

    public constructor(OAuthStore $store, OAuthConfig $config)
    {
        $this->store = $store;
        $this->config = $config;
    }

    public function handle(nexus::Payload& $payload) : result<nexus::Response, nexus::Problem>
    {
        string $issuer = Metadata::issuer($this->config, $payload->request);
        Asked $asked = guard Asked::check($payload->request->queryString, $this->store, $issuer, $this->config) else ($d) {
            return $d->answer();
        };
        // the extension checked the consent page at boot
        nexus::Url $consent = guard nexus::Url::parse($this->config->consent) else ($e) {
            return .error(.server("consent: {$e->message()}"));
        };
        if (!$consent->absolute()) {
            nexus::Url $base = guard nexus::Url::parse($issuer) else {
                return .error(.badRequest('the Host header names no host'));
            };
            $consent = $consent->on($base);
        }
        $asks = nexus::Query(parse: $asked->query);
        foreach ($asks->pairs as const &$p) {
            $consent->query->add($p->name, $p->value);
        }
        return .ok(nexus::Response(redirect: $consent));
    }
}
