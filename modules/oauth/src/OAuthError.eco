namespace nexus::oauth;

/**
 * An error in the shape OAuth asks for (RFC 6749, section 5.2):
 * `{"error": "invalid_grant", "error_description": "..."}`, not a problem
 * document, since clients read the code.
 */
public struct OAuthError
{
    public string $code;
    public string $description;
    public int32 $status = 400;

    public const function response() : nexus::Response
    {
        json::Value $o = json::object();
        $o['error'] = json::str($this->code);
        $o['error_description'] = json::str($this->description);
        nexus::Response $res = nexus::Response(json: $o, status: $this->status);
        $res->header('Cache-Control', 'no-store');
        return $res;
    }

    /**
     * A store or server failure as `server_error`, 500.
     */
    public static function of(const nexus::Problem& $p) : OAuthError
    {
        if ($p->status() >= 500) {
            return OAuthError('server_error', 'the server could not answer; try again', 500);
        }
        return OAuthError('invalid_request', $p->detail(nexus::Mode::prod), 400);
    }
}
