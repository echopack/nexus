namespace nexus::oauth;

/**
 * Disconnects a client the signed in user allowed: its tokens stop working at once.
 */
#[nexus::through: ["nexus::auth::Authenticate"]]
public class DropGrant : nexus::Action
{
    private Grants $grants;

    public constructor(Grants $grants)
    {
        $this->grants = $grants;
    }

    public function handle(nexus::Payload& $payload, string $id) : status<nexus::Problem>
    {
        $me = try $payload->state<nexus::auth::Identity>();
        Grant? $found = try $this->grants->store->grant($id);
        Grant $g = guard $found else {
            return .error(.notFound('the grant'));
        };
        if ($g->subject != $me->subject) {
            return .error(.notFound('the grant'));
        }
        return $this->grants->drop($g->id);
    }
}
