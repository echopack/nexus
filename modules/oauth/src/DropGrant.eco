namespace nexus::oauth;

/**
 * Disconnects a client the signed in user allowed: its tokens stop
 * working at once.
 */
#[nexus::through: ["nexus::auth::Authenticate"]]
public class DropGrant : nexus::Action
{
    private OAuthStore $store;

    public constructor(OAuthStore $store)
    {
        $this->store = $store;
    }

    public function handle(nexus::Payload& $payload, string $id) : status<nexus::Problem>
    {
        nexus::auth::Identity $me = guard $payload->state<nexus::auth::Identity>() else ($p) {
            return .error($p);
        };
        Grant? $found = guard $this->store->grant($id) else ($p) {
            return .error($p);
        };
        Grant $g = guard $found else {
            return .error(.notFound('the grant'));
        };
        if ($g->subject != $me->subject) {
            return .error(.notFound('the grant'));
        }
        return $this->store->drop($g->id);
    }
}
