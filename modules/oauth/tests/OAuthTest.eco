/**
 * nexus-oauth end to end in process: registration, the authorize hop to the consent page with a
 * kept request, its answer by a signed in user, the code traded with PKCE, the access token on its
 * resource (and nowhere else), resources and scopes, clients registered in code, refresh rotation
 * with reuse detection, revocation, the grants list and pruning, on memory stores and a clock the
 * tests move.
 *
 * Requests reach the app as host `app`, so the issuer is `http://app`.
 */

use nexus::oauth::{Pkce, Register};
use nexus::mcp::{ToolSpec, Schema};
use nexus::testing::TestApp;
use ecotest::http::{Api, Reply};
use std::time;
use ecotest::expect;

internal const KEY = 'a-test-key-of-at-least-thirty-two-chars';
internal const START = 1700000000;
internal const VERIFIER = 'a-verifier-of-at-least-forty-three-characters-0123456789';
internal const REDIRECT = 'http://127.0.0.1:33418/callback';

/**
 * A tool that says who calls.
 */
internal struct TWhoMcp
{
    public static function spec() : ToolSpec
    {
        function<nexus::Response(nexus::Payload&, nexus::Fields&)> $run = function(nexus::Payload& $payload, nexus::Fields& $args) : nexus::Response {
            nexus::auth::Identity $me = guard $payload->state<nexus::auth::Identity>() else ($p) {
                return nexus::Reply::problem($payload, $p);
            };
            json::Value $o = json::object();
            $o['subject'] = json::str($me->subject);
            $o['via'] = json::str($me->via);
            return nexus::Response(json: $o);
        };
        function<bool(container::Container)> $bound = function(container::Container $services) : bool {
            return true;
        };
        $t = ToolSpec('who', 'TWho', Schema::of('{"type":"object","properties":{},"additionalProperties":false}'), $run, $bound);
        $t->through = [nexus::MiddlewareRef::of<nexus::auth::Authenticate>('nexus::auth::Authenticate')];
        return $t;
    }
}

/**
 * Declares resource `api` at `/v1` with scopes `posts:read` and `posts:write`.
 */
internal class TApi : nexus::Extension
{
    public function name() : string
    {
        return 'test-api';
    }

    public function services(nexus::Services& $s) : status<nexus::BootError>
    {
        array<string> $scopes = ['posts:read', 'posts:write'];
        $s->get<nexus::auth::Resources>()->add($s, nexus::auth::Resource('api', '/v1', $scopes, 'Blog API'));
        return .ok;
    }
}

internal class Rig
{
    public TestApp $app;
    public calendar::ManualClock $clock;
    public string $user;

    /**
     * The app, signed in as user 7.
     */
    public Api $signedIn;

    public constructor()
    {
        $this->clock = calendar::ManualClock(time::timestamp::from_unix_secs(START));
        $this->app = TestApp(Rig::extensions($this->clock, '/consent'), Rig::vars());
        $this->user = Rig::signIn($this->app);
        $this->signedIn = $this->app->api()->bearer($this->user);
    }

    /**
     * A rig with the API resource next to MCP, and the app's own client `blog-cli`.
     */
    public constructor(api: bool $api)
    {
        $this->clock = calendar::ManualClock(time::timestamp::from_unix_secs(START));
        array<ToolSpec> $tools = [TWhoMcp::spec()];
        array<string> $redirects = ['http://127.0.0.1/cli'];
        array<nexus::oauth::Client> $own = [nexus::oauth::Client($id: 'blog-cli', $name: 'Blog CLI', $redirects: $redirects)];
        array<nexus::Extension> $exts = [
            nexus::auth::Extension('test', clock: $this->clock, cost: crypto::PasswordCost(8, 1)),
            nexus::oauth::Extension(clock: $this->clock, consent: '/consent', clients: $own),
            nexus::mcp::Extension(tools: $tools, name: 'Tests'),
            TApi(),
        ];
        $this->app = TestApp($exts, Rig::vars());
        $this->user = Rig::signIn($this->app);
        $this->signedIn = $this->app->api()->bearer($this->user);
    }

    /**
     * A rig whose consent page is `$consent`.
     */
    public constructor(consent: const string& $consent)
    {
        $this->clock = calendar::ManualClock(time::timestamp::from_unix_secs(START));
        $this->app = TestApp(Rig::extensions($this->clock, $consent), Rig::vars());
        $this->user = Rig::signIn($this->app);
        $this->signedIn = $this->app->api()->bearer($this->user);
    }

    public static function vars() : map<string, string>
    {
        map<string, string> $vars = ['NEXUS_AUTH_KEY' => KEY];
        return $vars;
    }

    public static function extensions(calendar::ManualClock $clock, const string& $consent) : array<nexus::Extension>
    {
        array<ToolSpec> $tools = [TWhoMcp::spec()];
        array<nexus::Extension> $exts = [
            nexus::auth::Extension('test', clock: $clock, cost: crypto::PasswordCost(8, 1)),
            nexus::oauth::Extension(clock: $clock, consent: $consent),
            nexus::mcp::Extension(tools: $tools, name: 'Tests'),
        ];
        return $exts;
    }

    internal static function signIn(TestApp $app) : string
    {
        nexus::Payload $payload = $app->kernel->background('issue', 'test');
        nexus::auth::Issued $issued = guard $payload->get<nexus::auth::Tokens>()->issue('7');
        nexus::Kernel::finish($payload);
        return $issued->token;
    }

    /**
     * Registers a client that comes back to `REDIRECT`: its id.
     */
    public function register() : string
    {
        return $this->app->api()
            ->post('/oauth/register', json: '{"client_name":"Test client","redirect_uris":["http://127.0.0.1:33418/callback"]}')
            ->status(201)
            ->capture('$.client_id');
    }

    public function query(const string& $client) : string
    {
        string $challenge = Pkce::challenge(VERIFIER);
        string $redirect = nexus::Percent::encode(REDIRECT);
        return "response_type=code&client_id={$client}&redirect_uri={$redirect}&code_challenge={$challenge}&code_challenge_method=S256&state=s1&resource=http%3A%2F%2Fapp%2Fmcp";
    }

    /**
     * Sends `$query` to `/oauth/authorize`: the id of the request it kept for the consent page.
     */
    public function ask(const string& $query) : string
    {
        string $consent = $this->app->api()->get("/oauth/authorize?{$query}")
            ->status(302)
            ->capture(header: 'Location');
        return Rig::param($consent, 'request');
    }

    /**
     * The consent page's answer for user 7 to request `$id`, and where it sends the browser.
     */
    public function answer(const string& $id, bool $allow) : string
    {
        json::Value $o = json::object();
        $o['allow'] = json::bool($allow);
        return $this->signedIn->post("/oauth/requests/{$id}", json: $o)->status(200)->capture('$.redirect');
    }

    /**
     * Asks with `$query` and answers: where the browser goes back to.
     */
    public function approve(const string& $query, bool $allow) : string
    {
        return $this->answer($this->ask($query), $allow);
    }

    /**
     * A payload for a request to `$path` with bearer token `$token`.
     */
    public function payload(const string& $path, const string& $token) : nexus::Payload
    {
        $req = nexus::Request(.get, $path);
        $req->headers->set('Authorization', "Bearer {$token}");
        return nexus::Payload($request: mv $req, $services: $this->app->kernel->services->child(), $mode: .testing, $log: nexus::Logger([], .info));
    }

    /**
     * Who token `$token` names at `$path`, as `via:subject`, or the status it is refused with.
     */
    public function identify(const string& $path, const string& $token) : string
    {
        nexus::Payload $payload = $this->payload($path, $token);
        nexus::auth::Identity? $found = guard $payload->get<nexus::auth::Guards>()->identify($payload) else ($p) {
            return "{$p->status()}";
        };
        nexus::auth::Identity $id = guard $found else {
            return 'nobody';
        };
        return "{$id->via}:{$id->subject}";
    }

    public function token(const ordered_map<string, string>& $form) : Reply
    {
        return $this->app->api()->post('/oauth/token', form: $form);
    }

    /**
     * Registers, approves and trades the code: the token answer.
     */
    public function connect() : Reply
    {
        string $client = $this->register();
        return $this->trade($client, $this->approve($this->query($client), true));
    }

    /**
     * Trades the code in `$back` for client `$client`: the token answer.
     */
    public function trade(const string& $client, const string& $back) : Reply
    {
        return $this->token([
            'grant_type' => 'authorization_code',
            'client_id' => $client,
            'code' => Rig::param($back, 'code'),
            'redirect_uri' => REDIRECT,
            'code_verifier' => VERIFIER,
        ]);
    }

    public function who(const string& $token) : Reply
    {
        return $this->app->api()
            ->bearer($token)
            ->post('/mcp', json: '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"who","arguments":{}}}');
    }

    /**
     * Query parameter `$name` of URL `$url`, decoded.
     */
    public static function param(const string& $url, const string& $name) : string
    {
        usize $q = $url->find('?');
        if ($q >= $url->size()) {
            return '';
        }
        $pairs = nexus::Query(parse: $url->sub($q + 1, $url->size() - $q - 1));
        return $pairs->get($name) ?? '';
    }
}

test the_metadata_names_the_endpoints
{
    $r = Rig();
    $blog = $r->app->api()->with('Host', 'blog.test');
    $blog->get('/.well-known/oauth-authorization-server')
        ->status(200)
        ->json('$.issuer', 'http://blog.test')
        ->json('$.token_endpoint', 'http://blog.test/oauth/token')
        ->json('$.code_challenge_methods_supported[0]', 'S256')
        ->json('$.scopes_supported[0]', 'mcp');
    $blog->get('/.well-known/oauth-protected-resource/mcp')
        ->json('$.resource', 'http://blog.test/mcp')
        ->json('$.authorization_servers[0]', 'http://blog.test')
        ->json('$.resource_name', 'Tests');
    $blog->post('/mcp', json: '{"jsonrpc":"2.0","id":1,"method":"ping"}')
        ->status(401)
        ->header('WWW-Authenticate', 'Bearer resource_metadata="http://blog.test/.well-known/oauth-protected-resource/mcp"');
}

test registration_checks_what_a_client_asks_for
{
    $r = Rig();
    expect($r->register())->length(32);

    $r->app->api()->post('/oauth/register', json: '{"redirect_uris":["http://evil.example/cb"]}')
        ->status(400)
        ->json('$.error', 'invalid_redirect_uri');
    $r->app->api()->post('/oauth/register', json: '{"redirect_uris":["https://app.example/cb"],"token_endpoint_auth_method":"client_secret_basic"}')
        ->json('$.error', 'invalid_client_metadata');

    expect(Register::clean("Evil\u{202E}txt.exe"))->is('Eviltxt.exe');
    expect(Register::clean("\n\t"))->is('an app');
}

test authorize_keeps_the_request_for_the_consent_page
{
    $r = Rig();
    string $client = $r->register();
    string $consent = $r->app->api()->get("/oauth/authorize?{$r->query($client)}")
        ->status(302)
        ->header('Location', starts: 'http://app/consent?request=')
        ->capture(header: 'Location');
    string $id = Rig::param($consent, 'request');
    expect($id)->length(32);

    $r->signedIn->get("/oauth/requests/{$id}")
        ->status(200)
        ->json('$.client.name', 'Test client')
        ->json('$.redirect', REDIRECT)
        ->json('$.resource.name', 'mcp')
        ->json('$.resource.url', 'http://app/mcp')
        ->json('$.scopes[0]', 'mcp')
        ->json('$.granted_before', false);
    $r->app->api()->get("/oauth/requests/{$id}")->status(401);
    $r->signedIn->get('/oauth/requests/nonsense')->status(404);

    $r->app->api()->get('/oauth/authorize?response_type=code&client_id=nobody')->status(400);
    string $back = $r->app->api()
        ->get('/oauth/authorize', query: ['response_type' => 'code', 'client_id' => $client, 'redirect_uri' => REDIRECT, 'state' => 's9'])
        ->status(302)
        ->header('Location', starts: REDIRECT)
        ->capture(header: 'Location');
    expect(Rig::param($back, 'error'))->is('invalid_request');
    expect(Rig::param($back, 'state'))->is('s9');
}

test a_request_is_answered_once_within_ten_minutes
{
    $r = Rig();
    string $client = $r->register();
    string $id = $r->ask($r->query($client));
    string $back = $r->answer($id, true);
    expect(Rig::param($back, 'code'))->length(64);
    json::Value $again = json::object();
    $again['allow'] = json::bool(true);
    $r->signedIn->post("/oauth/requests/{$id}", json: $again)->status(404);

    string $late = $r->ask($r->query($client));
    $r->clock->advance(.mins(11));
    $r->signedIn->get("/oauth/requests/{$late}")->status(404);
    $r->signedIn->post("/oauth/requests/{$late}", json: $again)->status(404);
}

test the_consent_page_keeps_its_own_query_and_origin
{
    $r = Rig(consent: '/consent?step=1');
    string $query = $r->query($r->register());
    $r->app->api()->get("/oauth/authorize?{$query}")->header('Location', starts: 'http://app/consent?step=1&request=');

    $far = Rig(consent: 'https://app.example.com/approve');
    string $asks = $far->query($far->register());
    $far->app->api()->get("/oauth/authorize?{$asks}")->header('Location', starts: 'https://app.example.com/approve?request=');
}

test a_consent_page_that_is_no_url_or_no_resource_stops_the_boot
{
    $clock = calendar::ManualClock(time::timestamp::from_unix_secs(START));
    result<TestApp, nexus::BootError> $broken = TestApp::attempt(Rig::extensions($clock, 'consent page'), Rig::vars());
    nexus::BootError $consent = expect($broken)->fails();
    expect($consent->lines()[0])->has("consent: 'consent page' is no URL");
    array<nexus::Extension> $bare = [nexus::auth::Extension('test', cost: crypto::PasswordCost(8, 1)), nexus::oauth::Extension()];
    nexus::BootError $none = expect(TestApp::attempt($bare, Rig::vars()))->fails();
    expect($none->lines()[0])->has('no resource to issue tokens for');
}

test a_denied_request_goes_back_with_access_denied
{
    $r = Rig();
    string $back = $r->approve($r->query($r->register()), false);
    expect(Rig::param($back, 'error'))->is('access_denied');
    expect(Rig::param($back, 'state'))->is('s1');
    expect(Rig::param($back, 'iss'))->is('http://app');
}

test the_code_is_traded_once_with_its_verifier
{
    $r = Rig();
    string $client = $r->register();
    string $back = $r->approve($r->query($client), true);
    string $code = Rig::param($back, 'code');
    expect($code)->length(64);
    expect(Rig::param($back, 'iss'))->is('http://app');

    $r->token([
        'grant_type' => 'authorization_code',
        'client_id' => $client,
        'code' => $code,
        'redirect_uri' => REDIRECT,
        'code_verifier' => 'wrong-verifier-wrong-verifier-wrong-verifier-wrong',
    ])->status(400)->json('$.error', 'invalid_grant');
    // the failed try spent it
    $r->token([
        'grant_type' => 'authorization_code',
        'client_id' => $client,
        'code' => $code,
        'redirect_uri' => REDIRECT,
        'code_verifier' => VERIFIER,
    ])->json('$.error', 'invalid_grant');

    $pair = $r->connect()
        ->status(200)
        ->json('$.token_type', 'Bearer')
        ->json('$.expires_in', 3600)
        ->json('$.scope', 'mcp')
        ->header('Cache-Control', 'no-store');
    expect($pair->capture('$.access_token'))->starts('nxo_');
    expect($pair->capture('$.refresh_token'))->starts('nxr_');
}

test an_access_token_opens_its_resource_and_nothing_else
{
    $r = Rig();
    string $access = $r->connect()->capture('$.access_token');
    $r->who($access)
        ->json('$.result.structuredContent.subject', '7')
        ->json('$.result.structuredContent.via', 'oauth');
    $r->app->api()->bearer($access)->get('/oauth/grants')->status(401);
    expect($r->identify('/mcp', $access))->is('oauth:7');
    expect($r->identify('/v1/me', $access))->is('401');
    nexus::Payload $payload = $r->payload('/mcp', $access);
    nexus::auth::Identity? $found = guard $payload->get<nexus::auth::Guards>()->identify($payload);
    nexus::auth::Identity $id = guard $found;
    expect($id->audience)->is('mcp');
    expect($id->client)->length(32);
    expect($id->has('mcp'))->yes(says: 'the token holds the scope it was granted');
    expect($id->has('admin'))->no(says: 'and no other');

    $r->clock->advance(.mins(61));
    $r->who($access)->status(401);
}

test the_resource_and_scopes_are_checked
{
    $r = Rig(api: true);
    string $client = $r->register();
    string $challenge = Pkce::challenge(VERIFIER);
    string $redirect = nexus::Percent::encode(REDIRECT);
    string $base = "response_type=code&client_id={$client}&redirect_uri={$redirect}&code_challenge={$challenge}&code_challenge_method=S256&state=s1";

    // two resources: the client has to say which
    string $unnamed = $r->app->api()->get("/oauth/authorize?{$base}")->status(302)->capture(header: 'Location');
    expect(Rig::param($unnamed, 'error'))->is('invalid_target');
    string $unknown = $r->app->api()->get("/oauth/authorize?{$base}&resource=http%3A%2F%2Fapp%2Fother")->capture(header: 'Location');
    expect(Rig::param($unknown, 'error'))->is('invalid_target');
    string $scope = $r->app->api()->get("/oauth/authorize?{$base}&resource=http%3A%2F%2Fapp%2Fv1&scope=mcp")->capture(header: 'Location');
    expect(Rig::param($scope, 'error'))->is('invalid_scope');

    string $id = $r->ask("{$base}&resource=http%3A%2F%2Fapp%2Fv1%2F&scope=posts%3Aread");
    $r->signedIn->get("/oauth/requests/{$id}")
        ->json('$.resource.name', 'api')
        ->json('$.resource.title', 'Blog API')
        ->count('$.scopes', 1)
        ->json('$.scopes[0]', 'posts:read');
    string $access = $r->trade($client, $r->answer($id, true))
        ->status(200)
        ->json('$.scope', 'posts:read')
        ->capture('$.access_token');
    expect($r->identify('/v1/posts', $access))->is('oauth:7');
    expect($r->identify('/mcp', $access))->is('401');
    $r->who($access)->status(401);

    // all of the resource's scopes when none are named, and the user allowed them before
    string $all = $r->ask("{$base}&resource=http%3A%2F%2Fapp%2Fv1");
    $r->signedIn->get("/oauth/requests/{$all}")->count('$.scopes', 2)->json('$.granted_before', false);
    $r->trade($client, $r->answer($all, true))->json('$.scope', 'posts:read posts:write');
    string $read = $r->ask("{$base}&resource=http%3A%2F%2Fapp%2Fv1&scope=posts%3Aread");
    $r->signedIn->get("/oauth/requests/{$read}")->json('$.granted_before', true);
    $r->signedIn->get('/oauth/grants')
        ->count('$.items', 2)
        ->json('$.items[0].resource', 'api')
        ->json('$.items[1].resource', 'api');
}

test a_client_registered_in_code_needs_no_registration
{
    $r = Rig(api: true);
    string $challenge = Pkce::challenge(VERIFIER);
    string $id = $r->ask("response_type=code&client_id=blog-cli&code_challenge={$challenge}&code_challenge_method=S256&resource=http%3A%2F%2Fapp%2Fmcp");
    $r->signedIn->get("/oauth/requests/{$id}")->json('$.client.name', 'Blog CLI');
    string $back = $r->answer($id, true);
    expect($back)->starts('http://127.0.0.1/cli?code=');
    $r->token([
        'grant_type' => 'authorization_code',
        'client_id' => 'blog-cli',
        'code' => Rig::param($back, 'code'),
        'code_verifier' => VERIFIER,
    ])->status(200);

    array<string> $none = [];
    array<nexus::oauth::Client> $bad = [nexus::oauth::Client($id: 'x', $name: 'X', $redirects: $none)];
    array<nexus::Extension> $exts = [nexus::auth::Extension('test', cost: crypto::PasswordCost(8, 1)), nexus::oauth::Extension(clients: $bad), nexus::mcp::Extension()];
    nexus::BootError $e = expect(TestApp::attempt($exts, Rig::vars()))->fails();
    expect($e->lines()[0])->has('client x needs a redirect');
}

test refresh_rotates_and_a_reused_token_ends_the_grant
{
    $r = Rig();
    $pair = $r->connect();
    string $client = Rig::param("x?{$r->query($r->register())}", 'client_id');
    string $firstAccess = $pair->capture('$.access_token');
    string $firstRefresh = $pair->capture('$.refresh_token');
    string $holder = $r->signedIn->get('/oauth/grants')->capture('$.items[0].client');
    expect($client)->isNot($holder);

    $r->token(['grant_type' => 'refresh_token', 'client_id' => $client, 'refresh_token' => $firstRefresh])
        ->json('$.error', 'invalid_grant');
    $second = $r->token(['grant_type' => 'refresh_token', 'client_id' => $holder, 'refresh_token' => $firstRefresh])
        ->status(200);
    string $secondAccess = $second->capture('$.access_token');
    string $secondRefresh = $second->capture('$.refresh_token');
    expect($secondRefresh)->isNot($firstRefresh);
    $r->who($firstAccess)->status(401);
    $r->who($secondAccess)->json('$.result.structuredContent.subject', '7');

    // the spent one comes back: someone holds a copy, so the grant ends
    $r->token(['grant_type' => 'refresh_token', 'client_id' => $holder, 'refresh_token' => $firstRefresh])
        ->json('$.error', 'invalid_grant');
    $r->who($secondAccess)->status(401);
    $r->token(['grant_type' => 'refresh_token', 'client_id' => $holder, 'refresh_token' => $secondRefresh])
        ->json('$.error', 'invalid_grant');
}

test revoking_and_disconnecting_end_the_grant
{
    $r = Rig();
    string $access = $r->connect()->capture('$.access_token');
    $r->app->api()->post('/oauth/revoke', form: ['token' => $access])->status(200);
    $r->who($access)->status(401);
    $r->app->api()->post('/oauth/revoke', form: ['token' => 'nonsense'])->status(200);

    string $again = $r->connect()->capture('$.access_token');
    string $grant = $r->signedIn->get('/oauth/grants')
        ->count('$.items', 1)
        ->json('$.items[0].name', 'Test client')
        ->json('$.items[0].resource', 'mcp')
        ->capture('$.items[0].id');
    $r->signedIn->delete("/oauth/grants/{$grant}")->status(204);
    $r->who($again)->status(401);
}

/**
 * The credentials `Endings` said ended, as `via id`.
 */
#[atomic]
internal class THeard
{
    private std::thread::mutex<array<string>> $ids = std::thread::mutex<array<string>>(array<string>());

    public constructor()
    {
    }

    public function add(const string& $id) : void
    {
        std::thread::locked<array<string>> $held = $this->ids->lock();
        $held->value->push($id);
    }

    public function all() : array<string>
    {
        std::thread::locked<array<string>> $held = $this->ids->lock();
        return $held->value->clone();
    }
}

/**
 * Whether the grant behind access token `$token` still holds, as nexus-auth asks it of a socket
 * opened with the token.
 */
internal function holds(Rig $r, const string& $token, const string& $grant) : bool
{
    nexus::Payload $payload = $r->payload('/mcp', $token);
    nexus::auth::Identity $id = nexus::auth::Identity($via: 'oauth', $subject: '7', $credential: $grant);
    bool $still = guard $payload->get<nexus::auth::Guards>()->holds($payload, $id) else {
        return false;
    };
    return $still;
}

test an_ended_grant_is_told_and_no_longer_holds
{
    $r = Rig();
    THeard $heard = THeard();
    $r->app->kernel->services->get<nexus::auth::Endings>()->listen(function[$heard](nexus::auth::Ending $e) : void {
        match ($e) {
            nexus::auth::Ending::credential($via, $id) => {
                $heard->add("{$via} {$id}");
            },
            else => {},
        }
    });

    // revoked at the endpoint
    string $access = $r->connect()->capture('$.access_token');
    string $first = $r->signedIn->get('/oauth/grants')->capture('$.items[0].id');
    expect(holds($r, $access, $first))->yes(says: 'a fresh grant holds');
    $r->app->api()->post('/oauth/revoke', form: ['token' => $access])->status(200);
    expect($heard->all())->is(["oauth {$first}"]);
    expect(holds($r, $access, $first))->no(says: 'a revoked grant');

    // disconnected by its user
    string $again = $r->connect()->capture('$.access_token');
    string $second = $r->signedIn->get('/oauth/grants')->capture('$.items[0].id');
    $r->signedIn->delete("/oauth/grants/{$second}")->status(204);
    expect($heard->all())->is(["oauth {$first}", "oauth {$second}"]);

    // its access token lapses without a refresh
    string $third = $r->connect()->capture('$.access_token');
    string $grant = $r->signedIn->get('/oauth/grants')->capture('$.items[0].id');
    expect(holds($r, $third, $grant))->yes(says: 'within the hour');
    $r->clock->advance(.mins(61));
    expect(holds($r, $third, $grant))->no(says: 'the access token lapsed');
}

test signing_out_everywhere_ends_every_grant_once
{
    $r = Rig();
    THeard $heard = THeard();
    $r->app->kernel->services->get<nexus::auth::Endings>()->listen(function[$heard](nexus::auth::Ending $e) : void {
        match ($e) {
            nexus::auth::Ending::subject($via, $subject) => {
                $heard->add("{$via} {$subject}");
            },
            else => {},
        }
    });
    $r->connect();
    $r->connect();
    $r->signedIn->get('/oauth/grants')->count('$.items', 2);
    nexus::Payload $payload = $r->app->kernel->background('sign out', 'test');
    guard $payload->get<nexus::auth::Tokens>()->revokeAll('7');
    guard $payload->get<nexus::auth::Tokens>()->revokeAll('7');
    nexus::Kernel::finish($payload);
    // oauth listens from boot, so its ending lands first; the second sign out finds nothing to drop
    expect($heard->all())->is(['oauth 7', 'bearer 7', 'bearer 7']);
    $r->app->api()->bearer(Rig::signIn($r->app))->get('/oauth/grants')->count('$.items', 0);
}

test pruning_drops_expired_requests_codes_and_grants
{
    $r = Rig();
    string $client = $r->register();
    $r->ask($r->query($client));
    $r->connect();
    $r->clock->advance(.hours(24 * 31));
    nexus::Payload $payload = $r->app->kernel->background('prune', 'test');
    array<nexus::auth::Pruned> $done = guard $payload->get<nexus::auth::Pruning>()->run($payload);
    nexus::Kernel::finish($payload);
    expect($done[2]->name)->is('oauth requests, codes and grants');
    expect($done[2]->count)->is(2 as uint64);
    // the user's own token expired as well; a fresh one sees no grant
    $r->app->api()->bearer(Rig::signIn($r->app))->get('/oauth/grants')->count('$.items', 0);
}

test boot_needs_nexus_auth_first
{
    map<string, string> $vars = ['NEXUS_AUTH_KEY' => KEY];
    array<nexus::Extension> $exts = [nexus::oauth::Extension(), nexus::auth::Extension('test')];
    result<TestApp, nexus::BootError> $r = TestApp::attempt($exts, $vars);
    expect($r)->fails();
}
