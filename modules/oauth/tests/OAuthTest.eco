/**
 * nexus-oauth end to end in process: registration, the authorize hop to the consent page, approval
 * by a signed in user, the code traded with PKCE, the access token on the MCP endpoint (and nowhere
 * else), refresh rotation with reuse detection, revocation and the grants list, on memory stores
 * and a clock the tests move.
 *
 * Requests reach the app as host `app`, so the issuer is `http://app`.
 */

use nexus::oauth::{Pkce, Register};
use nexus::mcp::{ToolSpec, Schema};
use nexus::testing::TestApp;
use ecotest::http::{Api, Reply};
use std::time;
use ecotest::expect;

internal const KEY = 'a-test-key-of-at-least-thirty-two-chars';
internal const START = 1700000000;
internal const VERIFIER = 'a-verifier-of-at-least-forty-three-characters-0123456789';
internal const REDIRECT = 'http://127.0.0.1:33418/callback';

/**
 * A tool that says who calls.
 */
internal struct TWhoMcp
{
    public static function spec() : ToolSpec
    {
        function<nexus::Response(nexus::Payload&, nexus::Fields&)> $run = function(nexus::Payload& $payload, nexus::Fields& $args) : nexus::Response {
            nexus::auth::Identity $me = guard $payload->state<nexus::auth::Identity>() else ($p) {
                return nexus::Reply::problem($payload, $p);
            };
            json::Value $o = json::object();
            $o['subject'] = json::str($me->subject);
            $o['via'] = json::str($me->via);
            return nexus::Response(json: $o);
        };
        function<bool(container::Container)> $bound = function(container::Container $services) : bool {
            return true;
        };
        $t = ToolSpec('who', 'TWho', Schema::of('{"type":"object","properties":{},"additionalProperties":false}'), $run, $bound);
        $t->through = [nexus::MiddlewareRef::of<nexus::auth::Authenticate>('nexus::auth::Authenticate')];
        return $t;
    }
}

internal class Rig
{
    public TestApp $app;
    public calendar::ManualClock $clock;
    public string $user;

    /**
     * The app, signed in as user 7.
     */
    public Api $signedIn;

    public constructor()
    {
        $this->clock = calendar::ManualClock(time::timestamp::from_unix_secs(START));
        $this->app = TestApp(Rig::extensions($this->clock, '/consent'), Rig::vars());
        $this->user = Rig::signIn($this->app);
        $this->signedIn = $this->app->api()->bearer($this->user);
    }

    /**
     * A rig whose consent page is `$consent`.
     */
    public constructor(consent: const string& $consent)
    {
        $this->clock = calendar::ManualClock(time::timestamp::from_unix_secs(START));
        $this->app = TestApp(Rig::extensions($this->clock, $consent), Rig::vars());
        $this->user = Rig::signIn($this->app);
        $this->signedIn = $this->app->api()->bearer($this->user);
    }

    public static function vars() : map<string, string>
    {
        map<string, string> $vars = ['NEXUS_AUTH_KEY' => KEY];
        return $vars;
    }

    public static function extensions(calendar::ManualClock $clock, const string& $consent) : array<nexus::Extension>
    {
        array<ToolSpec> $tools = [TWhoMcp::spec()];
        array<nexus::Extension> $exts = [
            nexus::auth::Extension('test', clock: $clock, cost: crypto::PasswordCost(8, 1)),
            nexus::oauth::Extension(clock: $clock, consent: $consent, name: 'Tests'),
            nexus::mcp::Extension(tools: $tools),
        ];
        return $exts;
    }

    internal static function signIn(TestApp $app) : string
    {
        nexus::Payload $payload = $app->kernel->background('issue', 'test');
        nexus::auth::Issued $issued = guard $payload->get<nexus::auth::Tokens>()->issue('7');
        nexus::Kernel::finish($payload);
        return $issued->token;
    }

    /**
     * Registers a client that comes back to `REDIRECT`: its id.
     */
    public function register() : string
    {
        return $this->app->api()
            ->post('/oauth/register', json: '{"client_name":"Test client","redirect_uris":["http://127.0.0.1:33418/callback"]}')
            ->status(201)
            ->capture('$.client_id');
    }

    public function query(const string& $client) : string
    {
        string $challenge = Pkce::challenge(VERIFIER);
        string $redirect = nexus::Percent::encode(REDIRECT);
        return "response_type=code&client_id={$client}&redirect_uri={$redirect}&code_challenge={$challenge}&code_challenge_method=S256&state=s1&resource=http%3A%2F%2Fapp%2Fmcp";
    }

    /**
     * The consent page's answer for user 7, and where it sends the browser.
     */
    public function approve(const string& $query, bool $allow) : string
    {
        json::Value $o = json::object();
        $o['query'] = json::str($query);
        $o['allow'] = json::bool($allow);
        return $this->signedIn->post('/oauth/approve', json: $o)->status(200)->capture('$.redirect');
    }

    public function token(const ordered_map<string, string>& $form) : Reply
    {
        return $this->app->api()->post('/oauth/token', form: $form);
    }

    /**
     * Registers, approves and trades the code: the token answer.
     */
    public function connect() : Reply
    {
        string $client = $this->register();
        string $back = $this->approve($this->query($client), true);
        return $this->token([
            'grant_type' => 'authorization_code',
            'client_id' => $client,
            'code' => Rig::param($back, 'code'),
            'redirect_uri' => REDIRECT,
            'code_verifier' => VERIFIER,
        ]);
    }

    public function who(const string& $token) : Reply
    {
        return $this->app->api()
            ->bearer($token)
            ->post('/mcp', json: '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"who","arguments":{}}}');
    }

    /**
     * Query parameter `$name` of URL `$url`, decoded.
     */
    public static function param(const string& $url, const string& $name) : string
    {
        usize $q = $url->find('?');
        if ($q >= $url->size()) {
            return '';
        }
        $pairs = nexus::Query(parse: $url->sub($q + 1, $url->size() - $q - 1));
        return $pairs->get($name) ?? '';
    }
}

test the_metadata_names_the_endpoints
{
    $r = Rig();
    $blog = $r->app->api()->with('Host', 'blog.test');
    $blog->get('/.well-known/oauth-authorization-server')
        ->status(200)
        ->json('$.issuer', 'http://blog.test')
        ->json('$.token_endpoint', 'http://blog.test/oauth/token')
        ->json('$.code_challenge_methods_supported[0]', 'S256');
    $blog->get('/.well-known/oauth-protected-resource/mcp')
        ->json('$.resource', 'http://blog.test/mcp')
        ->json('$.authorization_servers[0]', 'http://blog.test')
        ->json('$.resource_name', 'Tests');
}

test registration_checks_what_a_client_asks_for
{
    $r = Rig();
    expect($r->register())->length(32);

    $r->app->api()->post('/oauth/register', json: '{"redirect_uris":["http://evil.example/cb"]}')
        ->status(400)
        ->json('$.error', 'invalid_redirect_uri');
    $r->app->api()->post('/oauth/register', json: '{"redirect_uris":["https://app.example/cb"],"token_endpoint_auth_method":"client_secret_basic"}')
        ->json('$.error', 'invalid_client_metadata');

    expect(Register::clean("Evil\u{202E}txt.exe"))->is('Eviltxt.exe');
    expect(Register::clean("\n\t"))->is('MCP client');
}

test authorize_hands_the_browser_to_the_consent_page
{
    $r = Rig();
    string $client = $r->register();
    string $query = $r->query($client);
    $r->app->api()->get("/oauth/authorize?{$query}")
        ->status(302)
        ->header('Location', "http://app/consent?{$query}");

    $r->app->api()->get('/oauth/authorize?response_type=code&client_id=nobody')->status(400);
    string $back = $r->app->api()
        ->get('/oauth/authorize', query: ['response_type' => 'code', 'client_id' => $client, 'redirect_uri' => REDIRECT, 'state' => 's9'])
        ->status(302)
        ->header('Location', starts: REDIRECT)
        ->capture(header: 'Location');
    expect(Rig::param($back, 'error'))->is('invalid_request');
    expect(Rig::param($back, 'state'))->is('s9');

    $r->signedIn->get("/oauth/request?{$query}")->json('$.client.name', 'Test client');
    $r->app->api()->get("/oauth/request?{$query}")->status(401);
}

test the_consent_page_keeps_its_own_query_and_origin
{
    $r = Rig(consent: '/consent?step=1');
    string $query = $r->query($r->register());
    $r->app->api()->get("/oauth/authorize?{$query}")->header('Location', "http://app/consent?step=1&{$query}");

    $far = Rig(consent: 'https://app.example.com/approve');
    string $asks = $far->query($far->register());
    $far->app->api()->get("/oauth/authorize?{$asks}")->header('Location', "https://app.example.com/approve?{$asks}");
}

test a_consent_page_or_issuer_that_is_no_url_stops_the_boot
{
    $clock = calendar::ManualClock(time::timestamp::from_unix_secs(START));
    result<TestApp, nexus::BootError> $broken = TestApp::attempt(Rig::extensions($clock, 'consent page'), Rig::vars());
    nexus::BootError $consent = expect($broken)->fails();
    expect($consent->lines()[0])->has("consent: 'consent page' is no URL");
    map<string, string> $relative = Rig::vars();
    $relative['NEXUS_OAUTH_ISSUER'] = '/blog';
    result<TestApp, nexus::BootError> $again = TestApp::attempt(Rig::extensions($clock, '/consent'), $relative);
    nexus::BootError $issuer = expect($again)->fails();
    expect($issuer->lines()[0])->has('NEXUS_OAUTH_ISSUER');
}

test a_denied_request_goes_back_with_access_denied
{
    $r = Rig();
    string $back = $r->approve($r->query($r->register()), false);
    expect(Rig::param($back, 'error'))->is('access_denied');
    expect(Rig::param($back, 'state'))->is('s1');
    expect(Rig::param($back, 'iss'))->is('http://app');
}

test the_code_is_traded_once_with_its_verifier
{
    $r = Rig();
    string $client = $r->register();
    string $back = $r->approve($r->query($client), true);
    string $code = Rig::param($back, 'code');
    expect($code)->length(64);
    expect(Rig::param($back, 'iss'))->is('http://app');

    $r->token([
        'grant_type' => 'authorization_code',
        'client_id' => $client,
        'code' => $code,
        'redirect_uri' => REDIRECT,
        'code_verifier' => 'wrong-verifier-wrong-verifier-wrong-verifier-wrong',
    ])->status(400)->json('$.error', 'invalid_grant');
    // the failed try spent it
    $r->token([
        'grant_type' => 'authorization_code',
        'client_id' => $client,
        'code' => $code,
        'redirect_uri' => REDIRECT,
        'code_verifier' => VERIFIER,
    ])->json('$.error', 'invalid_grant');

    $pair = $r->connect()
        ->status(200)
        ->json('$.token_type', 'Bearer')
        ->json('$.expires_in', 3600)
        ->header('Cache-Control', 'no-store');
    expect($pair->capture('$.access_token'))->starts('nxo_');
    expect($pair->capture('$.refresh_token'))->starts('nxr_');
}

test an_access_token_opens_mcp_and_nothing_else
{
    $r = Rig();
    string $access = $r->connect()->capture('$.access_token');
    $r->who($access)
        ->json('$.result.structuredContent.subject', '7')
        ->json('$.result.structuredContent.via', 'oauth');
    $r->app->api()->bearer($access)->get('/oauth/grants')->status(401);

    $r->clock->advance(.mins(61));
    $r->who($access)->status(401);
}

test refresh_rotates_and_a_reused_token_ends_the_grant
{
    $r = Rig();
    $pair = $r->connect();
    string $client = Rig::param("x?{$r->query($r->register())}", 'client_id');
    string $firstAccess = $pair->capture('$.access_token');
    string $firstRefresh = $pair->capture('$.refresh_token');
    string $holder = $r->signedIn->get('/oauth/grants')->capture('$.items[0].client');
    expect($client)->isNot($holder);

    $r->token(['grant_type' => 'refresh_token', 'client_id' => $client, 'refresh_token' => $firstRefresh])
        ->json('$.error', 'invalid_grant');
    $second = $r->token(['grant_type' => 'refresh_token', 'client_id' => $holder, 'refresh_token' => $firstRefresh])
        ->status(200);
    string $secondAccess = $second->capture('$.access_token');
    string $secondRefresh = $second->capture('$.refresh_token');
    expect($secondRefresh)->isNot($firstRefresh);
    $r->who($firstAccess)->status(401);
    $r->who($secondAccess)->json('$.result.structuredContent.subject', '7');

    // the spent one comes back: someone holds a copy, so the grant ends
    $r->token(['grant_type' => 'refresh_token', 'client_id' => $holder, 'refresh_token' => $firstRefresh])
        ->json('$.error', 'invalid_grant');
    $r->who($secondAccess)->status(401);
    $r->token(['grant_type' => 'refresh_token', 'client_id' => $holder, 'refresh_token' => $secondRefresh])
        ->json('$.error', 'invalid_grant');
}

test revoking_and_disconnecting_end_the_grant
{
    $r = Rig();
    string $access = $r->connect()->capture('$.access_token');
    $r->app->api()->post('/oauth/revoke', form: ['token' => $access])->status(200);
    $r->who($access)->status(401);
    $r->app->api()->post('/oauth/revoke', form: ['token' => 'nonsense'])->status(200);

    string $again = $r->connect()->capture('$.access_token');
    string $grant = $r->signedIn->get('/oauth/grants')
        ->count('$.items', 1)
        ->json('$.items[0].name', 'Test client')
        ->capture('$.items[0].id');
    $r->signedIn->delete("/oauth/grants/{$grant}")->status(204);
    $r->who($again)->status(401);
}

test boot_needs_nexus_auth_first
{
    map<string, string> $vars = ['NEXUS_AUTH_KEY' => KEY];
    array<nexus::Extension> $exts = [nexus::oauth::Extension(), nexus::auth::Extension('test')];
    result<TestApp, nexus::BootError> $r = TestApp::attempt($exts, $vars);
    expect($r)->fails();
}
