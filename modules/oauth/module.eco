/*
 * nexus-oauth: an OAuth 2.1 authorization server for a nexus app's
 * protected resources (nexus-auth's `Resources`: the MCP endpoint, a
 * public API), so a client connects with a URL and a click instead of a
 * pasted token.
 *
 * A client registers itself (RFC 7591) or is registered in code, sends
 * the user to `/oauth/authorize`, which keeps the request and hands the
 * browser to the app's own consent page with `?request=<id>`; that page,
 * signed in as the user, reads `/oauth/requests/{id}` and answers it. The
 * client trades the code for tokens with its PKCE verifier. An access
 * token (`nxo_...`) opens the one resource it was asked for (RFC 8707);
 * refresh tokens (`nxr_...`) are single use, and one that comes back
 * after it was used ends the grant.
 *
 * Clients, requests, codes and grants are kept in memory here;
 * nexus-oauth-carbon keeps them in the app's database.
 */

#[module: "nexus-oauth"]
#[version: "0.1.0"]
#[epm::license: "MIT"]
#[epm::description: "OAuth 2.1 authorization server for the protected resources of nexus apps"]

#[depends: "../.."]
#[depends: "../auth"]
#[depends: "../../../container"]
#[depends: "../../../libjson"]
#[depends: "../../../libcrypto"]
#[depends: "../../../calendar"]

#[hook: before_build { run: "nexus", args: ["gen"] }]

#[sources: "src/*.eco"]
#[if: !NEXUS_NOGEN]
#[sources: ".nexus/*.eco"]
#[end]

#[target: test] {
    #[depends: "../mcp"]
    #[depends: "../testing"]
    #[sources: "tests/*.eco"]
}
