/**
 * Crud on carbon's example blog models and the fake driver, with a hand-written transformer.
 */

use blog::{Post, PostQuery, PostRepository, PostTable, UserRepository, CommentRepository, User, UserTable, Status};
use carbon::fake;
use hydrahon::{Value, Mysql};
use std::time;
use ecotest::expect;

/**
 * Who is asking, handed to the transformer through the crud's context.
 */
internal struct TViewer
{
    public string $name;
}

#[atomic]
internal class TPostTransformer : nexus::rest::Transformer<Post>
{
    public constructor()
    {
    }

    public function name() : string
    {
        return 'post';
    }

    public function availableIncludes() : array<string>
    {
        return ['author'];
    }

    public function defaultIncludes() : array<string>
    {
        array<string> $none = [];
        return $none;
    }

    public function map(const Post& $p, nexus::rest::Item& $item, const nexus::rest::TransformerContext& $ctx) : void
    {
        $item->int('id', $p->id);
        $item->text('title', $p->title);
        if ($item->wants('author') && $p->author->loaded()) {
            User? $u = $p->author->get();
            if ($u != null) {
                $user = guard $u;
                $item->text('author', $user->name);
            }
        }
    }

    public function transform(const Post& $p, nexus::rest::Item& $item, const nexus::rest::TransformerContext& $ctx) : void
    {
        TViewer $viewer = guard $ctx->find<TViewer>() else {
            return;
        };
        $item->text('viewer', $viewer->name);
    }
}

internal type TCrud = nexus::crud::Crud<Post, PostQuery, int64, PostRepository, TPostTransformer>;

internal class Rig
{
    public fake::Driver<Mysql> $fake;
    public carbon::DB $db;
    public PostRepository $posts;
    public TPostTransformer $transformer = TPostTransformer();

    public constructor()
    {
        $this->fake = fake::Driver<Mysql>();
        $this->db = carbon::DB($this->fake, clock: calendar::FixedClock(time::timestamp::from_unix_secs(1700000000)));
        guard $this->db->register<UserRepository>();
        guard $this->db->register<PostRepository>();
        guard $this->db->register<CommentRepository>();
        guard blog::Carbon::check($this->db);
        $posts = guard $this->db->session()->repo<PostRepository>();
        $this->posts = $posts;
    }

    public function crud() : TCrud
    {
        $crud = TCrud($this->posts, $this->transformer);
        $crud->name = 'post';
        $crud->load = function(PostQuery $q, const EchoPack::Rest::Includes& $inc) : PostQuery {
            if ($inc->has('author')) {
                return $q->withAuthor();
            }
            return $q;
        };
        return $crud;
    }
}

internal class Seen
{
    public array<string> $titles = [];
}

internal function payload(const string& $target) : nexus::Payload
{
    $req = nexus::Request(nexus::Method::get, $target);
    $none = container::Builder()->seal();
    return nexus::Payload($request: $req, $services: $none, $mode: nexus::Mode::testing, $log: nexus::Logger([], .info));
}

internal function row(int64 $id, const string& $title) : array<Value>
{
    return PostTable()->row(Post($id: $id, $authorId: 7, $title: $title));
}

internal function listing() : nexus::crud::Listing<PostQuery>
{
    $o = nexus::crud::Listing<PostQuery>();
    $o->orderable('created_at', PostTable::$createdAt);
    $o->orderable('title', PostTable::$title);
    $o->order = '-created_at';
    $o->size = 2;
    $o->ids = function(array<int64> $ids) : hydrahon::Term<bool> {
        return PostTable::$id in $ids;
    };
    return $o;
}

internal function body(result<nexus::Response, nexus::Problem> $r) : string
{
    $res = guard $r else ($p) {
        die("expected a response, got the problem: {$p->detail(nexus::Mode::testing)}");
    };
    return $res->body;
}

test a_page_in_the_default_order
{
    $r = Rig();
    $r->fake->rows([row(2, 'b'), row(1, 'a')]);
    $payload = payload('/posts');
    string $d = body($r->crud()->list($payload, listing()));
    expect($r->fake->last())->has('ORDER BY `posts`.`created_at` DESC LIMIT 2');
    expect($d)->is('{"page":1,"size":2,"data":[{"id":2,"title":"b"},{"id":1,"title":"a"}]}');
}

test order_page_size_ids_and_counts_from_the_query
{
    $r = Rig();
    $r->fake->rows([[Value::from(9)]])->rows([[Value::from(2)]])->rows([row(4, 'd')]);
    $payload = payload('/posts?order=title&page=2&size=1&ids=4,8&count=1');
    string $d = body($r->crud()->list($payload, listing()));
    $sql = $r->fake->texts();
    expect($sql[0])->has('SELECT COUNT(*)')->lacks('IN');
    expect($sql[1])->has('`posts`.`id` IN (?, ?)');
    expect($sql[2])->has('ORDER BY `posts`.`title` ASC LIMIT 1 OFFSET 1');
    expect($d)->is('{"page":2,"size":1,"total_count":9,"filter_count":2,"data":[{"id":4,"title":"d"}]}');
}

test bad_listing_parameters_are_422s
{
    $r = Rig();
    array<string> $bad = ['/posts?order=views', '/posts?size=500', '/posts?page=0', '/posts?ids=1,x'];
    foreach ($bad as const &$target) {
        $payload = payload($target);
        $res = $r->crud()->list($payload, listing());
        $p = expect($res)->fails();
        expect($p->status())->is(422);
    }
    $plain = payload('/posts?ids=1');
    $noIds = nexus::crud::Listing<PostQuery>();
    $refused = $r->crud()->list($plain, $noIds);
    expect($refused->failure()->status())->is(422);
    // nothing ran
    expect($r->fake->count())->is(0);
}

test show_loads_what_the_request_includes
{
    $r = Rig();
    $r->fake->rows([row(5, 'e')])->rows([UserTable()->row(User($id: 7, $email: 'ada@example.com', $name: 'Ada'))]);
    $payload = payload('/posts/5?include=author');
    expect(body($r->crud()->show($payload, 5)))->is('{"data":{"id":5,"title":"e","author":"Ada"}}');
    expect($r->fake->count())->is(2);
    $wrong = payload('/posts/5?include=comments');
    expect($r->crud()->show($wrong, 5)->failure()->status())->is(400);
}

test the_context_reaches_the_transformer
{
    $r = Rig();
    $r->fake->rows([row(5, 'e')]);
    $payload = payload('/posts/5');
    $crud = $r->crud();
    $crud->context->set<TViewer>($name: 'Ada');
    expect(body($crud->show($payload, 5)))->is('{"data":{"id":5,"title":"e","viewer":"Ada"}}');
}

test a_missing_record_is_a_404
{
    $r = Rig();
    $r->fake->rows([]);
    $payload = payload('/posts/9');
    $p = $r->crud()->show($payload, 9)->failure();
    expect($p->status())->is(404);
    expect($p->detail(nexus::Mode::testing))->has('the post');
}

test create_runs_the_hooks_and_answers_the_model
{
    $r = Rig();
    $r->fake->written($insertId: 11);
    $payload = payload('/posts');
    $crud = $r->crud();
    $seen = Seen();
    $crud->after = function[$seen](nexus::crud::Verb $v, const Post& $p) : void {
        $seen->titles[] = $p->title;
    };
    $made = guard $crud->create($payload, Post($authorId: 7, $title: 'fresh'));
    expect($made->status)->is(201);
    expect($made->body)->is('{"data":{"id":11,"title":"fresh"}}');
    expect($seen->titles)->is(['fresh']);
    expect($r->fake->last())->starts('INSERT INTO `posts`');
}

test the_repository_refusing_is_a_409
{
    $r = Rig();
    $payload = payload('/posts');
    $p = $r->crud()->create($payload, Post($authorId: 7, $title: '   '))->failure();
    expect($p->status())->is(409);
    expect($p->detail(nexus::Mode::testing))->has('a post needs a title');
    expect($r->fake->count())->is(0);
}

test update_fills_and_saves
{
    $r = Rig();
    $r->fake->rows([row(3, 'old')])->written();
    $payload = payload('/posts/3');
    string $p = body($r->crud()->update($payload, 3, function(Post& $post) : status<nexus::Problem> {
        $post->title = 'new';
        return .ok;
    }));
    expect($p)->is('{"data":{"id":3,"title":"new"}}');
    expect($r->fake->last())->starts('UPDATE `posts` SET `title` = ?');
}

test authorize_guards_every_record
{
    $r = Rig();
    $r->fake->rows([row(3, 'mine')]);
    $payload = payload('/posts/3');
    $crud = $r->crud();
    $crud->authorize = function(nexus::crud::Verb $v, const Post& $p) : status<nexus::Problem> {
        if ($v->writes()) {
            return .error(.forbidden('read only'));
        }
        return .ok;
    };
    expect($crud->delete($payload, 3)->failure()->status())->is(403);
    // only the read ran
    expect($r->fake->count())->is(1);
}

test delete_is_a_soft_delete_here
{
    $r = Rig();
    $r->fake->rows([row(3, 'gone')])->written();
    $payload = payload('/posts/3');
    guard $r->crud()->delete($payload, 3);
    expect($r->fake->last())->is('UPDATE `posts` SET `updated_at` = ?, `deleted_at` = ? WHERE `posts`.`id` = ?');
}

test find_and_page_hand_back_models
{
    $r = Rig();
    $r->fake->rows([row(5, 'e')])->rows([row(2, 'b'), row(1, 'a')]);
    $payload = payload('/posts/5');
    $p = guard $r->crud()->find($payload, 5);
    expect($p->title)->is('e');
    $l = payload('/posts?page=1');
    $page = guard $r->crud()->page($l, listing());
    expect($page->models)->size(2);
    expect($page->models[1]->title)->is('a');
    expect($page->paged)->yes(says: 'the page is paged');
    expect($page->window->size)->is(2);
    expect($page->counted)->no(says: 'the page was not counted');
}

test a_bad_include_stops_a_create_before_the_write
{
    $r = Rig();
    $payload = payload('/posts?include=secrets');
    expect($r->crud()->create($payload, Post($authorId: 7, $title: 'fresh'))->failure()->status())->is(400);
    expect($r->fake->count())->is(0);
}

test a_create_the_scope_hides_still_answers_with_the_record
{
    $r = Rig();
    // the read back finds nothing: the record is answered as written, not as a 404
    $r->fake->written($insertId: 11)->rows([]);
    $payload = payload('/posts?include=author');
    $crud = $r->crud();
    $crud->scope = function(PostQuery $q) : PostQuery {
        return $q->where(PostTable::$authorId == 1);
    };
    $made = guard $crud->create($payload, Post($authorId: 7, $title: 'fresh'));
    expect($made->status)->is(201);
    expect($made->body)->is('{"data":{"id":11,"title":"fresh"}}');
    // and it was read past the scope
    expect($r->fake->count())->is(2);
    expect($r->fake->last())->starts('SELECT');
    expect($r->fake->last()->find('`author_id` = ?') < $r->fake->last()->size())->no(says: 'the read back is not scoped');
}

test a_create_reads_back_what_the_request_includes
{
    $r = Rig();
    $r->fake->written($insertId: 11)->rows([row(11, 'fresh')])->rows([UserTable()->row(User($id: 7, $email: 'ada@example.com', $name: 'Ada'))]);
    $payload = payload('/posts?include=author');
    $made = guard $r->crud()->create($payload, Post($authorId: 7, $title: 'fresh'));
    expect($made->status)->is(201);
    expect($made->body)->is('{"data":{"id":11,"title":"fresh","author":"Ada"}}');
}

test authorize_sees_an_update_before_and_after_the_fill
{
    $r = Rig();
    $r->fake->rows([row(3, 'mine')]);
    $payload = payload('/posts/3');
    $crud = $r->crud();
    // the request may write the posts of author 7 only
    $crud->authorize = function(nexus::crud::Verb $v, const Post& $p) : status<nexus::Problem> {
        if ($p->authorId != 7) {
            return .error(.forbidden('not yours'));
        }
        return .ok;
    };
    $p = $crud->update($payload, 3, function(Post& $post) : status<nexus::Problem> {
        $post->authorId = 9;
        return .ok;
    })->failure();
    expect($p->status())->is(403);
    // only the read ran
    expect($r->fake->count())->is(1);
}

test an_update_answers_with_the_relations_after_the_change
{
    $r = Rig();
    $r->fake->rows([row(3, 'old')])->rows([UserTable()->row(User($id: 7, $email: 'ada@example.com', $name: 'Ada'))])->written();
    $r->fake->rows([PostTable()->row(Post($id: 3, $authorId: 8, $title: 'old'))])->rows([UserTable()->row(User($id: 8, $email: 'bo@example.com', $name: 'Bo'))]);
    $payload = payload('/posts/3?include=author');
    string $p = body($r->crud()->update($payload, 3, function(Post& $post) : status<nexus::Problem> {
        $post->authorId = 8;
        return .ok;
    }));
    expect($p)->is('{"data":{"id":3,"title":"old","author":"Bo"}}');
}
