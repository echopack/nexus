namespace nexus::realtime;

/**
 * Who a subscribe to a presence channel found there: the socket's own member and every member, for
 * the `subscribed` frame.
 */
public struct Roll
{
    public Present $me;
    public array<Present> $members;

    /**
     * A copy with JSON of its own, like `Present::clone`.
     */
    public const function clone() : Roll
    {
        array<Present> $members = [];
        foreach ($this->members as const &$p) {
            $members[] = $p->clone();
        }
        return Roll($this->me->clone(), mv $members);
    }
}
