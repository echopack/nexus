namespace nexus::realtime;

use std::thread;
use std::time;

/**
 * A server's housekeeping threads, under `serve`: every `recheck`, and at once after the hub's
 * relay lost notes (`Hub::lapse`, an `ended` among them maybe), it asks whether the credentials of
 * its open sockets still hold and closes those whose credential expired (4001); every `beat` it
 * tells the roster it is alive, takes out the members of servers that stopped, telling the
 * channels they left, and puts the roster right about this server's own members.
 */
#[atomic]
public class Sweeper
{
    private Hub $hub;
    public const time::duration $every;
    public const time::duration $beat;
    private atomic<bool> $halt = atomic<bool>(false);

    // the threads; dropping them joins
    private result<thread::handle, thread::error>? $rechecks = null;
    private result<thread::handle, thread::error>? $beats = null;

    public constructor(Hub $hub, time::duration $every, time::duration $beat)
    {
        $this->hub = $hub;
        $this->every = $every;
        $this->beat = $beat;
    }

    public function start(nexus::Kernel $kernel) : void
    {
        if ($this->beats != null) {
            return;
        }
        $this->halt->store(false);
        Sweeper $self = $this;
        $this->beats = thread::spawn(function[$self, $kernel]() : void {
            $self->loopBeat($kernel);
        });
        $this->rechecks = thread::spawn(function[$self, $kernel]() : void {
            $self->loopRecheck($kernel);
        });
    }

    public function stop() : void
    {
        $this->halt->store(true);
        $this->rechecks = null;
        $this->beats = null;
    }

    /**
     * Asks once whether the credential of every signed in socket still holds, on one payload, and
     * closes the sockets of those that do not: how many credentials ended. A guard that cannot
     * answer (its store is down) closes nothing.
     */
    public function recheck(nexus::Kernel $kernel) : usize
    {
        // via and credential of every identity asked about already
        map<string, bool> $asked = [];
        array<nexus::auth::Ending> $ended = [];
        nexus::Payload $payload = $kernel->background('realtime', 'recheck');
        $payload->door = .realtime;
        nexus::auth::Guards $guards = $payload->get<nexus::auth::Guards>();
        foreach ($this->hub->sockets() as const &$s) {
            if ($s->who->anonymous() || $s->who->credential->empty()) {
                continue;
            }
            string $key = "{$s->who->via} {$s->who->credential}";
            if ($asked->has($key)) {
                continue;
            }
            $asked[$key] = true;
            result<bool, nexus::Problem> $holds = $guards->holds($payload, $s->who);
            bool $still = guard $holds else ($p) {
                $kernel->log->warn('realtime recheck could not ask a guard', ['via' => $s->who->via, 'problem' => $p->title()]);
                continue;
            };
            if (!$still) {
                $ended[] = nexus::auth::Ending::credential($s->who->via, $s->who->credential);
            }
        }
        nexus::Kernel::finish($payload);
        foreach ($ended as const &$e) {
            $this->hub->hear(Note::ended($e));
        }
        return $ended->count();
    }

    /**
     * Tells the roster this server is alive, takes out the members of the presence channels
     * followed here whose server stopped beating, and reconciles this server's own members.
     */
    public function pulse(nexus::Kernel $kernel) : void
    {
        Roster $roster = $kernel->services->get<Roster>();
        Gateway $gateway = $kernel->services->get<Gateway>();
        guard $roster->beat($this->hub->node) else ($e) {
            $kernel->log->warn('realtime presence beat failed', ['error' => $e->message()]);
            return;
        };
        foreach ($this->hub->channels() as const &$c) {
            if ($c->present == 0) {
                continue;
            }
            array<string> $stale = guard $roster->prune($c->name) else ($e) {
                $kernel->log->warn('realtime presence prune failed', ['channel' => $c->name, 'error' => $e->message()]);
                continue;
            };
            foreach ($stale as const &$id) {
                $gateway->publish(Note::left($c->name, $id));
            }
        }
        $this->reconcile($kernel, $roster, $gateway);
    }

    /**
     * Puts the roster right about this server's members: one the hub holds and the roster lost (a
     * Redis that restarted, another server that pruned this one while it could not beat) is listed
     * again and the channel hears it joined; one the roster lists for this server and the hub no
     * longer holds (a leave that failed) is taken out and the channel hears it left. The roster is
     * read before the hub, so a member that subscribes meanwhile is never taken for a ghost.
     */
    public function reconcile(nexus::Kernel $kernel, Roster $roster, Gateway $gateway) : void
    {
        map<string, uint64> $owed = $gateway->owed();
        array<string> $names = [];
        foreach ($this->hub->presence() as $name => const &$members) {
            $names[] = $name;
        }
        foreach ($owed as $name => $debt) {
            if (!has($names, $name)) {
                $names[] = $name;
            }
        }
        map<string, array<Present>> $listed = [];
        foreach ($names as const &$name) {
            array<Present> $members = guard $roster->members($name) else ($e) {
                $kernel->log->warn('realtime presence could not read the roster', ['channel' => $name, 'error' => $e->message()]);
                continue;
            };
            $listed[$name] = $members;
        }
        map<string, array<Present>> $held = $this->hub->presence();
        foreach ($listed as $channel => const &$members) {
            array<Present> $mine = [];
            if ($held->has($channel)) {
                $mine = $held->at($channel);
            }
            bool $right = true;
            foreach ($members as const &$m) {
                if (SocketId::node($m->id) != $this->hub->node || Sweeper::lists($mine, $m->id)) {
                    continue;
                }
                guard $roster->leave($channel, $m->id) else ($e) {
                    $kernel->log->warn('realtime presence could not forget a member', ['channel' => $channel, 'error' => $e->message()]);
                    $right = false;
                    continue;
                };
                $gateway->publish(Note::left($channel, $m->id));
            }
            foreach ($mine as const &$p) {
                if (Sweeper::lists($members, $p->id)) {
                    continue;
                }
                guard $roster->join($channel, $p) else ($e) {
                    $kernel->log->warn('realtime presence could not list a member', ['channel' => $channel, 'error' => $e->message()]);
                    $right = false;
                    continue;
                };
                $gateway->publish(Note::joined($channel, $p));
            }
            if ($right && $owed->has($channel)) {
                $gateway->settled($channel, $owed->at($channel));
            }
        }
    }

    internal function loopBeat(nexus::Kernel $kernel) : void
    {
        $this->pulse($kernel);
        time::instant $beaten = time::instant::now();
        while (!$this->halt->load()) {
            thread::sleep(100);
            if ($this->beat > time::duration::zero() && $beaten->elapsed() >= $this->beat) {
                $this->pulse($kernel);
                $beaten = time::instant::now();
            }
        }
    }

    internal function loopRecheck(nexus::Kernel $kernel) : void
    {
        time::instant $checked = time::instant::now();
        uint64 $lapses = $this->hub->lapses();
        while (!$this->halt->load()) {
            thread::sleep(100);
            // an `ended` may have been lost with the notes, whether rechecks are on or not
            bool $lapsed = $this->hub->lapses() != $lapses;
            if ($lapsed || ($this->every > time::duration::zero() && $checked->elapsed() >= $this->every)) {
                $lapses = $this->hub->lapses();
                $this->recheck($kernel);
                $checked = time::instant::now();
            }
        }
    }

    // whether `$all` has the member `$id`
    private static function lists(const array<Present>& $all, const string& $id) : bool
    {
        foreach ($all as const &$p) {
            if ($p->id == $id) {
                return true;
            }
        }
        return false;
    }
}
