namespace nexus;

use std::env;
use std::io;
use std::time;

/**
 * `serve`: boots the app and serves it through its transport until SIGINT or SIGTERM, working the
 * task queues and the schedule unless told not to.
 */
public class ServeCommand : Command
{
    public const function name() : string
    {
        return 'serve';
    }

    public const function summary() : string
    {
        return 'answer requests until stopped';
    }

    public const function help() : string
    {
        return 'Boots the app and serves it through its transport. SIGINT or SIGTERM stops it cleanly: requests in flight get NEXUS_SHUTDOWN_GRACE to finish, and a second signal quits at once.';
    }

    public const function options() : array<CommandOption>
    {
        array<CommandOption> $out = [
            CommandOption(value: 'listen', '<host:port>', 'where to listen', string::from(env::var('NEXUS_LISTEN', EnvList::LISTEN))),
            CommandOption(value: 'workers', '<n>', 'worker threads, 0 for one per core', '0'),
            CommandOption(flag: 'no-work', 'run no task workers in this process'),
            CommandOption(flag: 'no-schedule', 'push no scheduled tasks from this process'),
        ];
        return $out;
    }

    public function run(Invocation& $in) : int32
    {
        $options = Serve();
        string $listen = ServeCommand::listen($in);
        guard $options->listen($listen) else {
            if ($in->stated('listen')) {
                io::eprintln("{$in->program}: --listen wants host:port");
            } else {
                io::eprintln("{$in->program}: NEXUS_LISTEN '{$listen}' is not host:port");
            }
            return 1;
        };
        uint32 $workers = guard ServeCommand::workers($in->value('workers')) else {
            io::eprintln("{$in->program}: --workers wants a number from 0 (one per core) to 2147483647");
            return 1;
        };
        $options->workers = $workers;
        $options->work = !$in->flag('no-work');
        $options->schedule = !$in->flag('no-schedule');
        string $grace = $in->env->get('NEXUS_SHUTDOWN_GRACE') ?? EnvList::SHUTDOWN_GRACE;
        time::duration $span = guard Settings::span($grace) else {
            io::eprintln("{$in->program}: NEXUS_SHUTDOWN_GRACE '{$grace}' is not a duration like 30s or 2m");
            return 1;
        };
        $options->grace = $span;
        // a request never waits on the terminal: the log gets a writer thread unless told otherwise
        if ($in->env->get('NEXUS_LOG_ASYNC') == null) {
            $in->env->set('NEXUS_LOG_ASYNC', EnvList::LOG_ASYNC);
        }
        Kernel $k = guard $in->kernel() else {
            return 1;
        };
        return Console::serve($k, $options, $in->program);
    }

    /**
     * Where `serve` listens: `--listen` when given, else `NEXUS_LISTEN` from the process
     * environment or the env file, else the default.
     */
    public static function listen(const Invocation& $in) : string
    {
        if ($in->stated('listen')) {
            return $in->value('listen');
        }
        return $in->env->get('NEXUS_LISTEN') ?? EnvList::LISTEN;
    }

    /**
     * The worker count `$text` asks for, or null when it is no number or more than a transport
     * takes (an `int32`).
     */
    public static function workers(const string& $text) : uint32?
    {
        uint64 $n = guard str::uint(str::trim($text)) else {
            return null;
        };
        if ($n > 2147483647) {
            return null;
        }
        return $n as uint32;
    }
}
