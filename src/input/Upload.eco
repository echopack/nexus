namespace nexus;

/**
 * A file sent in a `multipart/form-data` body, as an `#[nexus::input]` field:
 *
 * ```echo
 * #[nexus::input]
 * public struct CoverUpload
 * {
 *     #[nexus::rule: { maxBytes: 2097152, types: ['image/png', 'image/jpeg'] }]
 *     public nexus::Upload $image;
 * }
 * ```
 *
 * The file name and the type are what the client said, so neither decides anything on its own:
 * `sniffed()` reads the type from the bytes where it can, and the `types` rule goes by that. Store
 * the bytes under a key the app makes, never under the file name.
 */
public struct Upload
{
    /**
     * The form field it came in.
     */
    public string $field;

    /**
     * The file name the client gave, without any directory and without control characters; empty
     * when it gave none worth keeping.
     */
    public string $filename;

    /**
     * The `Content-Type` the client gave, without parameters, lowercased.
     */
    public string $type;
    public string $bytes;

    /**
     * An upload of `$bytes` from field `$field`, keeping a clean copy of what the client said.
     */
    public constructor(const string& $field, const string& $filename, const string& $type, const string& $bytes)
    {
        $this->field = $field;
        $this->filename = Upload::clean($filename);
        $this->type = Download::mediaType($type);
        $this->bytes = $bytes;
    }

    public const function size() : uint64
    {
        return $this->bytes->size() as uint64;
    }

    /**
     * The type the bytes start like, or null when they start like none `sniff` knows.
     */
    public const function sniffed() : string?
    {
        return Upload::sniff($this->bytes);
    }

    /**
     * The type to keep it as: the sniffed one when there is one, else what the client said.
     */
    public const function kind() : string
    {
        return $this->sniffed() ?? $this->type;
    }

    /**
     * The file name's extension, lowercased and without the dot: `png`; empty for none.
     */
    public const function extension() : string
    {
        return Upload::extension(of: $this->filename);
    }

    /**
     * The extension of the file name `$name`, lowercased and without the dot: `png`; empty for none
     * and for a name that only starts with a dot (`.env`).
     */
    public static function extension(of: const string& $name) : string
    {
        return str::lower(std::fs::path($name)->extension());
    }

    /**
     * The type `$bytes` start like: PNG, JPEG, GIF, WebP, AVIF, PDF, ZIP or gzip; null otherwise.
     */
    public static function sniff(const string& $bytes) : string?
    {
        if ($bytes->size() >= 8 && $bytes->byte(0) == 137 && Upload::opens($bytes, 1, "PNG\r\n\u{1a}\n")) {
            return 'image/png';
        }
        if ($bytes->size() >= 3 && $bytes->byte(0) == 255 && $bytes->byte(1) == 216 && $bytes->byte(2) == 255) {
            return 'image/jpeg';
        }
        if (Upload::opens($bytes, 0, 'GIF87a') || Upload::opens($bytes, 0, 'GIF89a')) {
            return 'image/gif';
        }
        if (Upload::opens($bytes, 0, 'RIFF') && Upload::opens($bytes, 8, 'WEBP')) {
            return 'image/webp';
        }
        if (Upload::opens($bytes, 4, 'ftyp') && (Upload::opens($bytes, 8, 'avif') || Upload::opens($bytes, 8, 'avis'))) {
            return 'image/avif';
        }
        if (Upload::opens($bytes, 0, '%PDF-')) {
            return 'application/pdf';
        }
        if (Upload::opens($bytes, 0, "PK\u{3}\u{4}") || Upload::opens($bytes, 0, "PK\u{5}\u{6}")) {
            return 'application/zip';
        }
        if ($bytes->size() >= 2 && $bytes->byte(0) == 31 && $bytes->byte(1) == 139) {
            return 'application/gzip';
        }
        return null;
    }

    /**
     * Whether `sniff` can tell `$type` from its bytes: the types it answers, and `image/*`, since
     * every image a browser shows inline is among them.
     */
    public static function sniffable(const string& $type) : bool
    {
        string $t = Download::mediaType($type);
        if ($t == 'image/*') {
            return true;
        }
        return $t == 'image/png' || $t == 'image/jpeg' || $t == 'image/gif' || $t == 'image/webp' || $t == 'image/avif'
            || $t == 'application/pdf' || $t == 'application/zip' || $t == 'application/gzip';
    }

    /**
     * The usual extension of a type `sniff` knows, without the dot; empty for others.
     */
    public static function extensionOf(const string& $type) : string
    {
        string $t = Download::mediaType($type);
        if ($t == 'image/png') { return 'png'; }
        if ($t == 'image/jpeg') { return 'jpg'; }
        if ($t == 'image/gif') { return 'gif'; }
        if ($t == 'image/webp') { return 'webp'; }
        if ($t == 'image/avif') { return 'avif'; }
        if ($t == 'application/pdf') { return 'pdf'; }
        if ($t == 'application/zip') { return 'zip'; }
        if ($t == 'application/gzip') { return 'gz'; }
        if ($t == 'text/plain') { return 'txt'; }
        return '';
    }

    // inside -----------------------------------------------------------------

    /**
     * Whether `$bytes` has `$magic` at `$at`.
     */
    internal static function opens(const string& $bytes, usize $at, const string& $magic) : bool
    {
        if ($bytes->size() < $at + $magic->size()) {
            return false;
        }
        usize $i = 0;
        while ($i < $magic->size()) {
            if ($bytes->byte($at + $i) != $magic->byte($i)) {
                return false;
            }
            $i = $i + 1;
        }
        return true;
    }

    /**
     * The last path segment of `$name`, without control characters, trimmed.
     */
    internal static function clean(const string& $name) : string
    {
        usize $from = 0;
        usize $i = 0;
        while ($i < $name->size()) {
            uint8 $c = $name->byte($i);
            if ($c == 47 || $c == 92) {
                $from = $i + 1;
            }
            $i = $i + 1;
        }
        string $out = '';
        $i = $from;
        while ($i < $name->size()) {
            uint8 $c = $name->byte($i);
            if ($c >= 32 && $c != 127) {
                $out->push($c);
            }
            $i = $i + 1;
        }
        string $trimmed = string::from(str::trim($out));
        if ($trimmed == '.' || $trimmed == '..') {
            return '';
        }
        return $trimmed;
    }
}
