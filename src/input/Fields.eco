namespace nexus;

use std::time;

internal const usize FORM_PAIRS = 1000;

/**
 * The fields of one input, read with types by the decoders `nexus gen` writes for `#[nexus::input]`
 * structs. A read that fails (missing, wrong type) is refused through `check`, next to every rule
 * that fails, and `done()` answers with all of them in one 422.
 *
 * The source is a JSON object, an urlencoded form, a multipart form or a query string; reads look
 * the same for all of them. Files come only in a multipart form, read with `upload`/`uploads`.
 * Nested inputs are JSON objects, or bracketed keys in a form: `shipping[city]`, `lines[0][qty]`,
 * `tags[]`.
 */
public class Fields
{
    /**
     * Where refusals go, and where this input sits in the whole one.
     */
    public Check $check;

    private json::Value $doc;
    private bool $json;

    /**
     * The pairs and files of a form, shared with every input nested in it.
     */
    private Form $form;

    /**
     * The bracketed key of this input in the pairs, empty at the top: `lines[0]`.
     */
    private string $base = '';

    /**
     * Fields of a JSON object.
     */
    public constructor(json: json::Value $doc)
    {
        $this->doc = mv $doc;
        $this->form = Form(Query(), []);
        $this->json = true;
        $this->check = Check();
    }

    /**
     * Fields of decoded name/value pairs (a form or a query string), and of a multipart form its
     * files as uploads.
     */
    public constructor(pairs: Query $pairs, files: array<Upload> $files = [])
    {
        $this->doc = json::object();
        $this->form = Form(mv $pairs, mv $files);
        $this->json = false;
        $this->check = Check();
    }

    /**
     * A nested input: the JSON object `$doc`, or the pairs and files of `$form` under `$base`.
     * `$fromJson` is the parent's source; do not infer it from `$base`.
     */
    internal constructor(json: json::Value $doc, form: Form $form, base: const string& $base, check: Check $check, fromJson: bool $fromJson)
    {
        $this->doc = mv $doc;
        $this->form = $form;
        $this->base = $base;
        $this->json = $fromJson;
        $this->check = $check;
    }

    /**
     * The request body as fields: JSON when the content type says so, an urlencoded or multipart
     * form when it says that, and an empty input for an empty body. Anything else is 415; JSON that
     * is not an object and a multipart body that does not parse are 400.
     */
    public static function body(Payload& $payload) : result<Fields, Problem>
    {
        string $type = $payload->request->contentType();
        if ($payload->request->body->empty() && ($type->empty() || $type == 'application/json' || $type->ends('+json'))) {
            return .ok(Fields(json: json::object()));
        }
        if ($type == 'application/json' || $type->ends('+json')) {
            json::Value $doc = guard json::parse($payload->request->body) else ($e) {
                return .error(.badRequest("the body is not valid JSON: {$e->message()}"));
            };
            if (!$doc->isObject()) {
                return .error(.badRequest('the body must be a JSON object'));
            }
            return .ok(Fields(json: mv $doc));
        }
        if ($type == 'application/x-www-form-urlencoded') {
            // a form's fields are looked up by scanning them, so their number is capped like a
            // multipart form's parts
            if (Fields::pieces($payload->request->body) > FORM_PAIRS) {
                return .error(.badRequest('the form has more than 1000 fields'));
            }
            return .ok(Fields(pairs: Query(parse: $payload->request->body)));
        }
        if ($type == 'multipart/form-data') {
            string $header = $payload->request->header('Content-Type') ?? '';
            array<FormPart> $parts = guard Multipart::parse($header, $payload->request->body) else ($p) {
                return .error($p);
            };
            $pairs = Query();
            array<Upload> $files = [];
            foreach ($parts as const &$part) {
                string? $filename = $part->filename;
                if ($filename == null) {
                    $pairs->add($part->name, $part->bytes);
                } else {
                    string $given = guard $filename;
                    if ($given->empty() && $part->bytes->empty()) {
                        // a file input left empty: a browser sends it without a file name or bytes
                        continue;
                    }
                    $files[] = Upload($part->name, $given, $part->type, $part->bytes);
                }
            }
            return .ok(Fields(pairs: mv $pairs, files: mv $files));
        }
        return .error(.unsupportedMedia($type));
    }

    /**
     * Whether the input names `$name` with a non-null value.
     */
    public const function has(const string& $name) : bool
    {
        if ($this->json) {
            json::Value $there = guard $this->doc->get($name) else {
                return false;
            };
            return !$there->isNull();
        }
        string $key = $this->key($name);
        if ($this->form->pairs->has($key)) {
            return true;
        }
        string $open = "{$key}[";
        foreach ($this->form->pairs->pairs as const &$p) {
            if ($p->name->starts($open)) {
                return true;
            }
        }
        foreach ($this->form->files as const &$f) {
            if ($f->field == $key || $f->field->starts($open)) {
                return true;
            }
        }
        return false;
    }

    /**
     * Whether a JSON input gives `$name` as an explicit null, which an optional field with a default
     * takes as null rather than as its default. A form or a query cannot say null.
     */
    public const function nulled(const string& $name) : bool
    {
        if (!$this->json) {
            return false;
        }
        json::Value $there = guard $this->doc->get($name) else {
            return false;
        };
        return $there->isNull();
    }

    /**
     * Ok when nothing was refused, otherwise one `invalid` problem listing every refusal.
     */
    public const function done() : status<Problem>
    {
        return $this->check->done();
    }

    // scalars ----------------------------------------------------------------

    public function string(const string& $name, required: bool $required) : string?
    {
        if (!$this->present($name, $required, 'string')) {
            return null;
        }
        if ($this->json) {
            $v = $this->value($name);
            string? $s = $v->asStr();
            if ($s == null) {
                $this->refuse($name, 'type', 'string');
            }
            return $s;
        }
        return $this->pair($name, 'string');
    }

    public function bool(const string& $name, required: bool $required) : bool?
    {
        if (!$this->present($name, $required, 'boolean')) {
            return null;
        }
        if ($this->json) {
            $v = $this->value($name);
            bool? $b = $v->asBool();
            if ($b == null) {
                $this->refuse($name, 'type', 'boolean');
            }
            return $b;
        }
        string $given = guard $this->pair($name, 'boolean') else {
            return null;
        };
        string $raw = str::lower($given);
        if ($raw == 'true' || $raw == '1' || $raw == 'on' || $raw == 'yes') {
            return true;
        }
        if ($raw == 'false' || $raw == '0' || $raw == 'off' || $raw == 'no' || $raw == '') {
            return false;
        }
        $this->refuse($name, 'type', 'boolean');
        return null;
    }

    public function int64(const string& $name, required: bool $required) : int64?
    {
        if (!$this->filled($name, $required, 'integer')) {
            return null;
        }
        int64? $n = null;
        if ($this->json) {
            $v = $this->value($name);
            $n = $v->asInt();
        } else {
            $n = str::int($this->form->pairs->get($this->key($name)) ?? '');
        }
        if ($n == null) {
            $this->refuse($name, 'type', 'integer');
        }
        return $n;
    }

    public function int32(const string& $name, required: bool $required) : int32?
    {
        int64 $n = guard $this->int64($name, required: $required) else {
            return null;
        };
        if ($n < (int32::min() as int64) || $n > (int32::max() as int64)) {
            $this->refuse($name, 'range', 'integer');
            return null;
        }
        return $n as int32;
    }

    public function uint64(const string& $name, required: bool $required) : uint64?
    {
        // a form value reads as unsigned, so the top half of the range is not lost to int64
        if (!$this->json) {
            if (!$this->filled($name, $required, 'integer')) {
                return null;
            }
            uint64? $u = str::uint($this->form->pairs->get($this->key($name)) ?? '');
            if ($u == null) {
                $this->refuse($name, 'type', 'integer');
            }
            return $u;
        }
        int64 $n = guard $this->int64($name, required: $required) else {
            return null;
        };
        if ($n < 0) {
            $this->refuse($name, 'range', 'integer');
            return null;
        }
        return $n as uint64;
    }

    public function uint32(const string& $name, required: bool $required) : uint32?
    {
        int64 $n = guard $this->int64($name, required: $required) else {
            return null;
        };
        if ($n < 0 || $n > (uint32::max() as int64)) {
            $this->refuse($name, 'range', 'integer');
            return null;
        }
        return $n as uint32;
    }

    public function uint16(const string& $name, required: bool $required) : uint16?
    {
        int64 $n = guard $this->int64($name, required: $required) else {
            return null;
        };
        if ($n < 0 || $n > (uint16::max() as int64)) {
            $this->refuse($name, 'range', 'integer');
            return null;
        }
        return $n as uint16;
    }

    /**
     * A number. NaN and the infinities are refused as no number, however they are spelled (`nan`,
     * `inf`, `1e999`): every rule would let NaN through.
     */
    public function float64(const string& $name, required: bool $required) : float64?
    {
        if (!$this->filled($name, $required, 'number')) {
            return null;
        }
        float64? $n = null;
        if ($this->json) {
            $v = $this->value($name);
            $n = $v->asFloat();
        } else {
            $n = str::float($this->form->pairs->get($this->key($name)) ?? '');
        }
        float64 $got = guard $n else {
            $this->refuse($name, 'type', 'number');
            return null;
        };
        if (!Check::finite($got)) {
            $this->refuse($name, 'type', 'number');
            return null;
        }
        return $got;
    }

    /**
     * An ISO 8601 calendar date, `2026-10-28`.
     */
    public function date(const string& $name, required: bool $required) : calendar::Date?
    {
        string $text = guard $this->text($name, $required, 'date') else {
            return null;
        };
        calendar::Date $d = guard calendar::Date::parse($text) else {
            $this->refuse($name, 'type', 'date');
            return null;
        };
        return $d;
    }

    /**
     * An instant in RFC 3339, `2026-10-28T09:30:00Z` or with an offset.
     */
    public function timestamp(const string& $name, required: bool $required) : time::timestamp?
    {
        string $text = guard $this->text($name, $required, 'timestamp') else {
            return null;
        };
        calendar::Zoned $z = guard calendar::Zoned::parse($text) else {
            $this->refuse($name, 'type', 'timestamp');
            return null;
        };
        return $z->instant;
    }

    /**
     * The raw JSON value of a field, for types the decoders do not know.
     */
    public function json(const string& $name, required: bool $required) : json::Value?
    {
        if (!$this->present($name, $required, 'json')) {
            return null;
        }
        if ($this->json) {
            return $this->value($name);
        }
        string $s = guard $this->pair($name, 'json') else {
            return null;
        };
        return json::str($s);
    }

    // lists ------------------------------------------------------------------

    /**
     * A list of strings: a JSON array, or every value of a repeated form field (`tag=a&tag=b`,
     * `tag[]=a`, `tag[0]=a`).
     */
    public function strings(const string& $name, required: bool $required) : array<string>?
    {
        if (!$this->present($name, $required, 'list')) {
            return null;
        }
        if (!$this->json) {
            return $this->listed($name);
        }
        $v = $this->value($name);
        array<json::Value> $items = guard $v->asArray() else {
            $this->refuse($name, 'type', 'list');
            return null;
        };
        array<string> $out = [];
        foreach ($items as const &$item) {
            string $s = guard $item->asStr() else {
                $this->refuse($name, 'type', 'list');
                return null;
            };
            $out[] = $s;
        }
        return $out;
    }

    /**
     * A list of whole numbers.
     */
    public function ints(const string& $name, required: bool $required) : array<int64>?
    {
        if (!$this->present($name, $required, 'list')) {
            return null;
        }
        array<int64> $out = [];
        if (!$this->json) {
            array<string> $all = guard $this->listed($name) else {
                return null;
            };
            foreach ($all as const &$raw) {
                int64 $n = guard str::int($raw) else {
                    $this->refuse($name, 'type', 'list');
                    return null;
                };
                $out[] = $n;
            }
            return $out;
        }
        $v = $this->value($name);
        array<json::Value> $items = guard $v->asArray() else {
            $this->refuse($name, 'type', 'list');
            return null;
        };
        foreach ($items as const &$item) {
            int64 $n = guard $item->asInt() else {
                $this->refuse($name, 'type', 'list');
                return null;
            };
            $out[] = $n;
        }
        return $out;
    }

    // files ------------------------------------------------------------------

    /**
     * The file sent as `$name` in a multipart form. Anything else under the name (text, a JSON
     * value) is refused as not a file.
     */
    public function upload(const string& $name, required: bool $required) : Upload?
    {
        if (!$this->present($name, $required, 'file')) {
            return null;
        }
        string $key = $this->key($name);
        foreach ($this->form->files as const &$f) {
            if ($f->field == $key) {
                return $f;
            }
        }
        $this->refuse($name, 'type', 'file');
        return null;
    }

    /**
     * Every file sent as `$name`, `$name[]` or `$name[0]`, ... in the order they came.
     */
    public function uploads(const string& $name, required: bool $required) : array<Upload>?
    {
        if (!$this->present($name, $required, 'list')) {
            return null;
        }
        string $key = $this->key($name);
        string $open = "{$key}[";
        array<Upload> $out = [];
        foreach ($this->form->files as const &$f) {
            if ($f->field == $key || $f->field == "{$key}[]" || Fields::indexed($f->field, $open)) {
                $out[] = $f;
            }
        }
        if ($out->empty()) {
            $this->refuse($name, 'type', 'file');
            return null;
        }
        return $out;
    }

    // nested inputs ----------------------------------------------------------

    /**
     * The nested input `$name`: a JSON object, or the form keys `name[...]`. Its refusals land
     * under `name.`.
     */
    public function object(const string& $name, required: bool $required) : Fields?
    {
        if (!$this->present($name, $required, 'object')) {
            return null;
        }
        $inner = $this->check->child($name);
        if (!$this->json) {
            return Fields(json: json::nil(), form: $this->form, base: $this->key($name), check: $inner, fromJson: false);
        }
        $v = $this->value($name);
        if (!$v->isObject()) {
            $this->refuse($name, 'type', 'object');
            return null;
        }
        return Fields(json: $v, form: $this->form, base: '', check: $inner, fromJson: true);
    }

    /**
     * The list of nested inputs `$name`: a JSON array of objects, or the form keys `name[0][...]`,
     * `name[1][...]` in index order. Each one's refusals land under `name.<i>.`.
     */
    public function objects(const string& $name, required: bool $required) : array<Fields>?
    {
        if (!$this->present($name, $required, 'list')) {
            return null;
        }
        array<Fields> $out = [];
        if (!$this->json) {
            string $key = $this->key($name);
            foreach ($this->indices($key) as const &$i) {
                $inner = $this->check->child("{$name}.{$i}");
                $out[] = Fields(json: json::nil(), form: $this->form, base: "{$key}[{$i}]", check: $inner, fromJson: false);
            }
            return $out;
        }
        $v = $this->value($name);
        array<json::Value> $items = guard $v->asArray() else {
            $this->refuse($name, 'type', 'list');
            return null;
        };
        int64 $i = 0;
        foreach ($items as const &$item) {
            if (!$item->isObject()) {
                $this->refuse("{$name}.{$i}", 'type', 'object');
                return null;
            }
            $inner = $this->check->child("{$name}.{$i}");
            $out[] = Fields(json: $item->clone(), form: $this->form, base: '', check: $inner, fromJson: true);
            $i = $i + 1;
        }
        return $out;
    }

    // inside -----------------------------------------------------------------

    /**
     * Whether `$field` is `$open` followed by a number and `]`: `photos[3]`.
     */
    internal static function indexed(const string& $field, const string& $open) : bool
    {
        return Fields::index($field, $open) != null && $field->find(']', $open->size()) == $field->size() - 1;
    }

    private function refuse(const string& $name, const string& $code, const string& $kind) : void
    {
        $none = ordered_map<string, string>();
        $this->check->refuse($name, $code, $kind, $none);
    }

    private function present(const string& $name, bool $required, const string& $kind) : bool
    {
        if ($this->has($name)) {
            return true;
        }
        if ($required) {
            $this->refuse($name, 'required', $kind);
        }
        return false;
    }

    /**
     * Like `present`, for a field read as a number, a date or a timestamp: a form or query value left
     * blank (`age=`, what an empty input sends) counts as missing, so an optional field is null or
     * its default, and a required one is refused as required rather than as the wrong type.
     */
    private function filled(const string& $name, bool $required, const string& $kind) : bool
    {
        if (!$this->json) {
            string? $given = $this->form->pairs->get($this->key($name));
            if ($given != null) {
                string $raw = guard $given;
                if ($raw->empty()) {
                    if ($required) {
                        $this->refuse($name, 'required', $kind);
                    }
                    return false;
                }
            }
        }
        return $this->present($name, $required, $kind);
    }

    /**
     * A field read as text, for the readers that parse it.
     */
    private function text(const string& $name, bool $required, const string& $kind) : string?
    {
        if (!$this->filled($name, $required, $kind)) {
            return null;
        }
        if (!$this->json) {
            return $this->pair($name, $kind);
        }
        $v = $this->value($name);
        string? $s = $v->asStr();
        if ($s == null) {
            $this->refuse($name, 'type', $kind);
        }
        return $s;
    }

    /**
     * The text of form field `$name`. A name that holds only files or nested keys is refused as not
     * `$kind`.
     */
    private function pair(const string& $name, const string& $kind) : string?
    {
        string? $s = $this->form->pairs->get($this->key($name));
        if ($s == null) {
            $this->refuse($name, 'type', $kind);
        }
        return $s;
    }

    /**
     * The values of repeated form field `$name`. A name that holds only files or nested keys is
     * refused as not a list.
     */
    private function listed(const string& $name) : array<string>?
    {
        array<string> $all = $this->repeated($name);
        if ($all->empty()) {
            $this->refuse($name, 'type', 'list');
            return null;
        }
        return $all;
    }

    private const function value(const string& $name) : json::Value
    {
        json::Value $there = guard $this->doc->get($name) else {
            return json::nil();
        };
        return $there;
    }

    /**
     * The pair key of field `$name`: itself at the top, `base[name]` inside a nested input.
     */
    private const function key(const string& $name) : string
    {
        if ($this->base->empty()) {
            return $name;
        }
        return "{$this->base}[{$name}]";
    }

    /**
     * Every value of a repeated pair: `key`, `key[]`, then `key[0]`, `key[1]`, ... in index order.
     */
    private const function repeated(const string& $name) : array<string>
    {
        string $key = $this->key($name);
        $out = $this->form->pairs->all($key);
        foreach ($this->form->pairs->all("{$key}[]") as const &$v) {
            $out[] = $v;
        }
        foreach ($this->indices($key) as const &$i) {
            string? $one = $this->form->pairs->get("{$key}[{$i}]");
            if ($one != null) {
                string $v = guard $one;
                $out[] = mv $v;
            }
        }
        return $out;
    }

    /**
     * The numeric indices used under `key[` by text and file fields alike, ascending, each once.
     */
    private const function indices(const string& $key) : array<int64>
    {
        string $open = "{$key}[";
        array<int64> $found = [];
        foreach ($this->form->pairs->pairs as const &$p) {
            int64 $i = guard Fields::index($p->name, $open) else {
                continue;
            };
            $found[] = $i;
        }
        foreach ($this->form->files as const &$f) {
            int64 $i = guard Fields::index($f->field, $open) else {
                continue;
            };
            $found[] = $i;
        }
        $found->sort();
        array<int64> $out = [];
        foreach ($found as $i) {
            if ($out->empty() || $out[$out->count() - 1] != $i) {
                $out[] = $i;
            }
        }
        return $out;
    }

    /**
     * The index `$name` has right after `$open`: `lines[3][qty]` under `lines[` is 3. Null when
     * there is none.
     */
    private static function index(const string& $name, const string& $open) : int64?
    {
        if (!$name->starts($open)) {
            return null;
        }
        usize $from = $open->size();
        usize $close = $name->find(']', $from);
        if ($close >= $name->size() || $close == $from) {
            return null;
        }
        int64 $i = guard str::int($name->sub($from, $close - $from)) else {
            return null;
        };
        if ($i < 0) {
            return null;
        }
        return $i;
    }

    // how many `&` separated pieces `$body` has, empty ones included
    internal static function pieces(const string& $body) : usize
    {
        usize $n = 1;
        usize $i = 0;
        while ($i < $body->size()) {
            if ($body->byte($i) == 38) {
                $n = $n + 1;
            }
            $i = $i + 1;
        }
        return $n;
    }
}

/**
 * The pairs and files of one form, read by its fields and every input nested in them without a
 * copy.
 */
internal class Form
{
    internal Query $pairs;

    /**
     * The files of a multipart form, keyed by their field as sent: `cover`, `photos[]`.
     */
    internal array<Upload> $files;

    internal constructor(Query $pairs, array<Upload> $files)
    {
        $this->pairs = mv $pairs;
        $this->files = mv $files;
    }
}
