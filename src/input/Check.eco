namespace nexus;

use std::time;

/**
 * Where an input's rules write what they refuse. The decoders `nexus gen` writes point it at a
 * field (`at`) and call a rule method per rule; a rule class (`nexus::Rule<T>`) gets it to refuse
 * in its own words. Every nested input gets its own `Check` over the same list of refusals, so one
 * 422 answers for the whole request.
 *
 * ```echo
 * public function check(const string& $email, nexus::Check $v) : void
 * {
 *     if ($this->users->taken($email)) {
 *         $v->fail('unique', 'The {label} has already been taken.');
 *     }
 * }
 * ```
 */
public class Check
{
    /**
     * The input type being checked, `blog::NewPost`.
     */
    public string $input = '';

    /**
     * Where this input sits in the whole one: empty at the top, `posts.1` for the second of a list.
     */
    public string $prefix = '';

    /**
     * The field the next rule checks, its kind and its English label.
     */
    public string $name = '';
    public string $kind = '';
    public string $label = '';

    /**
     * The path of the field the next rule checks, when it differs from `name`: `tags.2` for one
     * item of a list.
     */
    private string $at = '';
    private Refusals $sink;

    public constructor()
    {
        $this->sink = Refusals();
    }

    /**
     * A check over `$sink`, at `$prefix`.
     */
    public constructor(sink: Refusals $sink, prefix: const string& $prefix)
    {
        $this->sink = $sink;
        $this->prefix = $prefix;
    }

    /**
     * The check of a nested input at `$path` below this one, writing into the same refusals.
     */
    public const function child(const string& $path) : Check
    {
        return Check(sink: $this->sink, prefix: $this->join($path));
    }

    /**
     * Points the next rules at field `$name`.
     */
    public function at(const string& $name, const string& $kind, const string& $label) : void
    {
        $this->name = $name;
        $this->kind = $kind;
        $this->label = $label;
        $this->at = '';
    }

    /**
     * Points the next rules at item `$index` of the list field `$name`.
     */
    public function item(const string& $name, usize $index, const string& $kind) : void
    {
        $this->name = $name;
        $this->kind = $kind;
        int64 $i = $index as int64;
        $this->at = "{$name}.{$i}";
    }

    /**
     * How many refusals there are so far, across the whole input.
     */
    public const function count() : usize
    {
        return $this->sink->errors->count();
    }

    /**
     * Every refusal so far.
     */
    public const function errors() : array<FieldError>
    {
        return $this->sink->errors;
    }

    /**
     * Ok when nothing was refused, otherwise one `invalid` problem listing every refusal.
     */
    public const function done() : status<Problem>
    {
        if ($this->sink->errors->empty()) {
            return .ok;
        }
        return .error(.invalid($this->sink->errors));
    }

    // refusing ---------------------------------------------------------------

    /**
     * Refuses the current field with `$code`. `$message` may name `{label}` and any of `$params`.
     */
    public function fail(const string& $code, const string& $message) : void
    {
        $none = ordered_map<string, string>();
        $this->current($code, $message, $none);
    }

    public function fail(const string& $code, const string& $message, params: const map<string, string>& $params) : void
    {
        $this->current($code, $message, Check::ordered($params));
    }

    /**
     * Refuses field `$field` of this input, for a rule on the whole input that blames one field:
     * `$v->fail(field: 'ends', 'after', '...')`.
     */
    public function fail(field: const string& $field, const string& $code, const string& $message) : void
    {
        $none = ordered_map<string, string>();
        $this->add($this->join($field), $field, $code, '', '', $message, $none);
    }

    public function fail(field: const string& $field, const string& $code, const string& $message, params: const map<string, string>& $params) : void
    {
        $this->add($this->join($field), $field, $code, '', '', $message, Check::ordered($params));
    }

    /**
     * Refuses field `$name` with a built-in rule's English message, for the readers of `Fields`.
     */
    public function refuse(const string& $name, const string& $code, const string& $kind, const ordered_map<string, string>& $params) : void
    {
        string $label = '';
        string $path = $this->join($name);
        if ($name == $this->name) {
            $label = $this->label;
            if (!$this->at->empty()) {
                $path = $this->join($this->at);
            }
        }
        $this->add($path, $name, $code, $kind, $label, Check::english($code, $kind), $params);
    }

    /**
     * Refuses the current field with a built-in rule.
     */
    public function rule(const string& $code, const ordered_map<string, string>& $params) : void
    {
        string $kind = $this->kind;
        $this->current($code, Check::english($code, $kind), $params);
    }

    public function rule(const string& $code) : void
    {
        $none = ordered_map<string, string>();
        $this->rule($code, $none);
    }

    // strings ----------------------------------------------------------------

    public function minLength(const string& $value, int64 $min) : void
    {
        if (($value->count() as int64) < $min) {
            $this->rule('min', Check::one('min', str::from($min)));
        }
    }

    public function maxLength(const string& $value, int64 $max) : void
    {
        if (($value->count() as int64) > $max) {
            $this->rule('max', Check::one('max', str::from($max)));
        }
    }

    public function betweenLength(const string& $value, int64 $min, int64 $max) : void
    {
        int64 $n = $value->count() as int64;
        if ($n < $min || $n > $max) {
            $this->rule('between', Check::two('min', str::from($min), 'max', str::from($max)));
        }
    }

    public function sizeLength(const string& $value, int64 $size) : void
    {
        if (($value->count() as int64) != $size) {
            $this->rule('size', Check::one('size', str::from($size)));
        }
    }

    public function notBlank(const string& $value) : void
    {
        if (str::trim($value)->empty()) {
            $this->rule('notBlank');
        }
    }

    /**
     * A plausible mail address: one `@`, something before it, a dot in the domain after it, no
     * spaces.
     */
    public function email(const string& $value) : void
    {
        usize $at = $value->find('@');
        bool $ok = $at > 0 && $at < $value->size() && !$value->contains(' ');
        if ($ok) {
            string $domain = $value->sub($at + 1, $value->size() - $at - 1);
            $ok = $domain->contains('.') && !$domain->contains('@') && !$domain->starts('.') && !$domain->ends('.');
        }
        if (!$ok) {
            $this->rule('email');
        }
    }

    /**
     * An absolute `http` or `https` URL with a host and no spaces.
     */
    public function url(const string& $value) : void
    {
        string $rest = '';
        if ($value->starts('https://')) {
            $rest = $value->sub(8, $value->size() - 8);
        } else if ($value->starts('http://')) {
            $rest = $value->sub(7, $value->size() - 7);
        }
        bool $ok = !$rest->empty() && !$value->contains(' ') && !$rest->starts('/') && !$rest->starts('?') && !$rest->starts('#');
        if (!$ok) {
            $this->rule('url');
        }
    }

    /**
     * A UUID in its 8-4-4-4-12 hex form, any case.
     */
    public function uuid(const string& $value) : void
    {
        if (!Constraint::isUuid($value)) {
            $this->rule('uuid');
        }
    }

    /**
     * Letters only. Any letter beyond ASCII counts.
     */
    public function alpha(const string& $value) : void
    {
        if (!Check::only($value, false, false)) {
            $this->rule('alpha');
        }
    }

    /**
     * Letters and digits only.
     */
    public function alphaNum(const string& $value) : void
    {
        if (!Check::only($value, true, false)) {
            $this->rule('alphaNum');
        }
    }

    /**
     * Letters, digits, `-` and `_` only.
     */
    public function alphaDash(const string& $value) : void
    {
        if (!Check::only($value, true, true)) {
            $this->rule('alphaDash');
        }
    }

    public function ascii(const string& $value) : void
    {
        usize $i = 0;
        while ($i < $value->size()) {
            if ($value->byte($i) > 127) {
                $this->rule('ascii');
                return;
            }
            $i = $i + 1;
        }
    }

    /**
     * Digits `0` to `9` only, at least one.
     */
    public function digits(const string& $value) : void
    {
        bool $ok = !$value->empty();
        usize $i = 0;
        while ($ok && $i < $value->size()) {
            uint8 $b = $value->byte($i);
            $ok = $b >= 48 && $b <= 57;
            $i = $i + 1;
        }
        if (!$ok) {
            $this->rule('digits');
        }
    }

    public function startsWith(const string& $value, const array<string>& $prefixes) : void
    {
        foreach ($prefixes as const &$p) {
            if ($value->starts($p)) {
                return;
            }
        }
        $this->rule('startsWith', Check::one('values', str::join($prefixes, ', ')));
    }

    public function endsWith(const string& $value, const array<string>& $suffixes) : void
    {
        foreach ($suffixes as const &$s) {
            if ($value->ends($s)) {
                return;
            }
        }
        $this->rule('endsWith', Check::one('values', str::join($suffixes, ', ')));
    }

    public function oneOf(const string& $value, const array<string>& $allowed) : void
    {
        foreach ($allowed as const &$a) {
            if ($a == $value) {
                return;
            }
        }
        $this->rule('oneOf', Check::one('values', str::join($allowed, ', ')));
    }

    public function noneOf(const string& $value, const array<string>& $refused) : void
    {
        foreach ($refused as const &$r) {
            if ($r == $value) {
                $this->rule('noneOf', Check::one('values', str::join($refused, ', ')));
                return;
            }
        }
    }

    // numbers ----------------------------------------------------------------

    public function min(int64 $value, int64 $min) : void
    {
        if ($value < $min) {
            $this->rule('min', Check::one('min', str::from($min)));
        }
    }

    public function max(int64 $value, int64 $max) : void
    {
        if ($value > $max) {
            $this->rule('max', Check::one('max', str::from($max)));
        }
    }

    public function between(int64 $value, int64 $min, int64 $max) : void
    {
        if ($value < $min || $value > $max) {
            $this->rule('between', Check::two('min', str::from($min), 'max', str::from($max)));
        }
    }

    public function min(float64 $value, float64 $min) : void
    {
        if ($value < $min) {
            $this->rule('min', Check::one('min', str::from($min)));
        }
    }

    public function max(float64 $value, float64 $max) : void
    {
        if ($value > $max) {
            $this->rule('max', Check::one('max', str::from($max)));
        }
    }

    public function between(float64 $value, float64 $min, float64 $max) : void
    {
        if ($value < $min || $value > $max) {
            $this->rule('between', Check::two('min', str::from($min), 'max', str::from($max)));
        }
    }

    public function multipleOf(int64 $value, int64 $of) : void
    {
        if ($of != 0 && $value % $of != 0) {
            $this->rule('multipleOf', Check::one('value', str::from($of)));
        }
    }

    public function multipleOf(float64 $value, float64 $of) : void
    {
        if ($of == 0.0) {
            return;
        }
        float64 $times = $value / $of;
        float64 $whole = std::math::round($times);
        if (std::math::abs($times - $whole) > 0.000000001) {
            $this->rule('multipleOf', Check::one('value', str::from($of)));
        }
    }

    public function oneOf(int64 $value, const array<int64>& $allowed) : void
    {
        array<string> $shown = [];
        foreach ($allowed as const &$a) {
            if ($a == $value) {
                return;
            }
            $shown[] = str::from($a);
        }
        $this->rule('oneOf', Check::one('values', str::join($shown, ', ')));
    }

    public function noneOf(int64 $value, const array<int64>& $refused) : void
    {
        array<string> $shown = [];
        bool $hit = false;
        foreach ($refused as const &$r) {
            if ($r == $value) {
                $hit = true;
            }
            $shown[] = str::from($r);
        }
        if ($hit) {
            $this->rule('noneOf', Check::one('values', str::join($shown, ', ')));
        }
    }

    /**
     * `gt`, `gte`, `lt` or `lte` against `$than`; `$shown` is what the message names (a number, or
     * the other field's value).
     */
    public function compare(const string& $code, float64 $value, float64 $than, const string& $shown) : void
    {
        bool $ok = true;
        if ($code == 'gt') {
            $ok = $value > $than;
        } else if ($code == 'gte') {
            $ok = $value >= $than;
        } else if ($code == 'lt') {
            $ok = $value < $than;
        } else if ($code == 'lte') {
            $ok = $value <= $than;
        }
        if (!$ok) {
            $this->rule($code, Check::one('value', $shown));
        }
    }

    // booleans ---------------------------------------------------------------

    /**
     * Must be true: a box ticked to accept terms.
     */
    public function accepted(bool $value) : void
    {
        if (!$value) {
            $this->rule('accepted');
        }
    }

    public function declined(bool $value) : void
    {
        if ($value) {
            $this->rule('declined');
        }
    }

    // dates ------------------------------------------------------------------

    /**
     * `after`, `before`, `afterOrEqual` or `beforeOrEqual` against `$other`; `$shown` is what the
     * message names.
     */
    public function date(const string& $code, const calendar::Date& $value, const calendar::Date& $other, const string& $shown) : void
    {
        bool $ok = Check::order($code, $value < $other, $value == $other);
        if (!$ok) {
            $this->rule($code, Check::one('date', $shown));
        }
    }

    public function date(const string& $code, time::timestamp $value, time::timestamp $other, const string& $shown) : void
    {
        bool $ok = Check::order($code, $value < $other, $value == $other);
        if (!$ok) {
            $this->rule($code, Check::one('date', $shown));
        }
    }

    /**
     * Today in UTC, for `after: 'today'`.
     */
    public static function today() : calendar::Date
    {
        return calendar::Zoned::now(calendar::Zone::utc())->date;
    }

    public static function now() : time::timestamp
    {
        return calendar::SystemClock()->now();
    }

    // files ------------------------------------------------------------------

    public function maxBytes(const Upload& $file, int64 $max) : void
    {
        if (($file->size() as int64) > $max) {
            $this->rule('maxBytes', Check::two('max', str::from($max), 'shown', Check::bytes($max)));
        }
    }

    public function minBytes(const Upload& $file, int64 $min) : void
    {
        if (($file->size() as int64) < $min) {
            $this->rule('minBytes', Check::two('min', str::from($min), 'shown', Check::bytes($min)));
        }
    }

    /**
     * The file is one of `$types` (`image/png`, or `image/*` for any image). A type whose bytes
     * `Upload::sniff` knows (images, PDF, ZIP, gzip) has to be what the bytes show, so HTML sent as
     * `image/png` is refused; any other type (`text/csv`) goes by what the client said.
     */
    public function types(const Upload& $file, const array<string>& $types) : void
    {
        string? $sniffed = $file->sniffed();
        foreach ($types as const &$t) {
            string $kind = $file->type;
            if (Upload::sniffable($t)) {
                $kind = $sniffed ?? '';
            }
            if ($t == $kind) {
                return;
            }
            if ($t->ends('/*') && !$kind->empty() && $kind->starts($t->sub(0, $t->size() - 1))) {
                return;
            }
        }
        $this->rule('types', Check::one('values', str::join($types, ', ')));
    }

    /**
     * The file's name ends in one of `$extensions`, written without the dot.
     */
    public function extensions(const Upload& $file, const array<string>& $extensions) : void
    {
        string $mine = $file->extension();
        foreach ($extensions as const &$e) {
            if (str::lower($e) == $mine) {
                return;
            }
        }
        $this->rule('extensions', Check::one('values', str::join($extensions, ', ')));
    }

    /**
     * `$n` bytes as people read them: `512 bytes`, `2 KB`, `1.5 MB`.
     */
    public static function bytes(int64 $n) : string
    {
        if ($n < 1024) {
            return "{$n} bytes";
        }
        float64 $v = ($n as float64) / 1024.0;
        string $unit = 'KB';
        if ($v >= 1024.0) {
            $v = $v / 1024.0;
            $unit = 'MB';
        }
        if ($v >= 1024.0) {
            $v = $v / 1024.0;
            $unit = 'GB';
        }
        float64 $whole = (($v as int64) as float64);
        if ($v - $whole < 0.05) {
            int64 $w = $v as int64;
            return "{$w} {$unit}";
        }
        return "{$v:.1f} {$unit}";
    }

    // lists ------------------------------------------------------------------

    public function minCount(usize $count, int64 $min) : void
    {
        if (($count as int64) < $min) {
            $this->rule('min', Check::one('min', str::from($min)));
        }
    }

    public function maxCount(usize $count, int64 $max) : void
    {
        if (($count as int64) > $max) {
            $this->rule('max', Check::one('max', str::from($max)));
        }
    }

    public function betweenCount(usize $count, int64 $min, int64 $max) : void
    {
        int64 $n = $count as int64;
        if ($n < $min || $n > $max) {
            $this->rule('between', Check::two('min', str::from($min), 'max', str::from($max)));
        }
    }

    public function sizeCount(usize $count, int64 $size) : void
    {
        if (($count as int64) != $size) {
            $this->rule('size', Check::one('size', str::from($size)));
        }
    }

    public function distinct(const array<string>& $values) : void
    {
        map<string, bool> $seen = [];
        foreach ($values as const &$v) {
            if ($seen->has($v)) {
                $this->rule('distinct');
                return;
            }
            $seen[$v] = true;
        }
    }

    public function distinct(const array<int64>& $values) : void
    {
        map<int64, bool> $seen = [];
        foreach ($values as const &$v) {
            if ($seen->has($v)) {
                $this->rule('distinct');
                return;
            }
            $seen[$v] = true;
        }
    }

    // more than one field ----------------------------------------------------

    /**
     * `{name}Confirmation` must hold the same: `$same` says whether it does.
     */
    public function confirmed(bool $same) : void
    {
        if (!$same) {
            $this->rule('confirmed');
        }
    }

    public function same(bool $same, const string& $other) : void
    {
        if (!$same) {
            $this->rule('same', Check::one('other', $other));
        }
    }

    public function different(bool $differs, const string& $other) : void
    {
        if (!$differs) {
            $this->rule('different', Check::one('other', $other));
        }
    }

    /**
     * Required when `$other` is in the input: `$given` says whether this field is, `$otherGiven`
     * whether the other one is.
     */
    public function requiredWith(bool $given, bool $otherGiven, const string& $other) : void
    {
        if (!$given && $otherGiven) {
            $this->rule('requiredWith', Check::one('other', $other));
        }
    }

    public function requiredWithout(bool $given, bool $otherGiven, const string& $other) : void
    {
        if (!$given && !$otherGiven) {
            $this->rule('requiredWithout', Check::one('other', $other));
        }
    }

    // normalisers ------------------------------------------------------------

    public static function trim(const string& $value) : string
    {
        return string::from(str::trim($value));
    }

    public static function lower(const string& $value) : string
    {
        return string::from(str::lower($value));
    }

    public static function upper(const string& $value) : string
    {
        return string::from(str::upper($value));
    }

    /**
     * Trimmed, and every run of whitespace inside one space.
     */
    public static function squish(const string& $value) : string
    {
        string $out = '';
        bool $gap = false;
        string $t = Check::trim($value);
        usize $i = 0;
        while ($i < $t->size()) {
            uint8 $b = $t->byte($i);
            if ($b == 32 || $b == 9 || $b == 10 || $b == 13) {
                $gap = true;
            } else {
                if ($gap) {
                    $out->push(32);
                    $gap = false;
                }
                $out->push($b);
            }
            $i = $i + 1;
        }
        return $out;
    }

    public static function blank(const string& $value) : bool
    {
        return str::trim($value)->empty();
    }

    // messages ---------------------------------------------------------------

    /**
     * The English message of a built-in rule, before `nexus::Messages` renders it in another
     * language. `{label}` and the rule's params are holes.
     */
    public static function english(const string& $code, const string& $kind) : string
    {
        return CheckMessages::english($code, $kind);
    }

    // inside -----------------------------------------------------------------

    internal function current(const string& $code, const string& $template, ordered_map<string, string> $params) : void
    {
        string $path = $this->here();
        string $name = $this->name;
        string $kind = $this->kind;
        string $label = $this->label;
        $this->add($path, $name, $code, $kind, $label, $template, mv $params);
    }

    internal function add(const string& $path, const string& $name, const string& $code, const string& $kind, const string& $label, const string& $template, ordered_map<string, string> $params) : void
    {
        string $shown = $label;
        if ($shown->empty()) {
            $shown = FieldError::readable($name);
        }
        $e = FieldError($path, $code, FieldError::fill($template, $shown, $params));
        $e->params = mv $params;
        $e->input = $this->input;
        $e->name = $name;
        $e->kind = $kind;
        $e->label = $shown;
        $e->template = $template;
        $this->sink->errors[] = mv $e;
    }

    internal const function here() : string
    {
        if (!$this->at->empty()) {
            return $this->join($this->at);
        }
        return $this->join($this->name);
    }

    internal const function join(const string& $name) : string
    {
        if ($this->prefix->empty()) {
            return $name;
        }
        if ($name->empty()) {
            return $this->prefix;
        }
        return "{$this->prefix}.{$name}";
    }

    internal static function one(const string& $k, const string& $v) : ordered_map<string, string>
    {
        $m = ordered_map<string, string>();
        $m[$k] = $v;
        return $m;
    }

    internal static function two(const string& $k1, const string& $v1, const string& $k2, const string& $v2) : ordered_map<string, string>
    {
        $m = ordered_map<string, string>();
        $m[$k1] = $v1;
        $m[$k2] = $v2;
        return $m;
    }

    /**
     * `$params` in key order, so answers do not depend on hashing.
     */
    internal static function ordered(const map<string, string>& $params) : ordered_map<string, string>
    {
        $keys = $params->keys();
        $keys->sort();
        $m = ordered_map<string, string>();
        foreach ($keys as const &$k) {
            $m[$k] = $params->get($k);
        }
        return $m;
    }

    internal static function order(const string& $code, bool $less, bool $equal) : bool
    {
        if ($code == 'after') {
            return !$less && !$equal;
        }
        if ($code == 'afterOrEqual') {
            return !$less;
        }
        if ($code == 'before') {
            return $less;
        }
        return $less || $equal;
    }

    /**
     * Whether `$value` is letters only, plus digits and `-`/`_` when asked. Bytes past ASCII belong
     * to letters beyond it.
     */
    internal static function only(const string& $value, bool $digits, bool $dashes) : bool
    {
        if ($value->empty()) {
            return false;
        }
        usize $i = 0;
        while ($i < $value->size()) {
            uint8 $b = $value->byte($i);
            bool $letter = ($b >= 65 && $b <= 90) || ($b >= 97 && $b <= 122) || $b > 127;
            bool $digit = $b >= 48 && $b <= 57;
            bool $dash = $b == 45 || $b == 95;
            if (!$letter && !($digits && $digit) && !($dashes && $dash)) {
                return false;
            }
            $i = $i + 1;
        }
        return true;
    }
}

