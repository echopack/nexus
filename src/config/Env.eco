namespace nexus;

use std::env;
use std::io;

/**
 * Where configuration values come from: values set explicitly (command line
 * flags, tests) win over the process environment, which wins over a
 * `.env` file.
 */
#[atomic]
public class Env
{
    private map<string, string> $file;
    private map<string, string> $overrides;
    private bool $process;

    /**
     * The process environment only.
     */
    public constructor()
    {
        $this->file = map<string, string>();
        $this->overrides = map<string, string>();
        $this->process = true;
    }

    /**
     * Fixed values and nothing else, for tests.
     */
    public constructor(fixed: map<string, string> $vars)
    {
        $this->file = map<string, string>();
        $this->overrides = $vars;
        $this->process = false;
    }

    /**
     * The process environment over the `.env` file at `$path`. A missing
     * file is fine; a broken one is not.
     */
    public static function load(const string& $path) : result<Env, ConfigError>
    {
        Env $e = Env();
        bool $there = std::fs::exists($path)->or(false);
        if (!$there) {
            return .ok($e);
        }
        string $text = guard std::fs::readfile($path) else {
            return .error(.unreadable($path));
        };
        guard Env::parse($path, $text, $e->file) else ($err) {
            return .error($err);
        };
        return .ok($e);
    }

    /**
     * Sets a value that wins over every source.
     */
    public function set(const string& $name, const string& $value) : void
    {
        $this->overrides[$name] = $value;
    }

    /**
     * The value of `$name`, or null when no source has it.
     */
    public const function get(const string& $name) : string?
    {
        if ($this->overrides->has($name)) {
            string $v = $this->overrides->get($name);
            return $v;
        }
        if ($this->process) {
            string::view? $p = env::var($name->view());
            if ($p != null) {
                string::view $view = guard $p;
                string $v = string::from($view);
                return $v;
            }
        }
        if ($this->file->has($name)) {
            string $v = $this->file->get($name);
            return $v;
        }
        return null;
    }

    /**
     * Parses `.env` text: `KEY=value` lines, `#` comments, an optional
     * `export ` prefix, and single or double quotes around a value.
     */
    public static function parse(const string& $path, const string& $text, map<string, string>& $out) : status<ConfigError>
    {
        array<string> $lines = str::split($text, "\n")->owned();
        int64 $no = 0;
        foreach ($lines as const &$raw) {
            $no = $no + 1;
            string $line = str::trim($raw);
            if ($line->empty() || $line->starts('#')) {
                continue;
            }
            if ($line->starts('export ')) {
                $line = str::trim($line->sub(7, $line->size() - 7));
            }
            usize $eq = $line->find('=');
            if ($eq >= $line->size()) {
                return .error(.syntax($path, $no, 'expected KEY=value'));
            }
            string $key = str::trim($line->sub(0, $eq));
            string $value = str::trim($line->sub($eq + 1, $line->size() - $eq - 1));
            if ($key->empty()) {
                return .error(.syntax($path, $no, 'empty key'));
            }
            if ($value->size() >= 2) {
                uint8 $first = $value->byte(0);
                uint8 $last = $value->byte($value->size() - 1);
                if (($first == 34 || $first == 39) && $first == $last) {
                    $value = $value->sub(1, $value->size() - 2);
                }
            }
            $out[$key] = $value;
        }
        return .ok;
    }
}
