namespace nexus;

use std::env;
use std::io;

/**
 * Where configuration values come from: values set explicitly (command line flags, tests) win over
 * the process environment, which wins over a `.env` file.
 */
#[atomic]
public class Env
{
    private map<string, string> $file;
    private map<string, string> $overrides;
    private bool $process;

    /**
     * The process environment only.
     */
    public constructor()
    {
        $this->file = map<string, string>();
        $this->overrides = map<string, string>();
        $this->process = true;
    }

    /**
     * Fixed values and nothing else, for tests.
     */
    public constructor(fixed: map<string, string> $vars)
    {
        $this->file = map<string, string>();
        $this->overrides = mv $vars;
        $this->process = false;
    }

    /**
     * The process environment over the `.env` file at `$path`. A missing file is fine; a broken one
     * is not.
     */
    public static function load(std::fs::path $path) : result<Env, ConfigError>
    {
        $e = Env();
        bool $there = std::fs::exists($path)->or(false);
        if (!$there) {
            return .ok($e);
        }
        string $text = guard std::fs::readfile($path) else {
            return .error(.unreadable("{$path}"));
        };
        try Env::parse($path, $text, $e->file);
        return .ok($e);
    }

    /**
     * Sets a value that wins over every source.
     */
    public function set(const string& $name, const string& $value) : void
    {
        $this->overrides[$name] = $value;
    }

    /**
     * The value of `$name`, or null when no source has it.
     */
    public const function get(const string& $name) : string?
    {
        if ($this->overrides->has($name)) {
            string $v = $this->overrides->get($name);
            return $v;
        }
        if ($this->process) {
            string::view? $p = env::var($name->view());
            if ($p != null) {
                string::view $view = guard $p;
                return string::from($view);
            }
        }
        if ($this->file->has($name)) {
            string $v = $this->file->get($name);
            return $v;
        }
        return null;
    }

    /**
     * Parses `.env` text: `KEY=value` lines, `#` comments (on their own line, or after a value and
     * a blank), an optional `export ` prefix, and single or double quotes around a value.
     */
    public static function parse(std::fs::path $path, const string& $text, map<string, string>& $out) : status<ConfigError>
    {
        $lines = str::split($text, "\n")->owned();
        int64 $no = 0;
        foreach ($lines as const &$raw) {
            $no = $no + 1;
            string $line = str::trim($raw);
            if ($line->empty() || $line->starts('#')) {
                continue;
            }
            if ($line->starts('export ')) {
                $line = str::trim($line->sub(7, $line->size() - 7));
            }
            usize $eq = $line->find('=');
            if ($eq >= $line->size()) {
                return .error(.syntax("{$path}", $no, 'expected KEY=value'));
            }
            string $key = str::trim($line->sub(0, $eq));
            string $value = str::trim($line->sub($eq + 1, $line->size() - $eq - 1));
            if ($key->empty()) {
                return .error(.syntax("{$path}", $no, 'empty key'));
            }
            string $kept = try Env::value($path, $no, $value);
            $out[$key] = $kept;
        }
        return .ok;
    }

    /**
     * The value of a `.env` line after its `=`, trimmed: the text inside its quotes, or up to a
     * `#` comment that follows a blank when it has none. In double quotes, `\"` and `\\` stand for
     * `"` and `\`. A quote that is not closed, or text after the closing one, is an error.
     */
    internal static function value(std::fs::path $path, int64 $no, const string& $raw) : result<string, ConfigError>
    {
        if ($raw->empty()) {
            return .ok('');
        }
        uint8 $quote = $raw->byte(0);
        if ($quote != 34 && $quote != 39) {
            usize $at = 1;
            while ($at < $raw->size()) {
                uint8 $before = $raw->byte($at - 1);
                if ($raw->byte($at) == 35 && ($before == 32 || $before == 9)) {
                    string $kept = str::trim($raw->sub(0, $at));
                    return .ok($kept);
                }
                $at++;
            }
            return .ok($raw);
        }
        string $inner = '';
        usize $i = 1;
        while ($i < $raw->size()) {
            uint8 $b = $raw->byte($i);
            if ($b == $quote) {
                string $rest = str::trim($raw->sub($i + 1, $raw->size() - $i - 1));
                if (!$rest->empty() && !$rest->starts('#')) {
                    return .error(.syntax("{$path}", $no, 'text after the closing quote'));
                }
                return .ok($inner);
            }
            if ($quote == 34 && $b == 92 && $i + 1 < $raw->size()) {
                uint8 $escaped = $raw->byte($i + 1);
                if ($escaped == 34 || $escaped == 92) {
                    $inner->push($escaped);
                    $i = $i + 2;
                    continue;
                }
            }
            $inner->push($b);
            $i++;
        }
        return .error(.syntax("{$path}", $no, 'a quote is not closed'));
    }
}
