namespace nexus;

use std::time;

/**
 * One environment variable the app reads, as the `env` command lists it: `nexus gen` writes one
 * per `#[nexus::env]` field of a module's config structs, the core lists the ones it reads itself.
 */
public struct EnvVar
{
    public string $name;

    /**
     * What the value is read as: `string`, `uint32`, `duration`, ...
     */
    public string $type;

    /**
     * The default as the variable would be written (`5m`, `2`), empty when there is none.
     */
    public string $fallback = '';

    /**
     * Whether the app stops at boot when it is not set.
     */
    public bool $required = false;

    /**
     * Whether the value must never be shown.
     */
    public bool $secret = false;

    /**
     * What it is for, from the field's docblock.
     */
    public string $doc = '';

    /**
     * The config struct it fills, or `nexus` for the core's own.
     */
    public string $owner = '';

    /**
     * `$value` as it would be written in the environment.
     */
    public static function text(const string& $value) : string
    {
        return $value;
    }

    public static function text(bool $value) : string
    {
        if ($value) {
            return 'true';
        }
        return 'false';
    }

    public static function text(int32 $value) : string
    {
        return "{$value}";
    }

    public static function text(int64 $value) : string
    {
        return "{$value}";
    }

    public static function text(uint16 $value) : string
    {
        return "{$value}";
    }

    public static function text(uint32 $value) : string
    {
        return "{$value}";
    }

    public static function text(uint64 $value) : string
    {
        return "{$value}";
    }

    public static function text(float64 $value) : string
    {
        return "{$value}";
    }

    /**
     * A duration in the largest unit that holds it whole: `720h`, `5m`, `30s`, `250ms`.
     */
    public static function text(time::duration $value) : string
    {
        int64 $ms = $value->as_millis();
        if ($ms != 0 && $ms % 3600000 == 0) {
            int64 $h = $ms / 3600000;
            return "{$h}h";
        }
        if ($ms != 0 && $ms % 60000 == 0) {
            int64 $m = $ms / 60000;
            return "{$m}m";
        }
        if ($ms % 1000 == 0) {
            int64 $s = $ms / 1000;
            return "{$s}s";
        }
        return "{$ms}ms";
    }
}
