namespace nexus;

/**
 * Percent-encoding (RFC 3986) for paths, queries and forms.
 */
public struct Percent
{
    /**
     * Decodes `%XX` escapes. With `plus: true` (queries and forms) a `+` is a space. Null on a
     * broken escape.
     */
    public static function decode(const string& $text, plus: bool $plus) : string?
    {
        string $out = '';
        $out->reserve($text->size());
        usize $i = 0;
        while ($i < $text->size()) {
            uint8 $c = $text->byte($i);
            if ($c == 37) {
                uint8 $byte = guard Percent::escape($text, $i) else { return null; };
                $out->push($byte);
                $i = $i + 3;
                continue;
            }
            if ($plus && $c == 43) {
                $out->push(32);
            } else {
                $out->push($c);
            }
            $i = $i + 1;
        }
        return mv $out;
    }

    /**
     * Decodes `%XX` escapes like `decode`, but a broken escape stays as written instead of
     * failing the whole text: `100%` is `100%`, `%zz` is `%zz`. Queries and forms read this way,
     * the way browsers send them.
     */
    public static function loose(const string& $text, plus: bool $plus) : string
    {
        string $out = '';
        $out->reserve($text->size());
        usize $i = 0;
        while ($i < $text->size()) {
            uint8 $c = $text->byte($i);
            if ($c == 37) {
                uint8? $byte = Percent::escape($text, $i);
                if ($byte != null) {
                    uint8 $b = guard $byte;
                    $out->push($b);
                    $i = $i + 3;
                    continue;
                }
            }
            if ($plus && $c == 43) {
                $out->push(32);
            } else {
                $out->push($c);
            }
            $i = $i + 1;
        }
        return $out;
    }

    /**
     * Decodes a path segment, where `+` stays a plus.
     */
    public static function decode(const string& $text) : string?
    {
        return Percent::decode($text, plus: false);
    }

    /**
     * Escapes everything but the unreserved characters `A-Z a-z 0-9 - . _ ~`.
     */
    public static function encode(const string& $text) : string
    {
        string $digits = '0123456789ABCDEF';
        string $out = '';
        $out->reserve($text->size());
        usize $i = 0;
        while ($i < $text->size()) {
            uint8 $c = $text->byte($i);
            if (Percent::unreserved($c)) {
                $out->push($c);
            } else {
                $out->push(37);
                $out->push($digits->byte(($c >> 4) as usize));
                $out->push($digits->byte(($c & 15) as usize));
            }
            $i = $i + 1;
        }
        return $out;
    }

    /**
     * Escapes each segment of a path but keeps the `/` between them, for a catch-all `{rest*}`
     * value.
     */
    public static function path(const string& $text) : string
    {
        $parts = str::split($text, '/')->owned();
        array<string> $out = [];
        foreach ($parts as const &$p) {
            $out[] = Percent::encode($p);
        }
        return str::join($out, '/');
    }

    internal static function unreserved(uint8 $c) : bool
    {
        if ($c >= 65 && $c <= 90) { return true; }
        if ($c >= 97 && $c <= 122) { return true; }
        if ($c >= 48 && $c <= 57) { return true; }
        return $c == 45 || $c == 46 || $c == 95 || $c == 126;
    }

    // the byte the `%XX` escape at `$at` stands for; null when the `%` there starts no complete escape
    internal static function escape(const string& $text, usize $at) : uint8?
    {
        if ($at + 2 >= $text->size()) {
            return null;
        }
        uint8 $hi = guard Percent::nibble($text->byte($at + 1)) else { return null; };
        uint8 $lo = guard Percent::nibble($text->byte($at + 2)) else { return null; };
        return ($hi << 4) | $lo;
    }

    internal static function nibble(uint8 $c) : uint8?
    {
        if ($c >= 48 && $c <= 57) { return $c - 48; }
        if ($c >= 65 && $c <= 70) { return $c - 55; }
        if ($c >= 97 && $c <= 102) { return $c - 87; }
        return null;
    }
}
