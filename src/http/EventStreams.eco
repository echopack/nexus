namespace nexus;

use std::thread;

/**
 * A set of open event streams to send to at once, from any thread. A send never waits on a slow
 * client: `publish` queues the event and one thread of the set's own hands it to every stream's
 * own queue, which a few writer threads work through (`Spools`), so a stream that stops reading
 * holds up only itself. A stream more than `room` sends behind is closed, and a stream a send
 * fails on is dropped. Keep one per feed, shared (`#[atomic]`):
 *
 *     return nexus::Response(events: function[$feed](nexus::EventStream $s) : void {
 *         $feed->streams->add($s);
 *     }, closed: function[$feed](nexus::EventStream $s) : void {
 *         $feed->streams->remove($s);
 *     });
 *
 * A stream that resumes (`Last-Event-ID`) joins with what it missed: take the backlog and `join`
 * under the same lock your `publish` calls hold, so every event reaches it once and in order.
 */
#[atomic]
public class EventStreams
{
    private Mailbox<StreamJob> $mail;
    private StreamSet $set;

    public constructor(usize $room = 256)
    {
        $set = StreamSet($room);
        $this->set = $set;
        $this->mail = Mailbox<StreamJob>(function[$set](StreamJob $job) : void {
            $set->run($job);
        });
    }

    /**
     * Starts sending to `$s`.
     */
    public function add(EventStream $s) : void
    {
        $this->join($s, []);
    }

    /**
     * Sends `$backlog` to `$s`, then everything published after this call.
     */
    public function join(EventStream $s, array<ServerEvent> $backlog) : void
    {
        $this->mail->put(StreamJob::join($s, mv $backlog));
    }

    /**
     * Stops sending to `$s`. Its close hook calls this.
     */
    public function remove(EventStream $s) : void
    {
        $this->mail->put(StreamJob::leave($s->id()));
    }

    /**
     * Stops sending to `$s` and ends it once the send under way is through; what was still queued
     * for it is dropped.
     */
    public function close(EventStream $s) : void
    {
        $this->mail->put(StreamJob::close($s->id()));
    }

    /**
     * Queues `$e` for every stream in the set.
     */
    public function publish(const ServerEvent& $e) : void
    {
        $this->mail->put(StreamJob::publish($e));
    }

    /**
     * Closes every stream in the set and forgets them.
     */
    public function closeAll() : void
    {
        $this->mail->put(StreamJob::closeAll);
    }

    /**
     * How many streams the set holds now.
     */
    public function count() : usize
    {
        return $this->set->count();
    }

    /**
     * Waits until everything queued before the call went out, or was dropped with its stream.
     */
    public function settle() : void
    {
        $this->mail->settle();
        $this->set->settle();
    }
}

internal enum StreamJob
{
    case join(EventStream $stream, array<ServerEvent> $backlog);
    case leave(int64 $id);
    case close(int64 $id);
    case publish(ServerEvent $event);
    case closeAll;
}

/**
 * An event every stream sends, kept once however many queues hold it.
 */
#[atomic]
internal class SharedEvent
{
    public const ServerEvent $e;

    public constructor(const ServerEvent& $e)
    {
        $this->e = $e;
    }
}

/**
 * The streams of an `EventStreams`, which its sender thread hands sends to, one spool each.
 */
#[atomic]
internal class StreamSet
{
    private thread::mutex<array<EventStream>> $members = thread::mutex<array<EventStream>>(array<EventStream>());
    private Spools $spools;

    public constructor(usize $room)
    {
        $this->spools = Spools($room);
    }

    public function count() : usize
    {
        thread::locked<array<EventStream>> $held = $this->members->lock();
        return $held->value->count();
    }

    public function run(StreamJob $job) : void
    {
        $this->reap();
        match ($job) {
            StreamJob::join($s, $backlog) => {
                {
                    thread::locked<array<EventStream>> $held = $this->members->lock();
                    $held->value->push($s);
                }
                if ($backlog->empty()) {
                    return;
                }
                $this->offer($s, function[$s, $backlog]() : bool {
                    foreach ($backlog as const &$e) {
                        if (!$s->open() || !$s->send($e)) {
                            return false;
                        }
                    }
                    return true;
                });
            },
            StreamJob::leave($id) => {
                $this->drop($id);
                $this->spools->forget($id);
            },
            StreamJob::close($id) => {
                EventStream? $found = $this->drop($id);
                if ($found != null) {
                    EventStream $s = guard $found;
                    $this->end($s);
                }
            },
            StreamJob::publish($e) => {
                SharedEvent $one = SharedEvent($e);
                foreach ($this->snapshot() as $s) {
                    $this->offer($s, function[$s, $one]() : bool {
                        return $s->send($one->e);
                    });
                }
            },
            StreamJob::closeAll => {
                array<EventStream> $all = $this->snapshot();
                {
                    thread::locked<array<EventStream>> $held = $this->members->lock();
                    $held->value = array<EventStream>();
                }
                foreach ($all as $s) {
                    $this->end($s);
                }
            },
        }
    }

    /**
     * Waits until every send handed over went out or was dropped, and drops the streams one failed
     * on.
     */
    public function settle() : void
    {
        $this->spools->settle();
        $this->reap();
    }

    // queues `$send` on the spool of `$s`: a stream too far behind is closed, a gone one dropped
    private function offer(EventStream $s, function<bool()> $send) : void
    {
        match ($this->spools->put($s->id(), $send)) {
            Spooled::queued => {},
            Spooled::full => {
                $this->drop($s->id());
                $this->end($s);
            },
            Spooled::gone => {
                $this->drop($s->id());
                $this->spools->forget($s->id());
            },
        }
    }

    // closes `$s` on its spool, after the send under way
    private function end(EventStream $s) : void
    {
        $this->spools->shut($s->id(), function[$s]() : void {
            $s->close();
        });
    }

    // drops the streams a send failed on
    private function reap() : void
    {
        foreach ($this->spools->failed() as $id) {
            $this->drop($id);
            $this->spools->forget($id);
        }
    }

    private function snapshot() : array<EventStream>
    {
        thread::locked<array<EventStream>> $held = $this->members->lock();
        return $held->value->clone();
    }

    private function drop(int64 $id) : EventStream?
    {
        thread::locked<array<EventStream>> $held = $this->members->lock();
        usize $n = $held->value->count();
        usize $i = 0;
        while ($i < $n) {
            if ($held->value[$i]->id() == $id) {
                EventStream $s = $held->value[$i];
                $held->value->remove($i);
                return $s;
            }
            $i = $i + 1;
        }
        return null;
    }
}
