namespace nexus;

/**
 * One request, transport independent. The HTTP transport builds it from the wire; tests build it
 * directly: `Request(.get, '/v1/posts/42')`. `$params` is filled by the router, `$id` by the
 * kernel.
 */
public struct Request
{
    public Method $method = .get;
    public string $target = '';
    public string $path = '';
    public string $queryString = '';
    public Query $query = Query();
    public Headers $headers = Headers();
    public string $body = '';

    /**
     * The client's address, without a port, so a throttle can key on it: the socket's, or behind a
     * trusted proxy the one it forwarded for. Empty for work that came in another door.
     */
    public string $peer = '';
    public map<string, string> $params = map<string, string>();
    public string $id = '';

    /**
     * `http` or `https`. The transport sets this after the trusted-proxy check; a client cannot
     * flip it with `X-Forwarded-Proto` on its own.
     */
    public string $scheme = 'http';

    /**
     * A request for `$target` (path plus optional `?query`).
     */
    public constructor(Method $method, const string& $target)
    {
        $this->method = $method;
        $this->target = $target;
        usize $q = $target->find('?');
        if ($q < $target->size()) {
            $this->path = $target->sub(0, $q);
            $this->queryString = $target->sub($q + 1, $target->size() - $q - 1);
        } else {
            $this->path = $target;
            $this->queryString = '';
        }
        $this->query = Query(parse: $this->queryString);
        $this->headers = Headers();
        $this->body = '';
        $this->peer = '';
        $this->params = map<string, string>();
        $this->id = '';
        $this->scheme = 'http';
    }

    /**
     * A request carrying a body of the given content type.
     */
    public constructor(Method $method, const string& $target, body: const string& $body, type: const string& $type)
    {
        $this = Request($method, $target);
        $this->body = $body;
        $this->headers->set('Content-Type', $type);
    }

    /**
     * The first header of `$name`, any case, or null.
     */
    public const function header(const string& $name) : string?
    {
        return $this->headers->get($name);
    }

    /**
     * A path parameter the router captured, or null.
     */
    public const function param(const string& $name) : string?
    {
        if (!$this->params->has($name)) {
            return null;
        }
        string $v = $this->params->get($name);
        return $v;
    }

    /**
     * The media type of the body without parameters, lower case, or empty.
     */
    public const function contentType() : string
    {
        return Download::mediaType($this->headers->get('Content-Type') ?? '');
    }

    /**
     * Where the client reached the app, `https://blog.example.com`: `$scheme` and the `Host`
     * header. For links in answers to the same client; an app behind several names configures its
     * public origin instead.
     */
    public const function origin() : string
    {
        string $scheme = $this->scheme;
        if ($scheme != 'https') {
            $scheme = 'http';
        }
        string $host = str::trim($this->headers->get('Host') ?? '');
        if ($host->empty()) {
            $host = 'localhost';
        }
        return "{$scheme}://{$host}";
    }

    /**
     * The URL the client asked for, on `origin()`. A `Host` header that is no host gives
     * `localhost`, as an empty one does.
     */
    public const function url() : Url
    {
        $url = Url(path: $this->path);
        $url->query = $this->query;
        Url $origin = guard Url::parse($this->origin()) else {
            $url->scheme = 'http';
            $url->host = 'localhost';
            return $url;
        };
        return $url->on($origin);
    }
}
