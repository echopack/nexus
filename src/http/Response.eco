namespace nexus;

/**
 * One response, transport independent. What an action answers with in most cases, usually built by
 * a nexus-rest transformer (`$this->transformer->createResponse($payload, $post)`); build it
 * directly for anything else.
 */
public struct Response
{
    public int32 $status = 200;
    public Headers $headers = Headers();
    public string $body = '';

    /**
     * The body written while it runs, for an answer that is not done when the action returns: a
     * server-sent event stream, a long download. Null for an answer in `body`.
     */
    public function<void(Writer)>? $stream = null;

    /**
     * The hooks of a server-sent event stream the transport keeps open, or null.
     */
    public EventHooks? $events = null;

    /**
     * The hooks of a websocket this response upgrades to, and the subprotocol it agrees on when
     * the client offered it. Null for any other answer.
     */
    public SocketHooks? $websocket = null;
    public string $protocol = '';

    /**
     * A body of any content type.
     */
    public constructor(int32 $status, const string& $body, type: const string& $type)
    {
        $this->status = $status;
        $this->headers = Headers();
        $this->body = $body;
        $this->headers->set('Content-Type', $type);
    }

    /**
     * A status with no body.
     */
    public constructor(int32 $status)
    {
        $this->status = $status;
        $this->headers = Headers();
        $this->body = '';
    }

    /**
     * A JSON document, compact.
     */
    public constructor(json: json::Value $doc, status: int32 $status = 200)
    {
        $this = Response($status, json::dump($doc), type: 'application/json');
    }

    /**
     * Plain text, UTF-8.
     */
    public constructor(text: const string& $body, status: int32 $status = 200)
    {
        $this = Response($status, $body, type: 'text/plain; charset=utf-8');
    }

    /**
     * An HTML document, UTF-8.
     */
    public constructor(html: const string& $body, status: int32 $status = 200)
    {
        $this = Response($status, $body, type: 'text/html; charset=utf-8');
    }

    /**
     * A body `$fn` writes as it goes, of content type `$type`. The transport calls it after the
     * request is answered, when the request's container is dropped already: the closure keeps only
     * what outlives the request (shared `#[atomic]` services), never a scoped one.
     *
     *     return Response(stream: function[$feed](nexus::Writer $w) : void { ... }, type: 'text/event-stream');
     */
    public constructor(stream: function<void(Writer)> $fn, type: const string& $type, status: int32 $status = 200)
    {
        $this = Response($status);
        $this->stream = $fn;
        $this->headers->set('Content-Type', $type);
    }

    /**
     * A server-sent event stream: an explicit, continuous one-way feed to the client, for a use
     * that is exactly that (a dashboard's numbers, a log tail). The transport writes the head
     * (`text/event-stream`, never cached), runs `$opened` with the stream, and keeps the connection
     * without holding a thread for it; whoever keeps the stream sends to it later. `$closed` runs
     * once when it ends. Both run after the request's container is dropped: capture only shared
     * services. Realtime channels are websockets (nexus-realtime), not this.
     *
     *     return Response(events: function[$feed](nexus::EventStream $s) : void { $feed->streams->add($s); },
     *         closed: function[$feed](nexus::EventStream $s) : void { $feed->streams->remove($s); });
     */
    public constructor(events: function<void(EventStream)> $opened, closed: function<void(EventStream)>? $closed = null)
    {
        $this = Response(200);
        $this->events = EventHooks($opened, $closed);
        $this->headers->set('Content-Type', 'text/event-stream');
        $this->headers->set('Cache-Control', 'no-store');
    }

    /**
     * Upgrades the connection to a websocket run by `$hooks`, nexus's realtime connection. A bad
     * handshake is refused by the transport (426 or 400) and runs no hook. `$protocol` is agreed
     * on only when the client offered it.
     */
    public constructor(websocket: SocketHooks $hooks, protocol: const string& $protocol = '')
    {
        $this = Response(101);
        $this->websocket = $hooks;
        $this->protocol = $protocol;
    }

    /**
     * A redirect to `$location`, 302 unless told otherwise.
     */
    public constructor(redirect: const string& $location, status: int32 $status = 302)
    {
        $this = Response($status);
        $this->headers->set('Location', $location);
    }

    /**
     * A redirect to `$to`, 302 unless told otherwise:
     * `Response(redirect: $router->url<ShowPost>(['id' => '5']))`.
     */
    public constructor(redirect: const Url& $to, status: int32 $status = 302)
    {
        $this = Response(redirect: $to->text(), status: $status);
    }

    /**
     * 204, nothing to say.
     */
    public static function noContent() : Response
    {
        return Response(204);
    }

    /**
     * Sets a header, replacing earlier ones of the name.
     */
    public function header(const string& $name, const string& $value) : void
    {
        $this->headers->set($name, $value);
    }

    public const function header(const string& $name) : string?
    {
        return $this->headers->get($name);
    }

    public const function success() : bool
    {
        return $this->status >= 200 && $this->status < 300;
    }
}
