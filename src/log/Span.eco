namespace nexus::log;

use std::time;

/**
 * A named, timed stretch of work. Everything written through its `$log` carries the span, and when
 * the span goes out of scope it writes `<name> closed` with how long it was open in `ms`:
 *
 *     {
 *         log::Span $s = $log->span('import', ['file' => $path]);
 *         $s->log->info('rows read', ['n' => $n]);
 *     }   // import closed ms=41.2
 */
public struct Span
{
    /**
     * The logger inside the span.
     */
    public nexus::Logger $log;

    public const string $name;
    public const string $id;
    private time::instant $start;
    private Level $close;
    private nexus::trace::Trace? $trace = null;
    private uint32 $mark = 0;

    internal constructor(nexus::Logger $log, string $name, string $id, Level $close, traced: nexus::trace::Trace? $trace, mark: uint32 $mark)
    {
        $this->log = $log;
        $this->name = mv $name;
        $this->id = mv $id;
        $this->start = .now();
        $this->close = $close;
        $this->trace = $trace;
        $this->mark = $mark;
    }

    /**
     * How long the span has been open.
     */
    public const function elapsed() : time::duration
    {
        return $this->start->elapsed();
    }

    destructor()
    {
        if ($this->trace != null) {
            nexus::trace::Trace $t = guard $this->trace;
            $t->close($this->mark);
        }
        if (!$this->log->enabled($this->close)) {
            return;
        }
        float64 $ms = ($this->start->elapsed()->as_micros() as float64) / 1000.0;
        $this->log->write($this->close, "{$this->name} closed", ['ms' => $ms]);
    }
}
