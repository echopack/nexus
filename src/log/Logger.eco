namespace nexus;

use std::time;
use nexus::log;

/**
 * The structured logger. Shared by every thread. `with` gives a child that stamps extra fields on
 * every entry, the way each request's logger carries its request id; `span` gives a timed child
 * that logs when it closes.
 *
 *     $log->info('post created', ['post' => $post->id, 'user' => $u->id]);
 *
 * The kernel binds the root logger in the container and the request's logger in each request's, so
 * a service takes a `Logger` like any other dependency. Code that has neither reaches
 * `Logger::process()`.
 *
 * A build with `--define NEXUS_LOG_MAX_INFO` (or `_DEBUG`, `_WARN`, `_ERROR`) compiles the levels
 * below the cap to nothing. Their arguments are still built, so guard expensive fields with
 * `enabled`:
 *
 *     if ($log->enabled(.debug)) { $log->debug('plan', ['sql' => $q->render()]); }
 */
#[atomic]
public class Logger
{
    private array<log::Sink> $sinks;

    /**
     * The lowest level this logger writes.
     */
    public const log::Level $level;

    /**
     * What this logger stamps on its entries; null for a root logger.
     */
    public const log::Context? $context;

    public constructor(array<log::Sink> $sinks, log::Level $min)
    {
        $this->sinks = mv $sinks;
        $this->level = $min;
        $this->context = null;
    }

    internal constructor(array<log::Sink> $sinks, log::Level $min, context: log::Context $context)
    {
        $this->sinks = mv $sinks;
        $this->level = $min;
        $this->context = $context;
    }

    /**
     * A logger that writes nowhere.
     */
    public static function silent() : Logger
    {
        array<log::Sink> $none = [];
        return Logger(mv $none, .error);
    }

    /**
     * The logger of the process, for code that has no payload and no container to ask.
     * `Kernel::boot` installs the root logger; before that it is pretty lines on stderr from info
     * up.
     */
    public static function process() : Logger
    {
        Logger $installed = guard log::Installed::$logger else {
            array<log::Sink> $sinks = [log::Stream(.stderr, .pretty)];
            return Logger(mv $sinks, .info);
        };
        return $installed;
    }

    /**
     * Makes `$log` the process logger. Call it once, before other threads start.
     */
    public static function install(Logger $log) : void
    {
        log::Installed::$logger = $log;
    }

    /**
     * Whether an entry at `$level` would be written anywhere.
     */
    public const function enabled(log::Level $level) : bool
    {
        return $level->value() >= $this->level->value()
            && $level->value() >= log::Level::cap()->value()
            && !$this->sinks->empty();
    }

    /**
     * A child sharing the sinks that adds `$fields` to every entry.
     */
    public const function with(log::Fields $fields) : Logger
    {
        $c = log::Context($this->context, mv $fields);
        return Logger($this->sinks, $this->level, context: $c);
    }

    /**
     * Opens span `$name`. Its logger stamps the span and `$fields` on every entry; when the span
     * goes out of scope it logs `<name> closed` with the time it was open, at `$close`.
     */
    public const function span(const string& $name, log::Fields $fields = [], log::Level $close = .info) : log::Span
    {
        string $id = Kernel::id();
        $c = log::Context($this->context, mv $fields, span: $name, id: $id);
        $inner = Logger($this->sinks, $this->level, context: $c);
        return log::Span($inner, $name, mv $id, $close);
    }

    public function write(log::Level $level, const string& $message, log::Fields $fields = []) : void
    {
        if (!$this->enabled($level)) {
            return;
        }
        $e = log::Entry(time::timestamp::now(), $level, $message, $this->context, mv $fields);
        foreach ($this->sinks as &$s) {
            $s->write($e);
        }
    }

    public function trace(const string& $message, log::Fields $fields = []) : void
    {
        #[if: NEXUS_LOG_MAX_ERROR]
        #[elif: NEXUS_LOG_MAX_WARN]
        #[elif: NEXUS_LOG_MAX_INFO]
        #[elif: NEXUS_LOG_MAX_DEBUG]
        #[else]
        $this->write(.trace, $message, $fields);
        #[end]
    }

    public function debug(const string& $message, log::Fields $fields = []) : void
    {
        #[if: NEXUS_LOG_MAX_ERROR]
        #[elif: NEXUS_LOG_MAX_WARN]
        #[elif: NEXUS_LOG_MAX_INFO]
        #[else]
        $this->write(.debug, $message, $fields);
        #[end]
    }

    public function info(const string& $message, log::Fields $fields = []) : void
    {
        #[if: NEXUS_LOG_MAX_ERROR]
        #[elif: NEXUS_LOG_MAX_WARN]
        #[else]
        $this->write(.info, $message, $fields);
        #[end]
    }

    public function warn(const string& $message, log::Fields $fields = []) : void
    {
        #[if: NEXUS_LOG_MAX_ERROR]
        #[else]
        $this->write(.warn, $message, $fields);
        #[end]
    }

    public function error(const string& $message, log::Fields $fields = []) : void
    {
        $this->write(.error, $message, $fields);
    }

    /**
     * Writes a typed record. `R` needs a `nexus::log::record(const R&)`, which `nexus gen` writes
     * for a struct tagged `#[nexus::log]`:
     *
     *     $log->emit<LoginThrottled>($account, 11, $wait);
     */
    public function emit<R>(construct R $record) : void
    {
        $r = log::record($record);
        $this->write($r->level, $r->message, mv $r->fields);
    }

    /**
     * Writes out what every sink still holds. The console flushes before the process exits.
     */
    public function flush() : void
    {
        foreach ($this->sinks as &$s) {
            $s->flush();
        }
    }
}
