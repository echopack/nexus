namespace nexus::log;

/**
 * A typed log event spelled out: its level, message and fields.
 * `Logger::emit<R>` asks `nexus::log::record(const R&)` for one, the same
 * way `"{$v}"` asks `str::from`. `nexus gen` writes that overload for every
 * struct tagged `#[nexus::log: { level: "warn", message: "..." }]`; a hand
 * written one works the same.
 */
public struct Record
{
    public Level $level;
    public string $message;
    public Fields $fields;
}

/**
 * A record is its own record, so `$log->emit<log::Record>(.warn, 'x', [])`
 * works without generated code.
 */
public function record(const Record& $r) : Record
{
    return $r;
}
