namespace nexus::log;

/**
 * What a logger stamps on every entry: one node per `with` or `span`, pointing at its parent. Nodes
 * never change once built, so children and entries share them across threads instead of copying the
 * fields.
 */
#[atomic]
public class Context
{
    public const Context? $parent;

    /**
     * The fields this node adds.
     */
    public const Fields $fields;

    /**
     * Whether this node opened a span, rather than only adding fields.
     */
    public const bool $opens;

    /**
     * The innermost span at this node, its id and its parent's id. Empty outside any span.
     */
    public const string $span;
    public const string $spanId;
    public const string $parentId;

    /**
     * A node that adds `$fields` below `$parent`.
     */
    public constructor(Context? $parent, Fields $fields)
    {
        $this->parent = $parent;
        $this->fields = mv $fields;
        $this->opens = false;
        $this->span = $parent?->span ?? '';
        $this->spanId = $parent?->spanId ?? '';
        $this->parentId = $parent?->parentId ?? '';
    }

    /**
     * A node that opens span `$name` with id `$id` below `$parent`.
     */
    public constructor(Context? $parent, Fields $fields, span: string $name, id: string $id)
    {
        $this->parent = $parent;
        $this->fields = mv $fields;
        $this->opens = true;
        $this->span = mv $name;
        $this->spanId = mv $id;
        $this->parentId = $parent?->spanId ?? '';
    }

    /**
     * Adds the fields of every node from the root down to this one into `$into`; a nearer node's
     * value wins.
     */
    public const function collect(Fields& $into) : void
    {
        if ($this->parent != null) {
            Context $p = guard $this->parent;
            $p->collect($into);
        }
        $into->merge($this->fields);
    }
}
