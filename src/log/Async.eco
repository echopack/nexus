namespace nexus::log;

use std::thread;
use std::time;

/**
 * Hands entries to a writer thread through a bounded queue, so the thread that logs never waits on
 * a slow sink:
 *
 *     log::Async(log::Stream(.stdout, .json, buffered: true), $capacity: 8192, $overflow: .drop)
 *
 * With `.block` a full queue makes the logging thread wait; with `.drop` the entry is counted and
 * dropped, and the writer logs `log dropped entries` with the count once it catches up. The writer
 * takes everything waiting at once, writes it and flushes the sink once per batch, so a buffered
 * `Stream` behind it writes a burst of lines in one go. `flush` waits until everything queued
 * before it is written; dropping the sink writes what is still queued first. Entries still queued
 * when the process exits without a flush are lost.
 */
#[atomic]
public class Async : Sink
{
    public const usize $capacity;
    public const Overflow $overflow;
    private Sink $inner;
    private Backlog $backlog;

    // dropping the last handle joins the writer, after the destructor closed the queue
    private result<thread::handle, thread::error> $writer;

    public constructor(Sink $inner, usize $capacity = 8192, Overflow $overflow = .block)
    {
        usize $cap = $capacity;
        if ($cap == 0) {
            $cap = 1;
        }
        $this->capacity = $cap;
        $this->overflow = $overflow;
        $this->inner = $inner;
        $backlog = Backlog();
        $this->backlog = $backlog;
        Sink $sink = $inner;
        // the writer runs until the queue closes and is empty
        $this->writer = thread::spawn(function[$sink, $backlog]() : void {
            while (true) {
                array<Entry> $batch = guard $backlog->take() else {
                    break;
                };
                foreach ($batch as const &$e) {
                    $sink->write($e);
                }
                uint64 $lost = $backlog->dropped->exchange(0);
                if ($lost > 0) {
                    Fields $f = ['dropped' => $lost];
                    $sink->write(Entry(time::timestamp::now(), .warn, 'log dropped entries', null, mv $f));
                }
                $sink->flush();
                $backlog->wrote(($batch->count() as uint64) + $lost);
            }
            $sink->flush();
        });
    }

    destructor()
    {
        $this->backlog->close();
    }

    public function write(const Entry& $e) : void
    {
        if ($this->writer->failed() || !$this->backlog->push($e, $this->capacity, $this->overflow)) {
            $this->inner->write($e);
        }
    }

    /**
     * Waits until the writer has written, and flushed, every entry queued before the call, and has
     * reported every entry dropped before it.
     */
    public function flush() : void
    {
        if ($this->writer->failed()) {
            $this->inner->flush();
            return;
        }
        $this->backlog->settle();
    }

    /**
     * Entries dropped since the writer last reported them.
     */
    public const function dropped() : uint64
    {
        return $this->backlog->dropped->load();
    }
}
