namespace nexus::log;

use std::thread;
use std::time;

/**
 * Hands entries to a writer thread through a bounded queue, so the thread that logs never waits on
 * a slow sink:
 *
 *     log::Async(log::Stream(.stdout, .json), $capacity: 8192, $overflow: .drop)
 *
 * With `.block` a full queue makes the logging thread wait; with `.drop` the entry is counted and
 * dropped, and the writer logs `log dropped entries` with the count once it catches up. `flush`
 * waits until the queue is empty; dropping the sink writes what is still queued first. Entries
 * still queued when the process exits without a flush are lost.
 */
#[atomic]
public class Async : Sink
{
    public const usize $capacity;
    public const Overflow $overflow;
    private Sink $inner;
    private Backlog $backlog;
    private thread::sender<Entry> $tx;

    // dropping the last handle joins the writer, after the destructor closed the queue
    private result<thread::handle, thread::error> $writer;

    public constructor(Sink $inner, usize $capacity = 8192, Overflow $overflow = .block)
    {
        usize $cap = $capacity;
        if ($cap == 0) {
            $cap = 1;
        }
        $this->capacity = $cap;
        $this->overflow = $overflow;
        $this->inner = $inner;
        $backlog = Backlog();
        $this->backlog = $backlog;
        $ch = thread::channel<Entry>($cap);
        $this->tx = $ch->tx();
        $rx = $ch->rx();
        Sink $sink = $inner;
        // the writer runs until the queue closes
        $this->writer = thread::spawn(function[mv $rx, $sink, $backlog]() : void {
            while (true) {
                Entry $e = guard $rx->recv() else {
                    break;
                };
                $sink->write($e);
                $backlog->pending->sub(1);
                uint64 $lost = $backlog->dropped->exchange(0);
                if ($lost > 0) {
                    Fields $f = ['dropped' => $lost];
                    $sink->write(Entry(time::timestamp::now(), .warn, 'log dropped entries', null, mv $f));
                }
            }
            $sink->flush();
        });
    }

    destructor()
    {
        $this->tx->close();
    }

    public function write(const Entry& $e) : void
    {
        if ($this->writer->failed()) {
            $this->inner->write($e);
            return;
        }
        usize $before = $this->backlog->pending->add(1);
        if ($this->overflow == Overflow::drop && $before >= $this->capacity) {
            $this->backlog->pending->sub(1);
            $this->backlog->dropped->add(1);
            return;
        }
        $this->tx->send($e);
    }

    /**
     * Waits until the writer has written every queued entry, then flushes the sink it writes to.
     */
    public function flush() : void
    {
        while (!$this->writer->failed() && $this->backlog->pending->load() > 0) {
            time::sleep(.millis(1));
        }
        $this->inner->flush();
    }

    /**
     * Entries dropped since the writer last reported them.
     */
    public const function dropped() : uint64
    {
        return $this->backlog->dropped->load();
    }
}
