namespace nexus;

/**
 * The global middleware, outermost first. Extensions add to it in their `middleware` hook; the
 * kernel freezes it at boot.
 */
public class Pipeline
{
    public array<Middleware> $links = [];

    /**
     * The name of each link, for the request's timeline.
     */
    public array<string> $names = [];

    public function add(Middleware $m, name: string $name = '') : void
    {
        $this->links[] = $m;
        $this->names[] = mv $name;
    }
}
