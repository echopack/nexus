namespace nexus;

/**
 * The route `bindAction` or `route` just added, for what goes on it next: middleware that wraps
 * only this route.
 *
 * ```echo
 * $s->bindAction<Export>(method: .get, path: '/v1/export')->middleware<Audit>();
 * ```
 */
public class ActionRef<A>
{
    internal Services $services;
    internal Wiring $wiring;

    internal constructor(Services $services, Wiring $wiring)
    {
        $this->services = $services;
        $this->wiring = $wiring;
    }

    /**
     * Wraps this route in middleware `M`, taken from the request's container each time, so it may
     * depend on request-scoped services. Bind `M` like any other service. Middleware runs in the
     * order it is added, after the global middleware and before the middleware the action names in
     * `#[nexus::through]`.
     */
    public function middleware<M>() : ActionRef<A>
    {
        string $name = $this->services->generated->nameOf<M>('middleware');
        $this->wiring->route->middleware[] = MiddlewareRef::of<M>($name);
        return $this;
    }

    /**
     * Wraps this route in the middleware `$refs` name, in order: middleware chosen while wiring
     * rather than named by type here, as a list an extension was handed. It runs where
     * `middleware<M>()` would.
     */
    public function through(const array<MiddlewareRef>& $refs) : ActionRef<A>
    {
        foreach ($refs as const &$ref) {
            $this->wiring->route->middleware[] = $ref;
        }
        return $this;
    }

    /**
     * The path the route was asked for, as written. Routing the same action at the same path again
     * hands back this route, with the method added.
     */
    public const function path() : string
    {
        return $this->wiring->source;
    }

    /**
     * The action's qualified name.
     */
    public const function action() : string
    {
        return $this->wiring->route->action;
    }
}
