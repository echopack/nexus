namespace nexus;

use std::time;

/**
 * The running app: its extensions, the sealed container, the route table and the global middleware.
 * Boot it once, then call `handle` from any number of threads; a transport does that for real
 * traffic, a test does it directly.
 */
#[atomic]
public class Kernel
{
    public Mode $mode;
    public Logger $log;
    public Env $env;
    public container::Container $services;
    public Router $router;

    /**
     * What `nexus gen` wrote for the program, for `doctor`.
     */
    public Generated $generated;
    internal array<Extension> $extensions;
    internal array<Middleware> $global;

    /**
     * The app's middleware around every request, built per request.
     */
    internal array<MiddlewareRef> $around;
    internal atomic<int64> $served = atomic<int64>(0);

    internal constructor(array<Extension> $extensions, Mode $mode, Logger $log, Env $env, container::Container $services, Router $router, array<Middleware> $global, array<MiddlewareRef> $around, Generated $generated)
    {
        $this->around = mv $around;
        $this->generated = $generated;
        $this->extensions = mv $extensions;
        $this->mode = $mode;
        $this->log = $log;
        $this->env = $env;
        $this->services = $services;
        $this->router = $router;
        $this->global = mv $global;
    }

    /**
     * Runs the app's command line (`serve`, `routes`, `doctor`) and exits the process with its
     * code. The one call `main.eco` makes.
     */
    public static function main(const array<Extension>& $extensions) : void
    {
        int32 $code = Console::run($extensions, std::env::argv());
        std::env::exit($code);
    }

    /**
     * Boots with the tables `nexus gen` wrote for every module of the program.
     */
    public static function boot(array<Extension> $extensions, Mode $mode, Logger $log, Env $env) : result<Kernel, BootError>
    {
        return Kernel::boot($extensions, $mode, $log, $env, tables: Tables::generated());
    }

    /**
     * Boots with explicit tables, for tests that want generated tables of their own.
     */
    public static function boot(array<Extension> $extensions, Mode $mode, Logger $log, Env $env, tables: const Tables& $tables) : result<Kernel, BootError>
    {
        $generated = Generated($tables->generated);
        $b = container::Builder();
        // names for the line a failed resolve stops with
        foreach ($generated->names as $id => const &$name) {
            $b->name($id, $name);
        }
        $b->name<Logger>('nexus::Logger');
        $b->name<Env>('nexus::Env');
        $b->name<Messages>('nexus::Messages');
        $b->name<Request>('nexus::Request');
        $b->bind<Logger>(put: $log);
        $b->bind<Env>(put: $env);
        $messages = Messages();
        $inputs = Inputs($messages);
        foreach ($tables->inputs as const &$t) {
            $fill = $t->call;
            $fill($inputs);
        }
        $b->bind<Messages>(put: $messages);
        foreach ($tables->configs as const &$t) {
            $load = $t->call;
            try $load($env, $b);
        }
        // the generated commands' classes first, so an extension may replace one
        $commands = Commands($generated);
        foreach ($extensions as &$ext) {
            $ext->commands($commands);
        }
        foreach ($commands->problems() as const &$p) {
            return .error(.extension('nexus', $p));
        }
        $commands->bindInto($b);
        $s = Services($b, $generated);
        foreach ($extensions as &$ext) {
            try $ext->services($s);
            foreach ($s->problems as const &$p) {
                return .error($p);
            }
        }
        // the router everything was handed while wiring, filled now
        $router = $s->router;
        foreach ($s->routes() as const &$r) {
            guard $router->add($r) else ($e) {
                return .error(.route($e));
            };
        }
        string $raw = $env->get('NEXUS_APP_URL') ?? '';
        if (!$raw->empty()) {
            Url $origin = guard Url::parse($raw) else ($e) {
                return .error(.config([.invalid('NEXUS_APP_URL', $e->message())]));
            };
            if (!$origin->absolute()) {
                return .error(.config([.invalid('NEXUS_APP_URL', "'{$raw}' is not absolute; give a scheme and a host")]));
            }
            $router->origin($origin);
        }
        $root = $b->seal(warm: true);

        foreach ($router->routes() as const &$r) {
            $bound = $r->bound;
            if (!$bound($root)) {
                return .error(.route(.unbound($r->action)));
            }
            foreach ($r->middleware as const &$ref) {
                $has = $ref->bound;
                if (!$has($root)) {
                    return .error(.extension('nexus', "{$r->action} goes through {$ref->name}, which is not bound; bind it in the app's services"));
                }
            }
        }
        foreach ($s->around as const &$ref) {
            $has = $ref->bound;
            if (!$has($root)) {
                return .error(.extension('nexus', "every request goes through {$ref->name}, which is not bound; bind it in the app's services"));
            }
        }
        foreach ($inputs->rules as const &$rule) {
            $has = $rule->bound;
            if (!$has($root)) {
                return .error(.extension('nexus', "rule class {$rule->name} is not bound; bind it in the app's services like an action"));
            }
        }

        $p = Pipeline();
        foreach ($extensions as &$ext) {
            $ext->middleware($p, $root);
        }
        $k = Kernel(mv $extensions, $mode, $log, $env, $root, $router, $p->links, $s->around, $generated);
        // every binding once, in a throwaway request: a missing one, a cycle
        // or a once binding that takes a per-request one stops the boot here
        // with its chain, not some request later
        $probe = $k->background('boot', 'probe');
        $probe->services->probe();
        Kernel::finish($probe);
        foreach ($k->extensions as &$ext) {
            try $ext->boot($k);
        }
        return .ok($k);
    }

    /**
     * Answers one request: the extensions' middleware, the app's, routing, the route's middleware,
     * the action's `#[nexus::through]`, the action. Safe to call from many threads at once.
     */
    public function handle(Request $request) : Response
    {
        time::instant $start = .now();
        Request $req = mv $request;
        if (!Kernel::sane($req->header('X-Request-Id') ?? '')) {
            $req->id = Kernel::id();
        } else {
            $req->id = $req->header('X-Request-Id') ?? '';
        }
        $scope = $this->services->child();
        $scope->put<Request>($req);
        $log = $this->log->with(['req' => $req->id]);
        $scope->put<Logger>($log);
        $payload = Payload($req, $scope, $this->mode, $log);

        Kernel $self = $this;
        array<Middleware> $links = $this->global;
        if (!$this->around->empty()) {
            foreach (MiddlewareRef::make($this->around, $scope) as const &$m) {
                $links[] = $m;
            }
        }
        $chain = Chain(mv $links, function(Payload& $ctx) : Response {
            return $self->route($ctx);
        });
        $next = Next(mv $chain);
        $res = $next->run($payload);
        $res->header('X-Request-Id', $req->id);
        if ($req->method == Method::head) {
            $res->body = '';
        }
        $this->served->add(1);

        float64 $ms = ($start->elapsed()->as_micros() as float64) / 1000.0;
        string $line = "{$req->method->verb()} {$req->path} {$res->status}";
        if ($res->status >= 500) {
            $payload->log->warn($line, ['ms' => $ms, 'action' => $payload->action]);
        } else {
            $payload->log->info($line, ['ms' => $ms, 'action' => $payload->action]);
        }
        $scope->drop();
        return $res;
    }

    /**
     * A payload for work that is not a request: a task, a scheduled run, a command. It has its own
     * child container, so services bound with `scope:` (a database session) are fresh, and a log
     * stamped with `$what` and `$id`. Drop it with `finish` when the work is done.
     */
    public function background(const string& $what, const string& $id) : Payload
    {
        $req = Request(.post, "/{$what}");
        $req->id = $id;
        $scope = $this->services->child();
        $scope->put<Request>($req);
        $log = $this->log->with(['work' => $what, 'id' => $id]);
        $scope->put<Logger>($log);
        $payload = Payload(mv $req, $scope, $this->mode, $log);
        $payload->action = $what;
        $payload->door = .work;
        return $payload;
    }

    /**
     * Releases what a background payload holds.
     */
    public static function finish(Payload& $payload) : void
    {
        $payload->services->drop();
    }

    /**
     * Sixteen hex characters of fresh randomness, for ids.
     */
    public static function id() : string
    {
        string $bytes = guard crypto::random(8) else {
            return str::from(time::timestamp::now()->unix_nanos());
        };
        return crypto::hex($bytes);
    }

    /**
     * How many requests this kernel answered.
     */
    public const function served() : int64
    {
        return $this->served->load();
    }

    /**
     * Every extension's `start` hook, in order. When one fails, the ones already started are
     * drained again.
     */
    public function start(const Serve& $options) : status<BootError>
    {
        usize $i = 0;
        while ($i < $this->extensions->count()) {
            guard $this->extensions[$i]->start($this, $options) else ($e) {
                while ($i > 0) {
                    $i = $i - 1;
                    $this->extensions[$i]->drain($this);
                }
                return .error($e);
            };
            $i = $i + 1;
        }
        return .ok;
    }

    /**
     * Every extension's `drain` hook, last started first.
     */
    public function drain() : void
    {
        usize $n = $this->extensions->count();
        while ($n > 0) {
            $n = $n - 1;
            $this->extensions[$n]->drain($this);
        }
    }

    /**
     * Every extension's shutdown hook, last booted first, then the container's.
     */
    public function shutdown() : void
    {
        usize $n = $this->extensions->count();
        while ($n > 0) {
            $n = $n - 1;
            $this->extensions[$n]->shutdown($this);
        }
        $this->services->drop();
        $this->log->flush();
    }

    /**
     * The transport of the first extension that brings one.
     */
    public function transport() : Transport?
    {
        foreach ($this->extensions as &$ext) {
            Transport? $t = $ext->transport();
            if ($t != null) {
                return $t;
            }
        }
        return null;
    }

    internal function route(Payload& $payload) : Response
    {
        map<string, string> $params = [];
        array<Method> $allow = [];
        Route $route = guard $this->router->find($payload->request->method, $payload->request->path, $params, $allow) else {
            if ($allow->empty()) {
                return $payload->fail(.notFound($payload->request->path));
            }
            if ($payload->request->method == Method::options) {
                array<string> $verbs = [];
                foreach ($allow as const &$m) {
                    $verbs[] = $m->verb();
                }
                $opts = Response(204);
                $opts->header('Allow', str::join($verbs, ', '));
                return $opts;
            }
            return $payload->fail(.methodNotAllowed(mv $allow));
        };
        $payload->request->params = mv $params;
        $payload->action = $route->action;
        if ($route->middleware->empty()) {
            $dispatch = $route->dispatch;
            return $dispatch($payload);
        }
        $next = Next(Chain(MiddlewareRef::make($route->middleware, $payload->services), $route->dispatch));
        return $next->run($payload);
    }

    /**
     * Whether an incoming request id is safe to adopt: 1 to 64 characters of letters, digits, `-`,
     * `_` and `.`.
     */
    internal static function sane(const string& $id) : bool
    {
        if ($id->empty() || $id->size() > 64) {
            return false;
        }
        usize $i = 0;
        while ($i < $id->size()) {
            uint8 $c = $id->byte($i);
            bool $ok = ($c >= 48 && $c <= 57) || ($c >= 65 && $c <= 90) || ($c >= 97 && $c <= 122) || $c == 45 || $c == 95 || $c == 46;
            if (!$ok) {
                return false;
            }
            $i = $i + 1;
        }
        return true;
    }
}
