namespace nexus;

use nexus::trace;

/**
 * Everything one request carries through middleware and the action: the request, its own child
 * container, the mode and a log stamped with the request id. The container holds the services bound
 * with `scope:` (a database session, the repositories on it) and the state middleware learned on
 * the way, such as who signed the request. Middleware puts that state, the action reads it:
 *
 * ```echo
 * #[nexus::through: ["blog::RequireUser"]]
 * public class CreatePost : nexus::Action
 * {
 *     public function handle(nexus::Payload& $payload, nexus::Body<NewPost> $in) : result<nexus::Response, nexus::Problem>
 *     {
 *         Caller $me = try $payload->state<Caller>();
 *         ...
 *     }
 * }
 * ```
 */
public struct Payload
{
    public Request $request;
    public container::Container $services;
    public Mode $mode;
    public Logger $log;
    public string $action = '';

    /**
     * The route the request matched, found before any middleware runs, so a global middleware can
     * tell which action it guards. Null when nothing answers the path and method; routing then
     * answers 404 or 405 once the middleware let the request through.
     */
    public Route? $route = null;

    /**
     * The methods that would have answered when `route` is null, empty when the path is unknown.
     */
    public array<Method> $allow = [];

    /**
     * How the work came in: `.http` for a request, `.cli`, `.mcp` or `.work` for the other doors.
     */
    public Door $door = .http;

    /**
     * The timeline this request is recorded on, null unless someone watches (the debug console).
     * Middleware and the action mark themselves on it.
     */
    public trace::Trace? $trace = null;

    /**
     * The service of type `T` for this request.
     */
    public function get<T>() : T
    {
        return $this->services->get<T>();
    }

    /**
     * The service or value of type `T`, or null when nothing provides it.
     */
    public function find<T>() : T?
    {
        return $this->services->find<T>();
    }

    /**
     * What a middleware put for this request with `put`. None did is a mistake in the wiring, not
     * in the request: a 500, logged, naming the action.
     */
    public function state<T>() : result<T, Problem>
    {
        T $value = guard $this->services->find<T>() else {
            return .error(.server("{$this->action} reads state no middleware put in its payload; name the middleware that puts it in the action's #[nexus::through]"));
        };
        return .ok($value);
    }

    /**
     * Leaves `$value` for whatever runs later in this request: the state a middleware learned, for
     * `state<T>()`.
     */
    public function put<T>(construct T $value) : void
    {
        $this->services->put<T>(mv $value);
    }

    /**
     * Makes `$log` the logger of this work, for the action and for the scoped services that ask the
     * container for a `nexus::Logger`.
     */
    public function useLog(Logger $log) : void
    {
        $this->log = $log;
        $this->services->put<Logger>($log);
    }

    /**
     * The app's public origin, `https://blog.example.com`, without a trailing slash: `NEXUS_APP_URL`
     * when it is set, else where the client reached the app (`Request::origin()`). What issuers,
     * resource URLs and absolute links in an answer are written on.
     */
    public function origin() : string
    {
        Router? $router = $this->services->find<Router>();
        if ($router != null) {
            Router $r = guard $router;
            Url? $base = $r->origin();
            if ($base != null) {
                Url $b = guard $base;
                string $text = $b->text();
                while ($text->ends('/')) {
                    $text = $text->sub(0, $text->size() - 1)->clone();
                }
                return $text;
            }
        }
        return $this->request->origin();
    }

    /**
     * `$url` as it is when it names a host, else on `origin()`: where a configured page like
     * `/connect` sends the browser. Null when the origin is no URL (a Host header that names no
     * host).
     */
    public function absolute(const Url& $url) : Url?
    {
        if ($url->absolute()) {
            return $url;
        }
        Url $base = guard Url::parse($this->origin()) else {
            return null;
        };
        return $url->on($base);
    }

    /**
     * A path parameter, or null.
     */
    public const function param(const string& $name) : string?
    {
        return $this->request->param($name);
    }

    /**
     * `$p` rendered for this request, logged first when it is the server's fault.
     */
    public function fail(const Problem& $p) : Response
    {
        if ($p->fault()) {
            $this->log->error('request failed', ['status' => $p->status(), 'detail' => $p->detail(.dev)]);
        }
        if ($p->fields()->empty()) {
            return $p->response($this->mode, $this->request->id);
        }
        string $locale = $this->locale();
        $shown = $this->localized($p, $locale);
        $r = $shown->response($this->mode, $this->request->id);
        $r->header('Content-Language', $locale);
        return $r;
    }

    /**
     * `$p` with its field messages in the language this request speaks, through the bound
     * `Messages`; as it is without one.
     */
    public function localized(const Problem& $p) : Problem
    {
        return $this->localized($p, $this->locale());
    }

    internal function localized(const Problem& $p, const string& $locale) : Problem
    {
        Messages $m = guard $this->find<Messages>() else {
            return $p;
        };
        return $m->translate($p, $locale);
    }

    /**
     * The locale this request speaks, `en` without a bound `Messages`.
     */
    public function locale() : string
    {
        Messages $m = guard $this->find<Messages>() else {
            return 'en';
        };
        return $m->locale($this);
    }
}
