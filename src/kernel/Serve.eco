namespace nexus;

use std::time;

/**
 * How `serve` runs: address, port, worker threads (0 means one per core), and whether the
 * background work of the extensions runs too (`--no-work`, `--no-schedule`). What a transport
 * accepts (body size, timeouts) is its own config.
 */
public struct Serve
{
    public string $host = '127.0.0.1';
    public uint16 $port = 3246;
    public uint32 $workers = 0;

    /**
     * How long the requests in flight get to finish once `serve` is told to stop
     * (`NEXUS_SHUTDOWN_GRACE`); then, or at a second signal, the process quits without them.
     */
    public time::duration $grace = .secs(30);

    /**
     * Whether task workers run in this process.
     */
    public bool $work = true;

    /**
     * Whether scheduled tasks are pushed from this process.
     */
    public bool $schedule = true;

    /**
     * Parses `host:port`, `[ipv6]:port`, `:port` or a bare port into `$host` and `$port`; an IPv6
     * host is kept without its brackets. Refuses a port that is not a number from 1 to 65535, and
     * an IPv6 address without brackets: `1::2:3` is an address of its own, not `[1::2]:3`.
     */
    public function listen(const string& $address) : status<ConfigError>
    {
        string $a = str::trim($address);
        string $portText = $a;
        if ($a->starts('[')) {
            usize $close = $a->find(']');
            if ($close + 1 >= $a->size() || $a->byte($close + 1) != 58) {
                return .error(.invalid('listen', "'{$address}' has no port from 1 to 65535"));
            }
            $this->host = $a->sub(1, $close - 1)->clone();
            $portText = $a->sub($close + 2, $a->size() - $close - 2);
        } else {
            usize $colon = $a->find(':');
            if ($colon < $a->size()) {
                if ($a->find(':', $colon + 1) < $a->size()) {
                    return .error(.invalid('listen', "'{$address}': an IPv6 address goes in brackets, [host]:port"));
                }
                string $host = $a->sub(0, $colon)->clone();
                if (!$host->empty()) {
                    $this->host = $host;
                }
                $portText = $a->sub($colon + 1, $a->size() - $colon - 1);
            }
        }
        uint64 $p = guard str::uint($portText) else {
            return .error(.invalid('listen', "'{$address}' has no port from 1 to 65535"));
        };
        if ($p == 0 || $p > 65535) {
            return .error(.invalid('listen', "'{$address}' has no port from 1 to 65535"));
        }
        $this->port = $p as uint16;
        return .ok;
    }

    /**
     * `host:port` as `listen` reads it back, an IPv6 host in brackets.
     */
    public const function address() : string
    {
        if ($this->host->contains(':')) {
            return "[{$this->host}]:{$this->port}";
        }
        return "{$this->host}:{$this->port}";
    }
}
