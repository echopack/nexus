namespace nexus;

use container::{Builder, Container, Entry};

/**
 * What an extension wires the app with in `services()`: the container (every `bind` of
 * `container::Builder` works here too), the routes and the listeners, in one place. `nexus gen`
 * only knows how each action runs; where it answers is said here.
 *
 * ```echo
 * public function services(nexus::Services& $s) : status<nexus::BootError>
 * {
 *     $s->bind<SignIn>(scope: function(Container $c) : SignIn {
 *         return SignIn($c->get<UserRepository>(), $c->get<nexus::auth::Logins>());
 *     });
 *     $s->bindAction<Login>(method: .post, path: '/v1/auth/token', function(Container $c) : Login {
 *         return Login($c->get<SignIn>(), $c->get<nexus::auth::Tokens>());
 *     });
 *     $s->listen<UserRegistered, WelcomeNewUser>();
 *     return .ok;
 * }
 * ```
 */
public class Services
{
    /**
     * The container being built, for what this class does not pass on (`install`, `overlay`).
     */
    public Builder $builder;

    /**
     * What `nexus gen` wrote for the program.
     */
    public Generated $generated;

    /**
     * The app's events, which `listen` adds to.
     */
    public Events $events;

    /**
     * The route table, bound in the container. It is empty while the app is wired and filled at
     * boot, so take it now and build links when a request comes.
     */
    public Router $router;

    internal array<Wiring> $wirings = [];
    internal array<MiddlewareRef> $around = [];
    internal array<BootError> $problems = [];

    public constructor(Builder $builder, Generated $generated, Events $events)
    {
        $this->builder = $builder;
        $this->generated = $generated;
        $this->events = $events;
        $this->router = Router();
        $builder->bind<Router>(put: $this->router);
        $builder->name<Router>('nexus::Router');
    }

    // the container ----------------------------------------------------------

    /**
     * Binds `T` as a singleton.
     */
    public function bind<T>(once: function<T()> $make) : Entry<T>
    {
        return $this->builder->bind<T>(once: $make);
    }

    /**
     * Binds `T` as a singleton built from the container.
     */
    public function bind<T>(once: function<T(Container)> $make) : Entry<T>
    {
        return $this->builder->bind<T>(once: $make);
    }

    /**
     * Binds `T` fresh on every `get`.
     */
    public function bind<T>(each: function<T()> $make) : Entry<T>
    {
        return $this->builder->bind<T>(each: $make);
    }

    /**
     * Binds `T` fresh on every `get`, built from the container.
     */
    public function bind<T>(each: function<T(Container)> $make) : Entry<T>
    {
        return $this->builder->bind<T>(each: $make);
    }

    /**
     * Binds `T` once per request (per child container).
     */
    public function bind<T>(scope: function<T()> $make) : Entry<T>
    {
        return $this->builder->bind<T>(scope: $make);
    }

    /**
     * Binds `T` once per request (per child container), built from the container.
     */
    public function bind<T>(scope: function<T(Container)> $make) : Entry<T>
    {
        return $this->builder->bind<T>(scope: $make);
    }

    /**
     * Binds an already built `T`, shared.
     */
    public function bind<T>(put: construct T $value) : Entry<T>
    {
        return $this->builder->bind<T>(put: $value);
    }

    /**
     * Binds a plain value `T`, such as a config struct.
     */
    public function param<T>(construct T $value) : Entry<T>
    {
        return $this->builder->param<T>($value);
    }

    /**
     * Replaces the binding of `T` an earlier extension made, as a singleton.
     */
    public function replace<T>(once: function<T()> $make) : Entry<T>
    {
        return $this->builder->replace<T>(once: $make);
    }

    /**
     * Replaces the binding of `T` as a singleton built from the container.
     */
    public function replace<T>(once: function<T(Container)> $make) : Entry<T>
    {
        return $this->builder->replace<T>(once: $make);
    }

    /**
     * Replaces the binding of `T`, fresh on every `get`.
     */
    public function replace<T>(each: function<T()> $make) : Entry<T>
    {
        return $this->builder->replace<T>(each: $make);
    }

    /**
     * Replaces the binding of `T`, fresh on every `get`, built from the container.
     */
    public function replace<T>(each: function<T(Container)> $make) : Entry<T>
    {
        return $this->builder->replace<T>(each: $make);
    }

    /**
     * Replaces the binding of `T`, once per request.
     */
    public function replace<T>(scope: function<T()> $make) : Entry<T>
    {
        return $this->builder->replace<T>(scope: $make);
    }

    /**
     * Replaces the binding of `T`, once per request, built from the container.
     */
    public function replace<T>(scope: function<T(Container)> $make) : Entry<T>
    {
        return $this->builder->replace<T>(scope: $make);
    }

    /**
     * Replaces the binding of `T` with an already built one.
     */
    public function replace<T>(put: construct T $value) : Entry<T>
    {
        return $this->builder->replace<T>(put: $value);
    }

    /**
     * Makes `get<I>()` answer the binding of class `C`.
     */
    public function alias<I, C>() : Entry<I>
    {
        return $this->builder->alias<I, C>();
    }

    /**
     * The already built `T` (a `put` or a `param`); a factory that has not run stops the program.
     */
    public function get<T>() : T
    {
        return $this->builder->get<T>();
    }

    /**
     * The already built `T`, or null.
     */
    public function find<T>() : T?
    {
        return $this->builder->find<T>();
    }

    /**
     * Whether `T` is bound.
     */
    public const function has<T>() : bool
    {
        return $this->builder->has<T>();
    }

    // actions ----------------------------------------------------------------

    /**
     * Routes `$method` `$path` to action `A`, built with `A()` once per request.
     */
    public function bindAction<A>(method: Method $method, path: const string& $path) : ActionRef<A>
    {
        $this->builder->bind<A>(scope: function() : A {
            return A();
        });
        return $this->route<A>(method: $method, path: $path);
    }

    /**
     * Routes `$method` `$path` to action `A`, built by `$make` once per request.
     */
    public function bindAction<A>(method: Method $method, path: const string& $path, function<A(Container)> $make) : ActionRef<A>
    {
        $this->builder->bind<A>(scope: $make);
        return $this->route<A>(method: $method, path: $path);
    }

    /**
     * Routes `$method` `$path` to action `A`, bound already (by a `bindAction` or a `bind`). The
     * same path again adds the method to that route; another path gives `A` a second route.
     */
    public function route<A>(method: Method $method, path: const string& $path) : ActionRef<A>
    {
        type_id $id = type_id<A>();
        foreach ($this->wirings as &$w) {
            if ($w->action == $id && $w->source == $path) {
                $w->route->methods[] = $method;
                return ActionRef<A>($this, $w);
            }
        }
        array<Method> $methods = [$method];
        string $name = $this->generated->nameOf<A>("the action at {$method->verb()} {$path}");
        $bound = function(Container $services) : bool {
            return $services->has<A>();
        };
        $none = function(Payload& $payload) : Response {
            return $payload->fail(.notFound($payload->request->path));
        };
        $w = Wiring($id, $path, Route(mv $methods, $path, $name, $none, $bound));
        $w->route->type = $id;
        Dispatcher $d = guard $this->generated->dispatcher<A>() else {
            $this->problems[] = .route(.undispatched($name));
            return ActionRef<A>($this, $w);
        };
        $constrained = Services::constrain($path, $d->params);
        guard Services::fits($name, $constrained, $d->params) else ($e) {
            $this->problems[] = .route($e);
            return ActionRef<A>($this, $w);
        };
        $w->route->path = mv $constrained;
        $w->route->dispatch = $d->dispatch;
        $w->through = $d->through;
        $this->wirings[] = $w;
        return ActionRef<A>($this, $w);
    }

    /**
     * Adds a route built by hand, with its own dispatch: for a test, or for an action `nexus gen`
     * does not see.
     */
    public function route(Route $route) : void
    {
        $this->wirings[] = Wiring(type_id<Route>(), $route->path, $route);
    }

    /**
     * Wraps every request in middleware `M`, taken from the request's container each time, so it
     * may depend on request-scoped services. It runs after the extensions' own middleware and
     * before routing, in the order added; tasks and commands do not go through it.
     */
    public function middleware<M>() : void
    {
        $this->around[] = MiddlewareRef::of<M>($this->generated->nameOf<M>('middleware'));
    }

    // events -----------------------------------------------------------------

    /**
     * Runs listener `L` whenever an `E` is emitted.
     */
    public function listen<E, L>() : void
    {
        string $name = $this->generated->nameOf<L>('a listener');
        $this->events->on<E>($name, function(Payload& $payload, const E& $e) : status<Problem> {
            return L::handle($payload, $e);
        });
    }

    /**
     * Runs `$listener` whenever an `E` is emitted; `$name` is what logs call it.
     */
    public function on<E>(const string& $name, function<status<Problem>(Payload&, const E&)> $listener) : void
    {
        $this->events->on<E>($name, $listener);
    }

    // problems ---------------------------------------------------------------

    /**
     * Records why the app cannot boot, for a helper that has no status to return; the kernel stops
     * after `services()` with the first one.
     */
    public function fail(BootError $why) : void
    {
        $this->problems[] = $why;
    }

    internal const function routes() : array<Route>
    {
        array<Route> $out = [];
        foreach ($this->wirings as const &$w) {
            $out[] = $w->built();
        }
        return $out;
    }

    /**
     * Writes the constraint an integer parameter implies into `{name}` segments that state none.
     */
    internal static function constrain(const string& $path, const array<PathParam>& $params) : string
    {
        string $out = $path;
        foreach ($params as const &$p) {
            if ($p->constraint->empty()) {
                continue;
            }
            $out = str::replace($out, "\{{$p->name}}", "\{{$p->name}:{$p->constraint}}");
            $out = str::replace($out, "\{{$p->name}?}", "\{{$p->name}:{$p->constraint}?}");
        }
        return $out;
    }

    /**
     * Whether `$path` gives every path parameter `handle()` reads, and leaves out only the ones it
     * may do without.
     */
    internal static function fits(const string& $action, const string& $path, const array<PathParam>& $params) : status<RouteError>
    {
        Pattern $pattern = try Pattern::parse($path);
        foreach ($params as const &$p) {
            bool $found = false;
            foreach ($pattern->segments as const &$seg) {
                if ($seg->kind == SegmentKind::literal || $seg->text != $p->name) {
                    continue;
                }
                $found = true;
                if ($seg->kind == SegmentKind::optional && !$p->optional) {
                    return .error(.param($action, $path, "\{{$p->name}?} may be left out, so handle() must take ${$p->name} nullable or with a default"));
                }
            }
            if (!$found) {
                return .error(.param($action, $path, "handle() takes ${$p->name}, but the path has no \{{$p->name}}; a loose parameter comes from the path, a query from nexus::QueryOf<T>"));
            }
        }
        return .ok;
    }
}
