namespace nexus;

/**
 * What a path parameter admits. `nexus gen` derives it from the type of the `handle()` parameter of
 * the same name (`int64 $id` is `number`), or the path says it: `{slug:slug}`.
 */
public enum Constraint : uint8
{
    case any = 0;
    case number = 1;
    case integer = 2;
    case alpha = 3;
    case alphanum = 4;
    case uuid = 5;
    case slug = 6;

    public const function name() : string
    {
        return match ($this) {
            Constraint::any => 'any',
            Constraint::number => 'number',
            Constraint::integer => 'integer',
            Constraint::alpha => 'alpha',
            Constraint::alphanum => 'alphanum',
            Constraint::uuid => 'uuid',
            Constraint::slug => 'slug',
        };
    }

    /**
     * Whether a decoded, non-empty segment satisfies this constraint.
     */
    public const function admits(const string& $value) : bool
    {
        if ($value->empty()) {
            return false;
        }
        if ($this == Constraint::any) {
            return true;
        }
        if ($this == Constraint::uuid) {
            return Constraint::isUuid($value);
        }
        usize $i = 0;
        while ($i < $value->size()) {
            uint8 $c = $value->byte($i);
            bool $digit = $c >= 48 && $c <= 57;
            bool $letter = ($c >= 65 && $c <= 90) || ($c >= 97 && $c <= 122);
            bool $ok = false;
            if ($this == Constraint::number) {
                $ok = $digit;
            } else if ($this == Constraint::integer) {
                $ok = $digit || ($i == 0 && $c == 45 && $value->size() > 1);
            } else if ($this == Constraint::alpha) {
                $ok = $letter;
            } else if ($this == Constraint::alphanum) {
                $ok = $letter || $digit;
            } else {
                $ok = ($c >= 97 && $c <= 122) || $digit || $c == 45;
            }
            if (!$ok) {
                return false;
            }
            $i = $i + 1;
        }
        return true;
    }

    public static function parse(const string& $name) : Constraint?
    {
        if ($name == 'any') { return Constraint::any; }
        if ($name == 'number') { return Constraint::number; }
        if ($name == 'integer') { return Constraint::integer; }
        if ($name == 'alpha') { return Constraint::alpha; }
        if ($name == 'alphanum') { return Constraint::alphanum; }
        if ($name == 'uuid') { return Constraint::uuid; }
        if ($name == 'slug') { return Constraint::slug; }
        return null;
    }

    internal static function isUuid(const string& $v) : bool
    {
        if ($v->size() != 36) {
            return false;
        }
        usize $i = 0;
        while ($i < 36) {
            uint8 $c = $v->byte($i);
            if ($i == 8 || $i == 13 || $i == 18 || $i == 23) {
                if ($c != 45) {
                    return false;
                }
            } else {
                bool $hex = ($c >= 48 && $c <= 57) || ($c >= 97 && $c <= 102) || ($c >= 65 && $c <= 70);
                if (!$hex) {
                    return false;
                }
            }
            $i = $i + 1;
        }
        return true;
    }
}
