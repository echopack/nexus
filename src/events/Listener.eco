namespace nexus;

/**
 * Marks a struct as a listener of event `E`: its static `handle` runs,
 * in the emitting request, whenever an `E` is emitted. The app wires it
 * with `$s->listen<UserRegistered, WelcomeNewUser>()`.
 *
 * ```echo
 * public struct WelcomeNewUser : nexus::Listener<UserRegistered>
 * {
 *     public static function handle(nexus::Payload& $payload, const UserRegistered& $e) : status<nexus::Problem>
 *     {
 *         return SendWelcomeTask::push($payload, SendWelcome($user: $e->user));
 *     }
 * }
 * ```
 */
public interface Listener<E>
{
    static function handle(Payload& $payload, const E& $e) : status<Problem>;
}
