namespace nexus;

/**
 * Typed events and their listeners, across every module of the program. An event is any struct. A
 * listener is a struct conforming to `nexus::Listener<E>`, with a static
 * `handle(nexus::Payload&, const E&)`, wired with `$s->listen<E, L>()` in an extension's
 * `services()`, so an app can listen to what a library emits. `emit` runs the listeners in the
 * request or task that emits, in the order they were wired, and stops at the first problem. Work
 * that should not hold up the caller goes to a task the listener pushes.
 *
 * ```echo
 * public struct UserRegistered { public int64 $user; }
 *
 * public struct WelcomeNewUser : nexus::Listener<UserRegistered>
 * {
 *     public static function handle(nexus::Payload& $payload, const UserRegistered& $e) : status<nexus::Problem>
 *     {
 *         return SendWelcomeTask::push($payload, SendWelcome($user: $e->user));
 *     }
 * }
 *
 * $s->listen<UserRegistered, WelcomeNewUser>();
 *
 * try nexus::Events::emit($payload, UserRegistered($user: $u->id));
 * ```
 *
 * The registry is filled while the kernel boots and only read afterwards.
 */
#[atomic]
public class Events
{
    internal ordered_map<type_id, erased> $byType = ordered_map<type_id, erased>();
    internal array<string> $names = [];

    /**
     * Adds a listener for events of type `E`, named for logs and listings. Boot time only.
     */
    public function on<E>(const string& $name, function<status<Problem>(Payload&, const E&)> $listener) : void
    {
        type_id $id = type_id<E>();
        if (!$this->byType->has($id)) {
            $fresh = Listeners<E>();
            $this->byType[$id] = erased::from($fresh);
        }
        $all = $this->listenersOf<E>($id);
        $all->names[] = $name;
        $all->calls[] = $listener;
        $this->names[] = $name;
    }

    /**
     * How many listeners events of type `E` have.
     */
    public const function count<E>() : usize
    {
        type_id $id = type_id<E>();
        if (!$this->byType->has($id)) {
            return 0;
        }
        Listeners<E> $all = $this->listenersOf<E>($id);
        return $all->calls->count();
    }

    /**
     * Every listener's name, in the order they were added.
     */
    public const function listeners() : array<string>
    {
        return $this->names;
    }

    /**
     * Runs every listener of `E` with `$event`; the first problem stops the rest and comes back.
     */
    public function run<E>(Payload& $payload, const E& $event) : status<Problem>
    {
        type_id $id = type_id<E>();
        if (!$this->byType->has($id)) {
            return .ok;
        }
        Listeners<E> $all = $this->listenersOf<E>($id);
        usize $i = 0;
        while ($i < $all->calls->count()) {
            function<status<Problem>(Payload&, const E&)> $call = $all->calls[$i];
            guard $call($payload, $event) else ($p) {
                $payload->log->debug('listener refused', ['listener' => $all->names[$i]]);
                return .error($p);
            };
            $i = $i + 1;
        }
        return .ok;
    }

    /**
     * Runs every listener of `E` with `$event`, through the app's registry.
     */
    public static function emit<E>(Payload& $payload, const E& $event) : status<Problem>
    {
        $ev = $payload->get<Events>();
        return $ev->run<E>($payload, $event);
    }

    internal const function listenersOf<E>(type_id $id) : Listeners<E>
    {
        unsafe {
            Listeners<E> $all = assume<Listeners<E>>($this->byType->get($id));
            return $all;
        }
    }
}
