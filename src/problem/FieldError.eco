namespace nexus;

/**
 * Why one input field was refused. `$code` is stable for clients to switch on (`required`, `type`,
 * `min`, `max`, `email`, `oneOf`, ...) and `$params` holds what the rule was given (`min: 3`);
 * `$message` is for people, in English until `nexus::Messages` renders it in the request's
 * language.
 */
public struct FieldError
{
    /**
     * Where the field is in the whole input: `title`, `posts.1.title`, `tags.2`.
     */
    public string $field;
    public string $code;
    public string $message;
    public ordered_map<string, string> $params;

    /**
     * The input type the field belongs to, `blog::NewPost`, and the field's own name there, without
     * the path: what message catalogs are keyed by.
     */
    public string $input = '';
    public string $name = '';

    /**
     * What the field holds: `string`, `integer`, `number`, `boolean`, `list`, `date`, `timestamp`,
     * `enum` or `object`. A rule like `min` reads differently for each.
     */
    public string $kind = '';

    /**
     * How the message calls the field, in English: `#[nexus::label]`, or the field's name made
     * readable.
     */
    public string $label = '';

    /**
     * The English message before its holes were filled:
     * `The {label} field must be at least {min} characters.`
     */
    public string $template = '';

    public constructor(const string& $field, const string& $code, const string& $message)
    {
        $this->field = $field;
        $this->code = $code;
        $this->message = $message;
        $this->params = ordered_map<string, string>();
        $this->template = $message;
    }

    public const function json() : json::Value
    {
        $o = json::object();
        $o['field'] = json::str($this->field);
        $o['code'] = json::str($this->code);
        $o['message'] = json::str($this->message);
        $p = json::object();
        foreach ($this->params as $k => const &$v) {
            $p[$k] = json::str($v);
        }
        $o['params'] = mv $p;
        return $o;
    }

    /**
     * `$template` with `{label}` and every `{param}` filled in.
     */
    public static function fill(const string& $template, const string& $label, const ordered_map<string, string>& $params) : string
    {
        string $out = str::replace($template, '{label}', $label);
        foreach ($params as $k => const &$v) {
            $out = str::replace($out, "\{{$k}}", $v);
        }
        return $out;
    }

    /**
     * A field name as words: `passwordConfirmation` is `password
     * confirmation`, `created_at` is `created at`.
     */
    public static function readable(const string& $name) : string
    {
        string $out = '';
        usize $i = 0;
        while ($i < $name->size()) {
            uint8 $b = $name->byte($i);
            if ($b >= 65 && $b <= 90) {
                if ($i > 0) {
                    $out->push(32);
                }
                $out->push($b + 32);
            } else if ($b == 95 || $b == 45) {
                $out->push(32);
            } else {
                $out->push($b);
            }
            $i = $i + 1;
        }
        return $out;
    }
}
