        $this->role = RoleColumn($this->carbonTable->column<int64>('role'));
        $this->welcomedAt = $this->carbonTable->column<hydrahon::DateTime?>('welcomed_at');
        $this->createdAt = $this->carbonTable->column<hydrahon::DateTime?>('created_at');
        $this->updatedAt = $this->carbonTable->column<hydrahon::DateTime?>('updated_at');
    }

    public const function table() : hydrahon::Table
    {
        return $this->carbonTable;
    }
}

/**
 * What a query for `User` models gathers: the field a query struct keeps.
 */
public type UserRows = carbon::Rows<blog::User, int64, blog::UserTable>;

/**
 * A query for `User` models. Declare a struct conforming to
 * `carbon::Query<User, …>` in its place to give it scopes of its own.
 */
public struct UserQuery : carbon::Query<blog::User, UserQuery>
{
    internal UserRows $rows;

    public constructor(carbon::Session $session)
    {
        $this->rows = UserRows($session);
    }

    public function rows() : UserRows&
    {
        return $this->rows;
    }
}

/**
 * The repository of `User` models: writes and queries, nothing of its own. Declare a
 * struct conforming to `carbon::Repository<User, …>` in its place for finders and hooks.
 */
public struct UserRepository : carbon::Repository<blog::User, blog::UserQuery, int64>, UserWiring
{
    public carbon::Session $session;
}

/**
 * What a repository of `User` models reaches through carbon: its session and the model's
 * store. A repository written by hand names it and keeps its session in `$session`:
 * `UserRepository : carbon::Repository<User, …>, UserWiring`.
 */
public interface UserWiring
{
    /**
     * The session the repository was built for.
     */
    function session() : carbon::Session
    {
        return $this->session;
    }

    /**
     * The store of `User` models, shared by every session.
     */
    function store() : carbon::Store<blog::User, int64, blog::UserTable>
    {
        carbon::Session $s = $this->session();
        return $s->store<blog::User, int64, blog::UserTable>();
    }
}

/**
 * A column holding a `Role`, compared and assigned with its cases.
 */
public struct RoleColumn
{
    /**
     * The column as hydrahon sees it, for anything else that takes a term.
     */
    public hydrahon::Term<int64> $term;

    /**
     * The condition that the column holds `$case`. The same as `==`, and the spelling to use
     * inside `&&` and `||`, where an operator of a generated type is not picked.
     */
    public const function is(blog::Role $case) : hydrahon::Term<bool>
    {
        int64 $raw = $case->value() as int64;
        return $this->term == $raw;
    }

    /**
     * The condition that the column holds any of `$cases`.
     */
    public const function in(const array<blog::Role>& $cases) : hydrahon::Term<bool>
    {
        array<int64> $raw = [];
        foreach ($cases as const &$v) {
            $raw[] = $v->value() as int64;
        }
        return $this->term in $raw;
    }

    /**
     * Ascending order on the column's stored value: `->order([PostTable::$status->asc()])`.
     */
    public const function asc() : hydrahon::Order
    {
        return $this->term->asc();
    }

    /**
     * Descending order on the column's stored value.
     */
    public const function desc() : hydrahon::Order
    {
        return $this->term->desc();
    }
}

operator (RoleColumn $column) == (blog::Role $case) : hydrahon::Term<bool>
{
    return $column->is($case);
}

operator (RoleColumn $column) != (blog::Role $case) : hydrahon::Term<bool>
{
    int64 $raw = $case->value() as int64;
    return $column->term != $raw;
}

operator (hydrahon::Values& $into)[const RoleColumn& $column] = (blog::Role $case) : void
{
    int64 $raw = $case->value() as int64;
    $into[$column->term] = $raw;
}

/**
 * The wiring of the models of this namespace, registered and checked in one go.
 */
public struct Carbon
{
    /**
     * The migrations of this namespace in id order, for a carbon::Migrator.
     */
    public static function migrations() : array<carbon::migrate::Step>
    {
        array<carbon::migrate::Step> $out = [
            carbon::migrate::Step('20261102100000_create_users', blog::CreateUsers(), true),
            carbon::migrate::Step('20261102100100_create_posts', blog::CreatePosts(), true),
            carbon::migrate::Step('20261102100200_seed_editor', blog::SeedEditor(), true),
        ];
        return $out;
    }

    /**
     * Register the repositories carbongen wrote for these models; the ones the module declares
     * are registered by the app, with what they need.
     */
    public static function register(carbon::DB $db) : status<carbon::Error>
    {
        guard $db->register<blog::UserRepository>() else ($e) { return .error($e); }
        return .ok();
    }

    /**
     * Whether every repository these models need is registered on `$db`: their own, and the
     * ones their relations load through. Run it once after registering, so a repository left
     * out stops the app at startup, not on the first request that reaches it; the error names
     * every one left out. It also makes the store of every model, so none is made while
     * requests run.
     */
    public static function check(carbon::DB $db) : status<carbon::Error>
    {
        array<string> $missing = [];
        if (!$db->has<blog::PostRepository>()) {
            $missing[] = 'blog::PostRepository';
        }
        if (!$db->has<blog::UserRepository>()) {
            $missing[] = 'blog::UserRepository';
        }
        if ($missing->count() > 0) {
            return .error(.unregistered(str::join($missing, ', ')));
        }
        $db->store<blog::Post, int64, blog::PostTable>();
        $db->store<blog::User, int64, blog::UserTable>();
        return .ok();
    }
}
