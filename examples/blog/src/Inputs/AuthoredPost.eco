namespace Blog::Inputs;

/**
 * A post written from the command line, which names its author.
 */
#[nexus::input]
public struct AuthoredPost
{
    /**
     * The id of the user who writes it.
     */
    public int64 $author;

    /**
     * The title, 3 to 120 characters.
     */
    #[nexus::rule: { min: 3, max: 120 }]
    public string $title;

    /**
     * The text.
     */
    #[nexus::rule: { notBlank: true }]
    public string $body;

    /**
     * A tag; give it once per tag.
     */
    #[nexus::rule: { max: 5 }]
    public array<string> $tags = [];
}
