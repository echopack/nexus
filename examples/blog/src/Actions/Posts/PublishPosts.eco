namespace Blog::Actions::Posts;

use Blog::Inputs::PostBatch;
use Blog::Services::PostService;
use Blog::Transformers::PostTransformer;
use Blog::Types::Caller;

/**
 * Publishes several posts by whoever is signed in, all or none.
 */
#[nexus::through: ["Blog::Middleware::RequireUser"]]
public class PublishPosts : nexus::Action
{
    private PostService $posts;
    private PostTransformer $transformer;

    public constructor(PostService $posts, PostTransformer $transformer)
    {
        $this->posts = $posts;
        $this->transformer = $transformer;
    }

    public function handle(nexus::Payload& $payload, nexus::Body<PostBatch> $in) : result<nexus::Response, nexus::Problem>
    {
        $me = try $payload->state<Caller>();
        $inc = try $this->transformer->requestedIncludes($payload);
        $made = try $this->posts->createAll($me->user, $in->value->posts);
        return .ok($this->transformer->createCollectionResponse($payload, $made, nexus::rest::Meta(), mv $inc, status: 201));
    }
}
