namespace Blog::Actions::Auth;

use Blog::DB::Model::UserRepository;
use Blog::Inputs::OutsideSignIn;
use Blog::Services::BlogUsers;
use Blog::Transformers::UserTransformer;

/**
 * Finishes a sign in with an outside provider (Google) on the session the request is signed with:
 * claims the attempt the page `/signed-in` got back, with the binding it kept, finds, links or
 * makes the user (`nexus::connect::Accounts`), puts them on the session and answers them, as
 * `POST /v1/auth/signin` does.
 */
public class SignInWith : nexus::Action
{
    private nexus::connect::Connect $connect;
    private nexus::connect::Accounts $accounts;
    private UserRepository $users;
    private nexus::SignalDispatcher $signals;
    private nexus::auth::Sessions $sessions;
    private UserTransformer $transformer;

    public constructor(nexus::connect::Connect $connect, nexus::connect::Accounts $accounts, UserRepository $users, nexus::SignalDispatcher $signals, nexus::auth::Sessions $sessions, UserTransformer $transformer)
    {
        $this->connect = $connect;
        $this->accounts = $accounts;
        $this->users = $users;
        $this->signals = $signals;
        $this->sessions = $sessions;
        $this->transformer = $transformer;
    }

    public function handle(nexus::Payload& $payload, nexus::Body<OutsideSignIn> $in) : result<nexus::Response, nexus::Problem>
    {
        $session = try $payload->state<nexus::auth::Identity>();
        if (!$session->anonymous()) {
            return .error(nexus::auth::Sessions::taken());
        }
        nexus::connect::ExternalIdentity $who = try $this->connect->claim($in->value->attempt, $in->value->binding);
        string $subject = try $this->accounts->of($who, BlogUsers($this->users, $this->signals, $payload->locale()));
        try $this->sessions->attach($session->credential, $subject);
        $user = try BlogUsers::of($this->users, $subject);
        return $this->transformer->own($payload, $user, nexus::rest::Meta());
    }
}
