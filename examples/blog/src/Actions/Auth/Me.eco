namespace Blog::Actions::Auth;

use Blog::Transformers::UserTransformer;
use Blog::Types::Caller;

/**
 * Who is signed in.
 */
#[nexus::through: ["Blog::Middleware::RequireUser"]]
public class Me : nexus::Action
{
    private UserTransformer $transformer;

    public constructor(UserTransformer $transformer)
    {
        $this->transformer = $transformer;
    }

    public function handle(nexus::Payload& $payload) : result<nexus::Response, nexus::Problem>
    {
        $me = try $payload->state<Caller>();
        return $this->transformer->own($payload, $me->user, nexus::rest::Meta());
    }
}
