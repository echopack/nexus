namespace Blog::Queries;

use Blog::Models::{Post, PostRelations, PostRows, PostTable};

/**
 * Reading posts.
 */
public struct PostQuery : carbon::Query<Post, PostQuery>, PostRelations<PostQuery>
{
    internal PostRows $rows;

    public constructor(carbon::Session $session)
    {
        $this->rows = PostRows($session);
    }

    public function rows() : PostRows&
    {
        return $this->rows;
    }

    /**
     * Posts carrying `$tag`.
     */
    public function tagged(const string& $tag) : PostQuery
    {
        // tags are stored comma separated; escape what LIKE treats specially
        string $plain = str::replace(str::replace(str::replace($tag, '\\', '\\\\'), '%', '\\%'), '_', '\\_');
        return $this->where(PostTable::$tags == $plain || PostTable::$tags like "{$plain},%" || PostTable::$tags like "%,{$plain}" || PostTable::$tags like "%,{$plain},%");
    }
}
