namespace Blog;

use container::Container;
use Blog::Actions::{Health, Home};
use Blog::Commands::SetPassword;
use Blog::Config::BlogConfig;
use Blog::Middleware::ServerTiming;
use Blog::Providers::{AuthProvider, PostsProvider};
use Blog::Queues::{JobLane, WorkerLane};

/**
 * The blog itself, as an extension: its providers, one per part, and what belongs to the whole
 * blog.
 */
public class App : nexus::Extension
{
    public function name() : string
    {
        return 'blog';
    }

    /**
     * The parts of the blog, each wiring itself.
     */
    public function providers() : array<nexus::Provider>
    {
        array<nexus::Provider> $all = [
            AuthProvider(), 
            PostsProvider()
        ];

        return $all;
    }

    public function services(nexus::Services& $s) : status<nexus::BootError>
    {
        $app = nexus::App($s);

        // every answer says how long it took
        $app->bind<ServerTiming>(scoped: () => ServerTiming());
        $app->middleware<ServerTiming>();

        // nothing under /v1 answers without a signed session, but opening one
        $app->bind<nexus::auth::RequireSession>(shared: (Container $c) => nexus::auth::RequireSession(
            $c->get<nexus::auth::Guards>(), under: '/v1', except: [type_id<Blog::Actions::Auth::OpenSession>()]));
        $app->middleware<nexus::auth::RequireSession>();

        $app->bindAction<Health>((Container $c) => Health($c->get<BlogConfig>()))
            ->route([.get], '/health');
        // the blog in a browser, a single page over the API
        $app->bindAction<Home>(() => Home())
            ->route([.get], '/');

        // tasks wait in the database and run on the worker threads of whichever server claims them
        $app->bindAsyncQueue<WorkerLane>();
        $app->bindDistributedQueue<JobLane>(store: nexus::work::carbon::Store($app->get<carbon::DB>()))
            ->into<WorkerLane>();

        // the providers bind their handlers on it
        $app->instance(nexus::SignalDispatcher());

        // bind additional services from the providers
        foreach ($this->providers() as const &$p) {
            $app->register($p);
        }

        return .ok;
    }

    /**
     * Input messages and the welcome subject in German, next to the English ones.
     */
    public function boot(nexus::Kernel $kernel) : status<nexus::BootError>
    {
        $german = guard json::parse(std::embed::text('../resources/lang/de.json')) else ($e) {
            return .error(.extension('blog', "resources/lang/de.json: {$e->message()}"));
        };
        $kernel->services->get<nexus::Messages>()->add('de', $german);
        return .ok;
    }

    /**
     * The providers' commands, and setting a password.
     */
    public function commands(nexus::Commands& $cmds) : void
    {
        nexus::App::commands($cmds, $this->providers());
        $cmds->add(SetPassword());
    }
}
