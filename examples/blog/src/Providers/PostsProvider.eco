namespace Blog::Providers;

use container::Container;
use Blog::Actions::Posts::{CreatePost, DeletePost, ListPosts, PostCRUD, PublishPosts, ShowPost, UpdatePost};
use Blog::Commands::{CreatePostCommand, ShowPostCommand};
use Blog::Config::BlogConfig;
use Blog::DB::Model::{Post, UserRepository};
use Blog::DB::Query::PostQuery;
use Blog::DB::Repository::PostRepository;
use Blog::Services::{CoverService, PostService};
use Blog::Tools::CreatePostTool;
use Blog::Transformers::PostTransformer;

/**
 * Posts: the service, its HTTP actions, its MCP tools and its commands.
 */
public class PostsProvider : nexus::Provider
{
    public function register(nexus::App $app) : void
    {
        $app->bindRepository<PostRepository>();
        $app->bind<PostService>(scoped: (Container $c) => PostService($c->get<PostRepository>(), $c->get<UserRepository>(), $c->get<nexus::Logger>()));

        $app->bindAction<ShowPost>((Container $c) => ShowPost($c->get<PostCRUD>()))
            ->route([.get], '/v1/posts/{id}')
            ->tool(
                'show_post',
                title: 'Read a post',
                description: 'One post of the blog by its id: title, body, tags and when it was written.',
                readOnly: true,
                map: ['post' => 'id']
            );
        $app->bindAction<ListPosts>((Container $c) => ListPosts($c->get<PostCRUD>(), $c->get<BlogConfig>()))
            ->route([.get], '/v1/posts');
        $app->bindAction<CreatePost>((Container $c) => CreatePost($c->get<PostService>(), $c->get<PostTransformer>()))
            ->route([.post], '/v1/posts');
        $app->bindAction<PublishPosts>((Container $c) => PublishPosts($c->get<PostService>(), $c->get<PostTransformer>()))
            ->route([.post], '/v1/posts/batch');
        $app->bindAction<UpdatePost>((Container $c) => UpdatePost($c->get<PostService>(), $c->get<PostTransformer>()))
            ->route([.patch], '/v1/posts/{id}');
        $app->bindAction<DeletePost>((Container $c) => DeletePost($c->get<PostCRUD>()))
            ->route([.delete], '/v1/posts/{id}');

        // a post links to ShowPost through the router, which boot fills
        $app->bindTransformer<Post, PostTransformer>(PostTransformer($app->router()));
        $app->bind<PostCRUD>(scoped: function(Container $c) : PostCRUD {
            $crud = PostCRUD($c->get<PostRepository>(), $c->get<PostTransformer>());
            $crud->name = 'post';
            // a deleted post's cover goes with it
            CoverService $covers = $c->get<CoverService>();
            $crud->after = function[$covers](nexus::crud::Verb $v, const Post& $p) : void {
                if ($v == nexus::crud::Verb::delete) {
                    $covers->forget($p->cover);
                }
            };
            $crud->load = function(PostQuery $q, const EchoPack::Rest::Includes& $inc) : PostQuery {
                if ($inc->has('author')) {
                    return $q->withAuthor();
                }
                return $q;
            };
            return $crud;
        });

        // the MCP door onto the same service
        $app->bindTool<CreatePostTool>((Container $c) => CreatePostTool($c->get<PostService>(), $c->get<PostTransformer>()))
            ->offer('create_post', title: 'Write a post');
    }

    /**
     * The command line door onto the same service.
     */
    public function commands(nexus::Commands& $cmds) : void
    {
        $cmds->bindCommand<ShowPostCommand>((Container $c) => ShowPostCommand($c->get<PostService>()))
            ->name('posts:show');
        $cmds->bindCommand<CreatePostCommand>((Container $c) => CreatePostCommand($c->get<PostService>()))
            ->name('posts:create');
    }
}
