namespace Blog::Tasks;

use Blog::Actions::Posts::ShowPost;
use Blog::Config::BlogConfig;
use Blog::DB::Model::{PostTable, UserRepository};
use Blog::DB::Repository::PostRepository;
use Blog::Mail::{PostLink, WelcomeMail};

/**
 * Mails a new user the welcome, in the locale they signed up in, with the latest posts, and notes
 * when; the note is what `/v1/me` shows. Tried five times, and one welcome per user waits or runs
 * at a time. A mail sent whose note then fails to save is sent again on the next try.
 */
public struct SendWelcome : nexus::work::Task
{
    public int64 $user;
    public string $locale = 'en';

    public const function tries() : int64
    {
        return 5;
    }

    public const function exclusive() : nexus::work::Exclusive
    {
        return .unique("user:{$this->user}");
    }

    public function handle(nexus::Payload& $payload) : status<nexus::work::Failure>
    {
        $users = $payload->get<UserRepository>();
        $found = guard $users->find()->get($this->user) else ($e) {
            return .error(.retry("the users table: {$e}"));
        };
        $u = guard $found else {
            return .error(.giveUp("user {$this->user} is gone"));
        };
        if ($u->welcomedAt != null) {
            // a try that died after saving: welcomed already
            return .ok;
        }
        $latest = guard $payload->get<PostRepository>()->find()->readonly()->order(desc: PostTable::$id)->limit(3)->get() else ($e) {
            return .error(.retry("the posts table: {$e}"));
        };
        nexus::Router $router = $payload->get<nexus::Router>();
        array<PostLink> $posts = [];
        foreach ($latest as const &$p) {
            $posts[] = PostLink($p->title, $router->url<ShowPost>(['id' => "{$p->id}"])->text());
        }
        $mail = WelcomeMail($u->name, $payload->get<BlogConfig>()->title, $this->locale, $payload->get<nexus::Messages>(), mv $posts);
        nexus::mail::Mailer $mailer = $payload->get<nexus::mail::Mailer>();
        nexus::mail::Message $msg = $mailer->compose($mail)->to(nexus::mail::Address($u->email, $u->name));
        guard $mailer->send($msg) else ($e) {
            return .error(nexus::work::Failure::of($e->problem()));
        };
        $u->welcomedAt = $payload->get<nexus::work::Work>()->clock->now();
        guard $users->save($u) else ($e) {
            return .error(.retry("saving the welcome: {$e}"));
        };
        return .ok;
    }
}
