namespace Blog::Commands;

use std::io;
use Blog::Models::{UserRepository, UserTable};

/**
 * `user:password --email <email> --password <password>`: sets a user's password, which also ends
 * their tokens and sessions.
 */
public class SetPassword : nexus::Command
{
    public const function name() : string
    {
        return 'user:password';
    }

    public const function summary() : string
    {
        return "set a user's password";
    }

    public const function options() : array<nexus::CommandOption>
    {
        array<nexus::CommandOption> $out = [];
        $out[] = nexus::CommandOption(value: 'email', '<email>', 'the user');
        $out[] = nexus::CommandOption(value: 'password', '<password>', 'the new password');
        return $out;
    }

    public function run(nexus::Invocation& $in) : int32
    {
        nexus::Kernel $kernel = guard $in->kernel() else {
            return 1;
        };
        string $email = $in->value('email');
        string $password = $in->value('password');
        $passwords = $kernel->services->get<nexus::auth::Passwords>();
        guard $passwords->acceptable($password) else ($p) {
            io::eprintln("user:password: {$p->detail(nexus::Mode::dev)}");
            return 1;
        };
        $hash = guard $passwords->hash($password) else ($p) {
            io::eprintln("user:password: {$p->detail(nexus::Mode::dev)}");
            return 1;
        };
        $s = $kernel->services->get<carbon::DB>()->session();
        $users = guard $s->repo<UserRepository>() else ($e) {
            io::eprintln("user:password: {$e}");
            return 1;
        };
        $found = guard $users->find()->where(UserTable::$email == $email)->first() else ($e) {
            io::eprintln("user:password: {$e}");
            return 1;
        };
        $u = guard $found else {
            io::eprintln("user:password: nobody has the email {$email}");
            return 1;
        };
        $u->passwordHash = $hash;
        guard $users->save($u) else ($e) {
            io::eprintln("user:password: {$e}");
            return 1;
        };
        string $subject = "{$u->id}";
        guard nexus::auth::carbon::CarbonTokens($s)->removeAll($subject) else ($p) {
            io::eprintln("user:password: {$p->detail(nexus::Mode::dev)}");
            return 1;
        };
        guard nexus::auth::carbon::CarbonSessions($s)->removeAll($subject) else ($p) {
            io::eprintln("user:password: {$p->detail(nexus::Mode::dev)}");
            return 1;
        };
        io::println("password set for {$email}");
        return 0;
    }
}
