array<nexus::Extension> $extensions = [
    nexus::http::Extension(),
    nexus::carbon::Extension((nexus::carbon::DatabaseConfig $config) => blog::database::open($config), blog::database::migrations()),
    nexus::auth::Extension('blog', stores: .provided),
    nexus::auth::carbon::Extension(),
    nexus::oauth::Extension(stores: .provided),
    nexus::oauth::carbon::Extension(),
    nexus::mcp::Extension(),
    nexus::work::Extension(stores: .provided),
    nexus::work::carbon::Extension(),
    blog::App(),
];
nexus::Kernel::main($extensions);
