namespace Blog;

/**
 * Everything the blog is made of, in boot order: the HTTP server, the database, signed sessions,
 * Google and OAuth kept in that database, realtime channels, the debug console, MCP, workers on a
 * queue in that database, and the blog itself. `main.eco` runs it; the integration tests boot the same list.
 */
public function extensions() : array<nexus::Extension>
{
    array<nexus::Extension> $all = [
        // the HTTP/1.1 server behind `serve`; nexus itself routes every request
        nexus::http::Extension(),

        // the MySQL database from NEXUS_DATABASE_URL, a session per request, and the
        // migrate commands running the blog's migrations
        nexus::carbon::Extension((nexus::carbon::DatabaseConfig $config) => Blog::DB::open($config), Blog::DB::migrations()),

        // who is calling: signed sessions only (a client opens one before anything else, signing in
        // puts the user on it) and password hashing; the stores come from the next line
        nexus::auth::Extension('blog', stores: .provided, guards: [nexus::auth::BuiltinGuard::signed]),

        // keeps those sessions in the database
        nexus::auth::carbon::Extension(),

        // OAuth 2.1 for the blog's resources (the MCP endpoint), so an MCP client signs in with a
        // click instead of a pasted token; the stores come from the next line
        nexus::oauth::Extension(stores: .provided),

        // keeps OAuth clients, requests, codes and grants in the database
        nexus::oauth::carbon::Extension(),

        // sign in with Google, once NEXUS_CONNECT_GOOGLE_CLIENT_ID and _SECRET are set; the
        // browser comes back to /signed-in, which posts the attempt to POST /v1/auth/connect, signed
        // with its session
        nexus::connect::Extension(page: '/signed-in', connectors: [nexus::connect::Google()], stores: .provided),

        // keeps sign-in attempts and the Google accounts linked to users in the database
        nexus::connect::carbon::Extension(),

        // live comments: a websocket at /realtime that follows channels (posts.5, users.7); with
        // NEXUS_REALTIME_URL=redis://... a broadcast from any process reaches every server
        nexus::realtime::Extension(),
        nexus::realtime::redis::Extension(),

        // the debug console at /__nexus/ once NEXUS_DEBUG_ENABLED=true: the requests, the log and
        // the routes live, for the blog's admins only, signed in with the blog's own session login
        nexus::debug::Extension(gate: nexus::debug::GuardGate(login: nexus::debug::Login(session: '/v1/auth/session', endpoint: '/v1/auth/signin'))
            ->through<Blog::Middleware::RequireUser>()
            ->through<Blog::Middleware::RequireAdmin>()),

        // the realtime sockets in that console: who is open, the channels they follow, close one
        nexus::debug::realtime::Extension(),

        // the `/mcp` endpoint that offers the blog's tools to models
        nexus::mcp::Extension(),

        // tasks, queues, workers and the scheduler
        nexus::work::Extension(),

        // keeps the distributed queue's tasks in the database
        nexus::work::carbon::Extension(),

        // the queues in the debug console: lanes, schedules, failed and stored tasks
        nexus::debug::work::Extension(),

        // mail through NEXUS_MAIL_URL: SMTP, the log, or kept in memory for tests
        nexus::mail::Extension(),

        // the blog itself: its routes, tools, commands, tasks, schedule and translations
        Blog::App(),
    ];
    return $all;
}
