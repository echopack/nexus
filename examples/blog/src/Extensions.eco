namespace Blog;

/**
 * Everything the blog is made of, in boot order: the HTTP server, the database, sign-in with
 * tokens, sessions, Google and OAuth kept in that database, MCP, workers on a queue in that
 * database, and the blog itself. `main.eco` runs it; the integration tests boot the same list, with
 * a `fetch` that answers for Google.
 */
public function extensions(fetch: nexus::connect::Fetch $fetch = nexus::connect::CurlFetch()) : array<nexus::Extension>
{
    array<nexus::Extension> $all = [
        // the HTTP/1.1 server behind `serve`; nexus itself routes every request
        nexus::http::Extension(),

        // the MySQL database from NEXUS_DATABASE_URL, a session per request, and the
        // migrate commands running the blog's migrations
        nexus::carbon::Extension((nexus::carbon::DatabaseConfig $config) => Blog::DB::open($config), Blog::DB::migrations()),

        // who is calling: bearer tokens, signed sessions and password hashing, prefixed `blog_`;
        // the stores come from the next line
        nexus::auth::Extension('blog', stores: .provided),

        // keeps those tokens and sessions in the database
        nexus::auth::carbon::Extension(),

        // OAuth 2.1 for the blog's resources (the MCP endpoint), so an MCP client signs in with a
        // click instead of a pasted token; the stores come from the next line
        nexus::oauth::Extension(stores: .provided),

        // keeps OAuth clients, requests, codes and grants in the database
        nexus::oauth::carbon::Extension(),

        // sign in with Google, once NEXUS_CONNECT_GOOGLE_CLIENT_ID and _SECRET are set; the
        // browser comes back to /signed-in, which posts the attempt to POST /v1/auth/connect
        nexus::connect::Extension(page: '/signed-in', connectors: [nexus::connect::Google()], stores: .provided, fetch: $fetch),

        // keeps sign-in attempts and the Google accounts linked to users in the database
        nexus::connect::carbon::Extension(),

        // the `/mcp` endpoint that offers the blog's tools to models
        nexus::mcp::Extension(),

        // tasks, queues, workers and the scheduler
        nexus::work::Extension(),

        // keeps the distributed queue's tasks in the database
        nexus::work::carbon::Extension(),

        // mail through NEXUS_MAIL_URL: SMTP, the log, or kept in memory for tests
        nexus::mail::Extension(),

        // the blog itself: its routes, tools, commands, tasks, schedule and translations
        Blog::App(),
    ];
    return $all;
}
