namespace blog;

/**
 * Publishes several posts by whoever is signed in, all or none.
 */
#[nexus::answers: { collection: "blog::PostTransformer" }]
#[nexus::through: ["blog::RequireUser"]]
public class PublishPosts : nexus::Action
{
    private PostService $posts;
    private PostTransformer $transformer;

    public constructor(PostService $posts, PostTransformer $transformer)
    {
        $this->posts = $posts;
        $this->transformer = $transformer;
    }

    public function handle(nexus::Payload& $payload, nexus::Body<PostBatch> $in) : result<nexus::Response, nexus::Problem>
    {
        Caller $me = guard $payload->state<Caller>() else ($p) {
            return .error($p);
        };
        EchoPack::Rest::Includes $inc = guard $this->transformer->requestedIncludes($payload) else ($p) {
            return .error($p);
        };
        array<Post> $made = guard $this->posts->createAll($me->user, $in->value->posts) else ($p) {
            return .error($p);
        };
        nexus::rest::Meta $none = nexus::rest::Meta();
        return .ok($this->transformer->createCollectionResponse($payload, $made, $none, mv $inc, status: 201));
    }
}
