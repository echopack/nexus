namespace blog;

/**
 * Ends the token or session the request came with.
 */
#[nexus::through: ["nexus::auth::Authenticate"]]
public class Logout : nexus::Action
{
    private nexus::auth::Guards $guards;

    public constructor(nexus::auth::Guards $guards)
    {
        $this->guards = $guards;
    }

    public function handle(nexus::Payload& $payload) : status<nexus::Problem>
    {
        nexus::auth::Identity $me = guard $payload->state<nexus::auth::Identity>() else ($p) {
            return .error($p);
        };
        return $this->guards->revoke($payload, $me);
    }
}
