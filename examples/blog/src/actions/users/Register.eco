namespace blog;

/**
 * Signs a new user up and tells whoever listens: `WelcomeNewUser` queues
 * the welcome. A taken email is a 409.
 */
#[nexus::answers: { response: "blog::UserTransformer" }]
public class Register : nexus::Action
{
    private UserRepository $users;
    private nexus::auth::Passwords $passwords;
    private UserTransformer $transformer;

    public constructor(UserRepository $users, nexus::auth::Passwords $passwords, UserTransformer $transformer)
    {
        $this->users = $users;
        $this->passwords = $passwords;
        $this->transformer = $transformer;
    }

    public function handle(nexus::Payload& $payload, nexus::Body<Registration> $in) : result<nexus::Response, nexus::Problem>
    {
        // checked before the write: a bad ?include= signs nobody up
        EchoPack::Rest::Includes $inc = guard $this->transformer->requestedIncludes($payload) else ($p) {
            return .error($p);
        };
        Registration $r = $in->value;
        guard $this->passwords->acceptable($r->password) else ($p) {
            return .error($p);
        };
        string $hash = guard $this->passwords->hash($r->password) else ($p) {
            return .error($p);
        };
        User $made = guard $this->users->create(User($email: $r->email, $name: $r->name, $passwordHash: $hash)) else ($e) {
            if ($e->duplicate()) {
                return .error(.conflict('that email is taken'));
            }
            return .error(nexus::carbon::Problems::of($e));
        };
        guard nexus::Events::emit($payload, UserRegistered($user: $made->id)) else ($p) {
            return .error($p);
        };
        return .ok($this->transformer->createResponse($payload, $made, mv $inc, status: 201));
    }
}
