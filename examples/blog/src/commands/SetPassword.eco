namespace blog;

use std::io;

/**
 * `user:password --email <email> --password <password>`: sets a user's
 * password, which also ends their tokens and sessions.
 */
public class SetPassword : nexus::Command
{
    public function name() : string
    {
        return 'user:password';
    }

    public function summary() : string
    {
        return "set a user's password";
    }

    public function options() : array<nexus::CommandOption>
    {
        array<nexus::CommandOption> $out = [];
        $out[] = nexus::CommandOption(value: 'email', '<email>', 'the user');
        $out[] = nexus::CommandOption(value: 'password', '<password>', 'the new password');
        return $out;
    }

    public function run(nexus::Kernel $kernel, const nexus::Invocation& $in) : int32
    {
        string $email = $in->value('email');
        string $password = $in->value('password');
        nexus::auth::Passwords $passwords = $kernel->services->get<nexus::auth::Passwords>();
        guard $passwords->acceptable($password) else ($p) {
            io::eprintln("user:password: {$p->detail(nexus::Mode::dev)}");
            return 1;
        };
        string $hash = guard $passwords->hash($password) else ($p) {
            io::eprintln("user:password: {$p->detail(nexus::Mode::dev)}");
            return 1;
        };
        carbon::Session $s = $kernel->services->get<carbon::DB>()->session();
        UserRepository $users = guard $s->repo<UserRepository>() else ($e) {
            io::eprintln("user:password: {$e}");
            return 1;
        };
        User? $found = guard $users->find()->where(UserTable::$email == $email)->first() else ($e) {
            io::eprintln("user:password: {$e}");
            return 1;
        };
        User $u = guard $found else {
            io::eprintln("user:password: nobody has the email {$email}");
            return 1;
        };
        $u->passwordHash = $hash;
        guard $users->save($u) else ($e) {
            io::eprintln("user:password: {$e}");
            return 1;
        };
        string $subject = "{$u->id}";
        guard nexus::auth::carbon::CarbonTokens($s)->removeAll($subject) else ($p) {
            io::eprintln("user:password: {$p->detail(nexus::Mode::dev)}");
            return 1;
        };
        guard nexus::auth::carbon::CarbonSessions($s)->removeAll($subject) else ($p) {
            io::eprintln("user:password: {$p->detail(nexus::Mode::dev)}");
            return 1;
        };
        io::println("password set for {$email}");
        return 0;
    }
}
