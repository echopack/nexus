namespace Blog::Middleware;

use Blog::DB::Model::UserRepository;
use Blog::Services::BlogUsers;
use Blog::Types::Caller;

/**
 * Lets only signed in users through and leaves them for the action as a `Caller`: a 401 for anybody
 * else, and for a credential whose account is gone.
 */
public class RequireUser : nexus::Middleware
{
    private nexus::auth::Guards $guards;
    private UserRepository $users;

    public constructor(nexus::auth::Guards $guards, UserRepository $users)
    {
        $this->guards = $guards;
        $this->users = $users;
    }

    public function handle(nexus::Payload& $payload, nexus::Next $next) : nexus::Response
    {
        $id = guard $this->guards->demand($payload) else ($r) {
            return $r;
        };
        $user = guard BlogUsers::of($this->users, $id->subject) else ($p) {
            return $payload->fail($p);
        };
        $payload->put<Caller>(Caller($id, $user));
        return $next->run($payload);
    }
}
