namespace blog;

/**
 * Welcomes whoever signs up, on a worker: the request only queues it.
 */
public struct WelcomeNewUser : nexus::Listener<UserRegistered>
{
    public static function handle(nexus::Payload& $payload, const UserRegistered& $e) : status<nexus::Problem>
    {
        return SendWelcomeTask::push($payload, $user: $e->user);
    }
}
