namespace blog;

/**
 * Publishes a post by the signed in user: a title of 3 to 120 characters,
 * a body, and up to five tags. Answers the post as the API does.
 */
#[nexus::answers: { response: "blog::PostTransformer" }]
#[nexus::through: ["blog::RequireUser"]]
public class CreatePostTool : nexus::mcp::Tool
{
    private PostService $posts;
    private PostTransformer $transformer;

    public constructor(PostService $posts, PostTransformer $transformer)
    {
        $this->posts = $posts;
        $this->transformer = $transformer;
    }

    public function handle(nexus::Payload& $payload, NewPost $in) : result<nexus::Response, nexus::Problem>
    {
        Caller $me = guard $payload->state<Caller>() else ($p) {
            return .error($p);
        };
        Post $made = guard $this->posts->create($me->user, $in) else ($p) {
            return .error($p);
        };
        return $this->transformer->createResponse($payload, $made);
    }
}
