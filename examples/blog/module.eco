/*
 * blog: the running tour of nexus. Users and posts in MySQL through
 * carbon, a JSON or XML API answered by transformers (nexus-rest),
 * list/show/create/update/delete through nexus-crud, signed sessions through
 * nexus-auth, kept in the database (a client opens one before anything under
 * /v1 answers it, signs every request with it, and signing in puts the user
 * on it), writes by signed in authors, config from the environment, a welcome task for new users and a nightly prune on
 * nexus-work's workers, queued in the same database. Posts are also
 * reachable from the command line (`posts:show`, `posts:create`) and over
 * MCP (`show_post`, `create_post`), where clients sign in with OAuth.
 * People sign in with a password or with Google (nexus-connect), once
 * NEXUS_CONNECT_GOOGLE_CLIENT_ID and _SECRET are set.
 *
 *   NEXUS_DATABASE_URL=mysql://app:secret@127.0.0.1:3306/blog echoc run -- migrate
 *   NEXUS_DATABASE_URL=... echoc run -- user:password --email editor@example.com --password ...
 *   NEXUS_DATABASE_URL=... NEXUS_AUTH_KEY=... echoc run -- serve   (listens on 127.0.0.1:3246, works the queue)
 *   NEXUS_DATABASE_URL=... echoc run -- work                  (works the queue, no HTTP)
 *   NEXUS_DATABASE_URL=... echoc run -- posts:show 1          (the same service as GET /v1/posts/1)
 *   echoc run -- routes
 *
 * `serve` also answers `/` with the blog in a browser: one HTML page (resources/web/index.html,
 * Tailwind from its CDN) embedded at build time, reading and writing through the same API with a
 * session it opens first and signs with Web Crypto (so on localhost or https).
 *
 * Tests: tests/unit/ is plain checks, tests/integration/ boots Blog::extensions() on a MySQL
 * database of each test's own (tests/integration/World.eco), seeds it and walks a flow in steps.
 *
 *   epm run -m ../.. ecotest                     (starts MySQL in Docker from ecotest.json)
 *   BLOG_TEST_DATABASE_URL=mysql://root:pw@127.0.0.1:3306/ echoc test   (your own server)
 *   echoc test --target unit                     (no database; plain `echoc test` skips the flows)
 *
 * Everything is wired in src/App.eco through nexus-app's builder: the
 * routes, the MCP tools, the signal handler, the tasks and their schedule. One
 * hook writes all generated code: `nexus gen` makes one decls pass and
 * runs carbongen (.carbon/) on it before writing .nexus/, which knows how
 * each action, command, tool and task runs but not where it answers.
 */

#[module: "nexus-blog"]
#[version: "0.1.0"]

#[depends: "../.."]
#[depends: "../../modules/http"]
#[depends: "../../modules/carbon"]
#[depends: "../../modules/rest"]
#[depends: "../../modules/crud"]
#[depends: "../../modules/auth"]
#[depends: "../../modules/auth/carbon"]
#[depends: "../../modules/work"]
#[depends: "../../modules/work/carbon"]
#[depends: "../../modules/mail"]
#[depends: "../../modules/mcp"]
#[depends: "../../modules/oauth"]
#[depends: "../../modules/oauth/carbon"]
#[depends: "../../modules/connect"]
#[depends: "../../modules/connect/carbon"]
#[depends: "../../modules/realtime"]
#[depends: "../../modules/realtime/redis"]
#[depends: "../../modules/app"]
#[depends: "../../modules/debug"]
#[depends: "../../modules/debug/realtime"]
#[depends: "../../modules/debug/work"]
#[depends: "../../../carbon"]
#[depends: "../../../carbon/drivers/mysql"]
#[depends: "../../../RestTransformers"]
#[depends: "../../../container"]
#[depends: "../../../libjson"]

#[hook: before_build { run: "nexus", args: ["gen"] }]

#[sources: "src/**/*.eco"]
#[if: !NEXUS_NOGEN]
#[sources: ".nexus/*.eco"]
#[end]
#[if: !CARBON_NOGEN]
#[sources: ".carbon/*.eco"]
#[end]

#[target: exe { name: "blog", entry: "src/main.eco" }]

#[target: test] {
    #[sources: "tests/**/*.eco"]
    #[depends: "../../../carbon/fake"]
    #[depends: "../../modules/testing"]
    #[depends: "../../modules/carbon/testing"]
}

// `echoc test --target unit` needs no database; `--target integration` is the flows alone
#[target: test { name: "unit", groups: ["unit"] }]
#[target: test { name: "integration", groups: ["integration"] }]
