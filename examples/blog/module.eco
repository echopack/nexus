/*
 * blog: the running tour of nexus. Users and posts in MySQL through
 * carbon, a JSON or XML API answered by transformers (nexus-rest),
 * list/show/create/update/delete through nexus-crud, writes by signed in
 * authors (bearer tokens or signed sessions through nexus-auth, kept in the database), config from the
 * environment, a welcome task for new users and a nightly prune on
 * nexus-work's workers, queued in the same database. Posts are also
 * reachable from the command line (`posts:show`, `posts:create`) and over
 * MCP (`show_post`, `create_post`), where clients sign in with OAuth.
 *
 *   DATABASE_URL=mysql://app:secret@127.0.0.1:3306/blog echoc run -- migrate
 *   DATABASE_URL=... echoc run -- user:password --email editor@example.com --password ...
 *   DATABASE_URL=... AUTH_KEY=... echoc run -- serve   (listens on 127.0.0.1:8080, works the queue)
 *   DATABASE_URL=... echoc run -- work                  (works the queue, no HTTP)
 *   DATABASE_URL=... echoc run -- posts:show 1          (the same service as GET /v1/posts/1)
 *   echoc run -- routes
 *   echoc test                                   (on carbon's fake driver)
 *
 * Everything is wired in src/App.eco through nexus-app's builder: the
 * routes, the MCP tools, the listener, the tasks and their schedule. One
 * hook writes all generated code: `nexus gen` makes one decls pass and
 * runs carbongen (.carbon/) on it before writing .nexus/, which knows how
 * each action, command, tool and task runs but not where it answers.
 */

#[module: "nexus-blog"]
#[version: "0.1.0"]

#[depends: "../.."]
#[depends: "../../modules/http"]
#[depends: "../../modules/carbon"]
#[depends: "../../modules/rest"]
#[depends: "../../modules/crud"]
#[depends: "../../modules/auth"]
#[depends: "../../modules/auth/carbon"]
#[depends: "../../modules/work"]
#[depends: "../../modules/work/carbon"]
#[depends: "../../modules/mcp"]
#[depends: "../../modules/oauth"]
#[depends: "../../modules/oauth/carbon"]
#[depends: "../../modules/app"]
#[depends: "../../../carbon"]
#[depends: "../../../carbon/drivers/mysql"]
#[depends: "../../../RestTransformers"]
#[depends: "../../../container"]
#[depends: "../../../libjson"]

#[hook: before_build { run: "nexus", args: ["gen"] }]

#[sources: "src/**/*.eco"]
#[if: !NEXUS_NOGEN]
#[sources: ".nexus/*.eco"]
#[end]
#[if: !CARBON_NOGEN]
#[sources: ".carbon/*.eco"]
#[end]

#[target: exe { name: "blog", entry: "src/main.eco" }]

#[target: test] {
    #[sources: "tests/*.eco"]
    #[depends: "../../../carbon/fake"]
    #[depends: "../../modules/testing"]
    #[requires: "echolang/ecotest" { version: "^0.3", source: git "https://github.com/echolang/ecotest" }]
}
