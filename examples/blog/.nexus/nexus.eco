namespace Blog::Tools;

/**
 * Runs Blog::Tools::CreatePostTool as an MCP tool.
 */
public struct CreatePostToolMcp
{
    /**
     * What MCP clients read of Blog::Tools::CreatePostTool unless the app says more.
     */
    public static function about() : string
    {
        return 'Publishes a post by the signed in user: a title of 3 to 120 characters, a body, and up to five tags. Answers the post as the API does.';
    }

    /**
     * What Blog::Tools::CreatePostTool offers MCP clients, and how it runs.
     */
    public static function offer() : nexus::mcp::Offer
    {
        $call = function(nexus::Payload& $payload, nexus::Fields& $args) : nexus::Response {
            return Blog::Tools::CreatePostToolMcp::call($payload, $args);
        };
        $offer = nexus::mcp::Offer('Blog::Tools::CreatePostTool', nexus::mcp::Schema::of('{"type":"object","properties":{"title":{"type":"string","minLength":3,"maxLength":120},"body":{"type":"string","minLength":1},"tags":{"type":"array","items":{"type":"string","maxLength":30,"minLength":1},"maxItems":5,"uniqueItems":true}},"required":["title","body"],"additionalProperties":false}'), Blog::Tools::CreatePostToolMcp::about(), mv $call);
        $offer->through = [nexus::MiddlewareRef::of<Blog::Middleware::RequireUser>('Blog::Middleware::RequireUser')];
        return $offer;
    }

    /**
     * Reads what Blog::Tools::CreatePostTool::handle() asks for from tool arguments,
     * calls it and turns the result into a response.
     */
    public static function call(nexus::Payload& $payload, nexus::Fields& $args) : nexus::Response
    {
        $valueIn = guard Blog::Inputs::NewPostDecoder::decode($payload, $args) else ($p) {
            return nexus::Reply::problem($payload, $p);
        };
        $target = $payload->get<Blog::Tools::CreatePostTool>();
        $result = $target->handle($payload, mv $valueIn);
        return nexus::Reply::of($payload, $result);
    }
}


namespace nexus::log;

/**
 * The log record of Blog::Logs::PostPublished.
 */
public function record(const Blog::Logs::PostPublished& $r) : nexus::log::Record
{
    nexus::log::Fields $f = [];
    $f['post'] = $r->post;
    $f['author'] = $r->author;
    $f['tags'] = $r->tags;
    return nexus::log::Record(.info, 'post published', mv $f);
}

namespace nexus::mail;

/**
 * The bodies of Blog::Mail::WelcomeMail, from resources/emails/welcome.txt and resources/emails/welcome.html.
 */
public function render(const Blog::Mail::WelcomeMail& $m) : nexus::mail::Rendered
{
    nexus::mail::Rendered $r = nexus::mail::Rendered();
    string $text = '';
    $text->append('Hello ');
    $text->append($m->name);
    $text->append(',');
    $text->push(10);
    $text->push(10);
    $text->append('welcome to ');
    $text->append($m->blog);
    $text->append('. Your account is ready, and you can sign in with the address this mail went to.');
    $text->push(10);
    if (!$m->posts->empty()) {
        $text->push(10);
        $text->append('The latest posts:');
        $text->push(10);
        foreach ($m->posts as const &$post1) {
            $text->append('- ');
            $text->append($post1->title);
            $text->append(' (');
            $text->append($post1->url);
            $text->append(')');
            $text->push(10);
        }
    }
    $text->push(10);
    $text->append('See you soon.');
    $text->push(10);
    $r->text = mv $text;
    string $html = '';
    $html->append('<!doctype html>');
    $html->push(10);
    $html->append('<html>');
    $html->push(10);
    $html->append('<body style="font-family: sans-serif; line-height: 1.5;">');
    $html->push(10);
    $html->append('  <h1>Hello ');
    $html->append(nexus::mail::Html::escape($m->name));
    $html->append('</h1>');
    $html->push(10);
    $html->append('  <p>Welcome to ');
    $html->append(nexus::mail::Html::escape($m->blog));
    $html->append('. Your account is ready, and you can sign in with the address this mail went to.</p>');
    $html->push(10);
    if (!$m->posts->empty()) {
        $html->append('  <h2>The latest posts</h2>');
        $html->push(10);
        $html->append('  <ul>');
        $html->push(10);
        foreach ($m->posts as const &$post1) {
            $html->append('    <li><a href="');
            $html->append(nexus::mail::Html::escape($post1->url));
            $html->append('">');
            $html->append(nexus::mail::Html::escape($post1->title));
            $html->append('</a></li>');
            $html->push(10);
        }
        $html->append('  </ul>');
        $html->push(10);
    }
    $html->append('  <p>See you soon.</p>');
    $html->push(10);
    $html->append('</body>');
    $html->push(10);
    $html->append('</html>');
    $html->push(10);
    $r->html = mv $html;
    return $r;
}

