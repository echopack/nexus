/**
 * Reads every #[nexus::config] struct of module nexus-blog and binds it.
 */
#[nexus::configs: 'nexus-blog']
public function configs(nexus::Env $env, container::Builder& $b) : status<nexus::BootError>
{
    $s = nexus::Settings($env);
    string $okC0Title = 'A nexus blog';
    $vC0Title = $s->string('BLOG_TITLE', required: false);
    if ($vC0Title != null) {
        $xC0Title = guard $vC0Title;
        $okC0Title = mv $xC0Title;
    }
    uint32 $okC0PageSize = 10;
    uint32? $vC0PageSize = $s->uint32('BLOG_DEFAULT_PAGE_SIZE', required: false);
    if ($vC0PageSize != null) {
        uint32 $xC0PageSize = guard $vC0PageSize;
        $okC0PageSize = $xC0PageSize;
    }
    std::time::duration $okC0StatsEvery = .secs(2);
    $vC0StatsEvery = $s->duration('BLOG_STATS_EVERY', required: false);
    if ($vC0StatsEvery != null) {
        $xC0StatsEvery = guard $vC0StatsEvery;
        $okC0StatsEvery = mv $xC0StatsEvery;
    }
    string $okC0CoversUrl = 'file:storage/covers';
    $vC0CoversUrl = $s->string('BLOG_COVERS_URL', required: false);
    if ($vC0CoversUrl != null) {
        $xC0CoversUrl = guard $vC0CoversUrl;
        $okC0CoversUrl = mv $xC0CoversUrl;
    }
    try $s->done();
    $b->param<Blog::Config::BlogConfig>(Blog::Config::BlogConfig($title: mv $okC0Title, $pageSize: $okC0PageSize, $statsEvery: mv $okC0StatsEvery, $coversUrl: mv $okC0CoversUrl));
    return .ok;
}

/**
 * Every environment variable the #[nexus::config] structs of module nexus-blog read.
 */
#[nexus::envs: 'nexus-blog']
public function envs() : array<nexus::EnvVar>
{
    array<nexus::EnvVar> $all = [];
    string $d0 = 'A nexus blog';
    $all[] = nexus::EnvVar($name: 'BLOG_TITLE', $type: 'string', $fallback: nexus::EnvVar::text($d0), $required: false, $secret: false, $doc: 'The blog\'s name, on every page.', $owner: 'Blog::Config::BlogConfig');
    uint32 $d1 = 10;
    $all[] = nexus::EnvVar($name: 'BLOG_DEFAULT_PAGE_SIZE', $type: 'uint32', $fallback: nexus::EnvVar::text($d1), $required: false, $secret: false, $doc: 'How many posts a page lists.', $owner: 'Blog::Config::BlogConfig');
    std::time::duration $d2 = .secs(2);
    $all[] = nexus::EnvVar($name: 'BLOG_STATS_EVERY', $type: 'duration', $fallback: nexus::EnvVar::text($d2), $required: false, $secret: false, $doc: 'How often the admin\'s live stats stream sends a fresh snapshot while somebody watches.', $owner: 'Blog::Config::BlogConfig');
    string $d3 = 'file:storage/covers';
    $all[] = nexus::EnvVar($name: 'BLOG_COVERS_URL', $type: 'string', $fallback: nexus::EnvVar::text($d3), $required: false, $secret: false, $doc: 'Where the posts\' cover images are kept: `file:storage/covers` (next to where the blog runs), `s3://bucket/covers` with nexus-files-s3\'s settings, or `memory:`.', $owner: 'Blog::Config::BlogConfig');
    return $all;
}

/**
 * What the inputs of module nexus-blog bring: English messages and
 * the rule classes they run. The kernel finds this function through
 * its attribute.
 */
#[nexus::inputs: 'nexus-blog']
public function inputs(nexus::Inputs $in) : void
{
    $in->message('Blog::Inputs::Registration', 'email', 'unique', 'Someone already signed up with that e-mail address.');
    $in->rule('Blog::Rules::UniqueEmail', function(container::Container $services) : bool {
        return $services->has<Blog::Rules::UniqueEmail>();
    });
}

/**
 * What the actions and tool classes of module nexus-blog offer MCP
 * clients, keyed by type; the app offers them under the names it picks.
 * nexus-mcp finds this function through its attribute.
 */
#[nexus::mcp::tools: 'nexus-blog']
public function tools(nexus::mcp::Offers $o) : void
{
    $o->add<Blog::Actions::Admin::StreamStats>(Blog::Actions::Admin::StreamStatsDispatch::offer());
    $o->add<Blog::Actions::Auth::Login>(Blog::Actions::Auth::LoginDispatch::offer());
    $o->add<Blog::Actions::Auth::Logout>(Blog::Actions::Auth::LogoutDispatch::offer());
    $o->add<Blog::Actions::Auth::Me>(Blog::Actions::Auth::MeDispatch::offer());
    $o->add<Blog::Actions::Auth::OpenSession>(Blog::Actions::Auth::OpenSessionDispatch::offer());
    $o->add<Blog::Actions::Auth::ShowSession>(Blog::Actions::Auth::ShowSessionDispatch::offer());
    $o->add<Blog::Actions::Auth::SignInWith>(Blog::Actions::Auth::SignInWithDispatch::offer());
    $o->add<Blog::Actions::Comments::CreateComment>(Blog::Actions::Comments::CreateCommentDispatch::offer());
    $o->add<Blog::Actions::Comments::DeleteComment>(Blog::Actions::Comments::DeleteCommentDispatch::offer());
    $o->add<Blog::Actions::Comments::ListComments>(Blog::Actions::Comments::ListCommentsDispatch::offer());
    $o->add<Blog::Actions::Covers::ConfirmCover>(Blog::Actions::Covers::ConfirmCoverDispatch::offer());
    $o->add<Blog::Actions::Covers::CoverUploadLink>(Blog::Actions::Covers::CoverUploadLinkDispatch::offer());
    $o->add<Blog::Actions::Covers::DeleteCover>(Blog::Actions::Covers::DeleteCoverDispatch::offer());
    $o->add<Blog::Actions::Covers::ShowCover>(Blog::Actions::Covers::ShowCoverDispatch::offer());
    $o->add<Blog::Actions::Health>(Blog::Actions::HealthDispatch::offer());
    $o->add<Blog::Actions::Home>(Blog::Actions::HomeDispatch::offer());
    $o->add<Blog::Actions::Posts::CreatePost>(Blog::Actions::Posts::CreatePostDispatch::offer());
    $o->add<Blog::Actions::Posts::DeletePost>(Blog::Actions::Posts::DeletePostDispatch::offer());
    $o->add<Blog::Actions::Posts::ListPosts>(Blog::Actions::Posts::ListPostsDispatch::offer());
    $o->add<Blog::Actions::Posts::PublishPosts>(Blog::Actions::Posts::PublishPostsDispatch::offer());
    $o->add<Blog::Actions::Posts::ShowPost>(Blog::Actions::Posts::ShowPostDispatch::offer());
    $o->add<Blog::Actions::Posts::UpdatePost>(Blog::Actions::Posts::UpdatePostDispatch::offer());
    $o->add<Blog::Actions::Users::ListUsers>(Blog::Actions::Users::ListUsersDispatch::offer());
    $o->add<Blog::Actions::Users::Register>(Blog::Actions::Users::RegisterDispatch::offer());
    $o->add<Blog::Tools::CreatePostTool>(Blog::Tools::CreatePostToolMcp::offer());
}

/**
 * How each task of module nexus-blog is stored, by type and by name. nexus-work
 * finds this function through its attribute.
 */
#[nexus::tasks: 'nexus-blog']
public function tasks(nexus::work::Codecs $k) : void
{
    $k->add<Blog::Tasks::CountUsers>('Blog::Tasks::CountUsers', function(const Blog::Tasks::CountUsers& $task) : string {
        return Blog::Tasks::CountUsersTaskCodec::encode($task);
    },
    function(const string& $text) : result<Blog::Tasks::CountUsers, nexus::work::DataError> {
        return Blog::Tasks::CountUsersTaskCodec::decode($text);
    });
    $k->add<Blog::Tasks::PruneAuth>('Blog::Tasks::PruneAuth', function(const Blog::Tasks::PruneAuth& $task) : string {
        return Blog::Tasks::PruneAuthTaskCodec::encode($task);
    },
    function(const string& $text) : result<Blog::Tasks::PruneAuth, nexus::work::DataError> {
        return Blog::Tasks::PruneAuthTaskCodec::decode($text);
    });
    $k->add<Blog::Tasks::SendWelcome>('Blog::Tasks::SendWelcome', function(const Blog::Tasks::SendWelcome& $task) : string {
        return Blog::Tasks::SendWelcomeTaskCodec::encode($task);
    },
    function(const string& $text) : result<Blog::Tasks::SendWelcome, nexus::work::DataError> {
        return Blog::Tasks::SendWelcomeTaskCodec::decode($text);
    });
}
