namespace Blog::DB::Model;

/**
 * How a Blog::DB::Model::Comment is written in its default shape: conform a
 * nexus::rest::Transformer<Blog::DB::Model::Comment> to it as well.
 */
public interface CommentMapping
{
    function name() : string
    {
        return 'comment';
    }

    function availableIncludes() : array<string>
    {
        array<string> $out = ['author'];
        foreach ($this->extraIncludes() as const &$extra) {
            $out[] = $extra;
        }
        return $out;
    }

    function defaultIncludes() : array<string>
    {
        return ['author'];
    }

    function map(const Blog::DB::Model::Comment& $m, nexus::rest::Item& $item, const nexus::rest::TransformerContext& $ctx) : void
    {
        $item->attribute('id', $m->id);
        $item->int('post_id', $m->postId);
        $item->text('body', $m->body);
        $item->time('created_at', $m->createdAt);
        if ($m->author->loaded()) {
            $item->include<Blog::DB::Model::User>('author', $m->author->get());
        }
    }
}

/**
 * How a Blog::DB::Model::Post is written in its default shape: conform a
 * nexus::rest::Transformer<Blog::DB::Model::Post> to it as well.
 */
public interface PostMapping
{
    function name() : string
    {
        return 'post';
    }

    function availableIncludes() : array<string>
    {
        array<string> $out = ['author'];
        foreach ($this->extraIncludes() as const &$extra) {
            $out[] = $extra;
        }
        return $out;
    }

    function defaultIncludes() : array<string>
    {
        return array<string>();
    }

    function map(const Blog::DB::Model::Post& $m, nexus::rest::Item& $item, const nexus::rest::TransformerContext& $ctx) : void
    {
        $item->attribute('id', $m->id);
        $item->text('title', $m->title);
        $item->text('body', $m->body);
        $item->texts('tags', $m->tags, item: 'tag');
        $item->time('created_at', $m->createdAt);
        if ($m->author->loaded()) {
            $item->include<Blog::DB::Model::User>('author', $m->author->get());
        }
    }
}

/**
 * How a Blog::DB::Model::User is written in its default shape: conform a
 * nexus::rest::Transformer<Blog::DB::Model::User> to it as well.
 */
public interface UserMapping
{
    function name() : string
    {
        return 'user';
    }

    function availableIncludes() : array<string>
    {
        array<string> $out = [];
        foreach ($this->extraIncludes() as const &$extra) {
            $out[] = $extra;
        }
        return $out;
    }

    function defaultIncludes() : array<string>
    {
        return array<string>();
    }

    function map(const Blog::DB::Model::User& $m, nexus::rest::Item& $item, const nexus::rest::TransformerContext& $ctx) : void
    {
        $item->protect(['email', 'password_hash']);
        $item->attribute('id', $m->id);
        $item->text('name', $m->name);
        $item->time('welcomed_at', $m->welcomedAt);
    }
}

/**
 * How a Blog::DB::Model::User is written in the shape 'admin': conform a
 * nexus::rest::Transformer<Blog::DB::Model::User> to it as well.
 */
public interface UserAdminMapping
{
    function name() : string
    {
        return 'user';
    }

    function availableIncludes() : array<string>
    {
        array<string> $out = [];
        foreach ($this->extraIncludes() as const &$extra) {
            $out[] = $extra;
        }
        return $out;
    }

    function defaultIncludes() : array<string>
    {
        return array<string>();
    }

    function map(const Blog::DB::Model::User& $m, nexus::rest::Item& $item, const nexus::rest::TransformerContext& $ctx) : void
    {
        $item->protect(['email', 'password_hash']);
        $item->attribute('id', $m->id);
        $item->reveal('email');
        $item->text('email', $m->email);
        $item->text('name', $m->name);
        $item->int('role', match ($m->role) {
            .author => 1,
            .admin => 2,
        });
        $item->time('welcomed_at', $m->welcomedAt);
    }
}


