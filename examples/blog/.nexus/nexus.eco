/**
 * Reads every #[nexus::config] struct of module nexus-blog and binds it.
 */
#[nexus::configs: 'nexus-blog']
public function configs(nexus::Env $env, container::Builder& $b) : status<nexus::BootError>
{
    $s = nexus::Settings($env);
    string $okC0Title = 'A nexus blog';
    $vC0Title = $s->string('BLOG_TITLE', required: false);
    if ($vC0Title != null) {
        $xC0Title = guard $vC0Title;
        $okC0Title = mv $xC0Title;
    }
    uint32 $okC0PageSize = 10;
    uint32? $vC0PageSize = $s->uint32('BLOG_PAGE_SIZE', required: false);
    if ($vC0PageSize != null) {
        uint32 $xC0PageSize = guard $vC0PageSize;
        $okC0PageSize = $xC0PageSize;
    }
    try $s->done();
    $b->param<blog::BlogConfig>(blog::BlogConfig($title: mv $okC0Title, $pageSize: $okC0PageSize));
    return .ok;
}

/**
 * What the inputs of module nexus-blog bring: English messages and
 * the rule classes they run. The kernel finds this function through
 * its attribute.
 */
#[nexus::inputs: 'nexus-blog']
public function inputs(nexus::Inputs $in) : void
{
    $in->message('blog::Registration', 'email', 'unique', 'Someone already signed up with that e-mail address.');
    $in->rule('blog::UniqueEmail', function(container::Container $services) : bool {
        return $services->has<blog::UniqueEmail>();
    });
}

/**
 * What the actions and tool classes of module nexus-blog offer MCP
 * clients, keyed by type; the app offers them under the names it picks.
 * nexus-mcp finds this function through its attribute.
 */
#[nexus::mcp::tools: 'nexus-blog']
public function tools(nexus::mcp::Offers $o) : void
{
    $o->add<blog::Health>(blog::HealthDispatch::offer());
    $o->add<blog::Login>(blog::LoginDispatch::offer());
    $o->add<blog::Logout>(blog::LogoutDispatch::offer());
    $o->add<blog::Me>(blog::MeDispatch::offer());
    $o->add<blog::OpenSession>(blog::OpenSessionDispatch::offer());
    $o->add<blog::CreatePost>(blog::CreatePostDispatch::offer());
    $o->add<blog::DeletePost>(blog::DeletePostDispatch::offer());
    $o->add<blog::ListPosts>(blog::ListPostsDispatch::offer());
    $o->add<blog::PublishPosts>(blog::PublishPostsDispatch::offer());
    $o->add<blog::ShowPost>(blog::ShowPostDispatch::offer());
    $o->add<blog::UpdatePost>(blog::UpdatePostDispatch::offer());
    $o->add<blog::ListUsers>(blog::ListUsersDispatch::offer());
    $o->add<blog::Register>(blog::RegisterDispatch::offer());
    $o->add<blog::CreatePostTool>(blog::CreatePostToolMcp::offer());
}

/**
 * How each task of module nexus-blog runs, keyed by type; the app binds
 * them with their queue, tries and schedule. nexus-work finds this
 * function through its attribute.
 */
#[nexus::tasks: 'nexus-blog']
public function tasks(nexus::work::Codecs $k) : void
{
    $run0 = function(nexus::Payload& $payload, const string& $data) : status<nexus::work::Failure> {
        return blog::PruneAuthTask::run($payload, $data);
    };
    $k->add<blog::PruneAuth>(nexus::work::Codec('blog::PruneAuth', mv $run0, blog::PruneAuthTask::encode(blog::PruneAuth())));
    $run1 = function(nexus::Payload& $payload, const string& $data) : status<nexus::work::Failure> {
        return blog::SendWelcomeTask::run($payload, $data);
    };
    $k->add<blog::SendWelcome>(nexus::work::Codec('blog::SendWelcome', mv $run1, ''));
}
