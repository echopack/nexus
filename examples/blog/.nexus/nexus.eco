/**
 * Runs blog::CreatePostCommand as a command.
 */
public class CreatePostCommandCli : nexus::Command
{
    private string $named;

    public constructor(const string& $name)
    {
        $this->named = $name;
    }

    public const function name() : string
    {
        return $this->named;
    }

    public const function summary() : string
    {
        return 'Publishes a post by the user `--author` names, with the same rules as the API.';
    }

    public const function help() : string
    {
        return 'Publishes a post by the user `--author` names, with the same rules as the API.';
    }

    public const function options() : array<nexus::CommandOption>
    {
        array<nexus::CommandOption> $out = [];
        $out[] = nexus::CommandOption(value: 'author', '<author>', 'The id of the user who writes it.');
        $out[] = nexus::CommandOption(value: 'title', '<title>', 'The title, 3 to 120 characters.');
        $out[] = nexus::CommandOption(value: 'body', '<body>', 'The text.');
        $out[] = nexus::CommandOption(list: 'tags', '<tags>', 'A tag; give it once per tag.');
        return $out;
    }

    public const function bound(container::Container $services) : bool
    {
        return $services->has<blog::CreatePostCommand>();
    }

    public function run(nexus::Kernel $k, const nexus::Invocation& $in) : int32
    {
        command::CLIContext $out = $in->out;
        $pairs = nexus::Query();
        if ($in->stated('author')) {
            $pairs->add('author', $in->value('author'));
        }
        if ($in->stated('title')) {
            $pairs->add('title', $in->value('title'));
        }
        if ($in->stated('body')) {
            $pairs->add('body', $in->value('body'));
        }
        foreach ($in->list('tags') as const &$item) {
            $pairs->add('tags', $item);
        }
        $payload = $k->background($this->named, nexus::Kernel::id());
        $payload->door = .cli;
        $fields = nexus::Fields(pairs: $pairs);
        $input = guard blog::AuthoredPostDecoder::decode($payload, $fields) else ($p) {
            nexus::Kernel::finish($payload);
            return nexus::Console::report($out, $payload->localized($p), $in->mode);
        };
        $command = $payload->get<blog::CreatePostCommand>();
        $done = $command->handle($payload, $out, mv $input);
        nexus::Kernel::finish($payload);
        guard $done else ($p) {
            return nexus::Console::report($out, $payload->localized($p), $in->mode);
        };
        return 0;
    }
}

/**
 * Runs blog::ShowPostCommand as a command.
