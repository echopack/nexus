    public static function offer() : nexus::mcp::Offer
    {
        $call = function(nexus::Payload& $payload, nexus::Fields& $args) : nexus::Response {
            return blog::CreatePostToolMcp::call($payload, $args);
        };
        $offer = nexus::mcp::Offer('blog::CreatePostTool', nexus::mcp::Schema::of('{"type":"object","properties":{"title":{"type":"string","minLength":3,"maxLength":120},"body":{"type":"string","minLength":1},"tags":{"type":"array","items":{"type":"string","maxLength":30,"minLength":1},"maxItems":5,"uniqueItems":true}},"required":["title","body"],"additionalProperties":false}'), blog::CreatePostToolMcp::about(), mv $call);
        $offer->through = [nexus::MiddlewareRef::of<blog::RequireUser>('blog::RequireUser')];
        return $offer;
    }

    /**
     * Reads what blog::CreatePostTool::handle() asks for from tool arguments,
     * calls it and turns the result into a response.
     */
    public static function call(nexus::Payload& $payload, nexus::Fields& $args) : nexus::Response
    {
        $valueIn = guard blog::NewPostDecoder::decode($payload, $args) else ($p) {
            return nexus::Reply::problem($payload, $p);
        };
        $target = $payload->get<blog::CreatePostTool>();
        $result = $target->handle($payload, mv $valueIn);
        return nexus::Reply::of($payload, $result);
    }
}

/**
 * How a blog::Post is written in its default shape: conform a
 * nexus::rest::Transformer<blog::Post> to it as well.
 */
public interface PostMapping
{
    function name() : string
    {
        return 'post';
    }

    function availableIncludes() : array<string>
    {
        array<string> $out = ['author'];
        foreach ($this->extraIncludes() as const &$extra) {
            $out[] = $extra;
        }
        return $out;
    }

    function defaultIncludes() : array<string>
    {
        return array<string>();
    }

    function map(const blog::Post& $m, nexus::rest::Item& $item, const nexus::rest::TransformerContext& $ctx) : void
    {
        $item->attribute('id', $m->id);
        $item->text('title', $m->title);
        $item->text('body', $m->body);
        $item->texts('tags', $m->tags, item: 'tag');
        $item->time('created_at', $m->createdAt);
        if ($m->author->loaded()) {
            $item->include<blog::User>('author', $m->author->get());
        }
    }
}

/**
 * How a blog::User is written in its default shape: conform a
 * nexus::rest::Transformer<blog::User> to it as well.
 */
public interface UserMapping
{
    function name() : string
    {
        return 'user';
    }

    function availableIncludes() : array<string>
    {
        array<string> $out = [];
        foreach ($this->extraIncludes() as const &$extra) {
            $out[] = $extra;
        }
        return $out;
    }

    function defaultIncludes() : array<string>
    {
        return array<string>();
    }

    function map(const blog::User& $m, nexus::rest::Item& $item, const nexus::rest::TransformerContext& $ctx) : void
    {
        $item->protect(['email', 'password_hash']);
        $item->attribute('id', $m->id);
        $item->text('name', $m->name);
        $item->time('welcomed_at', $m->welcomedAt);
    }
}

/**
 * How a blog::User is written in the shape 'admin': conform a
 * nexus::rest::Transformer<blog::User> to it as well.
 */
public interface UserAdminMapping
{
    function name() : string
    {
        return 'user';
    }

    function availableIncludes() : array<string>
    {
        array<string> $out = [];
        foreach ($this->extraIncludes() as const &$extra) {
            $out[] = $extra;
        }
        return $out;
    }

    function defaultIncludes() : array<string>
    {
        return array<string>();
    }

    function map(const blog::User& $m, nexus::rest::Item& $item, const nexus::rest::TransformerContext& $ctx) : void
    {
        $item->protect(['email', 'password_hash']);
        $item->attribute('id', $m->id);
        $item->reveal('email');
        $item->text('email', $m->email);
        $item->text('name', $m->name);
        $item->int('role', match ($m->role) {
            .author => 1,
            .admin => 2,
        });
        $item->time('welcomed_at', $m->welcomedAt);
    }
}


namespace nexus::log;

/**
 * The log record of blog::PostPublished.
 */
public function record(const blog::PostPublished& $r) : nexus::log::Record
{
    nexus::log::Fields $f = [];
    $f['post'] = $r->post;
    $f['author'] = $r->author;
    $f['tags'] = $r->tags;
    return nexus::log::Record(.info, 'post published', mv $f);
}

