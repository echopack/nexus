/**
 * The post commands, run as the command line would: the same service as the API, the same rules.
 */

use ecotest::expect;

/**
 * Runs command `$cmd` as the command line would, with `$in` filled in.
 */
internal function command(Rig $r, nexus::Command $cmd, nexus::Invocation& $in) : int32
{
    $in->attach($r->app->kernel);
    return $cmd->run($in);
}

/**
 * Everything the command printed, one line per row.
 */
internal function printed(const nexus::Invocation& $in) : string
{
    return str::join($in->out->page->rows, "\n");
}

test posts_show_prints_a_post_from_the_service
{
    $r = rig();
    $r->fake->rows([postRow(3, 'Hello')])->rows([editorRow()]);
    $in = nexus::Invocation(nexus::Mode::testing);
    $in->positionals = ['3'];
    expect(command($r, Blog::Commands::ShowPostCommandCli('posts:show'), $in))->is(0);
    string $text = printed($in);
    expect($text)->has('#3  Hello')->has('by The editor <editor@example.com>')->has('tags: echo, nexus');

    $r->fake->rows([]);
    $missing = nexus::Invocation(nexus::Mode::testing);
    $missing->positionals = ['9'];
    expect(command($r, Blog::Commands::ShowPostCommandCli('posts:show'), $missing))->is(1);
    expect(printed($missing))->has('error: Not Found');

    $bad = nexus::Invocation(nexus::Mode::testing);
    $bad->positionals = ['nine'];
    expect(command($r, Blog::Commands::ShowPostCommandCli('posts:show'), $bad))->is(1);
    expect(printed($bad))->has('error: id:');
}

test posts_create_keeps_the_api_rules
{
    $r = rig();
    $r->fake->rows([editorRow()])->written($insertId: 5);
    $in = nexus::Invocation(nexus::Mode::testing);
    $in->values['author'] = '1';
    $in->given['author'] = true;
    $in->values['title'] = 'From the shell';
    $in->given['title'] = true;
    $in->values['body'] = 'Typed in a terminal';
    $in->given['body'] = true;
    $in->lists['tags'] = ['Echo', ' echo', 'CLI'];
    expect(command($r, Blog::Commands::CreatePostCommandCli('posts:create'), $in))->is(0);
    expect(printed($in))->has('published post #5 by The editor');
    expect($r->fake->last())->starts('INSERT INTO `posts`');

    $short = nexus::Invocation(nexus::Mode::testing);
    $short->values['author'] = '1';
    $short->given['author'] = true;
    $short->values['title'] = 'No';
    $short->given['title'] = true;
    usize $sent = $r->fake->count();
    expect(command($r, Blog::Commands::CreatePostCommandCli('posts:create'), $short))->is(1);
    expect(printed($short))->has('title:')->has('body:');
    expect($r->fake->count())->is($sent);
    expect(str::join(Blog::Services::PostService::tags(['Echo', ' echo', '', 'CLI']), ','))->is('echo,cli');
}
