/**
 * The post tools over MCP: listed with schemas drawn from the actions' rules, and run through the
 * same actions and service as the API.
 */

use ecotest::expect;
use ecotest::http::Reply;

/**
 * One JSON-RPC message to the MCP endpoint, as the editor.
 */
internal function rpc(Rig $r, const string& $method, json::Value $params) : Reply
{
    $message = json::object(['jsonrpc' => '2.0', 'id' => 1, 'method' => $method]);
    $message['params'] = mv $params;
    return $r->editor()->post('/mcp', json: $message);
}

/**
 * Calls tool `$tool` with `$args`, as the editor.
 */
internal function toolCall(Rig $r, const string& $tool, json::Value $args) : Reply
{
    $params = json::object(['name' => $tool]);
    $params['arguments'] = mv $args;
    return rpc($r, 'tools/call', $params);
}

test the_post_tools_are_listed_with_their_schemas
{
    $r = rig();
    rpc($r, 'tools/list', json::object())
        ->status(200)
        ->count('$.result.tools', 2)
        ->json('$.result.tools[0].name', 'show_post')
        ->json('$.result.tools[0].inputSchema.properties.post.type', 'integer')
        ->json('$.result.tools[0].inputSchema.required[0]', 'post')
        ->json('$.result.tools[1].name', 'create_post')
        ->json('$.result.tools[1].inputSchema.properties.title.maxLength', 120)
        ->json('$.result.tools[1].inputSchema.properties.body.minLength', 1)
        ->json('$.result.tools[1].description', 'Publishes a post by the signed in user: a title of 3 to 120 characters, a body, and up to five tags. Answers the post as the API does.');
}

test the_post_tools_run_the_action_and_the_service
{
    $r = rig();
    $r->fake->rows([postRow(3, 'Hello')]);
    toolCall($r, 'show_post', json::object(['post' => 3]))
        ->json('$.result.structuredContent.data.title', 'Hello');

    $r->fake->rows([editorRow()])->written($insertId: 13);
    toolCall($r, 'create_post', json::object(['title' => 'Over MCP', 'body' => 'Written by a model']))
        ->json('$.result.structuredContent.data.id', 13);

    // a refusal is a tool error, not a JSON-RPC error
    $r->fake->rows([editorRow()]);
    toolCall($r, 'create_post', json::object(['title' => 'No']))
        ->json('$.result.isError', true)
        ->has('title');
}
