/**
 * The blog on carbon's fake MySQL driver, for the few cases a real database will not produce on
 * demand: queue what the database answers, including a failure, send a request, check the reply.
 * Everything else runs against a real database in `tests/integration/`.
 */

use ecotest::http::Api;
use nexus::testing::TestApp;
use Blog::DB::Model::{User, UserTable};
use carbon::fake;
use hydrahon::{Value, Mysql};
use std::time;

internal class FakeRig
{
    /**
     * The database: queue its answers with `rows`, `written` and `fails`.
     */
    public fake::Driver<Mysql> $fake;

    public TestApp $app;

    /**
     * Requests from a visitor, signed with a session nobody signed in on.
     */
    public Api $api;

    public constructor()
    {
        $driver = fake::Driver<Mysql>();
        $this->fake = $driver;
        $clock = calendar::FixedClock(time::timestamp::from_unix_secs(1700000000));
        $db = nexus::carbon::Extension(function[$driver, $clock](nexus::carbon::DatabaseConfig $cfg) : result<carbon::DB, carbon::Error> {
            $made = carbon::DB($driver, clock: $clock);
            try Blog::DB::wire($made);
            return .ok($made);
        });
        $auth = nexus::auth::Extension('blog', clock: $clock, cost: crypto::PasswordCost(8, 1), guards: [nexus::auth::BuiltinGuard::signed]);
        array<nexus::connect::Connector> $providers = [nexus::connect::Google()];
        array<nexus::Extension> $exts = [$db, $auth, nexus::oauth::Extension(clock: $clock), nexus::connect::Extension(connectors: $providers, clock: $clock),
            nexus::realtime::Extension(clock: $clock), nexus::mcp::Extension(), nexus::work::Extension(), Blog::App()];
        $vars = ['NEXUS_AUTH_KEY' => 'a-test-key-of-at-least-thirty-two-chars'];
        // nothing here signs in with Google, so its token endpoint answers nothing
        $this->app = TestApp($exts, mv $vars, replace: nexus::connect::ScriptedFetch()->replacing());
        $this->api = $this->session('');
    }

    /**
     * Requests signed in as the editor, user 1. `RequireUser` loads the editor on every request,
     * so queue `editorRow()` before each one.
     */
    public function editor() : Api
    {
        return $this->session('1');
    }

    /**
     * Requests signed with a new session for `$subject` (nobody when empty), kept in memory, at the
     * rig's fixed time.
     */
    private function session(const string& $subject) : Api
    {
        $sessions = $this->app->kernel->services->child()->get<nexus::auth::Sessions>();
        $opened = guard $sessions->open($subject) else ($p) {
            die("the test could not open a session: {$p->detail(nexus::Mode::testing)}");
        };
        $s = $opened->signer();
        return $this->app->api(signed: function[$s](string $method, string $target, string $body) : string {
            return $s->header($method, $target, 1700000000, $body);
        });
    }
}

internal function editorRow() : array<Value>
{
    return UserTable()->row(User($id: 1, $email: 'editor@example.com', $name: 'The editor'));
}
