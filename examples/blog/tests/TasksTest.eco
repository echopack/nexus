/**
 * The blog's tasks run inline, as a worker would, and the nightly schedule that queues the prune.
 */

use ecotest::expect;
use std::time;

test the_welcome_gives_up_when_the_user_is_gone
{
    $r = rig();
    $r->fake->rows([]);
    nexus::work::Failure $f = expect($r->runTask(Blog::Tasks::SendWelcome($user: 9)))->fails();
    expect($f->why())->is('user 9 is gone');
}

test auth_is_pruned_nightly_at_three
{
    $r = rig();
    $w = $r->app->kernel->services->get<nexus::work::Work>();
    expect($w->scheduler->plans)->size(1);
    expect($w->scheduler->plans[0]->into)->is('Blog::Queues::JobsLane');
    $w->scheduler->since($r->clock->now() - time::duration::mins(1));

    // the first tick finds no slot yet, and prunes the store: nothing expired, nothing old
    $r->fake->rows([])->rows([]);
    expect($w->scheduler->tick($r->app->kernel, $w, $r->clock->now()))->is(0 as uint32);
    $r->clock->advance(time::duration::secs(35));

    // 03:00: the slot's key is free, so the task is stored
    $r->fake->rows([])->written();
    expect($w->scheduler->tick($r->app->kernel, $w, $r->clock->now()))->is(1 as uint32);
    expect($r->sent('INSERT INTO `nexus_tasks`'))->is(1);

    $r->fake->written(2)->written(1);
    expect($r->runTask(Blog::Tasks::PruneAuth()))->fine();
    expect($r->fake->texts()[$r->fake->count() - 2])->is('DELETE FROM `auth_tokens` WHERE `auth_tokens`.`expires_at` < ?');
    expect($r->fake->last())->is('DELETE FROM `auth_sessions` WHERE `auth_sessions`.`expires_at` < ?');
    expect($r->app->logged('pruned'))->yes(says: 'the prune was logged');

    // the next one is tomorrow
    nexus::work::Schedule? $nightly = guard nexus::work::Schedule::of('', $w->scheduler->plans[0]->cron);
    nexus::work::Schedule $s = guard $nightly;
    $next = expect($s->next($r->clock->now(), $w->zone))->some();
    expect($next->unix_secs())->is(1793588400 + 86400);
}
