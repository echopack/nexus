/**
 * The blog booted for tests: in process, through the generated routes, on carbon's fake MySQL
 * driver and a fixed clock. Every API test has the same four steps: queue what the database
 * answers, send a request, check the reply, check the SQL that was sent.
 *
 * ```echo
 * $r = rig();
 * $r->fake->rows([postRow(5, 'Hello')]);
 * $r->api->get('/v1/posts/5')->status(200)->json('$.data.title', 'Hello');
 * expect($r->fake->last())->has('FROM `posts`');
 * ```
 *
 * `$r->api` is anonymous; `$r->editor()` is signed in as the editor. Both are ecotest-http `Api`
 * values, so `with` and `bearer` hand back a copy that sends more headers.
 */

use ecotest::http::Api;
use nexus::testing::TestApp;
use Blog::DB::Model::{Post, PostTable, User, UserTable};
use Blog::Types::Role;
use carbon::fake;
use hydrahon::{Value, Mysql};
use std::time;

internal class Rig
{
    /**
     * The database: queue its answers with `rows`, `written` and `fails`, read back what was sent
     * with `last`, `texts` and `count`.
     */
    public fake::Driver<Mysql> $fake;

    public TestApp $app;

    /**
     * Requests from nobody in particular.
     */
    public Api $api;

    /**
     * The workers' clock, from 2026-11-02T02:59:30Z.
     */
    public calendar::ManualClock $clock;

    public constructor(map<string, string> $vars)
    {
        $this->clock = calendar::ManualClock(time::timestamp::from_unix_secs(1793588370));
        $driver = fake::Driver<Mysql>();
        $this->fake = $driver;
        $db = nexus::carbon::Extension(function[$driver](nexus::carbon::DatabaseConfig $cfg) : result<carbon::DB, carbon::Error> {
            $made = carbon::DB($driver, clock: calendar::FixedClock(time::timestamp::from_unix_secs(1700000000)));
            try Blog::DB::wire($made);
            return .ok($made);
        });
        $clock = calendar::FixedClock(time::timestamp::from_unix_secs(1700000000));
        $auth = nexus::auth::Extension('blog', clock: $clock, cost: crypto::PasswordCost(8, 1));
        $work = nexus::work::Extension(clock: $this->clock);
        array<nexus::Extension> $exts = [$db, $auth, nexus::oauth::Extension(clock: $clock), nexus::mcp::Extension(), $work, Blog::App()];
        $vars['NEXUS_AUTH_KEY'] = 'a-test-key-of-at-least-thirty-two-chars';
        $this->app = TestApp($exts, mv $vars);
        $this->api = $this->app->api();
    }

    /**
     * Requests signed in as the editor, user 1, with a fresh bearer token. `RequireUser` loads the
     * editor on every request, so queue `editorRow()` (or `adminRow()`) before each one.
     */
    public function editor() : Api
    {
        $t = guard $this->app->kernel->services->child()->get<nexus::auth::Tokens>()->issue('1') else ($p) {
            die("the test could not issue the editor a token: {$p->detail(nexus::Mode::testing)}");
        };
        return $this->api->bearer($t->token);
    }

    /**
     * The hash of `$plain` at the test cost.
     */
    public function hash(const string& $plain) : string
    {
        $h = guard $this->app->kernel->services->get<nexus::auth::Passwords>()->hash($plain) else ($p) {
            die("the test could not hash a password: {$p->detail(nexus::Mode::testing)}");
        };
        return $h;
    }

    /**
     * Runs `$task` here, as a worker would, on a payload of its own.
     */
    public function runTask(Blog::Tasks::SendWelcome $task) : status<nexus::work::Failure>
    {
        nexus::Payload $payload = $this->app->kernel->background('test', nexus::Kernel::id());
        status<nexus::work::Failure> $out = nexus::work::Inline::run($payload, $task);
        nexus::Kernel::finish($payload);
        return $out;
    }

    public function runTask(Blog::Tasks::PruneAuth $task) : status<nexus::work::Failure>
    {
        nexus::Payload $payload = $this->app->kernel->background('test', nexus::Kernel::id());
        status<nexus::work::Failure> $out = nexus::work::Inline::run($payload, $task);
        nexus::Kernel::finish($payload);
        return $out;
    }

    /**
     * How many statements sent so far start with `$prefix`.
     */
    public function sent(const string& $prefix) : int32
    {
        int32 $n = 0;
        foreach ($this->fake->texts() as const &$t) {
            if ($t->starts($prefix)) {
                $n++;
            }
        }
        return $n;
    }
}

/**
 * The blog with a page size of 2, so paging shows with two rows.
 */
internal function rig() : Rig
{
    map<string, string> $vars = ['BLOG_DEFAULT_PAGE_SIZE' => '2'];
    return Rig($vars);
}

/**
 * A post by the editor, as the database answers it.
 */
internal function postRow(int64 $id, const string& $title) : array<Value>
{
    return postBy($id, $title, 1);
}

internal function postBy(int64 $id, const string& $title, int64 $author) : array<Value>
{
    return PostTable()->row(Post($id: $id, $authorId: $author, $title: $title, $body: 'Body', $tags: ['echo', 'nexus'], $createdAt: time::timestamp::from_unix_secs(1700000000)));
}

internal function editorRow() : array<Value>
{
    return UserTable()->row(User($id: 1, $email: 'editor@example.com', $name: 'The editor'));
}

/**
 * The editor as the seed makes them: the blog's admin.
 */
internal function adminRow() : array<Value>
{
    return UserTable()->row(User($id: 1, $email: 'editor@example.com', $name: 'The editor', $role: Role::admin));
}

internal function authorRow(int64 $id) : array<Value>
{
    return UserTable()->row(User($id: $id, $email: "author{$id}@example.com", $name: 'An author'));
}

internal function editorWith(const string& $hash) : array<Value>
{
    return UserTable()->row(User($id: 1, $email: 'editor@example.com', $name: 'The editor', $passwordHash: $hash));
}
