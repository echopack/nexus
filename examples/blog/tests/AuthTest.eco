/**
 * Signing in over the API: bearer tokens, logging out, throttled guesses and signed sessions.
 */

use ecotest::expect;

/**
 * What `POST /v1/auth/token` and `POST /v1/auth/session` take.
 */
internal function credentials(const string& $email, const string& $password) : json::Value
{
    return json::object(['email' => $email, 'password' => $password]);
}

test login_answers_a_token_that_signs_in
{
    $r = rig();
    $r->fake->rows([editorWith($r->hash('the right password'))]);
    string $token = $r->api->post('/v1/auth/token', json: credentials('editor@example.com', 'the right password'))
        ->status(201)
        ->capture('$.token');
    expect($token)->starts('blog_');
    expect($r->fake->last())->has('WHERE `users`.`email` = ?');

    $signedIn = $r->api->bearer($token);
    $r->fake->rows([editorRow()]);
    $signedIn->get('/v1/me')
        ->status(200)
        ->json('$.data.name', 'The editor')
        ->json('$.data.email', 'editor@example.com');

    $signedIn->delete('/v1/auth')->status(204);
    $signedIn->get('/v1/me')->problem(401);
}

test a_wrong_password_and_an_unknown_email_look_alike
{
    $r = rig();
    $r->fake->rows([editorWith($r->hash('the right password'))]);
    $wrong = $r->api->post('/v1/auth/token', json: credentials('editor@example.com', 'a wrong password'));
    $r->fake->rows([]);
    $unknown = $r->api->post('/v1/auth/token', json: credentials('nobody@example.com', 'a wrong password'));

    $wrong->problem(401)->has('the email or the password is wrong');
    $unknown->problem(401)->has('the email or the password is wrong');
    $r->api->post('/v1/auth/token', json: credentials('not an email', 'x'))->invalid('email', 'email');
}

test logins_are_throttled
{
    $r = rig();
    foreach (0 .. 10 as $i) {
        $r->fake->rows([]);
        $r->api->post('/v1/auth/token', json: credentials('editor@example.com', 'guess'))->problem(401);
    }

    usize $before = $r->fake->count();
    $r->api->post('/v1/auth/token', json: credentials('editor@example.com', 'guess'))
        ->problem(429)
        ->header('Retry-After', '900');
    // turned away before the database is asked
    expect($r->fake->count())->is($before);
}

test a_signed_session_signs_each_request
{
    $r = rig();
    $r->fake->rows([editorWith($r->hash('the right password'))]);
    $opened = $r->api->post('/v1/auth/session', json: credentials('editor@example.com', 'the right password'))->status(201);
    $s = nexus::auth::Signer($opened->capture('$.id'), $opened->capture('$.secret'));

    $r->fake->rows([editorRow()]);
    $r->api->with('Authorization', $s->header('GET', '/v1/me', 1700000000, ''))->get('/v1/me')
        ->status(200)
        ->json('$.data.name', 'The editor');

    // the same signature on another path
    $r->api->with('Authorization', $s->header('GET', '/v1/me', 1700000000, ''))->get('/v1/me?x=1')->problem(401);
    // too old
    $r->api->with('Authorization', $s->header('GET', '/v1/me', 1700000000 - 600, ''))->get('/v1/me')->problem(401);
}
