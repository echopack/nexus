/**
 * The blog as it runs in production, booted for one integration test: every extension from
 * `Blog::extensions()`, a MySQL database of the test's own (migrated, so the seed's admin is
 * there), real clocks and real password hashing. Requests go through `TestApp::api()`, in process,
 * each signed with a session as the browser signs them (`api` a visitor's, `admin` and `author`
 * one signed in); `bare` has none.
 * Google, the one outside service, is configured and answers what the test scripts (`google`).
 * The database is dropped when the test ends, even when a check stops it.
 *
 * ```echo
 * $world = World();
 * $admin = $world->admin();
 * $admin->post('/v1/posts', json: newPost('Hello'))->status(201);
 * expect($world->db->count('posts'))->is(1);
 * ```
 *
 * The server is `BLOG_TEST_DATABASE_URL` when you set one, else the MySQL ecotest started from
 * `ecotest.json`; with neither, the test is skipped.
 */

use ecotest::http::Api;
use nexus::testing::TestApp;
use nexus::carbon::testing::Database;
use Blog::DB::Model::{User, UserRepository, UserTable};
use Blog::Types::Role;

internal class World
{
    /**
     * The password every user the world seeds signs in with.
     */
    public const string PASSWORD = 'a test password';

    /**
     * The test's own database: `count` and `run` check and shape what the app cannot.
     */
    public Database $db;

    public TestApp $app;

    /**
     * Google as the blog reaches it: its token endpoint answers what a test scripts, for client
     * `blog-google`.
     */
    public nexus::connect::ScriptedFetch $google;

    /**
     * Requests from a visitor: signed with a session they opened through `POST /v1/auth/session`,
     * nobody signed in on it.
     */
    public Api $api;

    /**
     * Requests without any session.
     */
    public Api $bare;

    /**
     * `PASSWORD`, hashed once for every user the world seeds.
     */
    private string $hashed = '';

    /**
     * The world, with `$more` added to the app's environment, like `NEXUS_DEBUG_ENABLED`.
     */
    public constructor(map<string, string> $more = map<string, string>())
    {
        $server = Database::server(env: ['BLOG_TEST_DATABASE_URL', 'ECOTEST_MYSQL_URL']);
        $this->db = Database(server: $server, migrations: Blog::DB::migrations(), prefix: 'blog_test');
        $google = nexus::connect::ScriptedFetch();
        $this->google = $google;
        $vars = World::vars($this->db);
        foreach ($more as $k => const &$v) {
            $vars[$k] = $v;
        }
        $this->app = TestApp(Blog::extensions(), mv $vars, replace: $google->replacing());
        $this->bare = $this->app->api();
        $this->api = $this->visitor();
    }

    /**
     * A new visitor: a session opened through `POST /v1/auth/session`, as the page opens one,
     * signing every request after.
     */
    public function visitor() : Api
    {
        $opened = $this->bare->post('/v1/auth/session', json: '{}')->status(201);
        return $this->session(nexus::auth::Signer($opened->capture('$.id'), $opened->capture('$.secret')));
    }

    /**
     * Requests signed with `$s`, at the time each is sent.
     */
    public function session(nexus::auth::Signer $s) : Api
    {
        return $this->app->api(signed: World::sign($s));
    }

    internal static function vars(const Database& $db) : map<string, string>
    {
        return [
            'NEXUS_DATABASE_URL' => $db->url,
            'NEXUS_AUTH_KEY' => 'an-integration-key-of-at-least-32-chars',
            'NEXUS_MAIL_URL' => 'memory:',
            'NEXUS_MAIL_FROM' => 'hello@blog.test',
            'NEXUS_CONNECT_GOOGLE_CLIENT_ID' => 'blog-google',
            'NEXUS_CONNECT_GOOGLE_CLIENT_SECRET' => 'a-google-secret',
            'NEXUS_FILES_KEY' => 'a-files-key-of-at-least-32-chars!!',
            'BLOG_COVERS_URL' => 'memory:',
        ];
    }

    /**
     * The admin the seed migration made (`editor@example.com`, "The editor"), given `PASSWORD`
     * and signed in.
     */
    public function admin() : Api
    {
        return $this->session($this->adminSigner());
    }

    /**
     * The seeded admin's session as its signer, for what is opened rather than requested: an event
     * stream (`app->events(..., signed: World::sign($s))`).
     */
    public function adminSigner() : nexus::auth::Signer
    {
        $users = $this->users();
        $found = guard $users->find()->where(UserTable::$email == 'editor@example.com')->first() else ($e) {
            die("the world could not load the seeded admin: {$e}");
        };
        $admin = guard $found else {
            die('the seed migration made no admin');
        };
        $admin->passwordHash = $this->password();
        guard $users->save($admin) else ($e) {
            die("the world could not give the admin a password: {$e}");
        };
        return $this->signedIn($admin);
    }

    /**
     * A new author called `$name`, at `<name>@example.com` in lower case, with `PASSWORD`, signed
     * in.
     */
    public function author(const string& $name) : Api
    {
        return $this->session($this->authorSigner($name));
    }

    /**
     * `author`, as the signer of their session.
     */
    public function authorSigner(const string& $name) : nexus::auth::Signer
    {
        $local = str::lower($name);
        $email = "{$local}@example.com";
        return $this->signedIn($this->seed(User($email: $email, $name: $name, $passwordHash: $this->password())));
    }

    /**
     * What signs a request with `$s` at the time it is sent, for `TestApp::events` and `socket`.
     */
    public static function sign(nexus::auth::Signer $s) : function<string(string, string, string)>
    {
        return function[$s](string $method, string $target, string $body) : string {
            return $s->header($method, $target, std::time::timestamp::now()->unix_secs(), $body);
        };
    }

    /**
     * Waits until every broadcast so far reached the sockets.
     */
    public function settle() : void
    {
        $this->app->kernel->services->get<nexus::realtime::Hub>()->settle();
    }

    /**
     * A session of `$user`'s own, signed in, as its signer.
     */
    /**
     * Gives the user at `$email` the role `$role`.
     */
    public function role(const string& $email, Role $role) : void
    {
        $users = $this->users();
        $found = guard $users->find()->where(UserTable::$email == $email)->first() else ($e) {
            die("the world could not load {$email}: {$e}");
        };
        $user = guard $found else {
            die("the world has no {$email}");
        };
        $user->role = $role;
        guard $users->save($user) else ($e) {
            die("the world could not change the role of {$email}: {$e}");
        };
    }

    private function signedIn(const User& $user) : nexus::auth::Signer
    {
        $payload = $this->app->kernel->background('test', nexus::Kernel::id());
        $subject = "{$user->id}";
        $opened = guard $payload->get<nexus::auth::Sessions>()->open($subject) else ($p) {
            die("the world could not open a session: {$p->detail(nexus::Mode::testing)}");
        };
        nexus::Kernel::finish($payload);
        return $opened->signer();
    }

    /**
     * Where the app's mail went: `NEXUS_MAIL_URL` is `memory:` here.
     */
    public function outbox() : nexus::mail::Outbox
    {
        return $this->app->kernel->services->get<nexus::mail::Outbox>();
    }

    /**
     * Runs `$task` here, as a worker would, on a payload of its own. One overload per task: a
     * generic `run<T>` does not forward to `Inline::run<T>` yet.
     */
    public function run(Blog::Tasks::SendWelcome $task) : status<nexus::work::Failure>
    {
        $payload = $this->app->kernel->background('test', nexus::Kernel::id());
        $out = nexus::work::Inline::run($payload, $task);
        nexus::Kernel::finish($payload);
        return $out;
    }

    public function run(Blog::Tasks::PruneAuth $task) : status<nexus::work::Failure>
    {
        $payload = $this->app->kernel->background('test', nexus::Kernel::id());
        $out = nexus::work::Inline::run($payload, $task);
        nexus::Kernel::finish($payload);
        return $out;
    }

    private function seed(User $user) : User
    {
        $made = guard $this->users()->create($user) else ($e) {
            die("the world could not seed {$user->email}: {$e}");
        };
        return $made;
    }

    private function users() : UserRepository
    {
        $repo = guard $this->app->kernel->services->get<carbon::DB>()->session()->repo<UserRepository>() else ($e) {
            die("the world has no users: {$e}");
        };
        return $repo;
    }

    private function password() : string
    {
        if ($this->hashed->empty()) {
            $h = guard $this->app->kernel->services->get<nexus::auth::Passwords>()->hash(World::PASSWORD) else ($p) {
                die("the world could not hash a password: {$p->detail(nexus::Mode::testing)}");
            };
            $this->hashed = $h;
        }
        return $this->hashed;
    }
}

/**
 * What `POST /v1/auth/signin` takes.
 */
internal function credentials(const string& $email, const string& $password) : json::Value
{
    return json::object(['email' => $email, 'password' => $password]);
}

/**
 * A post as `POST /v1/posts` takes it.
 */
internal function newPost(const string& $title, const array<string>& $tags = []) : json::Value
{
    $post = json::object(['title' => $title, 'body' => 'Body text']);
    $post['tags'] = $tags;
    return $post;
}

/**
 * A comment as `POST /v1/posts/{id}/comments` takes it.
 */
internal function newComment(const string& $body) : json::Value
{
    return json::object(['body' => $body]);
}
