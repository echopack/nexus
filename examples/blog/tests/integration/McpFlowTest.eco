/**
 * The post tools over MCP, end to end: listed with schemas drawn from the actions' rules, and run
 * through the same actions, service and database as the API.
 */

use ecotest::expect;
use ecotest::http::{Api, Reply};

/**
 * One JSON-RPC message to the MCP endpoint, sent with `$as`.
 */
internal function rpc(const Api& $as, const string& $method, json::Value $params) : Reply
{
    $message = json::object(['jsonrpc' => '2.0', 'id' => 1, 'method' => $method]);
    $message['params'] = mv $params;
    return $as->post('/mcp', json: $message);
}

/**
 * Calls tool `$tool` with `$args`, sent with `$as`.
 */
internal function toolCall(const Api& $as, const string& $tool, json::Value $args) : Reply
{
    $params = json::object(['name' => $tool]);
    $params['arguments'] = mv $args;
    return rpc($as, 'tools/call', $params);
}

#[group: "integration"]
test the_post_tools_publish_and_show_posts
{
    $world = World();
    $admin = $world->admin();

    ecotest::step('both tools are listed with their schemas');
    rpc($admin, 'tools/list', json::object())
        ->status(200)
        ->count('$.result.tools', 2)
        ->json('$.result.tools[0].name', 'show_post')
        ->json('$.result.tools[0].inputSchema.properties.post.type', 'integer')
        ->json('$.result.tools[0].inputSchema.required[0]', 'post')
        ->json('$.result.tools[1].name', 'create_post')
        ->json('$.result.tools[1].inputSchema.properties.title.maxLength', 120)
        ->json('$.result.tools[1].inputSchema.properties.body.minLength', 1)
        ->json('$.result.tools[1].description', 'Publishes a post by the signed in user: a title of 3 to 120 characters, a body, and up to five tags. Answers the post as the API does.');

    ecotest::step('create_post publishes a post');
    $id = toolCall($admin, 'create_post', json::object(['title' => 'Over MCP', 'body' => 'Written by a model']))
        ->json('$.result.isError', false)
        ->capture('$.result.structuredContent.data.id');
    expect($world->db->count('posts'))->is(1);

    ecotest::step('show_post reads it back');
    int64 $post = str::int($id) ?? 0;
    toolCall($admin, 'show_post', json::object(['post' => $post]))
        ->json('$.result.structuredContent.data.title', 'Over MCP');

    ecotest::step('a refusal is a tool error, not a JSON-RPC error');
    toolCall($admin, 'create_post', json::object(['title' => 'No']))
        ->json('$.result.isError', true)
        ->has('title');
    expect($world->db->count('posts'))->is(1);
}
