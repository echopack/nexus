/**
 * Signing in with Google end to end, on the real database: the start, Google sending the browser
 * back, the blog's `/v1/auth/connect` claiming the attempt, making, finding or linking the user and
 * putting them on the browser's session. Only Google's token endpoint is scripted
 * (`World::google`).
 */

use ecotest::expect;
use ecotest::http::{Api, Reply};

/**
 * One sign in with Google as person `$sub` with `$email`, from the browser whose session `$browser`
 * signs with: through the start and the callback, then the claim, as the page `/signed-in` would
 * post it.
 */
internal function google(World& $world, const Api& $browser, const string& $sub, const string& $email, bool $verified) : Reply
{
    $started = $browser->post('/auth/connect/google', json: '{}')->status(201);
    $url = $started->capture('$.url');
    $attempt = $started->capture('$.attempt');
    $claims = json::object(['iss' => 'https://accounts.google.com', 'sub' => $sub, 'email' => $email, 'name' => 'Grace Hopper']);
    $claims['email_verified'] = json::bool($verified);
    $world->google->signedIn(nexus::connect::Google::TOKEN, $url, $claims);
    // the page gets the attempt and the proof only the browser that came back holds
    $back = $browser->get('/auth/connect/google/callback', query: ['state' => nexus::connect::ScriptedFetch::param($url, 'state'), 'code' => 'from-google'])
        ->status(302)
        ->header('Location', starts: "http://app/signed-in?attempt={$attempt}&proof=");
    string $location = $back->capture(header: 'Location');
    $claim = json::object(['attempt' => $attempt, 'binding' => $started->capture('$.binding'), 'proof' => nexus::connect::ScriptedFetch::param($location, 'proof')]);
    return $browser->post('/v1/auth/connect', json: $claim);
}

#[group: "integration"]
test signing_in_with_google_makes_finds_and_links_users
{
    $world = World();
    $world->admin();
    int64 $users = $world->db->count('users');

    ecotest::step('a new person gets a user, linked, signed in on their session');
    $grace = $world->visitor();
    google($world, $grace, 'g-1', 'grace@example.com', true)->status(200)->json('$.data.name', 'Grace Hopper');
    $grace->get('/v1/me')->status(200)->json('$.data.name', 'Grace Hopper');
    expect($world->db->count('users'))->is($users + 1);
    expect($world->db->count('connect_links'))->is(1);
    expect($world->db->count('connect_attempts'))->is(0);

    ecotest::step('the same person again is the same user');
    google($world, $world->visitor(), 'g-1', 'grace@example.com', true)->status(200);
    expect($world->db->count('users'))->is($users + 1);

    ecotest::step('a session somebody signed in on already takes nobody else');
    google($world, $grace, 'g-1', 'grace@example.com', true)->problem(409);

    ecotest::step('a verified email links to no account the blog never verified the email of');
    google($world, $world->visitor(), 'g-2', 'editor@example.com', true)->problem(409);
    expect($world->db->count('connect_links'))->is(1);

    ecotest::step('an unverified email makes no account at all');
    google($world, $world->visitor(), 'g-3', 'stranger@example.com', false)->problem(403);
    expect($world->db->count('users'))->is($users + 1);
    expect($world->db->count('connect_links'))->is(1);
}

#[group: "integration"]
test a_claim_without_its_binding_signs_nobody_in
{
    $world = World();
    $started = $world->api->post('/auth/connect/google', json: '{}');
    $claim = json::object(['attempt' => $started->capture('$.attempt'), 'binding' => 'guessed']);
    $world->api->post('/v1/auth/connect', json: $claim)->problem(401);
    $world->api->post('/auth/connect/apple', json: '{}')->problem(404);
}
