/**
 * Users over the API: signing up (and the welcome it queues), the sign-up rules in two languages,
 * and the admin's list of everyone.
 */

use ecotest::expect;
use Blog::DB::Model::{User, UserTable};

/**
 * What `POST /v1/users` takes, with the name padded so the trim shows.
 */
internal function registration(const string& $email, const string& $password) : json::Value
{
    return json::object(['name' => ' A reader ', 'email' => $email, 'password' => $password, 'passwordConfirmation' => $password]);
}

test signing_up_stores_a_welcome_pipeline
{
    $r = rig();
    // nobody has the address yet, the insert, then the welcome's unique key is free and the
    // pipeline is stored: two tasks and the edge between them
    $r->fake->rows([])->written($insertId: 7)->rows([])->written()->written()->written();

    $r->api->post('/v1/users', json: registration(' Reader@Example.com ', 'a long password'))
        ->status(201)
        ->json('$.data.id', 7)
        ->json('$.data.name', 'A reader');

    expect($r->fake->texts()[0])->has('WHERE `users`.`email` = ?');
    expect($r->sent('INSERT INTO `users`'))->is(1);
    expect($r->sent('SELECT') > 1)->yes(says: 'the unique key was checked');
    expect($r->sent('INSERT INTO `nexus_tasks`'))->is(2);
    expect($r->sent('INSERT INTO `nexus_task_edges`'))->is(1);
    expect($r->fake->pending())->is(0);

    // a worker welcomes them
    $r->fake->rows([UserTable()->row(User($id: 7, $email: 'reader@example.com', $name: 'A reader'))])->written();
    expect($r->runTask(Blog::Tasks::SendWelcome($user: 7)))->fine();
    expect($r->fake->last())->starts('UPDATE `users` SET')->has('`welcomed_at` = ?');
    expect($r->app->logged('welcome'))->yes(says: 'the welcome was logged');
}

test a_taken_email_or_a_short_password_queues_nothing
{
    $r = rig();
    // the address is taken: a 422 before anything is written
    $r->fake->rows([editorRow()]);
    $r->api->post('/v1/users', json: registration('Editor@Example.com', 'a long password'))
        ->invalid('email', 'unique')
        ->json('$.errors[0].message', 'Someone already signed up with that e-mail address.');

    // two sign-ups racing past the check: the insert still answers a 409
    $r->fake->rows([])->fails(carbon::Error::driver(carbon::Failure($fault: carbon::Fault::duplicate, $message: 'Duplicate entry')));
    $r->api->post('/v1/users', json: registration('editor@example.com', 'a long password'))
        ->problem(409)
        ->has('that email is taken');

    $r->fake->rows([]);
    $r->api->post('/v1/users', json: registration('new@example.com', 'short'))->invalid('password', 'min');

    expect($r->sent('INSERT INTO `nexus_tasks`'))->is(0);
}

test sign_up_rules_normalise_compare_and_speak_german
{
    $r = rig();
    $doc = registration('not an address', 'a long password');
    $doc['passwordConfirmation'] = 'something else';
    $doc['name'] = '   ';

    $r->api->post('/v1/users', json: $doc)
        ->invalid('name', 'notBlank')
        ->invalid('email', 'email')
        ->invalid('password', 'confirmed')
        ->header('Content-Language', 'en')
        ->json('$.errors[0].message', 'The name field must not be blank.');

    $r->api->with('Accept-Language', 'de-CH, en;q=0.5')->post('/v1/users', json: $doc)
        ->header('Content-Language', 'de')
        ->json('$.errors[0].message', 'Das Feld Name darf nicht leer sein.')
        ->has('Das Feld E-Mail-Adresse muss eine gültige E-Mail-Adresse sein.')
        ->has('Die Bestätigung von Passwort stimmt nicht überein.');

    // nothing was asked of the database
    expect($r->fake->count())->is(0);
}

test listing_users_needs_an_admin
{
    $r = rig();
    $r->api->get('/v1/users')->problem(401);
    $r->fake->rows([editorRow()]);
    $r->editor()->get('/v1/users')->problem(403);
    expect($r->fake->count())->is(1);

    // the admin shape: everyone's email and role
    $r->fake->rows([adminRow()])->rows([adminRow(), authorRow(2)]);
    $r->editor()->get('/v1/users')
        ->status(200)
        ->count('$.data', 2)
        ->json('$.data[0].email', 'editor@example.com')
        ->json('$.data[0].role', 2)
        ->json('$.data[1].name', 'An author')
        ->json('$.data[1].email', 'author2@example.com');

    expect($r->fake->last())->has('ORDER BY `users`.`id`');
}
